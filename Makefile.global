
ifndef ZIGURATIP_HOME
	ZIGURATIP_HOME := ../home
else ifeq ($(ZIGURATIP_HOME),)
	ZIGURATIP_HOME := ../home
endif

ifdef COMPILER
	CXX := $(COMPILER)
endif

ifndef CXXFLAGS
	CXXFLAGS := -Wall -std=c++11
endif

ifndef LDFLAGS
	LDFLAGS :=
endif

ifndef MODE
	MODE := Debug
endif

ifeq ($(MODE),Debug)
	CXXFLAGS := $(CXXFLAGS) -g
	LDFLAGS := $(LDFLAGS) -g
else ifeq ($(MODE),Release)
	# Release used to add nothing at all, so a release build was an unoptimised
	# one that had merely lost its debug symbols. -O3 to match Cicili's own
	# release set: the engine is built by Cicili at -O3, and a server compiled
	# below its own storage engine's optimisation level is a mismatch nobody
	# chose on purpose.
	CXXFLAGS := $(CXXFLAGS) -O3
	LDFLAGS := $(LDFLAGS) -O3
else
	$(error $(PROJECT) Accepted MODEs are Debug|Release!)	
endif

# A project may ask to be optimised whatever the mode. The big integer
# arithmetic and the ciphers standing on it are the hot code of the whole
# system -- one RSA-2048 private key operation is seconds unoptimised and
# fractions of a second with -O3 -- and nobody debugging the storage engine
# wants to pay that toll. Setting OPTIMIZE in a project's own Makefile keeps its
# arithmetic fast in a debug build without touching anyone else's.
ifdef OPTIMIZE
	CXXFLAGS := $(CXXFLAGS) $(OPTIMIZE)
endif

ifndef TYPE
	TYPE := Executable
endif

ifeq ($(OS),Windows_NT)
	OS := Windows
else
	OS := $(shell uname)
endif

BIN_DIR := "$(ZIGURATIP_HOME)/bin"
LIB_DIR := "$(ZIGURATIP_HOME)/lib"

ifeq ($(TYPE),Executable)
	LDFLAGS := $(LDFLAGS) -rdynamic
	ifndef OUTPUT
		ifeq ($(OS),Windows)
			OUTPUT := $(BIN_DIR)/$(PROJECT).exe
		else
			OUTPUT := $(BIN_DIR)/$(PROJECT)
		endif
	endif
else ifeq ($(TYPE),Library)
	LDFLAGS := $(LDFLAGS) -shared
	ifndef OUTPUT
		ifeq ($(OS),Windows)
			CXXFLAGS := $(CXXFLAGS)
			OUTPUT := $(LIB_DIR)/$(PROJECT).dll
		else
			CXXFLAGS := $(CXXFLAGS) -fPIC 
			OUTPUT := $(LIB_DIR)/lib$(PROJECT).so
		endif
	endif
else
	$(error $(PROJECT) Accepted TYPEs are Executable|Library!)
endif

ifeq ($(OS),Windows)
	RM := -del
	CP := -copy /Y
	COPY := copy /Y
	SEP := &
	TAB := ^	
	MK := -mkdir
else
	RM := -rm -f
	CP := -cp
	COPY := cp
	SEP := ;
	TAB := '	'
	MK := -mkdir -p
endif

ifeq ($(OS),FreeBSD)
	CXXFLAGS := $(CXXFLAGS) -D_GLIBCXX_USE_C99 -D_GLIBCXX_USE_C99_MATH -D_GLIBCXX_USE_C99_MATH_TR1
	LDFLAGS := $(LDFLAGS) -D_GLIBCXX_USE_C99 -D_GLIBCXX_USE_C99_MATH -D_GLIBCXX_USE_C99_MATH_TR1
else ifeq ($(OS),SunOS)
	CXXFLAGS := $(CXXFLAGS) -D_GLIBCXX_USE_C99 -D_GLIBCXX_USE_C99_MATH -D_GLIBCXX_USE_C99_MATH_TR1
	LDFLAGS := $(LDFLAGS) -D_GLIBCXX_USE_C99 -D_GLIBCXX_USE_C99_MATH -D_GLIBCXX_USE_C99_MATH_TR1
else ifeq ($(OS),Darwin)
	LDFLAGS := $(LDFLAGS) -lc++
	# The ZiguratIP libraries are mutually recursive (Core uses StreamIO's
	# bufferstream, StreamIO uses Core's Utility). ELF shared objects tolerate
	# unresolved symbols at link time; Mach-O does not unless asked to.
	ifeq ($(TYPE),Library)
		LDFLAGS := $(LDFLAGS) -Wl,-undefined,dynamic_lookup
		# Mach-O stamps a library's install name -- by default its -o path,
		# here the relative ../home/lib/libX.so -- into every binary linked
		# against it, and dyld then resolves that string against the
		# process's working directory, never the rpath. An @rpath install
		# name defers instead to the rpath of whatever loaded it: the
		# home/bin executables carry theirs below, and outside consumers
		# (cocolog) bake the absolute home/lib at their own link.
		LDFLAGS := $(LDFLAGS) -Wl,-install_name,@rpath/lib$(PROJECT).so
	else
		LDFLAGS := $(LDFLAGS) -Wl,-rpath,@executable_path/../lib
	endif
endif

INCLUDES := -I$(ZIGURATIP_HOME)/include $(INCLUDES)
LINKS := -L$(LIB_DIR) $(LINKS)

OBJECTS_DIR := $(ZIGURATIP_HOME)/obj
OBJECTS := $(addprefix $(OBJECTS_DIR)/,$(subst .cpp,.o,$(SOURCES)))

HEADERS_DEST := $(addprefix $(ZIGURATIP_HOME)/include/,$(HEADERS))

.PHONY: all clean headers

all: $(HEADERS_DEST) $(OUTPUT)
	@echo [Project: $(PROJECT)] "******* all done *******"

# Publish this project's headers without compiling anything. The modules are
# mutually recursive at the header level -- Core/bigint.cpp includes StreamIO's
# bufferstream.hpp, and StreamIO builds after Core -- so dependency generation
# cannot run until every public header is already in place. The top level runs
# this pass over all projects first.
headers:
	@$(MK) "$(ZIGURATIP_HOME)/include"
	@- $(foreach head,$(HEADERS), \
		$(COPY) $(head) "$(ZIGURATIP_HOME)/include" $(SEP)\
	)

DEPEND_FILE := $(PROJECT)-$(OS)-$(CXX).depend

$(OUTPUT): $(DEPEND_FILE) $(OBJECTS)
	@$(MK) "$(OBJECTS_DIR)"
	@$(MK) "$(LIB_DIR)"
	@$(MK) "$(BIN_DIR)"
	$(CXX) $(LDFLAGS) $(OBJECTS) -o $(OUTPUT) $(LINKS) $(LIBS)

$(DEPEND_FILE): $(SOURCES) $(HEADERS)
	@$(RM) $(DEPEND_FILE)
	@- $(foreach head,$(HEADERS_DEST), \
		echo $(head): $(notdir $(head)) >> $(DEPEND_FILE)$(SEP)\
		echo $(TAB)$(CP) $(notdir $(head)) "$(ZIGURATIP_HOME)/include" >> $(DEPEND_FILE)$(SEP)\
	)
	@- $(foreach src,$(SOURCES), \
		$(CXX) $(CXXFLAGS) $(INCLUDES) -c $(src) -MM -MT $(OBJECTS_DIR)/$(src:.cpp=.o) >> $(DEPEND_FILE)$(SEP)\
		echo $(TAB)$(CXX) $(CXXFLAGS) $(INCLUDES) -c $(src) -o $(OBJECTS_DIR)/$(src:.cpp=.o) >> $(DEPEND_FILE)$(SEP)\
	)

clean:
	$(RM) *~
	$(RM) $(DEPEND_FILE)
	$(RM) $(OBJECTS)
	@echo [Project: $(PROJECT)] "******* clean done *******"

# Building the dependency file compiles each source against home/include, so it
# must not happen during the headers pass: at that point the projects later in
# the build order have not published their headers yet, the -MM run fails, and
# the resulting file is missing rules for the objects it could not analyse.
ifeq ($(filter headers clean,$(MAKECMDGOALS)),)
include $(DEPEND_FILE)
endif
