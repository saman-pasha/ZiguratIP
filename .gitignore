# home is both the install prefix and the runtime home directory. The
# directories themselves are part of the expected layout and are kept with
# .gitkeep files; everything the build or the server puts inside them is
# generated and stays out of the repository.

# --- build output -----------------------------------------------------------
home/bin/*
home/lib/*
home/obj/*
home/include/*

# --- runtime state ----------------------------------------------------------
# Page store, compiled Parsi objects, catalogue entries, scratch files, logs.
home/data/*
home/ld/*
home/tmp/*
home/catalog/*
home/log/*

# Who may connect to this particular installation. Deployment state, and the
# certificates in it belong to real people.
home/etc/users/*

!home/*/.gitkeep
!home/etc/*/.gitkeep

# --- object and intermediate files ------------------------------------------
*.o
*.obj
*.lo
*.slo
*.ko
*.elf
*.gch
*.pch
*.mod
*.smod

# --- static libraries -------------------------------------------------------
*.a
*.la
*.lai
*.lib

# --- shared libraries -------------------------------------------------------
*.so
*.so.*
*.dylib
*.dylib.*
*.dll
*.exp

# --- executables ------------------------------------------------------------
*.exe
*.app
*.out
*.bin
*.hex
*.i*86
*.x86_64

# --- debug and profiling ----------------------------------------------------
*.pdb
*.ilk
*.idb
*.dwo
*.su
*.dSYM/
*.gcno
*.gcda
*.gcov
*.profraw
*.profdata

# --- archives ---------------------------------------------------------------
# Distribution bundles, never sources.
*.zip
*.tar
*.tar.*
*.tgz
*.tbz2
*.txz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.jar
*.iso
*.dmg
*.pkg

# --- generated build metadata -----------------------------------------------
# Dependency files are regenerated per platform and compiler
# (Project-OS-compiler.depend).
*.depend
compile_commands.json
zlib/configure.log
zlib/zlib.pc
zlib/Makefile.bak

# --- keys ---------------------------------------------------------------
# Nothing carrying a private key belongs in a repository.
*.key
*.pem
*.p12
*.pfx

# The shipped CA material is a sample, named so that nobody mistakes it for
# something usable. It is deliberately tracked so the ca examples run out of
# the box; generate your own with "ca keygen" for anything real.
!home/etc/cert/dont-use-*.key

# --- editors and platforms --------------------------------------------------
.DS_Store
*~
*.swp
*.swo
*.orig
*.rej
.vscode/
.idea/

# Note: the site assets under home/http (*.png, *.ico, *.gif) and zlib's
# documentation (*.pdf) are binary, but they are genuine sources rather than
# build output. Do not add blanket image or document patterns here.

# The MNIST test set, fetched rather than committed -- 7.8 MB of someone
# else's data. Test/ai/README.md has the two lines that get it, and
# Test/run-ai-e2e.sh skips its digit check, out loud, when it is absent.
Test/ai/t10k-images-idx3-ubyte
Test/ai/t10k-labels-idx1-ubyte
Test/ai/train-images-idx3-ubyte
Test/ai/train-labels-idx1-ubyte

# Byte-compiled Emacs Lisp. parsi-mode.el is the source; the .elc is built by
# whoever loads it.
emacs/*.elc
