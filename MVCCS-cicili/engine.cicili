;;;; The Cicili MVCCS as ONE SHARED LIBRARY -- the keystone of replacing
;;;; the C++ engine.
;;;;
;;;; Until now the engine was a macro: every target that wanted it
;;;; expanded its own copy (mvccs_test, schema_test, cocolog's embed).
;;;; That is the right shape for an embedded store and the wrong one for
;;;; the SERVER, whose Parsi-compiled procedure objects are separate .so
;;;; files that must all speak to ONE engine instance in one process.
;;;; This target expands the engine exactly once, adds the thin wrappers
;;;; consumers need so no RAII struct ever crosses the boundary, and
;;;; build.sh links it as libMVCCS.so.
;;;;
;;;; engine.hpp beside it is the consumer's view: the enums, the POD
;;;; Pointer, BaseTable verbatim (a generated table subclasses it, so
;;;; the vtable must match to the byte -- build.sh diffs the header's
;;;; copy against the emitted one), an OPAQUE Memory, and declarations.
;;;; Consumers never see Streams, Statement, or a thread-local.

(source "engine.cpp"
  (make :cpp #t :compile #t)

  (include <cstdio>)
  (include <cstdint>)
  (include <cstring>)
  (include <string>)
  (include <vector>)
  (include <pthread.h>)
  (include <unistd.h>)
  (include <time.h>)
  (include "/home/user/ZiguratIP/Core/zexception.hpp")
  (include "/home/user/ZiguratIP/Core/utility.hpp")
  (include "/home/user/ZiguratIP/StreamIO/binarystream.hpp")
  (include "/home/user/ZiguratIP/StreamIO/filestream.hpp")
  (include "/home/user/ZiguratIP/StreamIO/bufferstream.hpp")
  (include "/home/user/ZiguratIP/StreamIO/textstream.hpp")
  (include <ctype.h>)

  (import "./mvccs-lib.cicili")
  (mvccs-engine)

  ;; ==================================================================
  ;; The consumer surface -- what a Parsi-compiled object or a server
  ;; binding calls that the engine's free functions do not already give.
  ;; ==================================================================

  ;; Memory is opaque to consumers; they hold a Memory* and never lay
  ;; one out. The pair below is the whole of its lifetime.
  (func engine_memory_new () (out Memory *)
    (return (new* Memory)))

  (func engine_memory_delete ((Memory * m)) (out void)
    (delete* m))

  ;; The guarded cursor -- cursor_walk wants a Streams guard, and Streams
  ;; is an RAII struct whose inline body reaches the engine's
  ;; thread-locals. It stays inside the library; a consumer calls this.
  ;; tl_want_shared exactly as deftable's cursor sets it: shared when the
  ;; isolation writes nothing, decided by the guard's own constructor.
  (func engine_cursor ((Memory * m) (const uint8_t * hash_key) (void * ctx)
                       (func cb ((void * c) (Pointer * p)) (out bool)))
        (out void)
    (set tl_want_shared 1)
    (letin* ((streams (Streams m)))
      (cursor_walk m hash_key (aof streams) ctx cb)
      (cast void 0)))

  ;; The transaction the thread is in is a thread-local; a consumer names
  ;; the level and the engine finds the transaction.
  (func engine_set_isolation ((IsolationLevel level)) (out void)
    (if (!= tl_txn nil)
        (set_isolation_level tl_txn level)))

  ;; ------------------------------------------------------------------
  ;; The server's connection surface. A pooled thread serves one
  ;; connection at a time; each of these stages a transaction first --
  ;; a begin on an open transaction continues it -- so a fresh thread's
  ;; first touch opens its transaction exactly where the old engine's
  ;; thread-local Transaction did.
  ;; ------------------------------------------------------------------
  (func engine_transaction_id ((Memory * m)) (out size_t)
    (stage_needs_transaction m)
    (return (? (!= tl_txn nil) (-> tl_txn id) (cast size_t 0))))

  (func engine_isolate ((Memory * m) (IsolationLevel level)) (out void)
    (stage_needs_transaction m)
    (if (!= tl_txn nil)
        (set_isolation_level tl_txn level)))

  (func engine_set_autocommit ((Memory * m) (int64_t v)) (out void)
    (stage_needs_transaction m)
    (if (!= tl_txn nil)
        (set (-> tl_txn auto_commit) v)))

  ;; the connection's setting when one is open, the instance default
  ;; when none is -- the pair the old `transaction.auto_commit ||
  ;; default_autocommit_mode()' test asked for, in one answer
  (func engine_autocommit () (out int64_t)
    (return (? (!= tl_txn nil)
               (-> tl_txn auto_commit)
               (cast int64_t (globals_default_autocommit_mode)))))

  ;; what this thread's transaction runs at right now -- the default
  ;; when none is open, which is also what transaction_reset restores
  (func engine_isolation () (out IsolationLevel)
    (return (? (!= tl_txn nil)
               (-> tl_txn isolation_level)
               (globals_default_isolation_level))))

  ;; the bounded waits' knob, for tests that shrink or stretch them;
  ;; answers the previous value
  (func engine_set_lock_wait_ms ((int v)) (out int)
    (let ((int old . lock_wait_timeout_ms))
      (set lock_wait_timeout_ms v)
      (return old)))

  ;; the registry loses this transaction, exactly as it does when its
  ;; owner dies without commit or rollback -- the stale-lock breaker's
  ;; test stages debris with it
  (func engine_retire_transaction ((size_t transaction_id)) (out void)
    (transaction_retire transaction_id))

  ;; A TEXT COLUMN AS AN INT64 INDEX KEY. The Cicili B-tree keys are
  ;; int64 only; a String-keyed Parsi index rides as this fold of the
  ;; text -- FNV-1a 64, masked positive. TWO STRINGS CAN COLLIDE, and
  ;; the trade is taken openly, exactly as the leader draw's
  ;; grindability was: every generated lookup re-applies its full WHERE
  ;; predicate to each row the index hands back, so a collision costs a
  ;; wasted row visit and never a wrong answer. The one place the trade
  ;; shows is a UNIQUE string key, where a collision would falsely
  ;; refuse a distinct value -- at 2^63 that is a lottery nobody wins,
  ;; and it refuses loudly rather than corrupting anything.
  (func engine_text_key ((const char * s) (size_t n)) (out int64_t)
    ;; the FNV-1a 64 offset basis, composed from halves so no literal
    ;; overflows a signed reader anywhere between Lisp and C++
    (let ((uint64_t h . #'(+ (* (cast uint64_t 3421674724) (cast uint64_t 4294967296))
                             (cast uint64_t 2216829733))))
      (for ((size_t i . 0)) (< i n) ((++ i))
        (set h (xor h (cast uint64_t (cast uint8_t (nth i s)))))
        (set h (* h (cast uint64_t 1099511628211))))
      (return (cast int64_t (bitand h (cast uint64_t 9223372036854775807))))))

  ;; The catalogue-id rule generated attachers use: the key's first
  ;; eight bytes folded to a positive int64 -- the same rule the
  ;; defindex expansion computes at macro time, exported so the Parsi
  ;; compiler's emitted C++ derives identical ids from identical keys.
  (func engine_key64_bytes_fold ((const uint8_t * key)) (out int64_t)
    (let ((uint64_t v . 0))
      (for ((int i . 0)) (< i 8) ((++ i))
        (set v (+ (* v (cast uint64_t 256)) (cast uint64_t (nth i key)))))
      (return (cast int64_t (bitand v (cast uint64_t 9223372036854775807))))))

  ) ; source
