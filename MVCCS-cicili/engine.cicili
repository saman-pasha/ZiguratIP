;;;; The Cicili MVCCS as ONE SHARED LIBRARY -- the keystone of replacing
;;;; the C++ engine.
;;;;
;;;; Until now the engine was a macro: every target that wanted it
;;;; expanded its own copy (mvccs_test, schema_test, cocolog's embed).
;;;; That is the right shape for an embedded store and the wrong one for
;;;; the SERVER, whose Parsi-compiled procedure objects are separate .so
;;;; files that must all speak to ONE engine instance in one process.
;;;; This target expands the engine exactly once, adds the thin wrappers
;;;; consumers need so no RAII struct ever crosses the boundary, and
;;;; build.sh links it as libMVCCS.so.
;;;;
;;;; engine.hpp beside it is the consumer's view: the enums, the POD
;;;; Pointer, BaseTable verbatim (a generated table subclasses it, so
;;;; the vtable must match to the byte -- build.sh diffs the header's
;;;; copy against the emitted one), an OPAQUE Memory, and declarations.
;;;; Consumers never see Streams, Statement, or a thread-local.

(source "engine.cpp"
  (make :cpp #t
        ;; TWO CLANG-ONLY COMPLAINTS ABOUT CORRECT EMISSION: the
        ;; paren-wrapped `while ((x == 0))' the transpiler writes, and
        ;; the unbraced else-if chain. Cicili treats any unrecognised
        ;; compiler chatter as FATAL, so under clang the first of these
        ;; stopped the build outright -- an `Unhandled SIMPLE-ERROR'
        ;; whose text was a -Wparentheses-equality warning. gcc ignores
        ;; unknown -Wno- options, so both flags travel to every platform.
        ;; cocolog.cicili and embed.cicili carry the same pair.
        ;;
        ;; AND THE STANDARD, SAID OUT LOUD. Every makefile in this
        ;; workspace compiles with -std=c++17; these Cicili targets did
        ;; not say, and inherited whatever the compiler defaulted to --
        ;; gnu++17 on Ubuntu's clang, C++14 on Apple's. Under C++14
        ;; there is no guaranteed copy elision, so the transpiler's
        ;; `filestream f = filestream(...)' needs a copy constructor the
        ;; class deletes, and the build died at `call to
        ;; implicitly-deleted copy constructor' naming a line that is
        ;; correct C++17. gnu++17 rather than c++17 because the emitted
        ;; code uses statement expressions, a GNU extension both
        ;; compilers accept.
        ;; A THIRD, FROM APPLE'S SDK: `sprintf' is marked deprecated
        ;; there, and a deprecation is a warning -- which Cicili treats
        ;; as fatal, so the build stopped naming a function that works.
        ;; Silenced in the target's own list, as the other two are.
        :compile ("-std=gnu++17" "-Wno-deprecated-declarations"
                  "-Wno-parentheses-equality" "-Wno-dangling-else"
                  "-c" "engine.cpp"))

  (include <cstdio>)
  (include <cstdint>)
  (include <cstring>)
  (include <cstdlib>)
  (include <string>)
  (include <vector>)
  (include <pthread.h>)
  (include <unistd.h>)
  (include <time.h>)
  (include "../home/include/zexception.hpp")
  (include "../home/include/utility.hpp")
  (include "../home/include/binarystream.hpp")
  (include "../home/include/filestream.hpp")
  (include "../home/include/mapstream.hpp")
  (include "../home/include/bufferstream.hpp")
  (include "../home/include/textstream.hpp")
  (include <ctype.h>)

  (import "./mvccs-lib.cicili")
  (mvccs-engine)

  ;; ==================================================================
  ;; The consumer surface -- what a Parsi-compiled object or a server
  ;; binding calls that the engine's free functions do not already give.
  ;; ==================================================================

  ;; Memory is opaque to consumers; they hold a Memory* and never lay
  ;; one out. The pair below is the whole of its lifetime.
  (func engine_memory_new () (out Memory *)
    (return (new* Memory)))

  (func engine_memory_delete ((Memory * m)) (out void)
    (bt_cache_free m)
    (delete* m))

  ;; The guarded cursor -- cursor_walk wants a Streams guard, and Streams
  ;; is an RAII struct whose inline body reaches the engine's
  ;; thread-locals. It stays inside the library; a consumer calls this.
  ;; tl_want_shared exactly as deftable's cursor sets it: shared when the
  ;; isolation writes nothing, decided by the guard's own constructor.
  (func engine_cursor ((Memory * m) (const uint8_t * hash_key) (void * ctx)
                       (func cb ((void * c) (Pointer * p)) (out bool)))
        (out void)
    (set tl_want_shared 1)
    (letin* ((streams (Streams m)))
      (cursor_walk m hash_key (aof streams) ctx cb)
      (cast void 0)))

  ;; The transaction the thread is in is a thread-local; a consumer names
  ;; the level and the engine finds the transaction.
  (func engine_set_isolation ((IsolationLevel level)) (out void)
    (if (!= tl_txn nil)
        (set_isolation_level tl_txn level)))

  ;; ------------------------------------------------------------------
  ;; The server's connection surface. A pooled thread serves one
  ;; connection at a time; each of these stages a transaction first --
  ;; a begin on an open transaction continues it -- so a fresh thread's
  ;; first touch opens its transaction exactly where the old engine's
  ;; thread-local Transaction did.
  ;; ------------------------------------------------------------------
  (func engine_transaction_id ((Memory * m)) (out size_t)
    (stage_needs_transaction m)
    (return (? (!= tl_txn nil) (-> tl_txn id) (cast size_t 0))))

  ;; THE ONE THAT ONLY LOOKS. engine_transaction_id is not an accessor: it
  ;; stages, so asking for the id OPENS a transaction when none is open.
  ;; ziguratip printed "Transaction Closed <id>" through it at the end of
  ;; every connection, and so opened a second transaction per connection
  ;; in order to report on the first -- ZiguratIP#37 watched the ids step
  ;; by 2, and by 1 once the call was taken out. A log line that wants to
  ;; say what is there must not conjure something to report.
  ;;
  ;; This answers the id this thread's transaction has or last had -- the
  ;; id survives a commit, which nulls the record pointer and keeps it --
  ;; and 0 if the thread never had one. It never stages.
  (func engine_transaction_peek ((Memory * m)) (out size_t)
    (cast void m)
    (return (? (!= tl_txn nil) (-> tl_txn id) (cast size_t 0))))

  ;; the guard's own counters for THIS thread: outermost shared, outermost
  ;; exclusive, nested no-ops, and lifts -- a write that gave a shared hold
  ;; back to take the exclusive side. Deltas across a stretch of work are
  ;; what a test asserts and what a probe used to patch in.
  (func engine_guard_counts ((int64_t * shared) (int64_t * exclusive)
                             (int64_t * nested) (int64_t * lifted)) (out void)
    (set (cof shared) tl_guard_shared_n)
    (set (cof exclusive) tl_guard_exclusive_n)
    (set (cof nested) tl_guard_nested_n)
    (set (cof lifted) tl_guard_lifted_n))

  (func engine_isolate ((Memory * m) (IsolationLevel level)) (out void)
    (stage_needs_transaction m)
    (if (!= tl_txn nil)
        (set_isolation_level tl_txn level)))

  (func engine_set_autocommit ((Memory * m) (int64_t v)) (out void)
    (stage_needs_transaction m)
    (if (!= tl_txn nil)
        (set (-> tl_txn auto_commit) v)))

  ;; the connection's setting when one is open, the instance default
  ;; when none is -- the pair the old `transaction.auto_commit ||
  ;; default_autocommit_mode()' test asked for, in one answer
  (func engine_autocommit () (out int64_t)
    (return (? (!= tl_txn nil)
               (-> tl_txn auto_commit)
               (cast int64_t (globals_default_autocommit_mode)))))

  ;; what this thread's transaction runs at right now -- the default
  ;; when none is open, which is also what transaction_reset restores
  (func engine_isolation () (out IsolationLevel)
    (return (? (!= tl_txn nil)
               (-> tl_txn isolation_level)
               (globals_default_isolation_level))))

  ;; the bounded waits' knob, for tests that shrink or stretch them;
  ;; answers the previous value
  (func engine_set_lock_wait_ms ((int v)) (out int)
    (let ((int old . lock_wait_timeout_ms))
      (set lock_wait_timeout_ms v)
      (return old)))

  ;; the registry loses this transaction, exactly as it does when its
  ;; owner dies without commit or rollback -- the stale-lock breaker's
  ;; test stages debris with it
  (func engine_retire_transaction ((size_t transaction_id)) (out void)
    (transaction_retire transaction_id))

  ;; A COLUMN VALUE AS AN INT64 INDEX KEY. The Cicili B-tree keys are
  ;; int64 only, and the engine's key rules -- beside text_key64 in
  ;; mvccs-lib.cicili -- fold every column kind to one. These three
  ;; export them, so the Parsi compiler's generated C++ derives the same
  ;; key from the same value that a defindex expansion does:
  ;;
  ;;   text   FNV-1a 64 of the bytes, masked positive. TWO STRINGS CAN
  ;;          COLLIDE, and the trade is taken openly, exactly as the
  ;;          leader draw's grindability was: every generated lookup
  ;;          re-applies its full WHERE predicate to each row the index
  ;;          hands back, so a collision costs a wasted row visit and
  ;;          never a wrong answer. The one place the trade shows is a
  ;;          UNIQUE string key, where a collision would falsely refuse
  ;;          a distinct value -- at 2^63 that is a lottery nobody wins,
  ;;          and it refuses loudly rather than corrupting anything.
  ;;   real   the IEEE double folded ORDER-PRESERVING, so a range over a
  ;;          Double key is a real range.
  ;;   words  FNV-1a 64 over int64 words, masked positive -- what a
  ;;          Vector key is, each element folded first by its own rule.
  (func engine_text_key ((const char * s) (size_t n)) (out int64_t)
    (return (text_key64 s n)))

  (func engine_real_key ((double d)) (out int64_t)
    (return (real_key64 d)))

  (func engine_words_key ((const int64_t * w) (size_t n)) (out int64_t)
    (return (words_key64 w n)))

  ;; The catalogue-id rule generated attachers use: the key's first
  ;; eight bytes folded to a positive int64 -- the same rule the
  ;; defindex expansion computes at macro time, exported so the Parsi
  ;; compiler's emitted C++ derives identical ids from identical keys.
  (func engine_key64_bytes_fold ((const uint8_t * key)) (out int64_t)
    (let ((uint64_t v . 0))
      (for ((int i . 0)) (< i 8) ((++ i))
        (set v (+ (* v (cast uint64_t 256)) (cast uint64_t (nth i key)))))
      (return (cast int64_t (bitand v (cast uint64_t 9223372036854775807))))))

  ) ; source
