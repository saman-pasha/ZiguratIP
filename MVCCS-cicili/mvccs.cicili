;;;; MVCCS, written again in Cicili -- a C++ target (:cpp #t).
;;;;
;;;; This is the storage engine of ZiguratIP/MVCCS re-expressed in Cicili's
;;;; C++ layer, against the REAL StreamIO and Core libraries. What it keeps,
;;;; what it trades, and why is in README.md beside it; the ground truth it
;;;; was written from is RESPONSIBILITIES.md.
;;;;
;;;; The shape is C++: structs, RAII guards (ctor/dtor), inheritance with
;;;; virtual dispatch (BaseTable), real exceptions (try / throw*). The
;;;; plumbing is C: pthread mutexes, intrusive lists instead of std::multimap,
;;;; function-pointer + context callbacks instead of capturing lambdas --
;;;; Cicili lambdas are lifted and cannot capture, and every std:: container
;;;; walk would be an unresolvable escape. The table tier that C++ did with
;;;; templates is done with Cicili macros: see deftable at the bottom.
;;;;
;;;; Build:  sh MVCCS-cicili/build.sh   (or see build.sh for the one command)

(source "mvccs.cpp"
  (make :cpp #t :compile #t
        :link ("-lmvccs.o" "-o" "mvccs_test"
               "-L../home/lib" "-lCore" "-lStreamIO"
               "-lpthread"))

  (include <cstdio>)
  (include <cstdint>)
  (include <cstring>)
  (include <string>)
  (include <vector>)
  (include <pthread.h>)
  (include <unistd.h>)
  (include <time.h>)
  (include "../home/include/zexception.hpp")
  (include "../home/include/utility.hpp")
  (include "../home/include/binarystream.hpp")
  (include "../home/include/filestream.hpp")
  (include "../home/include/bufferstream.hpp")
  (include "../home/include/textstream.hpp")
  (include <ctype.h>)

  (import "./mvccs-lib.cicili")
  (mvccs-engine)

  ;; ==================================================================
  ;; The smoke tests. A Book table, one store, the ACID walk-through,
  ;; a restart, and a two-session race.
  ;; ==================================================================
  (deftable Book "smoke::Book" id value)
  (defindex IDX_BOOK_VALUE Book value 0 3)

  (deftable Tag "smoke::Tag" k)
  (defindex IDX_TAG_K Tag k 1 3)

  (deftable Loan "smoke::Loan" member_id book_id)
  (defindex IDX_LOAN_MB Loan (member_id book_id) 0 3)

  (deftable Pair "smoke::Pair" a b)
  (defindex IDX_PAIR_AB Pair (a b) 1 3)

  (defsequence SEQ_ORDER "smoke::OrderSeq" 100 999 1)

  (deftable Memo "smoke::Memo" id (TEXT body))

  (var int failures . 0)

  ;; the FIRST version's address of the row the row_latest scenario
  ;; updates -- kept across the restart so the stamps' durability is
  ;; checked from the same starting point
  (var int64_t latest_first_addr . -1)

  (func check ((const char * what) (int64_t got) (int64_t want)) (out void)
    (if (== got want)
        (printf "ok   %-42s %ld\n" what (cast long got))
      (block
        (printf "FAIL %-42s got %ld want %ld\n" what (cast long got) (cast long want))
        (set failures (+ failures 1)))))

  ;; count and sum through the typed cursor
  (struct CountCtx
    (member int64_t rows)
    (member int64_t value_sum))

  (func count_cb ((void * u) (Book * r)) (out bool)
    (let ((CountCtx * c . #'(cast (CountCtx *) u)))
      (set (-> c rows) (+ (-> c rows) 1))
      (set (-> c value_sum) (+ (-> c value_sum) ($ (cof r) value)))
      (return #t)))

  (func book_count ((Memory * m) (int64_t * value_sum)) (out int64_t)
    (let ((CountCtx c))
      (set ($ c rows) 0)
      (set ($ c value_sum) 0)
      (Book_cursor m (cast (void *) (aof c)) count_cb)
      (if (!= value_sum nil) (set (cof value_sum) ($ c value_sum)))
      (return ($ c rows))))

  ;; find one row by id
  (struct FindCtx
    (member int64_t id)
    (member Book row)
    (member bool found))

  (func find_cb ((void * u) (Book * r)) (out bool)
    (let ((FindCtx * c . #'(cast (FindCtx *) u)))
      (if (== ($ (cof r) id) (-> c id))
          (block
            (set (-> c row) (cof r))
            (set (-> c found) #t)
            (return #f)))
      (return #t)))

  (func book_find ((Memory * m) (int64_t id) (Book * out_row)) (out bool)
    (let ((FindCtx c))
      (set ($ c id) id)
      (set ($ c found) #f)
      (Book_cursor m (cast (void *) (aof c)) find_cb)
      (if ($ c found) (set (cof out_row) ($ c row)))
      (return ($ c found))))

  ;; the DML tier's twins of the two hand-rolled queries above: the
  ;; macros must fold to the same answers the spelled-out context
  ;; structs and lifted callbacks produce
  (defcount dml_book_count Book () #t)
  (deffind  dml_book_find  Book ((int64_t id)) (== (-> row id) id))
  (defcount dml_book_over  Book ((int64_t floor)) (> (-> row value) floor))
  (defquery dml_book_sum   Book () #t
    (set (cof (cast (int64_t *) user))
         (+ (cof (cast (int64_t *) user)) (-> row value))))
  (defupdate dml_book_bump Book ((int64_t k) (int64_t v))
             (== (-> row value) k)
             ((value v)))
  (defdelete dml_book_drop Book ((int64_t v)) (== (-> row value) v))

  ;; count matches through the index cursors
  (func book_equal_count ((Memory * m) (int64_t k)) (out int64_t)
    (let ((CountCtx c))
      (set ($ c rows) 0)
      (set ($ c value_sum) 0)
      (IDX_BOOK_VALUE_equal m k (cast (void *) (aof c)) count_cb)
      (return ($ c rows))))

  (func book_gt_count ((Memory * m) (int64_t k)) (out int64_t)
    (let ((CountCtx c))
      (set ($ c rows) 0)
      (set ($ c value_sum) 0)
      (IDX_BOOK_VALUE_greater_than m k (cast (void *) (aof c)) count_cb)
      (return ($ c rows))))

  ;; ordered-walk verifier for the Tag tree
  (struct TagOrdCtx
    (member int64_t rows)
    (member int64_t last)
    (member int ascending))

  (func tag_ord_cb ((void * u) (Tag * r)) (out bool)
    (let ((TagOrdCtx * c . #'(cast (TagOrdCtx *) u)))
      (if (and (> (-> c rows) 0) (<= (-> r k) (-> c last)))
          (set (-> c ascending) 0))
      (set (-> c last) (-> r k))
      (set (-> c rows) (+ (-> c rows) 1))
      (return #t)))

  (func tag_equal_count ((Memory * m) (int64_t k)) (out int64_t)
    (let ((TagOrdCtx c))
      (set ($ c rows) 0) (set ($ c last) 0) (set ($ c ascending) 1)
      (IDX_TAG_K_equal m k (cast (void *) (aof c)) tag_ord_cb)
      (return ($ c rows))))

  (func tag_lte_count ((Memory * m) (int64_t k)) (out int64_t)
    (let ((TagOrdCtx c))
      (set ($ c rows) 0) (set ($ c last) 0) (set ($ c ascending) 1)
      (IDX_TAG_K_less_than_equal m k (cast (void *) (aof c)) tag_ord_cb)
      (return ($ c rows))))

  (func tag_gt_count ((Memory * m) (int64_t k)) (out int64_t)
    (let ((TagOrdCtx c))
      (set ($ c rows) 0) (set ($ c last) 0) (set ($ c ascending) 1)
      (IDX_TAG_K_greater_than m k (cast (void *) (aof c)) tag_ord_cb)
      (return ($ c rows))))

  (func tag_neq_count ((Memory * m) (int64_t k)) (out int64_t)
    (let ((TagOrdCtx c))
      (set ($ c rows) 0) (set ($ c last) 0) (set ($ c ascending) 1)
      (IDX_TAG_K_not_equal m k (cast (void *) (aof c)) tag_ord_cb)
      (return ($ c rows))))

  ;; counters over the composite indexes
  (struct NRowsCtx
    (member int64_t rows))

  (func loan_n_cb ((void * u) (Loan * r)) (out bool)
    (cast void r)
    (let ((NRowsCtx * c . #'(cast (NRowsCtx *) u)))
      (set (-> c rows) (+ (-> c rows) 1))
      (return #t)))

  (func pair_n_cb ((void * u) (Pair * r)) (out bool)
    (cast void r)
    (let ((NRowsCtx * c . #'(cast (NRowsCtx *) u)))
      (set (-> c rows) (+ (-> c rows) 1))
      (return #t)))

  (func loan_equal_count ((Memory * m) (int64_t a) (int64_t b)) (out int64_t)
    (let ((NRowsCtx c))
      (set ($ c rows) 0)
      (IDX_LOAN_MB_equal m a b (cast (void *) (aof c)) loan_n_cb)
      (return ($ c rows))))

  (func loan_all_count ((Memory * m)) (out int64_t)
    (let ((NRowsCtx c))
      (set ($ c rows) 0)
      (IDX_LOAN_MB_cursor m (cast (void *) (aof c)) loan_n_cb)
      (return ($ c rows))))

  (func pair_equal_count ((Memory * m) (int64_t a) (int64_t b)) (out int64_t)
    (let ((NRowsCtx c))
      (set ($ c rows) 0)
      (IDX_PAIR_AB_equal m a b (cast (void *) (aof c)) pair_n_cb)
      (return ($ c rows))))

  ;; pick one row out of a composite lookup, to delete it
  (struct LoanPickCtx
    (member Loan row)
    (member int found))

  (func loan_pick_cb ((void * u) (Loan * r)) (out bool)
    (let ((LoanPickCtx * c . #'(cast (LoanPickCtx *) u)))
      (set (-> c row) (cof r))
      (set (-> c found) 1)
      (return #f)))

  ;; text-column scan: counts rows, sums body lengths, checks content
  (struct MemoScan
    (member int64_t rows)
    (member int64_t bytes))

  (func memo_cb ((void * u) (Memo * r)) (out bool)
    (let ((MemoScan * c . #'(cast (MemoScan *) u)))
      (set (-> c rows) (+ (-> c rows) 1))
      (set (-> c bytes) (+ (-> c bytes) (cast int64_t (($ (-> r body) size)))))
      (if (== (-> r id) 1)
          (if (!= 0 (strcmp (($ (-> r body) c_str)) "parent(tom, bob)."))
              (set (-> c rows) -1000)))
      (return #t)))

  ;; a session that updates one row and commits, for the SNAPSHOT test
  (func update_worker ((void * arg)) (out void *)
    (let ((Memory * m . #'(cast (Memory *) arg)))
      (begin_transaction m)
      (let ((Book old_row) (Book new_row))
        (if (book_find m 100 (aof old_row))
            (block
              (set new_row old_row)
              (set ($ new_row value) 500)
              (Book_update m (aof old_row) (aof new_row)))))
      (commit_transaction m))
    (return nil))

  ;; stages an update on row 300 and is ABANDONED: the registry loses
  ;; the owner, exactly as it does when the owning thread or process
  ;; dies without commit or rollback (a nested begin is NOT that -- it
  ;; continues the open transaction). The thread then parks holding its
  ;; stage on disk, so the row's EXCLUSIVE lock is real debris while
  ;; the second writer meets it, and ends without any cleanup at all,
  ;; as a dying thread here would.
  (var pthread_mutex_t abandon_gate . PTHREAD_MUTEX_INITIALIZER)
  (var int abandon_staged . 0)
  (var int abandon_release . 0)

  (func abandon_worker ((void * arg)) (out void *)
    (let ((Memory * m . #'(cast (Memory *) arg)))
      (begin_transaction m)
      (let ((Book old_row) (Book new_row))
        (if (book_find m 300 (aof old_row))
            (block
              (set new_row old_row)
              (set ($ new_row value) 701)
              (Book_update m (aof old_row) (aof new_row)))))
      ;; the abandonment: the registry no longer knows the owner
      (transaction_retire (-> tl_txn id))
      (pthread_mutex_lock (aof abandon_gate))
      (set abandon_staged 1)
      (pthread_mutex_unlock (aof abandon_gate))
      (let ((int held . 1))
        (while (== held 1)
          (pthread_mutex_lock (aof abandon_gate))
          (if (== abandon_release 1) (set held 0))
          (pthread_mutex_unlock (aof abandon_gate))
          (usleep 5000))))
    (return nil))

  ;; one concurrent session: its own transaction, ten inserts, commit
  (func session_worker ((void * arg)) (out void *)
    (let ((Memory * m . #'(cast (Memory *) arg)))
      (begin_transaction m)
      (let ((int64_t i . 0))
        (while (< i 10)
          (let ((Book b))
            (set ($ b id) (+ 100 i))
            (set ($ b value) 1)
            (Book_insert m (aof b)))
          (set i (+ i 1))))
      (commit_transaction m))
    (return nil))

  (main
    ;; a fresh pair of store files
    (remove "/tmp/mvccs-cicili-hexmap.bin")
    (remove "/tmp/mvccs-cicili-data.bin")
    ;; in|out|trunc creates the pair fresh
    (letin* ((hexmap (Zigurat::filestream (std::string "/tmp/mvccs-cicili-hexmap.bin")
                                 (bitor std::ios::in (bitor std::ios::out std::ios::trunc))))
             (data (Zigurat::filestream (std::string "/tmp/mvccs-cicili-data.bin")
                               (bitor std::ios::in (bitor std::ios::out std::ios::trunc)))))
      (let ((Memory mem))
        (memory_open (aof mem) (cast (binarystream *) (aof hexmap))
                     (cast (binarystream *) (aof data)) 8192)

        ;; the indexes: attached once, before anything writes
        (IDX_BOOK_VALUE_attach (aof mem))
        (IDX_TAG_K_attach (aof mem))
        (IDX_LOAN_MB_attach (aof mem))
        (IDX_PAIR_AB_attach (aof mem))

        ;; ---- insert three, commit, read back --------------------------
        (let ((int64_t i . 1))
          (while (<= i 3)
            (let ((Book b))
              (set ($ b id) i)
              (set ($ b value) (* i 10))
              (Book_insert (aof mem) (aof b)))
            (set i (+ i 1))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        (let ((int64_t sum . 0))
          (check "three rows committed" (book_count (aof mem) (aof sum)) 3)
          (check "their values landed" sum 60))

        ;; ---- update one, commit; the new version is the one shown -----
        (let ((Book old_row) (Book new_row))
          (if (book_find (aof mem) 2 (aof old_row))
              (block
                (set new_row old_row)
                (set ($ new_row value) 42)
                (Book_update (aof mem) (aof old_row) (aof new_row)))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        (let ((int64_t sum . 0))
          (check "update kept the row count" (book_count (aof mem) (aof sum)) 3)
          (check "the new version shows" sum 82))
        (check "the index finds the new version" (book_equal_count (aof mem) 42) 1)
        (check "the index dropped the old version" (book_equal_count (aof mem) 20) 0)

        ;; ---- a rolled back delete never happened ----------------------
        (let ((Book doomed))
          (if (book_find (aof mem) 3 (aof doomed))
              (Book_delete (aof mem) (aof doomed))))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "rollback undid the delete" (book_count (aof mem) nil) 3)
        (check "a rolled back delete reappears in the index" (book_equal_count (aof mem) 30) 1)

        ;; ---- the same delete, committed, is real ----------------------
        (let ((Book doomed))
          (if (book_find (aof mem) 3 (aof doomed))
              (Book_delete (aof mem) (aof doomed))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "committed delete holds" (book_count (aof mem) nil) 2)
        (check "the index hides the deleted row" (book_equal_count (aof mem) 30) 0)

        ;; ---- TRUNCATE reclaims exactly the settled dead ---------------
        ;; two of them: row 3's settled delete AND the superseded old
        ;; version row 2's update left behind -- reclaiming UPDATED
        ;; versions is the machines-table lesson, see dead_pointers
        (check "truncate frees the settled dead" (cast int64_t (Book_truncate (aof mem))) 2)
        (check "truncate spares the living" (book_count (aof mem) nil) 2)
        (check "the index survives truncate" (book_equal_count (aof mem) 42) 1)

        ;; ---- the DML macros against their hand-rolled twins -----------
        (let ((int64_t hsum . 0) (int64_t msum . 0))
          (check "defcount twins book_count"
                 (dml_book_count (aof mem)) (book_count (aof mem) (aof hsum)))
          (dml_book_sum (aof mem) (cast (void *) (aof msum)))
          (check "defquery sums what the hand walk sums" msum hsum))
        (let ((Book a) (Book b))
          (check "deffind finds what book_find finds"
                 (cast int64_t (dml_book_find (aof mem) 2 (aof a))) 1)
          (if (book_find (aof mem) 2 (aof b))
              (check "and hands back the same row" ($ a value) ($ b value))))
        (check "deffind misses what is not there"
               (cast int64_t (dml_book_find (aof mem) 777 nil)) 0)
        (check "a parameter reaches the WHERE" (dml_book_over (aof mem) 20) 1)
        (check "defupdate rewrites the admitted row" (dml_book_bump (aof mem) 42 77) 1)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "the rewrite moved the index" (book_equal_count (aof mem) 77) 1)
        (check "and back is the mirror" (dml_book_bump (aof mem) 77 42) 1)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((Book tmp))
          (set ($ tmp id) 99)
          (set ($ tmp value) 999)
          (Book_insert (aof mem) (aof tmp)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "defdelete removes what WHERE admits" (dml_book_drop (aof mem) 999) 1)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "and spares the rest" (book_count (aof mem) nil) 2)

        ;; ---- an allocation past a page is refused ---------------------
        (let ((int64_t refused . 0))
          (try (block
                 (let ((Pointer p . #'(allocate (aof mem) (Book_key) 9000)))
                   (cast void p)))
               (catch ((const MemoryException & e))
                 (cast void e)
                 (set refused 1)))
          (check "allocation overflow refused" refused 1))

        ;; ---- two sessions race their inserts --------------------------
        (let ((pthread_t t1) (pthread_t t2))
          (pthread_create (aof t1) nil session_worker (cast (void *) (aof mem)))
          (pthread_create (aof t2) nil session_worker (cast (void *) (aof mem)))
          (pthread_join t1 nil)
          (pthread_join t2 nil))
        (check "two sessions landed their rows" (book_count (aof mem) nil) 22)
        (check "the index carries the sessions' rows" (book_equal_count (aof mem) 1) 20)
        (check "a range query finds the pair above nine" (book_gt_count (aof mem) 9) 2)

        ;; ---- REPEATABLE READ takes and releases its shared locks ------
        (set_isolation_level tl_txn REPEATABLE_READ)
        (check "repeatable read sees the same store" (book_count (aof mem) nil) 22)
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "the locks went back" (book_count (aof mem) nil) 22)

        ;; ---- SERIALIZABLE gate admits and releases --------------------
        (set_isolation_level tl_txn SERIALIZABLE)
        (check "serializable admits one" (book_count (aof mem) nil) 22)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        ;; ---- SNAPSHOT: a read anchored before a concurrent commit ------
        ;; Main anchors its snapshot, another session updates a row and
        ;; commits, and main still reads the store as it was.
        (set_isolation_level tl_txn SNAPSHOT)
        (let ((pthread_t tu))
          (pthread_create (aof tu) nil update_worker (cast (void *) (aof mem)))
          (pthread_join tu nil))
        (let ((int64_t sum . 0)
              (int64_t rows . 0))
          (set rows (book_count (aof mem) (aof sum)))
          (check "snapshot holds its point in time (rows)" rows 22)
          (check "snapshot holds its point in time (sum)" sum 72))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((int64_t sum . 0))
          (check "a fresh read sees the update" (book_count (aof mem) (aof sum)) 22)
          (check "the updated value" sum 571))
        (check "the index moved with the update" (book_equal_count (aof mem) 500) 1)

        ;; ---- thirty distinct keys through a branching-3 tree ----------
        ;; inserted in a shuffled order (i*7 mod 30), so the tree splits
        ;; its way up from a root of max degree 4
        (let ((int64_t i . 0))
          (while (< i 30)
            (let ((Tag t))
              (set ($ t k) (% (* i 7) 30))
              (Tag_insert (aof mem) (aof t)))
            (set i (+ i 1))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        (let ((TagOrdCtx oc))
          (set ($ oc rows) 0) (set ($ oc last) 0) (set ($ oc ascending) 1)
          (IDX_TAG_K_cursor (aof mem) (cast (void *) (aof oc)) tag_ord_cb)
          (check "thirty keys through the splits" ($ oc rows) 30)
          (check "and the walk comes back in order" (cast int64_t ($ oc ascending)) 1))
        (check "a key below the median" (tag_equal_count (aof mem) 4) 1)
        (check "a key above the median" (tag_equal_count (aof mem) 27) 1)

        ;; ---- the unique index refuses a duplicate ---------------------
        (let ((int64_t refused . 0))
          (try (block
                 (let ((Tag dup))
                   (set ($ dup k) 7)
                   (Tag_insert (aof mem) (aof dup))))
               (catch ((const IndexException & e))
                 (cast void e)
                 (set refused 1)))
          (check "the unique index refuses a duplicate" refused 1))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "the refusal left exactly one behind" (tag_equal_count (aof mem) 7) 1)

        ;; ---- ranges over the split tree -------------------------------
        (check "less_than_equal ten" (tag_lte_count (aof mem) 10) 11)
        (check "greater_than twenty-seven" (tag_gt_count (aof mem) 27) 2)
        (check "not_equal five" (tag_neq_count (aof mem) 5) 29)

        ;; ---- composite: a five-by-six grid through two levels ---------
        ;; five top keys split the top root (max degree 4); six dependent
        ;; keys under each split THEIR roots -- the write-back the
        ;; original loses (its dependent root splits update a catalogue
        ;; record the dependent does not have, and the parent key is only
        ;; told at creation)
        (let ((int64_t i . 0))
          (while (< i 5)
            (let ((int64_t j . 0))
              (while (< j 6)
                (let ((Loan l))
                  (set ($ l member_id) i)
                  (set ($ l book_id) j)
                  (Loan_insert (aof mem) (aof l)))
                (set j (+ j 1))))
            (set i (+ i 1))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        (check "composite equal finds its cell" (loan_equal_count (aof mem) 3 4) 1)
        (check "composite cursor sees the grid" (loan_all_count (aof mem)) 30)

        ;; a second row in one cell: the non-unique tuple buckets
        (let ((Loan l))
          (set ($ l member_id) 3)
          (set ($ l book_id) 4)
          (Loan_insert (aof mem) (aof l)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "the cell buckets its pair" (loan_equal_count (aof mem) 3 4) 2)

        ;; delete one of the pair: the other stays found
        (let ((LoanPickCtx pick))
          (set ($ pick found) 0)
          (IDX_LOAN_MB_equal (aof mem) 3 4 (cast (void *) (aof pick)) loan_pick_cb)
          (if (== ($ pick found) 1)
              (Loan_delete (aof mem) (aof ($ pick row)))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "one of the pair deleted" (loan_equal_count (aof mem) 3 4) 1)
        (check "the grid is whole again" (loan_all_count (aof mem)) 30)

        ;; ---- composite uniqueness is the whole tuple's ----------------
        (let ((Pair p))
          (set ($ p a) 1) (set ($ p b) 1)
          (Pair_insert (aof mem) (aof p)))
        (let ((Pair p))
          (set ($ p a) 1) (set ($ p b) 2)
          (Pair_insert (aof mem) (aof p)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        (let ((int64_t refused . 0))
          (try (block
                 (let ((Pair dup))
                   (set ($ dup a) 1) (set ($ dup b) 2)
                   (Pair_insert (aof mem) (aof dup))))
               (catch ((const IndexException & e))
                 (cast void e)
                 (set refused 1)))
          (check "a duplicate tuple refused" refused 1))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "a shared first column is no duplicate" (pair_equal_count (aof mem) 1 1) 1)
        (check "the refused tuple left one behind" (pair_equal_count (aof mem) 1 2) 1)

        ;; ---- the sequence: FROM first, refusals loud, never rolls back
        (SEQ_ORDER_attach (aof mem))
        (check "next answers FROM first" (SEQ_ORDER_next) 100)
        (check "and advances" (SEQ_ORDER_next) 101)
        (check "current stands past it" (SEQ_ORDER_current) 102)
        (SEQ_ORDER_set_current 200)
        (check "set_current lands" (SEQ_ORDER_current) 200)
        (let ((int64_t refused . 0))
          (try (SEQ_ORDER_set_current 1000)
               (catch ((const SequenceException & e))
                 (cast void e)
                 (set refused 1)))
          (check "out of range refused" refused 1))
        (check "back answers where it stood" (SEQ_ORDER_back) 200)
        (check "and stepped down" (SEQ_ORDER_current) 199)
        (SEQ_ORDER_reset)
        (check "reset returns to FROM" (SEQ_ORDER_current) 100)
        (let ((int64_t refused . 0))
          (try (block
                 (let ((int64_t v . #'(SEQ_ORDER_back)))
                   (cast void v)))
               (catch ((const SequenceException & e))
                 (cast void e)
                 (set refused 1)))
          (check "below FROM refused" refused 1))
        ;; a sequence is outside transactions: the draw survives rollback
        (let ((int64_t drawn . #'(SEQ_ORDER_next)))
          (cast void drawn))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "a sequence never rolls back" (SEQ_ORDER_current) 101)
        ;; exhaustion says so
        (SEQ_ORDER_set_current 999)
        (let ((int64_t refused . 0))
          (try (block
                 (let ((int64_t v . #'(SEQ_ORDER_next)))
                   (cast void v)))
               (catch ((const SequenceException & e))
                 (cast void e)
                 (set refused 1)))
          (check "maximum exceeds refused" refused 1))

        ;; ---- Globals: switches, the registry, who may reach what ------
        (globals_set_trace_mode 1)
        (check "a switch flips on" (cast int64_t (globals_trace_mode)) 1)
        (globals_set_trace_mode 0)
        (check "and off" (cast int64_t (globals_trace_mode)) 0)
        (check "the canary answers"
               (? (!= (globals_runtime_instance) nil) 1 0) 1)

        ;; an unbound client stream refuses instead of dying later
        (let ((int64_t refused . 0))
          (try (block
                 (let ((binarystream * cs . #'(globals_client_stream)))
                   (cast void cs)))
               (catch ((const ZiguratException & e))
                 (cast void e)
                 (set refused 1)))
          (check "no connection refused loudly" refused 1))
        (globals_set_client_stream (cast (binarystream *) (aof data)))
        (check "a bound stream comes back"
               (? (== (globals_client_stream) (cast (binarystream *) (aof data))) 1 0) 1)
        (globals_set_client_stream nil)

        ;; the permission paths, exactly the original's model
        (check "permissions off admits all" (cast int64_t (globals_permits "ANY::THING")) 1)
        (globals_set_permissions_mode 1)
        (check "unidentified admits all" (cast int64_t (globals_permits "ANY::THING")) 1)
        (globals_set_peer "tester")
        (globals_add_peer_permission "demo")
        (globals_add_peer_permission "App::Books")
        (check "a schema grant covers its tables" (cast int64_t (globals_permits "DEMO::AUTHORS")) 1)
        (check "case never decides" (cast int64_t (globals_permits "demo::authors")) 1)
        (check "an object grant covers itself" (cast int64_t (globals_permits "app::books")) 1)
        (check "and what is under it" (cast int64_t (globals_permits "APP::BOOKS::TITLE")) 1)
        (check "but never its schema" (cast int64_t (globals_permits "APP")) 0)
        (check "and nothing else" (cast int64_t (globals_permits "OTHER")) 0)
        (let ((int64_t refused . 0))
          (try (globals_require_permission "OTHER::THING")
               (catch ((const ZiguratException & e))
                 (cast void e)
                 (set refused 1)))
          (check "denial names its subject" refused 1))
        (globals_add_peer_permission "*")
        (check "star covers everything" (cast int64_t (globals_permits "anything::at::all")) 1)
        (globals_clear_peer)
        (check "a cleared peer is a plain connection" (cast int64_t (globals_permits "OTHER")) 1)
        (globals_set_permissions_mode 0)

        ;; the connection defaults flow into the next transaction
        (globals_set_default_isolation_level SNAPSHOT)
        (globals_set_default_autocommit_mode 1)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "the default level reaches the transaction"
               (cast int64_t (cast int (-> tl_txn isolation_level))) 3)
        (check "so does autocommit" (-> tl_txn auto_commit) 1)
        (globals_set_default_isolation_level READ_COMMITTED)
        (globals_set_default_autocommit_mode 0)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        ;; the registry holds what it is given
        (globals_set_memory (aof mem))
        (check "the registry answers with the store"
               (? (== (globals_memory) (aof mem)) 1 0) 1)

        ;; ---- the DBA reports and the watcher --------------------------
        (let ((binarystream * report . #'(cast (binarystream *) (new* Zigurat::bufferstream))))
          (dba_pagefiles (aof mem) report)
          (check "pagefiles describes the store"
                 (? (> ((-> report length)) 0) 1 0) 1)
          (delete* report))
        (let ((binarystream * report . #'(cast (binarystream *) (new* Zigurat::bufferstream))))
          ((-> report write_std_long) (cast int64_t 0))
          (dba_pointers (aof mem) report)
          (check "pointers walks page zero"
                 (? (> ((-> report length)) 8) 1 0) 1)
          (delete* report))
        (let ((binarystream * ear . #'(cast (binarystream *) (new* Zigurat::bufferstream))))
          (dba_attach_watcher (aof mem) ear)
          (let ((Pair pr))
            (set ($ pr a) 5) (set ($ pr b) 5)
            (Pair_insert (aof mem) (aof pr)))
          (commit_transaction (aof mem))
          (begin_transaction (aof mem))
          (check "the watcher heard the engine work"
                 (? (> ((-> ear length)) 0) 1 0) 1)
          (dba_detach_watcher (aof mem)))

        ;; ---- a TEXT column: variable rows, read back exactly ----------
        (let ((Memo w))
          (set ($ w id) 1)
          (set ($ w body) (std::string "parent(tom, bob)."))
          (Memo_insert (aof mem) (aof w)))
        (let ((Memo w))
          (set ($ w id) 2)
          (set ($ w body) (std::string ""))
          (Memo_insert (aof mem) (aof w)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((MemoScan sc))
          (set ($ sc rows) 0)
          (set ($ sc bytes) 0)
          (Memo_cursor (aof mem) (cast (void *) (aof sc)) memo_cb)
          (check "text rows come back" ($ sc rows) 2)
          (check "byte for byte" ($ sc bytes) 17))

        ;; ---- a dead transaction's lock breaks on contact --------------
        ;; abandon_worker leaves row 300 EXCLUSIVE-locked by a transaction
        ;; nothing will ever finish. Before the breaker this update burned
        ;; the whole lock_wait_timeout_ms on a corpse and threw; now
        ;; check_lock finds the owner dead in the live registry, rolls the
        ;; one pointer back exactly as startup recovery would, and the
        ;; update lands in milliseconds.
        (let ((Book b))
          (set ($ b id) 300)
          (set ($ b value) 700)
          (Book_insert (aof mem) (aof b)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((pthread_t ta))
          (pthread_create (aof ta) nil abandon_worker (cast (void *) (aof mem)))
          (let ((int ready . 0))
            (while (== ready 0)
              (pthread_mutex_lock (aof abandon_gate))
              (if (== abandon_staged 1) (set ready 1))
              (pthread_mutex_unlock (aof abandon_gate))
              (usleep 5000)))
          (let ((int64_t t0 . #'(mvccs_wall_micros)))
            (let ((Book old_row) (Book new_row))
              (check "the debris hides nothing committed"
                     (? (book_find (aof mem) 300 (aof old_row)) 1 0) 1)
              (check "and the committed version is what reads"
                     ($ old_row value) 700)
              (set new_row old_row)
              (set ($ new_row value) 702)
              (Book_update (aof mem) (aof old_row) (aof new_row)))
            (commit_transaction (aof mem))
            (begin_transaction (aof mem))
            (check "the stale lock broke on contact, not by timeout"
                   (? (< (- (mvccs_wall_micros) t0) 1000000) 1 0) 1))
          (pthread_mutex_lock (aof abandon_gate))
          (set abandon_release 1)
          (pthread_mutex_unlock (aof abandon_gate))
          (pthread_join ta nil))
        (check "the abandoned stage never landed" (book_equal_count (aof mem) 701) 0)
        (check "the second writer's update did" (book_equal_count (aof mem) 702) 1)
        ;; and the row leaves, so every later count stands
        (let ((Book doomed))
          (if (book_find (aof mem) 300 (aof doomed))
              (Book_delete (aof mem) (aof doomed))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        ;; ---- the last inserted version, from the first of history -----
        ;; A row is updated eight times, so its history is nine versions
        ;; and the page scan meets the FIRST of them first. row_latest
        ;; follows the successor stamps the commits wrote and lands on
        ;; the ninth in eight verified hops -- the growing history in
        ;; between is never read.
        (let ((Book b))
          (set ($ b id) 900)
          (set ($ b value) 1)
          (Book_insert (aof mem) (aof b))
          (set latest_first_addr ($ ($ b pointer) address)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((int64_t round . 0))
          (while (< round 8)
            (let ((Book old_row) (Book new_row))
              (if (book_find (aof mem) 900 (aof old_row))
                  (block
                    (set ($ new_row id) 900)
                    (set ($ new_row value) (+ ($ old_row value) 1))
                    (Book_update (aof mem) (aof old_row) (aof new_row)))))
            (commit_transaction (aof mem))
            (begin_transaction (aof mem))
            (set round (+ round 1))))
        (let ((Pointer p . #'(pointer_at (aof mem) (Book_key) latest_first_addr))
              (int64_t hops . 0))
          (set hops (row_latest (aof mem) (aof p)))
          (check "eight stamps walked from the first version" hops 8)
          (let ((Book got))
            (set ($ got pointer) p)
            (read_row (aof mem) (cast (BaseTable *) (aof got)))
            (check "and they end on the last inserted version" ($ got value) 9)))
        ;; a version nothing superseded has nowhere to hop
        (let ((Book fresh))
          (if (book_find (aof mem) 100 (aof fresh))
              (let ((Pointer p2 . #'($ fresh pointer))
                    (int64_t hops2 . 0))
                (set hops2 (row_latest (aof mem) (aof p2)))
                (check "a current version stands still" hops2 0))))
        ;; a rolled-back update stamps nothing: the road still ends at nine
        (let ((Book old_row) (Book new_row))
          (if (book_find (aof mem) 900 (aof old_row))
              (block
                (set ($ new_row id) 900)
                (set ($ new_row value) 1000)
                (Book_update (aof mem) (aof old_row) (aof new_row)))))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((Pointer p . #'(pointer_at (aof mem) (Book_key) latest_first_addr))
              (int64_t hops . 0))
          (set hops (row_latest (aof mem) (aof p)))
          (check "a rollback stamped nothing" hops 8)
          (let ((Book got))
            (set ($ got pointer) p)
            (read_row (aof mem) (cast (BaseTable *) (aof got)))
            (check "and the road still ends where it did" ($ got value) 9)))
        ;; deletion ends the road without erasing it -- the walk arrives
        ;; at the last inserted version, whose control then says deleted
        (let ((Book doomed))
          (if (book_find (aof mem) 900 (aof doomed))
              (Book_delete (aof mem) (aof doomed))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (let ((Pointer p . #'(pointer_at (aof mem) (Book_key) latest_first_addr))
              (int64_t hops . 0))
          (set hops (row_latest (aof mem) (aof p)))
          (check "the walk survives the row's deletion" hops 8))

        (sync_disk (aof mem))
        (cast void 0)))

    ;; ---- a fresh Memory over the same files: recovery ---------------
    (letin* ((hexmap (Zigurat::filestream (std::string "/tmp/mvccs-cicili-hexmap.bin")
                                 (bitor std::ios::in std::ios::out)))
             (data (Zigurat::filestream (std::string "/tmp/mvccs-cicili-data.bin")
                               (bitor std::ios::in std::ios::out))))
      (let ((Memory mem))
        (memory_open (aof mem) (cast (binarystream *) (aof hexmap))
                     (cast (binarystream *) (aof data)) 8192)
        (check "the store survives a restart" (book_count (aof mem) nil) 22)

        ;; the stamps are rows like everything else, so they restart too
        (let ((Pointer p . #'(pointer_at (aof mem) (Book_key) latest_first_addr))
              (int64_t hops . 0))
          (set hops (row_latest (aof mem) (aof p)))
          (check "the stamps survive a restart" hops 8))

        ;; attach finds the catalogue records written last time -- the
        ;; roots come back, nothing re-inserts
        (IDX_BOOK_VALUE_attach (aof mem))
        (IDX_TAG_K_attach (aof mem))
        (IDX_LOAN_MB_attach (aof mem))
        (IDX_PAIR_AB_attach (aof mem))
        (check "the index survives it too" (book_equal_count (aof mem) 500) 1)
        (check "the composite survives it too" (loan_equal_count (aof mem) 3 4) 1)
        (check "the whole grid survives it too" (loan_all_count (aof mem)) 30)
        (let ((TagOrdCtx oc))
          (set ($ oc rows) 0) (set ($ oc last) 0) (set ($ oc ascending) 1)
          (IDX_TAG_K_cursor (aof mem) (cast (void *) (aof oc)) tag_ord_cb)
          (check "the tree survives it too" ($ oc rows) 30)
          (check "and still walks in order" (cast int64_t ($ oc ascending)) 1))

        (SEQ_ORDER_attach (aof mem))
        (check "the sequence survives it too" (SEQ_ORDER_current) 999)

        ;; ---- unmap_key: the lowest ten keys leave the tree wholesale,
        ;; every deletion of the minimum walking the leftmost leaf, the
        ;; underflow merges and the root shrinks
        (let ((int64_t k . 0))
          (while (< k 10)
            (IDX_TAG_K_unmap_key (aof mem) k)
            (set k (+ k 1))))
        (check "a deleted key answers nothing" (tag_equal_count (aof mem) 5) 0)
        (check "its neighbour above survives" (tag_equal_count (aof mem) 15) 1)
        (let ((TagOrdCtx oc))
          (set ($ oc rows) 0) (set ($ oc last) 0) (set ($ oc ascending) 1)
          (IDX_TAG_K_cursor (aof mem) (cast (void *) (aof oc)) tag_ord_cb)
          (check "twenty keys remain" ($ oc rows) 20)
          (check "in order through the merges" (cast int64_t ($ oc ascending)) 1))
        (sync_disk (aof mem))
        (cast void 0)))

    ;; ---- and a third opening: the deletions are durable --------------
    (letin* ((hexmap (Zigurat::filestream (std::string "/tmp/mvccs-cicili-hexmap.bin")
                                 (bitor std::ios::in std::ios::out)))
             (data (Zigurat::filestream (std::string "/tmp/mvccs-cicili-data.bin")
                               (bitor std::ios::in std::ios::out))))
      (let ((Memory mem))
        (memory_open (aof mem) (cast (binarystream *) (aof hexmap))
                     (cast (binarystream *) (aof data)) 8192)
        (IDX_TAG_K_attach (aof mem))
        (let ((TagOrdCtx oc))
          (set ($ oc rows) 0) (set ($ oc last) 0) (set ($ oc ascending) 1)
          (IDX_TAG_K_cursor (aof mem) (cast (void *) (aof oc)) tag_ord_cb)
          (check "the deletions survive a restart" ($ oc rows) 20)
          (check "and the tree still walks in order" (cast int64_t ($ oc ascending)) 1))

        ;; two more out of the middle, on the reopened store -- keys deep
        ;; enough to sit as internal separators, so the successor
        ;; replacement runs against reloaded pages
        (IDX_TAG_K_unmap_key (aof mem) 15)
        (IDX_TAG_K_unmap_key (aof mem) 20)
        (check "a mid-tree key deleted" (tag_equal_count (aof mem) 15) 0)
        (check "and another" (tag_equal_count (aof mem) 20) 0)
        (check "their neighbours stand" (tag_equal_count (aof mem) 16) 1)
        (let ((TagOrdCtx oc))
          (set ($ oc rows) 0) (set ($ oc last) 0) (set ($ oc ascending) 1)
          (IDX_TAG_K_cursor (aof mem) (cast (void *) (aof oc)) tag_ord_cb)
          (check "eighteen remain, ordered" ($ oc rows) 18)
          (check "order held through replacement" (cast int64_t ($ oc ascending)) 1))
        (cast void 0)))

    (if (== failures 0)
        (printf "\nmvccs-cicili: all green\n")
      (printf "\nmvccs-cicili: %d FAILED\n" failures))
    (return failures)))

