;;;; COCOLOG::MACHINE_STATE -- generated by the Parsi compiler beside the
;;;; C++ pair. One file is header and source both: import it into a
;;;; target that imports the Cicili MVCCS engine (MVCCS-cicili/), whose
;;;; def... macros expand the object. Attach each index once, after
;;;; memory_open.
;;;;
;;;; Columns, with their Parsi types (Cicili MVCCS columns are int64):
;;;;   ID LONG
;;;;   MACHINE_ID LONG
;;;;   SEQ INT
;;;;   CHUNK TEXT

(DEFMACRO define-COCOLOG_MACHINE_STATE ()
  '($$$
    (deftable COCOLOG::MACHINE_STATE ID MACHINE_ID SEQ (TEXT CHUNK))
    (defindex IDX_COCOLOG_MACHINE_STATE_ID COCOLOG::MACHINE_STATE ID 1 65)
    (defindex IDX_COCOLOG_MACHINE_STATE_MACHINE_ID COCOLOG::MACHINE_STATE MACHINE_ID 0 65)
    ))
