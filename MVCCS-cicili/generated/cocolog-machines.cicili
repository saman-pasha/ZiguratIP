;;;; COCOLOG::MACHINES -- generated by the Parsi compiler beside the
;;;; C++ pair. One file is header and source both: import it into a
;;;; target that imports the Cicili MVCCS engine (MVCCS-cicili/), whose
;;;; def... macros expand the object. Attach each index once, after
;;;; memory_open.
;;;;
;;;; Columns, with their Parsi types (Cicili MVCCS columns are int64):
;;;;   ID LONG
;;;;   NAME STRING
;;;;   KB STRING
;;;;   STATUS STRING
;;;;   CHUNKS INT
;;;;   NOTE STRING

(DEFMACRO define-COCOLOG_MACHINES ()
  '($$$
    (deftable COCOLOG::MACHINES ID (TEXT NAME) (TEXT KB) (TEXT STATUS) CHUNKS (TEXT NOTE))
    (defindex IDX_COCOLOG_MACHINES_ID COCOLOG::MACHINES ID 1 65)
    ;; string-keyed, no Cicili B-tree:    (defindex IDX_COCOLOG_MACHINES_NAME COCOLOG::MACHINES NAME 1 65)
    ;; string-keyed, no Cicili B-tree:    (defindex IDX_COCOLOG_MACHINES_KB COCOLOG::MACHINES KB 0 65)
    ))
