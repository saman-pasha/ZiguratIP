;;;; COCOLOG::CLAUSES -- generated by the Parsi compiler beside the
;;;; C++ pair. One file is header and source both: import it into a
;;;; target that imports the Cicili MVCCS engine (MVCCS-cicili/), whose
;;;; def... macros expand the object. Attach each index once, after
;;;; memory_open.
;;;;
;;;; Columns, with their Parsi types (Cicili MVCCS columns are int64,
;;;; STRING/TEXT ride as TEXT, FLOAT/DOUBLE/REAL as REAL, Vector<Double>
;;;; as a VECTOR of doubles). Every index is a defindex: an INT or REAL
;;;; key keeps its order, a TEXT or VECTOR key is a hash -- equality
;;;; only, the row re-checked by the consumer:
;;;;   ID LONG
;;;;   KB STRING
;;;;   NAME STRING
;;;;   ARITY INT
;;;;   ORDINAL LONG
;;;;   BODY TEXT

(DEFMACRO define-COCOLOG_CLAUSES ()
  '($$$
    (deftable COCOLOG::CLAUSES ID (TEXT KB) (TEXT NAME) ARITY ORDINAL (TEXT BODY))
    (defindex IDX_COCOLOG_CLAUSES_ID COCOLOG::CLAUSES ID 1 65)
    (defindex IDX_COCOLOG_CLAUSES_KB_NAME COCOLOG::CLAUSES (KB NAME) 0 65)
    ))
