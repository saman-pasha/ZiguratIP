;;;; The Cicili MVCCS engine and its def... macros, as an importable
;;;; library. An imported file is evaluated Lisp, so the engine ships the
;;;; way every Cicili library does: one macro. A target imports this file
;;;; and says (mvccs-engine) after its includes; the def... forms -- and
;;;; the .cicili files the Parsi compiler generates from a schema -- come
;;;; after that. See mvccs.cicili and schema-test.cicili.

(DEFMACRO mvccs-engine ()
  '($$$
  ;; ------------------------------------------------------------------
  ;; Declaration bindings: emit nothing, buy member resolution on the
  ;; real Zigurat::binarystream. Only single-signature members are
  ;; declared -- Cicili has one signature per name -- and only the ones
  ;; this engine calls.
  ;; ------------------------------------------------------------------
  (DEFMACRO stream-decls ()
    `($$$
      (decl) (struct Zigurat::binarystream
        (method seekg ((int64_t off) (std::ios_base::seekdir dir)) (out void))
        (method seekp ((int64_t off) (std::ios_base::seekdir dir)) (out void))
        (method tellg () (out int64_t))
        (method tellp () (out int64_t))
        (method read ((char * buffer) (int64_t n)) (out void))
        (method write ((const char * buffer) (int64_t n)) (out void))
        (method read_std_ubyte ((uint8_t & v)) (out void))
        (method write_std_ubyte ((uint8_t && v)) (out void))
        (method read_std_long ((int64_t & v)) (out void))
        (method write_std_long ((int64_t && v)) (out void))
        (method read_std_double ((double & v)) (out void))
        (method write_std_double ((double && v)) (out void))
        (method read_std_size ((size_t & v)) (out void))
        (method write_std_size ((size_t && v)) (out void))
        (method read_std_time ((time_t & v)) (out void))
        (method write_std_time ((time_t && v)) (out void))
        (method fill_n ((size_t count) (char c)) (out void))
        (method write_std_string ((std::string && s)) (out void))
        (method write_std_text ((std::string && s)) (out void))
        (method read_std_text ((std::string & s)) (out void))
        (method write_std_bool ((bool && v)) (out void))
        (method length () (out int64_t))
        (method flush () (out void))
        (method good () (out bool))
        (method clear () (out void))
        (method sync_to_disk () (out bool)))))
  (stream-decls)

  ;; The wall clock in microseconds, one leaf of real C++ text: Cicili has no
  ;; binding for struct timespec and does not need one for a single call site.
  (code "int64_t mvccs_wall_micros() { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000 + (int64_t)ts.tv_nsec / 1000; }")
  (decl) (func mvccs_wall_micros () (out int64_t))
  ;; the thread's own CPU clock, for the guard trace: a hold whose wall
  ;; time is milliseconds and whose CPU time is microseconds was not
  ;; running -- it was descheduled with the guard in hand
  (code "int64_t mvccs_cpu_micros() { struct timespec ts; clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts); return (int64_t)ts.tv_sec * 1000000 + (int64_t)ts.tv_nsec / 1000; }")
  (decl) (func mvccs_cpu_micros () (out int64_t))

  ;; The VECTOR column kind's member type: what the real engine's
  ;; Vector<Double> column is here, per doc/lib-std-c.md's `@define'
  ;; escape. The importing target includes <vector>.
  (@define (code "dvec_t std::vector<double>"))

  ;; No namespace: `module' under :cpp mangles top-level vars (an unexercised
  ;; corner of the transpiler), and this unit links against nothing that could
  ;; collide. Names are the original ones, at file scope.
  (using namespace Zigurat)

    ;; ----------------------------------------------------------------
    ;; A COLUMN VALUE BECOMES AN INT64 KEY. The B-tree's key is one
    ;; int64 -- BTKey packs it in a 56-byte record and every bt_* takes
    ;; it as such -- so every column kind folds to one, and these four
    ;; rules are the whole of it. defindex applies them per column kind
    ;; at expansion time; the server's generated C++ reaches the same
    ;; three through engine.cicili's exports, so a key is the same
    ;; number whichever side derived it.
    ;;
    ;;   INT     the value itself
    ;;   REAL    an ORDER-PRESERVING fold of the IEEE double: the bit
    ;;           pattern as a signed int64 already orders the positives;
    ;;           the negatives order backwards, so their low 63 bits are
    ;;           flipped. -0.0 is +0.0 first, or equality would split
    ;;           them. Ranges over a REAL index are therefore real ranges.
    ;;   TEXT    FNV-1a 64 of the bytes, masked positive. TWO STRINGS CAN
    ;;           COLLIDE, and the trade is taken openly: every consumer
    ;;           re-applies its own predicate to each row the index hands
    ;;           back, so a collision costs a wasted row visit and never a
    ;;           wrong answer. Order is hash order, so defindex emits no
    ;;           range family over a hashed key. A UNIQUE hashed key can
    ;;           falsely refuse a distinct value -- at 2^63 a lottery
    ;;           nobody wins, and it refuses loudly.
    ;;   VECTOR  FNV-1a 64 over the REAL fold of each element, masked
    ;;           positive: equality over the whole vector, hashed like TEXT.
    ;; ----------------------------------------------------------------
    (func fnv_basis64 () (out uint64_t)
      ;; the FNV-1a 64 offset basis, composed from halves so no literal
      ;; overflows a signed reader anywhere between Lisp and C++
      (return (+ (* (cast uint64_t 3421674724) (cast uint64_t 4294967296))
                 (cast uint64_t 2216829733))))

    (func fnv_word64 ((uint64_t h) (int64_t word)) (out uint64_t)
      (let ((uint64_t x . #'(cast uint64_t word)))
        (for ((int b . 0)) (< b 8) ((++ b))
          (set h (xor h (bitand x (cast uint64_t 255))))
          (set h (* h (cast uint64_t 1099511628211)))
          (set x (>> x 8)))
        (return h)))

    (func text_key64 ((const char * s) (size_t n)) (out int64_t)
      (let ((uint64_t h . #'(fnv_basis64)))
        (for ((size_t i . 0)) (< i n) ((++ i))
          (set h (xor h (cast uint64_t (cast uint8_t (nth i s)))))
          (set h (* h (cast uint64_t 1099511628211))))
        (return (cast int64_t (bitand h (cast uint64_t 9223372036854775807))))))

    (func real_key64 ((double d)) (out int64_t)
      (let ((double v . d)
            (int64_t bits . 0))
        (if (== v 0.0) (set v 0.0))
        (memcpy (cast (void *) (aof bits)) (cast (const void *) (aof v)) 8)
        (if (< bits 0) (set bits (xor bits 9223372036854775807)))
        (return bits)))

    (func words_key64 ((const int64_t * w) (size_t n)) (out int64_t)
      (let ((uint64_t h . #'(fnv_basis64)))
        (for ((size_t i . 0)) (< i n) ((++ i))
          (set h (fnv_word64 h (nth i w))))
        (return (cast int64_t (bitand h (cast uint64_t 9223372036854775807))))))

    (func dvec_key64 ((const dvec_t & v)) (out int64_t)
      (let ((uint64_t h . #'(fnv_basis64))
            (size_t n . #'(($ v size))))
        (for ((size_t i . 0)) (< i n) ((++ i))
          (set h (fnv_word64 h (real_key64 (($ v at) i)))))
        (return (cast int64_t (bitand h (cast uint64_t 9223372036854775807))))))

    ;; ----------------------------------------------------------------
    ;; The vocabulary
    ;; ----------------------------------------------------------------

    ;; memory.cpp:20-37 -- the layout constants
    (var const int64_t CHUNK_SIZE . 16)
    (var const int64_t HASHKEY_SIZE . 20)
    (var const int64_t PAGEFILE_CONTROL_COUNT . 3)
    (var const int64_t PAGEFILE_CONTROL_SIZE . 48)
    (var const int64_t CONTROL_COUNT . 3)
    (var const int64_t CONTROL_SIZE . 48)

    ;; the hexmap byte: bit7 allocated, bit6 standalone, bit5 control,
    ;; bit4 tail-size, bits2-3 RowState, bits0-1 RowLock
    (var const uint8_t FREE_CHUNK . 0)
    (var const uint8_t FREE_STANDALONE_CHUNK . 64)
    (var const uint8_t DATA_CHUNK . 144)
    (var const uint8_t DATA_STANDALONE_CHUNK . 192)
    (var const uint8_t CONTROL_CHUNK . 176)
    (var const uint8_t CONTROL_STANDALONE_CHUNK . 240)

    (var const uint8_t MAX_CURSOR_COUNT . 16)
    (var int lock_wait_timeout_ms . 10000)

    ;; How many chains the page list is split into, by hash key. Every
    ;; cursor walks ONE key's pages; while the list was single, each walk
    ;; read the WHOLE store's pages to find them -- see "The page list and
    ;; the free list" below for what that cost.
    (var const int64_t PAGE_BUCKET_COUNT . 251)
    ;; the free list's size classes, a power of two each, and its slots:
    ;; one chain per (key bucket, class) -- 251 x 24
    (var const int64_t FREE_CLASSES . 24)
    (var const int64_t FREE_SLOT_COUNT . 6024)

    ;; rowstate.hpp / rowlock.hpp / isolationlevel.hpp. Cicili's enum is a
    ;; plain C enum, so the members carry prefixes instead of scope.
    (enum RowState (ROW_NONE . 0) (ROW_INSERTED . 4) (ROW_UPDATED . 8) (ROW_DELETED . 12))
    (enum RowLock (LOCK_NONE . 0) (LOCK_SHARED . 1) (LOCK_EXCLUSIVE . 2))
    (enum IsolationLevel
      (READ_UNCOMMITTED . 0) (READ_COMMITTED . 1) (REPEATABLE_READ . 2)
      (SNAPSHOT . 3) (SERIALIZABLE . 4))

    ;; The engine-internal hash keys, byte for byte the ones in memory.cpp.
    (var uint8_t FREE_HASHKEY [20]
         . '{ 180 244 146 224 9 24 213 160 47 17 250 182 7 67 179 136 24 251 20 152 })
    (var uint8_t TRANSACTIONS_HASHKEY [20]
         . '{ 249 41 16 85 114 106 86 121 50 152 173 159 116 212 167 172 100 237 62 14 })

    ;; memoryexception.hpp, code 9390 -- the real base class, really thrown.
    (struct MemoryException (inherits ZiguratException)
      (ctor ((const char * msg))
        (init (ZiguratException 9390 (std::string msg)))))

    ;; pointer.hpp. A plain aggregate: C++'s generated copy is exactly what
    ;; the five hand-written members did.
    (struct Pointer
      (member const uint8_t * hash_key)
      (member int64_t address)
      (member int64_t size))

    (func pointer_make ((const uint8_t * hash_key) (int64_t address) (int64_t size))
          (out Pointer)
      (let ((Pointer p))
        (set ($ p hash_key) hash_key
             ($ p address) address
             ($ p size) size)
        (return p)))

    (func pointer_null () (out Pointer)
      (return (pointer_make nil 0 0)))

    ;; control.hpp -- one row version's whole story.
    (struct Control
      (member RowState online_state)
      (member RowLock online_lock)
      (member RowState offline_state)
      (member RowLock offline_lock)
      (member time_t online_time)
      (member size_t transaction_id)
      (member int64_t query_id)
      (member int64_t reference_address)
      (member time_t modify_time)
      (member time_t create_time))

    (func control_clear ((Control * c)) (out void)
      (set (-> c online_state) ROW_NONE
           (-> c online_lock) LOCK_NONE
           (-> c offline_state) ROW_NONE
           (-> c offline_lock) LOCK_NONE
           (-> c online_time) (cast time_t 0)
           (-> c transaction_id) 0
           (-> c query_id) 0
           (-> c reference_address) -1
           (-> c modify_time) (cast time_t 0)
           (-> c create_time) (cast time_t 0)))

    ;; ----------------------------------------------------------------
    ;; The version clock -- memory.cpp version_time(). Microseconds,
    ;; strictly increasing across the process. The C++ used an atomic CAS
    ;; loop; a mutex says the same thing in Cicili's reach and the clock
    ;; is not on the hot path this rewrite is measuring.
    ;; ----------------------------------------------------------------
    (var pthread_mutex_t clock_access . PTHREAD_MUTEX_INITIALIZER)
    (var int64_t clock_last . 0)

    ;; ----------------------------------------------------------------
    ;; TRACING, AND HOW TO TURN IT ON WITHOUT TOUCHING A LINE OF THIS
    ;; FILE. Cicili's four logging macros compile away to nothing unless
    ;; the transpiler is told otherwise, so what is written below costs a
    ;; release build exactly zero: `info!' emits only under --info and
    ;; above, `warn!' under --warn and above, `debug!' under --debug and
    ;; above, and level 0 -- every ordinary build -- emits none of them.
    ;;
    ;;     MVCCS_DEBUG=info  sh MVCCS-cicili/build.sh      the lifecycle
    ;;     MVCCS_DEBUG=warn  sh MVCCS-cicili/build.sh      and what is odd
    ;;     MVCCS_DEBUG=debug sh MVCCS-cicili/build.sh      and every read
    ;;
    ;; WHAT EACH LEVEL IS FOR, chosen from what two hard bugs actually
    ;; needed (#32, a commit stamp in the future; #33, a read with no
    ;; guard inside a cursor's callback window -- both took days of
    ;; patched builds downstream to see, and both are one line here):
    ;;
    ;;   info   the store's lifecycle -- open, what the startup walk
    ;;          repaired, every commit's stamp and rows, every rollback.
    ;;          A handful of lines a run.
    ;;   warn   the paths that should be rare: a torn record salvaged, a
    ;;          page refreed because it had no key, a commit that had to
    ;;          WAIT for the wall clock, a bounded wait giving up, and any
    ;;          streams guard waited for or held over a millisecond.
    ;;   debug  per-operation: every read with the stream it used and the
    ;;          guard it held, every callback window's release and its
    ;;          eligibility decision, every synthesised clock value, and
    ;;          EVERY guard acquisition with its mode, its wait and its
    ;;          hold. Loud, and the point: this is what a race looks like.
    ;;
    ;; THE GUARD POINT PAYS FOR ITS OWN MEASUREMENT, which is a limit and
    ;; not a caveat. At debug it writes two lines per acquisition --
    ;; 119 396 of them in one contention_test run -- so the DISTRIBUTION it
    ;; reports is that of a build busy writing to stderr, not of the build
    ;; that ships. The shape is trustworthy and the absolute figures are
    ;; inflated; warn, which carries only the tail over a millisecond and
    ;; two orders of magnitude fewer lines, is what to ask when the numbers
    ;; themselves matter.
    ;;
    ;; EVERY LINE GOES TO stderr, never stdout: a consumer's answers live
    ;; there (cocolog prints its own on stdout and is parsed by scripts),
    ;; and a trace that corrupts the thing being debugged is worse than
    ;; none. Every line carries the thread, because the questions these
    ;; answer are all "which thread, and in what order" -- as the LOW
    ;; SIXTEEN BITS of pthread_self, which is what makes eight threads
    ;; tellable apart at a glance in a file of ten thousand lines. It is a
    ;; tag and not an identity: two threads could in principle wear the
    ;; same one, so a trace that reads as though one thread were in two
    ;; places at once is the first thing to doubt.
    ;;
    ;; What two lines together look like, at debug, on the store the
    ;; contention suite races -- and this pair IS issue #33, which took
    ;; four days and eleven comments to establish the first time:
    ;;
    ;;     mvccs[t0a10] cursor window: release=1 flip=0
    ;;     mvccs[t0a10] read 8240  held=0 shared=0 window=0 eligible=0
    ;;
    ;; the guard released, no private redirect, and then a read holding
    ;; nothing on the stream every other thread is seeking.
    ;; ----------------------------------------------------------------

    (func version_time () (out time_t)
      (pthread_mutex_lock (aof clock_access))
      (let ((int64_t now . #'(mvccs_wall_micros))
            (int64_t next . 0))
        (set next (? (> now clock_last) now (+ clock_last 1)))
        (set clock_last next)
        (pthread_mutex_unlock (aof clock_access))
        ;; a synthesised value is the clock running ahead of real time --
        ;; the whole of #32 in one line, had it been printable then
        (debug! (if (> next now)
                    (fprintf stderr "mvccs[t%04zx] clock synth %lld, ahead by %lld us\n"
                             (bitand (cast size_t (pthread_self)) 65535)
                             (cast llong next) (cast llong (- next now)))))
        (return (cast time_t next))))

    ;; HOW FAR THIS PROCESS'S CLOCK HAS RUN AHEAD OF REAL TIME, in
    ;; microseconds, and 0 or less when it has not. The synthesised
    ;; clock_last + 1 above is what makes that possible: a burst of calls
    ;; inside one microsecond each take the next integer, and clock_last
    ;; only ratchets, so a fast enough writer stamps rows with a time that
    ;; has not happened yet. Nothing outside this process can see where the
    ;; count got to, which is what makes the lead matter -- see
    ;; clock_settle, and the case in mvccs.cicili that measures both.
    (func clock_ahead () (out int64_t)
      (pthread_mutex_lock (aof clock_access))
      (let ((int64_t ahead . #'(- clock_last (mvccs_wall_micros))))
        (pthread_mutex_unlock (aof clock_access))
        (return ahead)))

    ;; WAIT UNTIL REAL TIME REACHES A STAMP THIS PROCESS HANDED OUT.
    ;;
    ;; WHY A COMMIT OWES THIS. A committed row carries the transaction's
    ;; stamp as its create_time, and every reader judges it by "born after
    ;; this read began" -- against ITS OWN clock, which in a fresh process
    ;; starts at zero and is therefore the true wall clock. So a writer
    ;; that exits before the time it stamped its rows with leaves them
    ;; invisible to the next process for as long as the lead lasts: the
    ;; rows are all there, the store is whole to the byte, and the reader
    ;; simply cannot see any of them -- the catalogue row included, which
    ;; is why it reads as a missing predicate rather than an empty answer,
    ;; and why the same read a few milliseconds later is perfect.
    ;;
    ;; Diagnosed downstream on Linux/ext4 and measured there
    ;; (saman-pasha/ZiguratIP#32): a 32 000-row flush led the wall clock by
    ;; 25.6 ms and 0 of 8 first reads saw the rows; 20 ms of delay made it
    ;; 8 of 8. The lead tracks how fast the flush is -- the same rows over
    ;; the three growth strategies in StreamIO/mapbuf led by -16.5, +9.6
    ;; and +26.3 ms -- which is how a pair of storage commits with no
    ;; defect in them came to look like the cause.
    ;;
    ;; The wait is the lead and nothing more: microseconds for an ordinary
    ;; commit, spun out rather than slept away because a sleep's own
    ;; granularity would cost more than the wait; milliseconds for a flush
    ;; that outran the clock, slept through in one call. It is paid outside
    ;; the streams guard -- the rows are durable before it starts -- so a
    ;; committer waiting here holds nothing that another thread needs.
    (func clock_settle ((time_t stamp)) (out void)
      (let ((int64_t target . #'(cast int64_t stamp))
            (int64_t now . #'(mvccs_wall_micros)))
        (warn! (if (> (- target now) 1000)
                   (fprintf stderr "mvccs[t%04zx] commit waits %lld us for the wall clock\n"
                            (bitand (cast size_t (pthread_self)) 65535)
                            (cast llong (- target now)))))
        (while (< now target)
          (let ((int64_t gap . #'(- target now)))
            ;; a syscall is worth making only for a gap that dwarfs it
            (if (> gap 200)
                (usleep (cast unsigned (- gap 100)))))
          (set now (mvccs_wall_micros)))))

    ;; ----------------------------------------------------------------
    ;; Layout arithmetic -- the _pointer_* helpers. Integer arithmetic
    ;; instead of floor/ceil over doubles: exact for every non-negative
    ;; size, and honest about being integer work.
    ;; ----------------------------------------------------------------
    (func size_data_count ((int64_t size)) (out int64_t)
      (return (/ (+ size (- CHUNK_SIZE 1)) CHUNK_SIZE)))
    (func size_actual_count ((int64_t size)) (out int64_t)
      (return (+ (size_data_count size) CONTROL_COUNT)))
    (func size_round ((int64_t size)) (out int64_t)
      (return (* (size_data_count size) CHUNK_SIZE)))
    (func size_actual ((int64_t size)) (out int64_t)
      (return (* (size_actual_count size) CHUNK_SIZE)))

    ;; The size a standalone hexmap byte contributes when a pointer is read
    ;; back. The writer stores SIZE % CHUNK_SIZE in the low five bits, so for
    ;; a record whose size is an exact multiple of the chunk the byte says 0
    ;; -- and 0 there means A WHOLE CHUNK, not an empty one. Decoding it as 0
    ;; is how a 16-byte transaction record measured 3 chunks instead of its 4:
    ;; every free of such a record leaked its last chunk forever, no freed
    ;; span of it ever fit a fresh allocation of the same record, and a store
    ;; only ever grew -- ~32KB per consult/forget cycle that netted zero rows,
    ;; vacuum or no vacuum. The rule applies to DATA standalones only: a FREE
    ;; standalone's low bits are always written 0 and its size is counted in
    ;; whole chunks by the run walks, never through this remainder.
    (func size_remainder ((uint8_t hex_byte)) (out int64_t)
      (let ((int64_t r . #'(cast int64_t (bitand hex_byte 31))))
        (if (and (== (bitand hex_byte 128) 128) (== r 0)) (return CHUNK_SIZE))
        (return r)))

    (func addr_hexmap ((int64_t address)) (out int64_t)
      (return (/ address CHUNK_SIZE)))
    (func addr_hexmap_data ((int64_t address)) (out int64_t)
      (return (+ (/ address CHUNK_SIZE) CONTROL_COUNT)))
    (func addr_data ((int64_t address)) (out int64_t)
      (return (+ address CONTROL_SIZE)))

    (func ptr_data_count ((const Pointer * p)) (out int64_t)
      (return (size_data_count (-> p size))))
    (func ptr_actual_count ((const Pointer * p)) (out int64_t)
      (return (+ (ptr_data_count p) CONTROL_COUNT)))
    (func ptr_actual_size ((const Pointer * p)) (out int64_t)
      (return (* (ptr_actual_count p) CHUNK_SIZE)))
    (func ptr_hexmap ((const Pointer * p)) (out int64_t)
      (return (/ (-> p address) CHUNK_SIZE)))
    (func ptr_hexmap_data ((const Pointer * p)) (out int64_t)
      (return (+ (/ (-> p address) CHUNK_SIZE) CONTROL_COUNT)))
    (func ptr_data ((const Pointer * p)) (out int64_t)
      (return (+ (-> p address) CONTROL_SIZE)))


  ;; ==================================================================
  ;; BaseTable -- basetable.hpp, minus the per-class statics (those are
  ;; deftable's job, done with macros instead of templates) and minus
  ;; the stream operator<</>> (Cicili has no `operator'; pack/unpack
  ;; virtuals carry the row across the stream instead).
  ;; ==================================================================
  (struct BaseTable
    (member Pointer pointer)
    (virtual) (method prepare () (out void))
    (virtual) (method map ((void * m)) (out void))
    (virtual) (method unmap ((void * m)) (out void))
    (virtual) (method pack_size () (out int64_t) (return 0))
    (virtual) (method pack ((binarystream & io)) (out void))
    (virtual) (method unpack ((binarystream & io)) (out void))
    (virtual) (dtor ()))

  ;; ==================================================================
  ;; Interned hash keys. Every Pointer's hash_key aims at one canonical
  ;; 20-byte copy that lives for the process, which removes the whole
  ;; class of who-owns-this-key lifetime questions the multimaps had.
  ;; ==================================================================
  (struct KeyIntern
    (member uint8_t key [20])
    (member KeyIntern * next))

  (var pthread_mutex_t intern_access . PTHREAD_MUTEX_INITIALIZER)
  (var KeyIntern * intern_head . nil)

  (func intern_key ((const uint8_t * key)) (out const uint8_t *)
    (pthread_mutex_lock (aof intern_access))
    (let ((KeyIntern * e . #'intern_head))
      (while (!= e nil)
        (if (== (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)) 0)
            (block
              (pthread_mutex_unlock (aof intern_access))
              (return (-> e key))))
        (set e (-> e next)))
      (let ((KeyIntern * fresh . #'(new* KeyIntern)))
        (memcpy (-> fresh key) key (cast size_t HASHKEY_SIZE))
        (set (-> fresh next) intern_head)
        (set intern_head fresh)
        (pthread_mutex_unlock (aof intern_access))
        (return (-> fresh key)))))

  ;; ==================================================================
  ;; The page list and the free list -- std::multimap in the original,
  ;; intrusive singly-linked lists here. Only equal_range walks and
  ;; insert/erase were ever asked of them; a linear list answers both.
  ;;
  ;; EXCEPT THAT equal_range IS WHAT EVERY WALK ASKS, and a single list
  ;; answers it by reading the whole store. A cursor walks ONE key's
  ;; pages -- and a SEQUENCE DRAW is a cursor, over the sequence's own
  ;; key, one page holding one row. So the i-th row a process wrote
  ;; walked past the pages the first i-1 had made, twice a draw and
  ;; with two arrays of that size allocated and zeroed each time, and
  ;; a write came out QUADRATIC IN ITS OWN ROWS. Measured from cocolog
  ;; 1.2.16 over a fresh --embed: 16 000 rows 0.53 s, 32 000 1.42,
  ;; 64 000 5.77, 128 000 26.9, while the assert loop that fed them
  ;; stayed flat at 3.8 us a clause. Splitting the rows over 128
  ;; predicates did not help -- pages are one store's however the rows
  ;; are named -- which is exactly what ruled out the guess that it was
  ;; an index key's value chain.
  ;;
  ;; So every entry sits in a second chain, of the pages under ITS KEY
  ;; (key_next, bucketed by a hash of the key's twenty bytes), and the
  ;; cursor, dead_pointers and drop_key_pages walk that one. The
  ;; whole-store list stays: startup walks every page whatever its key,
  ;; and so does the DBA's page dump. A bucket may hold two keys, so
  ;; every walk still checks the key it reads.
  ;; ==================================================================
  (struct PageEntry
    (member const uint8_t * key)
    (member int64_t address)
    (member PageEntry * next)
    (member PageEntry * key_next))   ;; the next page under the same key

  (struct FreeEntry
    (member const uint8_t * key)
    (member int64_t address)
    (member int64_t size)          ;; the WHOLE span, control chunks included
    (member FreeEntry * next))

  ;; ==================================================================
  ;; Transaction -- transaction.hpp/.cpp. One per session thread, held
  ;; through a thread-local pointer (Cicili's thread-local is __thread,
  ;; which cannot run constructors -- so the lifecycle is explicit:
  ;; memory_begin_transaction creates it, thread end abandons it).
  ;; ==================================================================
  (struct TxnEntry
    (member time_t at)
    (member Pointer ptr)
    (member TxnEntry * next)
    (member TxnEntry * prev))

  (struct Transaction
    (member size_t id)
    (member time_t init_time)
    (member Pointer pointer)
    (member int64_t query_id)
    (member time_t query_time)
    (member IsolationLevel isolation_level)
    (member int64_t auto_commit)
    (member TxnEntry * ctx_head)
    (member TxnEntry * ctx_tail))

  (thread-local) (var Transaction * tl_txn . nil)

  ;; ---- the live-transaction registry ------------------------------
  ;; Which transaction ids are between begin and commit-or-rollback
  ;; right now, process-wide. A lock whose owner is not in here belongs
  ;; to a transaction nothing will ever finish, and check_lock breaks
  ;; it in place instead of waiting on a corpse until a restart's
  ;; recovery would have swept it. What makes an id dead: commit and
  ;; rollback retire it after every lock is cleared, and a process that
  ;; dies takes its registry with it, so after the restart's recovery
  ;; anything it left stamped reads as breakable. A begin on a thread
  ;; whose transaction is still open CONTINUES it -- the id and its
  ;; registration stand, see begin_transaction -- so an open
  ;; transaction is never orphaned by beginning again.
  ;; 512 slots holds one live transaction per thread plus every slot a
  ;; thread abandoned and has not yet re-begun over -- far above any
  ;; real thread count here. A full table would leave a live id
  ;; unregistered and its locks breakable, so the headroom is the point.
  (var pthread_mutex_t live_txn_access . PTHREAD_MUTEX_INITIALIZER)
  (var size_t live_txn_ids [512])            ;; zero marks an empty slot
  (thread-local) (var size_t tl_live_txn . 0)
  (var size_t txn_id_base . 0)
  (var size_t txn_id_serial . 0)

  (func transaction_live ((size_t transaction_id)) (out bool)
    (if (== transaction_id (cast size_t 0)) (return #f))
    (let ((bool found . #f))
      (pthread_mutex_lock (aof live_txn_access))
      (let ((int i . 0))
        (while (< i 512)
          (if (== (nth i live_txn_ids) transaction_id)
              (block (set found #t) (set i 512))
            (set i (+ i 1)))))
      (pthread_mutex_unlock (aof live_txn_access))
      (return found)))

  (func transaction_retire ((size_t transaction_id)) (out void)
    (pthread_mutex_lock (aof live_txn_access))
    (let ((int i . 0))
      (while (< i 512)
        (if (== (nth i live_txn_ids) transaction_id)
            (set (nth i live_txn_ids) (cast size_t 0)))
        (set i (+ i 1))))
    (if (== tl_live_txn transaction_id) (set tl_live_txn (cast size_t 0)))
    (pthread_mutex_unlock (aof live_txn_access)))

  (func transaction_register ((size_t fresh_id)) (out void)
    (pthread_mutex_lock (aof live_txn_access))
    (let ((int i . 0))
      ;; the thread's previous transaction, if it never ended, ends here
      (if (!= tl_live_txn (cast size_t 0))
          (block
            (while (< i 512)
              (if (== (nth i live_txn_ids) tl_live_txn)
                  (set (nth i live_txn_ids) (cast size_t 0)))
              (set i (+ i 1)))
            (set i 0)))
      (while (< i 512)
        (if (== (nth i live_txn_ids) (cast size_t 0))
            (block (set (nth i live_txn_ids) fresh_id) (set i 512))
          (set i (+ i 1)))))
    (set tl_live_txn fresh_id)
    (pthread_mutex_unlock (aof live_txn_access)))

  (var IsolationLevel default_isolation_level . READ_COMMITTED)

  ;; ==================================================================
  ;; Globals -- globals.hpp/.cpp, the process and the connection. The
  ;; class of statics becomes file-scope state behind globals_ accessors;
  ;; Parser and Compiler stay behind (no such components here). The
  ;; permission model is the original's, word for word: a permission is
  ;; a path, it covers what it names and everything under it, "*" covers
  ;; everything, matching ignores case, and an empty level is dropped so
  ;; a stray separator cannot widen a grant.
  ;; ==================================================================
  (var int g_reset_mode)
  (var int g_trace_mode)
  ;; whether what a certificate grants is enforced at all -- one switch,
  ;; because half enforced would be worse than either
  (var int g_permissions_mode)
  (var int g_default_autocommit)

  (func globals_reset_mode () (out int) (return g_reset_mode))
  (func globals_set_reset_mode ((int v)) (out void) (set g_reset_mode v))
  (func globals_trace_mode () (out int) (return g_trace_mode))
  (func globals_set_trace_mode ((int v)) (out void) (set g_trace_mode v))
  (func globals_permissions_mode () (out int) (return g_permissions_mode))
  (func globals_set_permissions_mode ((int v)) (out void) (set g_permissions_mode v))
  (func globals_default_autocommit_mode () (out int) (return g_default_autocommit))
  (func globals_set_default_autocommit_mode ((int v)) (out void) (set g_default_autocommit v))
  (func globals_default_isolation_level () (out IsolationLevel) (return default_isolation_level))
  (func globals_set_default_isolation_level ((IsolationLevel lvl)) (out void)
    (set default_isolation_level lvl))

  ;; who is on the other end of this thread's connection, and what the
  ;; certificate that opened it says they may reach -- a connection
  ;; carries its own authority, nothing is stored anywhere else
  (thread-local) (var int tl_identified)
  (thread-local) (var char tl_peer_subject [128])
  (thread-local) (var char tl_peer_perms [2048])     ;; 16 grants, stride 128
  (thread-local) (var int tl_peer_perm_count)

  (thread-local) (var binarystream * tl_client_stream)
  (thread-local) (var Zigurat::textstream * tl_echo_stream)

  (func globals_identified () (out int) (return tl_identified))
  (func globals_peer_subject () (out const char *)
    (return (cast (char *) tl_peer_subject)))

  (func globals_set_peer ((const char * subject)) (out void)
    (set tl_identified 1)
    (strncpy tl_peer_subject subject 127)
    (set (nth 127 tl_peer_subject) 0)
    (set tl_peer_perm_count 0))

  (func globals_add_peer_permission ((const char * granted)) (out void)
    (if (< tl_peer_perm_count 16)
        (block
          (strncpy (aof (nth (* tl_peer_perm_count 128) tl_peer_perms)) granted 127)
          (set (nth (+ (* tl_peer_perm_count 128) 127) tl_peer_perms) 0)
          (set tl_peer_perm_count (+ tl_peer_perm_count 1)))))

  (func globals_clear_peer () (out void)
    (set tl_identified 0)
    (set (nth 0 tl_peer_subject) 0)
    (set tl_peer_perm_count 0))

  ;; "DEMO::AUTHORS" -> {"DEMO", "AUTHORS"}, upper cased, empties dropped.
  ;; Levels land in OUT at stride 64; the count comes back.
  (func path_split ((const char * qualified) (char * out_levels) (int max_levels)) (out int)
    (let ((int n . #'(cast int (strlen qualified)))
          (int i . 0)
          (int count . 0)
          (char level [64])
          (int li . 0))
      (while (<= i n)
        (let ((int is_sep . 0))
          (if (== i n)
              (set is_sep 1)
            (if (and (== (cast int (nth i qualified)) 58)
                     (and (< (+ i 1) n) (== (cast int (nth (+ i 1) qualified)) 58)))
                (set is_sep 1)))
          (if (== is_sep 1)
              (block
                ;; trailing spaces off, and an empty level dropped
                (while (and (> li 0) (== (cast int (nth (- li 1) level)) 32))
                  (set li (- li 1)))
                (if (and (> li 0) (< count max_levels))
                    (block
                      (set (nth li level) (cast char 0))
                      (strcpy (aof (nth (* count 64) out_levels)) level)
                      (set count (+ count 1))))
                (set li 0)
                (if (== i n) break)
                (set i (+ i 2)))
            (block
              (let ((int c . #'(bitand (cast int (nth i qualified)) 255)))
                ;; leading spaces never start a level
                (if (not (and (== li 0) (== c 32)))
                    (if (< li 63)
                        (block
                          (set (nth li level) (cast char (toupper c)))
                          (set li (+ li 1))))))
              (set i (+ i 1))))))
      (return count)))

  (func globals_permits ((const char * qualified_name)) (out int)
    ;; turned off, a certificate says who its holder is and nothing more
    (if (== g_permissions_mode 0) (return 1))
    ;; a plain connection has nobody to ask about
    (if (== tl_identified 0) (return 1))

    (let ((char object [512])
          (int object_n . #'(path_split qualified_name object 8)))
      (if (== object_n 0) (return 0))

      (let ((int pn . 0))
        (while (< pn tl_peer_perm_count)
          (let ((char granted [512])
                (int granted_n . #'(path_split (aof (nth (* pn 128) tl_peer_perms)) granted 8)))
            (if (> granted_n 0)
                (block
                  (if (and (== granted_n 1)
                           (== 0 (strcmp (aof (nth 0 granted)) "*")))
                      (return 1))
                  ;; a permission covers what it names and everything under it
                  (if (<= granted_n object_n)
                      (let ((int covers . 1)
                            (int i . 0))
                        (while (< i granted_n)
                          (if (!= 0 (strcmp (aof (nth (* i 64) granted))
                                            (aof (nth (* i 64) object))))
                              (block (set covers 0) break))
                          (set i (+ i 1)))
                        (if (== covers 1) (return 1)))))))
          (set pn (+ pn 1))))
      (return 0)))

  ;; the same question, asked where the answer has to be no
  (func globals_require_permission ((const char * qualified_name)) (out void)
    (if (!= (globals_permits qualified_name) 0) (return))
    (let ((char msg [256]))
      (snprintf msg 256 "'%s' has no permission for '%s'" tl_peer_subject qualified_name)
      (throw* (Zigurat::ZiguratException 7800 (std::string msg)))))

  ;; a null client stream is not a forgotten null check: it is a call
  ;; through a vtable at address zero several frames later. Refuse here.
  (func globals_client_stream () (out binarystream *)
    (if (== tl_client_stream nil)
        (throw* (Zigurat::ZiguratException 7802 (std::string "no connection is bound to this thread"))))
    (return tl_client_stream))
  (func globals_set_client_stream ((binarystream * stream)) (out void)
    (set tl_client_stream stream))
  (func globals_echo_stream () (out Zigurat::textstream *)
    (return tl_echo_stream))
  (func globals_set_echo_stream ((Zigurat::textstream * stream)) (out void)
    (set tl_echo_stream stream))

  ;; one byte, at a different address in every copy of this library a
  ;; process has loaded -- the canary that catches a rebuilt object
  ;; mapped in beside the one the server already holds
  (var char g_runtime_instance)
  (func globals_runtime_instance () (out const void *)
    (return (cast (void *) (aof g_runtime_instance))))
  ;; and the C-linkage spelling the servers dlsym for
  (extern-c
    (func mvccs_runtime_instance () (out const void *)
      (return (globals_runtime_instance))))


  ;; the SERIALIZABLE semaphore of one -- Transaction::_serialize_* done
  ;; with pthreads. Counter and wait under one mutex; the slot is taken
  ;; only after the wait; a held slot is given back before waiting.
  (var pthread_mutex_t serialize_access . PTHREAD_MUTEX_INITIALIZER)
  (var pthread_cond_t serialize_cv . PTHREAD_COND_INITIALIZER)
  (var size_t serialize_counter . 0)

  (func set_isolation_level ((Transaction * t) (IsolationLevel iso_lvl)) (out void)
    (if (== (-> t isolation_level) iso_lvl) (return))

    (pthread_mutex_lock (aof serialize_access))
    (let ((bool was_serializable . #'(== (-> t isolation_level) SERIALIZABLE)))
      (if (and was_serializable (> serialize_counter 0))
          (set serialize_counter (- serialize_counter 1)))

      (if (== iso_lvl SERIALIZABLE)
          (block
            ;; BOUNDED, like a row lock: an unbounded wait turns one silent
            ;; client into every other connection's hang.
            (let ((int waited_ms . 0)
                  (bool got . #t))
              (while (!= serialize_counter 0)
                (if (and (> lock_wait_timeout_ms 0) (>= waited_ms lock_wait_timeout_ms))
                    (block (set got #f) break))
                (pthread_mutex_unlock (aof serialize_access))
                (usleep 10000)
                (set waited_ms (+ waited_ms 10))
                (pthread_mutex_lock (aof serialize_access)))
              (if (not got)
                  (block
                    (pthread_mutex_unlock (aof serialize_access))
                    (if was_serializable (pthread_cond_signal (aof serialize_cv)))
                    (throw* (MemoryException "serializable wait timeout"))))
              (set serialize_counter (+ serialize_counter 1)))))

      (set (-> t isolation_level) iso_lvl)
      (pthread_mutex_unlock (aof serialize_access))
      (if was_serializable (pthread_cond_signal (aof serialize_cv)))))

  (func transaction_reset ((Transaction * t)) (out void)
    ;; The version clock, not the wall clock -- SNAPSHOT compares init_time
    ;; against create_time/modify_time stamps.
    (set (-> t init_time) (version_time))
    (set (-> t query_time) (cast time_t 0))
    (set (-> t query_id) 0)
    ;; the connection's settings, not the last transaction's
    (set (-> t auto_commit) (cast int64_t g_default_autocommit))
    (set_isolation_level t default_isolation_level))

  (func txn () (out Transaction *)
    (if (== tl_txn nil)
        (throw* (MemoryException "no transaction on this thread")))
    (return tl_txn))

  ;; ==================================================================
  ;; Memory -- the store. Data only; the operations are the free
  ;; functions below (Cicili checks struct methods top-down, and the
  ;; engine's call graph is recursive).
  ;; ==================================================================
  (struct Memory
    (member binarystream * hexmap_io)
    (member binarystream * data_io)
    (member int64_t page_size)
    (member int64_t hbpp)                 ;; hex bytes per page
    (member int64_t page_count)
    (member bool initialized)
    (member PageEntry * pages)
    ;; the same entries, chained by key: one bucket answers equal_range
    (member PageEntry * page_heads [PAGE_BUCKET_COUNT])
    ;; the free spans, chained by key bucket AND size class -- see "The
    ;; free list, segregated" with allocate
    (member FreeEntry * free_heads [6024])
    (member pthread_mutex_t hexmap_access)
    (member pthread_mutex_t data_access)
    (member pthread_rwlock_t streams_rw)
    ;; HOW MANY THREADS ARE QUEUED FOR THE EXCLUSIVE SIDE. The rwlock is
    ;; created PREFER_WRITER_NONRECURSIVE_NP and on glibc that defers
    ;; nothing: ZiguratIP#37 counted 36 729 941 of 36 731 243 shared grants
    ;; made while a writer was already queued, and a writer granted the
    ;; guard ZERO times in 120 rounds. Writer preference has to be the
    ;; engine's own, because it cannot be the platform's.
    (member pthread_mutex_t writers_access)
    (member pthread_cond_t writers_clear)
    (member int writers_waiting)
    ;; where a thread may open its own read-only view of the two files --
    ;; empty means "no private readers": every guard is exclusive, as before
    (member char rd_hex_path [512])
    (member char rd_data_path [512])
    (member pthread_mutex_t page_list_access)
    (member pthread_mutex_t free_list_access)
    ;; the DBA watcher: one line per engine operation goes through this
    ;; stream while it is attached; detached on the first write failure
    (member binarystream * watcher)
    ;; the B-tree record cache -- a BTCache, opaque here because the tree's
    ;; records are defined after Memory; see "The B-tree record cache"
    (member void * bt_cache))

  ;; the cache's hooks into the memory tier, defined with the tree below
  (decl) (func bt_cache_new () (out void *))
  (decl) (func bt_cache_reset ((Memory * m)) (out void))
  (decl) (func bt_cache_forget ((Memory * m) (int64_t address)) (out void))

  ;; ==================================================================
  ;; Streams -- THE guard. One pair of shared streams for the whole
  ;; process; a seek and its read are one operation. Re-entrant by
  ;; thread through tl_streams_held; idempotent lock/unlock because
  ;; scans hand the pair back around procedure callbacks. This is the
  ;; C++ layer earning its keep: a ctor/dtor pair IS the discipline.
  ;; ==================================================================
  (thread-local) (var void * tl_streams_held . nil)
  ;; AND THE SHARED TWIN OF IT. tl_streams_held names the guard only when it
  ;; is EXCLUSIVE, because that is the hold whose reads own the canonical
  ;; streams. A cursor's callback window found the guard to hand back through
  ;; that name, and so handed back nothing when the hold was shared -- and a
  ;; callback that wrote then constructed an exclusive guard under a shared
  ;; one, which lock() refuses by design. A read holding the shared side has
  ;; to be findable too, or no read can ever take that side around a
  ;; callback. ZiguratIP#37.
  (thread-local) (var void * tl_streams_shared . nil)
  ;; nonzero while this thread holds the guard SHARED: its reads go through
  ;; the thread's own read-only streams, and writers are excluded wholesale
  (thread-local) (var int tl_read_mode . 0)
  ;; reads inside a cursor's UNLOCKED callback window go private -- a flag
  ;; of its own, because tl_read_mode also means "this thread holds the
  ;; shared rwlock", which the exclusive guard's deadlock check reads.
  (thread-local) (var int tl_window_reads . 0)
  (thread-local) (var binarystream * tl_rd_hex . nil)
  (thread-local) (var binarystream * tl_rd_data . nil)
  ;; the next Streams constructed on this thread would LIKE to be shared;
  ;; the ctor consumes the flag and grants it only when it is safe to
  (thread-local) (var int tl_want_shared . 0)
  ;; THE GUARD'S OWN STOPWATCH -- when this thread asked for the guard, and
  ;; when it got it. Written ONLY inside warn!/debug!, so an ordinary build
  ;; never reads the clock; the two words of TLS are declared
  ;; unconditionally because an unused file-scope thread-local warns
  ;; nowhere, and a conditional declaration would need a macro of its own.
  ;; The clock is mvccs_wall_micros, the same one the version clock uses:
  ;; one clock in this file is worth more than a more suitable second one.
  (thread-local) (var int64_t tl_guard_want . 0)
  (thread-local) (var int64_t tl_guard_since . 0)
  (thread-local) (var int64_t tl_guard_cpu_since . 0)
  ;; and the same pair around the entropy draw in Statement's constructor,
  ;; which cocolog#16 timed at 12 603us of a 12 613us hold -- a syscall is
  ;; a scheduling point, and this says whether the thread ran through it
  (thread-local) (var int64_t tl_draw_wall . 0)
  (thread-local) (var int64_t tl_draw_cpu . 0)

  ;; a shared guard is granted only to a read whose isolation writes
  ;; nothing: REPEATABLE READ and SERIALIZABLE stamp shared row locks as
  ;; they scan -- the lesson of the reverted first attempt at this -- so
  ;; the lock mode follows the level
  (func reader_eligible ((Memory * m)) (out int)
    (if (not (-> m initialized)) (return 0))
    (if (== (nth 0 (-> m rd_hex_path)) (cast char 0)) (return 0))
    (if (== tl_txn nil) (return 0))
    (if (or (== (-> tl_txn isolation_level) REPEATABLE_READ)
            (== (-> tl_txn isolation_level) SERIALIZABLE))
        (return 0))
    (return 1))

  ;; MAPSTREAMS, NOT FILESTREAMS. A private filestream's filebuf caches a
  ;; get area and a seek inside it does not reload -- so a reader whose
  ;; block was cached while a fresh page held only its zero-fill kept
  ;; answering ZEROS for a row committed and fsynced underneath it, once,
  ;; healing on the next reload. Measured in the act: read_row's first
  ;; eight bytes all zero on a private stream (good, right position),
  ;; correct on the immediate re-seek, correct on disk all along. A
  ;; read-only mapbuf is coherent with the file by MAP_SHARED and
  ;; refreshes its length by fstat -- it is what a private reader is.
  (func reader_ensure ((Memory * m)) (out void)
    (if (!= tl_rd_hex nil) (return))
    (set tl_rd_hex (cast (binarystream *)
                         (new* Zigurat::mapstream (std::string (-> m rd_hex_path))
                               std::ios::in)))
    (set tl_rd_data (cast (binarystream *)
                          (new* Zigurat::mapstream (std::string (-> m rd_data_path))
                                std::ios::in))))

  ;; which stream a READ goes through: the thread's private one under a
  ;; shared guard, the canonical one everywhere else -- above all under a
  ;; write guard, where the canonical stream is the only place this
  ;; thread's own unflushed bytes can be read back from
  (func hex_in ((Memory * m)) (out binarystream *)
    (if (!= tl_streams_held nil) (return (-> m hexmap_io)))
    (if (and (== tl_read_mode 0) (== tl_window_reads 0)) (return (-> m hexmap_io)))
    (reader_ensure m)
    (return tl_rd_hex))

  (func data_in ((Memory * m)) (out binarystream *)
    (if (!= tl_streams_held nil) (return (-> m data_io)))
    (if (and (== tl_read_mode 0) (== tl_window_reads 0)) (return (-> m data_io)))
    (reader_ensure m)
    (return tl_rd_data))

  ;; ==================================================================
  ;; THE GATE. A shared acquirer stands down while any thread is queued
  ;; for the exclusive side, which is what makes the guard
  ;; writer-preferring on a platform whose rwlock is not.
  ;;
  ;; IT WAS A POLL AND IT COST TOO MUCH. The first build stood a reader
  ;; down with `usleep 20' in a loop, and ZiguratIP#37 measured what that
  ;; buys on four cores: the writer passed 120/120 rounds at every reader
  ;; count, and the LOOKUPS COLLAPSED 14x to 57x, ranges not overlapping
  ;; at any count. 15 688 sleeps to serve 142 lookups -- 110 sleeps each
  ;; -- because a 20us sleep among thirteen runnable threads on four
  ;; cores is a timer, a context switch and a queue, and measured ~137us.
  ;; A reader was standing down for 137us to let through a begin that
  ;; holds the guard for 3.2us.
  ;;
  ;; So the reader SLEEPS instead of polling: a condition variable the
  ;; writer broadcasts on every grant, which is why the count needs a
  ;; mutex rather than an atomic -- the mutex is what makes the wait and
  ;; the wake race-free, not what protects an integer.
  ;;
  ;; Nested guards never reach lock(), so they neither announce nor wait:
  ;; a thread that already holds the guard cannot be made to queue behind
  ;; itself.
  ;; ==================================================================
  ;; HOW MANY TIMES A READER WILL STAND DOWN before it takes the shared
  ;; side anyway. Strict preference is unbounded by construction -- a
  ;; reader defers while ANY writer is queued, and a workload whose
  ;; writers never stop arriving is one where readers never run. That is
  ;; the fault this gate exists to fix, mirrored, and cocolog's httpd pool
  ;; is exactly such a workload: every request is a short exclusive
  ;; acquisition through run_isolated/2. So the preference is bounded, and
  ;; two is the bound ZiguratIP#37 proposed from the box that has the
  ;; numbers.
  (var const int GATE_STANDDOWNS . 2)

  (func writers_enqueue ((Memory * m)) (out void)
    (pthread_mutex_lock (aof (-> m writers_access)))
    (set (-> m writers_waiting) (+ (-> m writers_waiting) 1))
    (pthread_mutex_unlock (aof (-> m writers_access))))

  (func writers_granted ((Memory * m)) (out void)
    (pthread_mutex_lock (aof (-> m writers_access)))
    (set (-> m writers_waiting) (- (-> m writers_waiting) 1))
    ;; EVERY grant wakes the standing-down readers, not only the one that
    ;; empties the queue. A reader that slept until the count reached zero
    ;; would sleep through a continuous stream of writers, and never
    ;; reaching zero is precisely what a busy store looks like.
    (pthread_cond_broadcast (aof (-> m writers_clear)))
    (pthread_mutex_unlock (aof (-> m writers_access))))

  (func writers_stand_down ((Memory * m)) (out void)
    (let ((int rounds . 0))
      (pthread_mutex_lock (aof (-> m writers_access)))
      (while (and (> (-> m writers_waiting) 0) (< rounds GATE_STANDDOWNS))
        (pthread_cond_wait (aof (-> m writers_clear)) (aof (-> m writers_access)))
        (set rounds (+ rounds 1)))
      (pthread_mutex_unlock (aof (-> m writers_access)))))

  (struct Streams
    (member Memory * m)
    (member bool mine_)
    (member bool locked_)
    (member bool shared_)

    (method lock () (out void)
      ;; a nested guard takes nothing and waits for nothing, and saying so
      ;; is what explains a thread that shows no acquisition at all
      (if (not ($ this mine_))
          (block
            (debug! (fprintf stderr "mvccs[t%04zx] guard nested: no-op\n"
                             (bitand (cast size_t (pthread_self)) 65535)))
            (return)))
      (if ($ this locked_) (return))
      (warn! (set tl_guard_want (mvccs_wall_micros)))
      (if ($ this shared_)
          (block
            ;; stand down for a queued writer -- asleep, not polling, and
            ;; at most GATE_STANDDOWNS times
            (writers_stand_down ($ this m))
            (pthread_rwlock_rdlock (aof (-> ($ this m) streams_rw)))
            (set tl_read_mode 1)
            (set tl_streams_shared (cast (void *) this)))
        (block
          ;; a write guard under a held shared one would deadlock on the
          ;; rwlock -- surface the bug instead of wedging on it
          (if (== tl_read_mode 1)
              (throw* (MemoryException "an exclusive streams guard under a shared one")))
          ;; announced BEFORE blocking and withdrawn once granted, so the
          ;; count covers exactly the interval a reader must respect
          (writers_enqueue ($ this m))
          (pthread_rwlock_wrlock (aof (-> ($ this m) streams_rw)))
          (writers_granted ($ this m))
          (set tl_streams_held (cast (void *) this))))
      (set ($ this locked_) #t)
      ;; THE WAIT IS THE MEASUREMENT. ZiguratIP#37 timestamped the four
      ;; regions of a begin from a patched working copy and found 99.9% of
      ;; it here and 0.1% in the writes under it -- the number nothing in
      ;; this file could answer. debug! carries every acquisition, so a
      ;; distribution can be had from a grep; warn! carries only what took
      ;; longer than a millisecond, which is what keeps `warn' the level of
      ;; things that should be rare.
      (warn! (set tl_guard_since (mvccs_wall_micros))
             (set tl_guard_cpu_since (mvccs_cpu_micros))
             (let ((int64_t waited . #'(- tl_guard_since tl_guard_want)))
               (debug! (fprintf stderr "mvccs[t%04zx] guard taken %s waited %lld us\n"
                                (bitand (cast size_t (pthread_self)) 65535)
                                (? ($ this shared_) "shared" "exclusive")
                                (cast llong waited)))
               (if (> waited 1000)
                   (fprintf stderr "mvccs[t%04zx] guard %s WAITED %lld us\n"
                            (bitand (cast size_t (pthread_self)) 65535)
                            (? ($ this shared_) "shared" "exclusive")
                            (cast llong waited))))))

    (method unlock () (out void)
      (if (or (not ($ this mine_)) (not ($ this locked_))) (return))
      (if ($ this shared_)
          (block
            ;; withdrawn BEFORE releasing: never claim a hold already given back
            (set tl_read_mode 0)
            (set tl_streams_shared nil)
            (set ($ this locked_) #f)
            (pthread_rwlock_unlock (aof (-> ($ this m) streams_rw))))
        (block
          ;; every write is in the FILE before the guard is released, or a
          ;; private reader taken the next instant would miss the bytes
          ;; still sitting in the canonical streams' buffers
          ((-> (-> ($ this m) hexmap_io) flush))
          ((-> (-> ($ this m) data_io) flush))
          (set tl_streams_held nil)
          (set ($ this locked_) #f)
          (pthread_rwlock_unlock (aof (-> ($ this m) streams_rw)))))
      ;; AFTER the release, because the flush above is PART OF THE HOLD --
      ;; it is there so a private reader cannot miss bytes still in the
      ;; canonical buffers -- and what the next thread waited for is the
      ;; whole of it, flush included.
      ;; WALL BESIDE CPU, because a hold can be long without running: cocolog#16
      ;; chased a 9-17ms hold through the callback, cold reads and the walk
      ;; and found one key, no misses and 5us of code. The suffixes are
      ;; suffixes so a `grep -o "guard HELD [0-9]* us"' keeps matching.
      (warn! (let ((int64_t held . #'(- (mvccs_wall_micros) tl_guard_since))
                   (int64_t cpu . #'(- (mvccs_cpu_micros) tl_guard_cpu_since)))
               (debug! (fprintf stderr "mvccs[t%04zx] guard held %lld us, cpu %lld us\n"
                                (bitand (cast size_t (pthread_self)) 65535)
                                (cast llong held) (cast llong cpu)))
               (if (> held 1000)
                   (fprintf stderr "mvccs[t%04zx] guard HELD %lld us, on cpu %lld us\n"
                            (bitand (cast size_t (pthread_self)) 65535)
                            (cast llong held) (cast llong cpu))))))

    (ctor ((Memory * mem))
      (init (m mem) (mine_ #f) (locked_ #f) (shared_ #f))
      (let ((int want . tl_want_shared))
        (set tl_want_shared 0)
        (if (!= tl_streams_held nil)
            (set ($ this mine_) #f)          ;; nested under a write hold: no-op
          (if (== tl_read_mode 1)
              (if (== want 1)
                  (set ($ this mine_) #f)     ;; nested under a shared hold: no-op
                (set ($ this mine_) #t))      ;; write wanted under shared: trap in lock()
            (block                            ;; outermost
              (set ($ this mine_) #t)
              (if (and (== want 1) (== 1 (reader_eligible mem)))
                  (set ($ this shared_) #t))))))
      (($ this lock)))

    (dtor ()
      (($ this unlock))))

  ;; called once, by whoever opened the store and knows where its two
  ;; files live -- this is what turns the shared side ON
  (func memory_reader_paths ((Memory * m) (const char * hex) (const char * data)) (out void)
    (snprintf (-> m rd_hex_path) 512 "%s" hex)
    (snprintf (-> m rd_data_path) 512 "%s" data))

  ;; ==================================================================
  ;; THE STORE IS IN THE WRITING MACHINE'S BYTE ORDER, and this is what
  ;; says so out loud.
  ;;
  ;; filestream, mapstream and bufferstream are all hbostream -- HOST
  ;; byte order, a raw eight-byte read with no swap -- while the protocol
  ;; is networkstream over nbostream, which reverses the octets on a
  ;; little-endian host. That asymmetry is the right one: a connection
  ;; crosses machines and a store does not. But nothing said it, and a
  ;; store carried across the boundary anyway would OPEN: the page list is
  ;; built from twenty-byte hash keys, which are byte arrays and read the
  ;; same everywhere, and only then does the startup walk begin reading
  ;; control blocks whose every int64 is reversed -- transaction ids,
  ;; stamps, reference addresses. What comes out of that is not an error,
  ;; it is nonsense, and the first thing it does is write more of it.
  ;;
  ;; So a store keeps a mark beside it. The magic is written in host order
  ;; at the store's first open and read back at every later one: equal
  ;; means the same order, REVERSED means the store came from the other
  ;; kind of machine and this is refused by name, and anything else means
  ;; the mark itself is damaged. A store that predates the mark gets one
  ;; stamped with the opening host's order -- which is a guess, and the
  ;; honest limit of this: it cannot know where bytes written before it
  ;; existed came from, only that everything after agrees.
  ;;
  ;; The caller passes the store's DIRECTORY because that is what a caller
  ;; has -- the engine is handed two streams and never learns a path. Both
  ;; real consumers call it before memory_open: ziguratip's loadmemory and
  ;; cocolog's embedded open. The test binaries make their own stores in
  ;; /tmp with no directory to mark, and are unaffected.
  ;; ==================================================================
  (var const int64_t STORE_ORDER_MAGIC . 81985529216486895)   ;; 0x0123456789ABCDEF

  (func store_order_reversed ((int64_t seen)) (out int)
    (let ((uint8_t a [8]) (uint8_t b [8]) (int64_t mine . STORE_ORDER_MAGIC))
      (memcpy (cast (void *) a) (cast (const void *) (aof seen)) 8)
      (memcpy (cast (void *) b) (cast (const void *) (aof mine)) 8)
      (for ((int i . 0)) (< i 8) ((++ i))
        (if (!= (nth i a) (nth (- 7 i) b)) (return 0)))
      (return 1)))

  ;; 1 the store's order is this machine's, 0 it is not and ERR says why
  (func store_order_check ((const char * dir) (char * err) (size_t errcap)) (out int)
    (let ((char path [640]) (FILE * f . nil) (int64_t seen . 0))
      (snprintf path 640 "%s/byteorder.bin" dir)
      (set f (fopen path "rb"))
      (if (== f nil)
          (block
            ;; no mark yet: this open makes one, in this machine's order
            (set f (fopen path "wb"))
            (if (== f nil) (return 1))   ;; unmarkable is not unreadable
            (let ((int64_t mine . STORE_ORDER_MAGIC))
              (fwrite (cast (const void *) (aof mine)) 8 1 f))
            (fclose f)
            (return 1)))
      (let ((size_t got . #'(fread (cast (void *) (aof seen)) 8 1 f)))
        (fclose f)
        (if (!= got 1)
            (block
              (if (and (!= err nil) (> errcap 0))
                  (snprintf err errcap
                            "the store's byte-order mark in %s is short: the store cannot be judged either way"
                            path))
              (return 0))))
      (if (== seen STORE_ORDER_MAGIC) (return 1))
      (if (and (!= err nil) (> errcap 0))
          (if (== 1 (store_order_reversed seen))
              (snprintf err errcap
                        "the store in %s was written on a machine of the OTHER byte order: every int64 in it -- stamps, ids, addresses, keys -- would read reversed here. A store does not cross that boundary; the protocol does (ZiguratIP, StreamIO/nbostream)."
                        dir)
            (snprintf err errcap
                      "the store's byte-order mark in %s is neither this machine's nor its reverse, so the file is damaged"
                      path)))
      (return 0)))

  ;; ==================================================================
  ;; Statement -- where a reader's single point in time is fixed. The
  ;; outermost one starts the statement; inner ones nest silently.
  ;; ==================================================================
  ;; CONSTRUCTED BEFORE THE STREAMS GUARD, NOT INSIDE IT. Every cursor used
  ;; to take the guard first and build its Statement second, so the entropy
  ;; draw below -- one read() of eight bytes -- ran inside the hold. A
  ;; syscall is a scheduling point, and cocolog#16 measured what that costs
  ;; on four cores: a hold of 22 779us with 103us on CPU, of which the draw
  ;; was 22 729us wall and 56us CPU. The thread was descheduled at the
  ;; read(), holding the guard, and no other connection could take it for
  ;; the better part of a scheduler quantum. Nothing here needs the guard:
  ;; the constructor touches only thread-local fields. Moving it out does
  ;; not stop the deschedule -- it stops the deschedule being inside a
  ;; global lock, which is the whole of what it buys and is worth having.
  (struct Statement
    (member bool mine_)

    (ctor ((Memory * mem))
      (init (mine_ #f))
      (if (and (!= mem nil) (-> mem initialized))
          (if (and (!= tl_txn nil) (== (-> tl_txn query_time) (cast time_t 0)))
              (block
                (set ($ this mine_) #t)
                ;; a random positive query id, so an update cursor can tell
                ;; its own freshly inserted rows from the rows it is walking
                (let ((uint64_t drawn . 0))
                  ;; THE DRAW, TIMED WALL BESIDE CPU. One read() of eight
                  ;; bytes from a kept-open /dev/urandom -- a mean of 1.5us
                  ;; on cocolog#16's box, and once 12 603us, inside a hold
                  ;; of 12 613us. Whether that is the read blocking or the
                  ;; thread being descheduled at the syscall is exactly what
                  ;; a wall clock cannot say and a CPU clock can.
                  (warn! (set tl_draw_wall (mvccs_wall_micros))
                         (set tl_draw_cpu (mvccs_cpu_micros)))
                  (Utility::random_bytes (cast (uint8_t *) (aof drawn)) (sizeof uint64_t))
                  (warn! (let ((int64_t w . #'(- (mvccs_wall_micros) tl_draw_wall))
                               (int64_t c . #'(- (mvccs_cpu_micros) tl_draw_cpu)))
                           (debug! (fprintf stderr "mvccs[t%04zx] draw %lld us, cpu %lld us\n"
                                            (bitand (cast size_t (pthread_self)) 65535)
                                            (cast llong w) (cast llong c)))
                           (if (> w 1000)
                               (fprintf stderr "mvccs[t%04zx] draw STALLED %lld us, on cpu %lld us\n"
                                        (bitand (cast size_t (pthread_self)) 65535)
                                        (cast llong w) (cast llong c)))))
                  (set (-> tl_txn query_id) (cast int64_t (>> drawn 1))))
                (set (-> tl_txn query_time) (version_time))))))

    (dtor ()
      (if ($ this mine_)
          (block
            (set (-> tl_txn query_id) 0)
            (set (-> tl_txn query_time) (cast time_t 0))))))

  ;; ==================================================================
  ;; The watcher -- dba_watch and its formatting helpers. Nothing
  ;; generated checks the watcher first; these do, so a sprinkled call
  ;; costs one pointer test when nobody is watching.
  ;; ==================================================================
  (func dba_watch ((Memory * m) (const char * text)) (out void)
    (if (== (-> m watcher) nil) (return))
    (try (block
           ((-> (-> m watcher) write_std_size)
            (cast size_t (? (!= tl_txn nil) (-> tl_txn id) 0)))
           ((-> (-> m watcher) write_std_string) (std::string text)))
         ;; the watcher is best effort: the first failed write detaches it
         (catch ()
           (set (-> m watcher) nil))))

  (func dba_watch0 ((Memory * m) (const char * op)) (out void)
    (if (== (-> m watcher) nil) (return))
    (let ((char msg [192]))
      (snprintf msg 192 "%s: ()" op)
      (dba_watch m msg)))

  (func dba_watch1 ((Memory * m) (const char * op) (int64_t a)) (out void)
    (if (== (-> m watcher) nil) (return))
    (let ((char msg [192]))
      (snprintf msg 192 "%s: (%ld)" op (cast long a))
      (dba_watch m msg)))

  (func dba_watch2 ((Memory * m) (const char * op) (int64_t a) (int64_t b)) (out void)
    (if (== (-> m watcher) nil) (return))
    (let ((char msg [192]))
      (snprintf msg 192 "%s: (%ld, %ld)" op (cast long a) (cast long b))
      (dba_watch m msg)))

  ;; ==================================================================
  ;; Control block I/O -- _dump_control / _load_control
  ;; ==================================================================
  (func dump_control ((Memory * m) (const Pointer * p) (const Control * c)) (out void)
    (let ((uint8_t online_hexmap . #'(cast uint8_t (+ CONTROL_CHUNK
                                       (+ (cast int (-> c online_state)) (cast int (-> c online_lock))))))
          (uint8_t offline_hexmap . #'(cast uint8_t (+ CONTROL_CHUNK
                                        (+ (cast int (-> c offline_state)) (cast int (-> c offline_lock)))))))
      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m hexmap_io) good)))
          ((-> (-> m hexmap_io) clear)))
      ((-> (-> m hexmap_io) seekp) (ptr_hexmap p) std::ios::beg)
      ((-> (-> m hexmap_io) write_std_ubyte) online_hexmap)
      ((-> (-> m hexmap_io) write_std_ubyte) offline_hexmap)
      ((-> (-> m hexmap_io) write_std_ubyte) CONTROL_STANDALONE_CHUNK)

      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m data_io) good)))
          ((-> (-> m data_io) clear)))
      ((-> (-> m data_io) seekp) (-> p address) std::ios::beg)
      ((-> (-> m data_io) write_std_time) (cast time_t (-> c online_time)))
      ((-> (-> m data_io) write_std_size) (cast size_t (-> c transaction_id)))
      ((-> (-> m data_io) write_std_long) (cast int64_t (-> c query_id)))
      ((-> (-> m data_io) write_std_long) (cast int64_t (-> c reference_address)))
      ((-> (-> m data_io) write_std_time) (cast time_t (-> c modify_time)))
      ((-> (-> m data_io) write_std_time) (cast time_t (-> c create_time)))))

  ;; Two block reads instead of nine field reads: the stream's read_std_*
  ;; are host-order raw reads, so the 48-byte control area decodes with
  ;; memcpy. What this buys is measured, not cosmetic -- a cursor at
  ;; READ_COMMITTED judges every row, dead ones included, through this
  ;; function, and under twelve threads it was where the one stream guard's
  ;; holder spent most of its time.
  (func load_control ((Memory * m) (const Pointer * p) (Control * c)) (out void)
    (let ((uint8_t flags [4])
          (uint8_t fields [48])
          (binarystream * hio . #'(hex_in m))
          (binarystream * dio . #'(data_in m)))
      ;; a stream a failed read has poisoned answers nothing until it is
      ;; cleared -- and a thread's PRIVATE stream lives for the thread, so
      ;; one bad read would turn every later judgment on this thread into
      ;; garbage. Clear first, verify after.
      (if (not ((-> hio good))) ((-> hio clear)))
      (if (not ((-> dio good))) ((-> dio clear)))
      ((-> hio seekg) (ptr_hexmap p) std::ios::beg)
      ((-> hio read) (cast (char *) flags) 2)

      (set (-> c online_state) (cast RowState (bitand (nth 0 flags) 12)))
      (set (-> c online_lock) (cast RowLock (bitand (nth 0 flags) 3)))
      (set (-> c offline_state) (cast RowState (bitand (nth 1 flags) 12)))
      (set (-> c offline_lock) (cast RowLock (bitand (nth 1 flags) 3)))

      ((-> dio seekg) (-> p address) std::ios::beg)
      ((-> dio read) (cast (char *) fields) 48)
      (if (or (not ((-> hio good))) (not ((-> dio good))))
          (block
            ;; the read did not land: clear the streams and answer the one
            ;; safe thing -- a control nobody may see (offline NONE)
            ((-> hio clear))
            ((-> dio clear))
            (control_clear c)
            (return)))
      (memcpy (cast (void *) (aof (-> c online_time))) (cast (void *) (+ fields 0)) 8)
      (memcpy (cast (void *) (aof (-> c transaction_id))) (cast (void *) (+ fields 8)) 8)
      (memcpy (cast (void *) (aof (-> c query_id))) (cast (void *) (+ fields 16)) 8)
      (memcpy (cast (void *) (aof (-> c reference_address))) (cast (void *) (+ fields 24)) 8)
      (memcpy (cast (void *) (aof (-> c modify_time))) (cast (void *) (+ fields 32)) 8)
      (memcpy (cast (void *) (aof (-> c create_time))) (cast (void *) (+ fields 40)) 8)))

  ;; ==================================================================
  ;; Hexmap runs
  ;; ==================================================================
  (func full_hexmap_at ((Memory * m) (int64_t hex_address) (int64_t count)) (out void)
    ;; a failed read poisons the stream and every write after it no-ops --
    ;; writes clear first, exactly as the read accessors do
    (if (not ((-> (-> m hexmap_io) good)))
        ((-> (-> m hexmap_io) clear)))
    ((-> (-> m hexmap_io) seekp) hex_address std::ios::beg)
    ((-> (-> m hexmap_io) fill_n) (cast size_t (- count 1)) (cast char DATA_CHUNK))
    ((-> (-> m hexmap_io) write_std_ubyte) DATA_STANDALONE_CHUNK))

  (func full_hexmap ((Memory * m) (const Pointer * p)) (out void)
    (let ((int64_t hex_address . #'(ptr_hexmap_data p))
          (int64_t count . #'(ptr_data_count p)))
      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m hexmap_io) good)))
          ((-> (-> m hexmap_io) clear)))
      ((-> (-> m hexmap_io) seekp) hex_address std::ios::beg)
      ((-> (-> m hexmap_io) fill_n) (cast size_t (- count 1)) (cast char DATA_CHUNK))
      ((-> (-> m hexmap_io) write_std_ubyte)
       (cast uint8_t (+ DATA_STANDALONE_CHUNK (% (-> p size) CHUNK_SIZE))))))

  (func free_hexmap ((Memory * m) (int64_t hex_address) (int64_t count)) (out void)
    ;; a failed read poisons the stream and every write after it no-ops --
    ;; writes clear first, exactly as the read accessors do
    (if (not ((-> (-> m hexmap_io) good)))
        ((-> (-> m hexmap_io) clear)))
    ((-> (-> m hexmap_io) seekp) hex_address std::ios::beg)
    ((-> (-> m hexmap_io) fill_n) (cast size_t (- count 1)) (cast char FREE_CHUNK))
    ((-> (-> m hexmap_io) write_std_ubyte) FREE_STANDALONE_CHUNK))

  ;; how many chunks the free run at ADDRESS spans, read from the hexmap
  ;; and stopped at the page boundary whatever the bytes claim
  (func free_run_count ((Memory * m) (int64_t address) (int64_t end_address)) (out int64_t)
    (let ((uint8_t hex_byte . 0)
          (int64_t count . 0))
      ((-> (-> m hexmap_io) seekg) (addr_hexmap address) std::ios::beg)
      (while (< (+ address (* count CHUNK_SIZE)) end_address)
        ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
        (if (not ((-> (-> m hexmap_io) good)))
            (block
              ((-> (-> m hexmap_io) clear))
              (throw* (MemoryException "hexmap ends inside the free run"))))
        ;; an allocated chunk is not part of this run
        (if (== (bitand hex_byte 128) 128) break)
        (set count (+ count 1))
        (if (== (bitand hex_byte 64) 64) break))   ;; standalone: run ends here
      (return count)))

  ;; a Pointer read back from the hexmap chain at ADDRESS -- _pointer
  (func pointer_at ((Memory * m) (const uint8_t * key) (int64_t address)) (out Pointer)
    (let ((uint8_t hex_byte . 0)
          (int64_t size . 0)
          (binarystream * hio . #'(hex_in m)))
      ((-> hio seekg) (addr_hexmap_data address) std::ios::beg)
      (while #t
        ((-> hio read_std_ubyte) hex_byte)
        (if (not ((-> hio good)))
            (block
              ((-> hio clear))
              (throw* (MemoryException "hexmap ends inside the chunk"))))
        ;; Every chunk of a record is a DATA chunk: the high bit is set on
        ;; all of them, standalone or not. A byte without it is free space,
        ;; which is where a torn chain link points -- walked naively that is
        ;; the hexmap read one free byte at a time to its end, and the C++
        ;; twin measured exactly that as a vacuum spinning forever.
        (if (!= (bitand hex_byte 128) 128)
            (throw* (MemoryException "the chunk is not an allocated record -- a torn link")))
        (if (== (bitand hex_byte 64) 64)
            (return (pointer_make key address (+ size (size_remainder hex_byte)))))
        (set size (+ size CHUNK_SIZE)))
      (return (pointer_null))))

  ;; Whether ADDRESS names an allocated record: its first hexmap byte carries
  ;; the DATA bit. A chain walk asks this before following a link, because a
  ;; torn chain edit -- one the process died inside of -- can land as a ZERO,
  ;; a "valid" address that in practice points at free space. One such link
  ;; sent the C++ vacuum's walk spinning at address 0 with the whole server
  ;; queued behind its exclusive guard; the walks in both engines now end a
  ;; chain at an unresolvable link exactly as they end it at -1.
  (func chain_resolves ((Memory * m) (int64_t address)) (out bool)
    (if (< address 0) (return #f))
    (let ((uint8_t hex_byte . 0)
          (binarystream * hio . #'(hex_in m)))
      ((-> hio seekg) (addr_hexmap_data address) std::ios::beg)
      ((-> hio read_std_ubyte) hex_byte)
      (if (not ((-> hio good)))
          (block
            ((-> hio clear))
            (return #f)))
      (return (== (bitand hex_byte 128) 128))))

  ;; the startup variant that also answers is-data and the online flags
  (func pointer_at_state ((Memory * m) (const uint8_t * key) (int64_t address)
                          (bool * is_data) (RowState * online_state) (RowLock * online_lock))
        (out Pointer)
    (let ((uint8_t hex_byte . 0)
          (int64_t size . 0)
          (binarystream * hio . #'(hex_in m)))
      ((-> hio seekg) (addr_hexmap address) std::ios::beg)
      ((-> hio read_std_ubyte) hex_byte)
      (set (cof online_state) (cast RowState (bitand hex_byte 12)))
      (set (cof online_lock) (cast RowLock (bitand hex_byte 3)))
      ((-> hio seekg) (- CONTROL_COUNT 1) std::ios::cur)
      (while #t
        ((-> hio read_std_ubyte) hex_byte)
        ;; Reading past the end of the hexmap leaves the stream failed and
        ;; every further read a no-op, so without this the loop spins
        ;; forever on a truncated store rather than reporting the problem.
        ;; The C++ engine throws here in the same words (memory.cpp,
        ;; _pointer_state); the port had dropped the guard, and a wedged
        ;; store took the process with it instead of refusing.
        (if (not ((-> hio good)))
            (block
              ((-> hio clear))
              (let ((char msg [96]))
                (snprintf msg 96 "hexmap ends inside the chunk at %lld"
                          (cast llong address))
                (throw* (MemoryException msg)))))
        (if (== (bitand hex_byte 64) 64)
            (block
              (set (cof is_data) (== (bitand hex_byte 128) 128))
              (return (pointer_make key address (+ size (size_remainder hex_byte))))))
        (set size (+ size CHUNK_SIZE)))
      (return (pointer_null))))

  ;; ==================================================================
  ;; Allocation
  ;; ==================================================================
  ;; Which chain a key's pages hang from: FNV-1a over the key's twenty
  ;; bytes, taken down to a bucket. The key is interned, so a pointer
  ;; would do -- but a cursor is handed the table's own array, which is
  ;; not, and the bytes are what both agree on.
  (func key_bucket ((const uint8_t * key)) (out int64_t)
    (let ((uint64_t h . #'(fnv_basis64)))
      (for ((int64_t i . 0)) (< i HASHKEY_SIZE) ((++ i))
        (set h (xor h (cast uint64_t (nth i key))))
        (set h (* h (cast uint64_t 1099511628211))))
      (return (cast int64_t (% h (cast uint64_t PAGE_BUCKET_COUNT))))))

;; ==================================================================
  ;; THE FREE LIST, SEGREGATED. It was one list of every key's free spans,
  ;; and a fresh page leaves a tail too short for the next row of its key
  ;; behind it for good: measured on bench/table-bench.cpp, the list held
  ;; 27 434 entries at its block 1 000, 21 001 of them the rows' -- one a
  ;; page -- and every allocation that met no fit near the head walked
  ;; them all, a cache miss a link, until a row's insert took 45 us
  ;; instead of 6 (a quarter of a gdb sample of the run in `allocate').
  ;; Now a span is chained by its key's bucket AND its size class, a
  ;; power of two: an allocation looks in its own class -- a bounded walk,
  ;; since that class holds the spans just too short for it -- and then
  ;; takes the first span of its key in any larger class, which fits by
  ;; construction. A short tail sits in a class nothing of its size asks.
  ;; ==================================================================
  (func free_class ((int64_t size)) (out int64_t)
    (let ((int64_t c . 0)
          (int64_t s . size))
      (while (and (> s 1) (< c (- FREE_CLASSES 1)))
        (set s (>> s 1))
        (set c (+ c 1)))
      (return c)))

  (func free_slot ((const uint8_t * key) (int64_t size)) (out int64_t)
    (return (+ (* (key_bucket key) FREE_CLASSES) (free_class size))))

  (func free_list_insert ((Memory * m) (const uint8_t * key)
                          (int64_t address) (int64_t size)) (out void)
    (let ((FreeEntry * e . #'(new* FreeEntry))
          (int64_t slot . #'(free_slot key size)))
      (set (-> e key) (intern_key key))
      (set (-> e address) address)
      (set (-> e size) size)
      (set (-> e next) (nth slot (-> m free_heads)))
      (set (nth slot (-> m free_heads)) e)))

  ;; the head of KEY's chain. Every caller holds page_list_access, which
  ;; is what it held to walk the whole list.
  (func page_chain ((Memory * m) (const uint8_t * key)) (out PageEntry *)
    (return (nth (key_bucket key) (-> m page_heads))))

  (func page_bucket_link ((Memory * m) (PageEntry * e)) (out void)
    (let ((int64_t b . #'(key_bucket (-> e key))))
      (set (-> e key_next) (nth b (-> m page_heads)))
      (set (nth b (-> m page_heads)) e)))

  (func page_bucket_unlink ((Memory * m) (PageEntry * e)) (out void)
    (let ((int64_t b . #'(key_bucket (-> e key)))
          (PageEntry * prev . nil)
          (PageEntry * c . nil))
      (set c (nth b (-> m page_heads)))
      (while (!= c nil)
        (if (== c e)
            (block
              (if (== prev nil)
                  (set (nth b (-> m page_heads)) (-> c key_next))
                (set (-> prev key_next) (-> c key_next)))
              (set (-> e key_next) nil)
              (return)))
        (set prev c)
        (set c (-> c key_next)))))

  ;; a page changes hands -- out of its old key's chain and into the new
  ;; one, the entry itself staying where it is in the whole-store list
  (func page_rekey ((Memory * m) (PageEntry * e) (const uint8_t * key)) (out void)
    (page_bucket_unlink m e)
    (set (-> e key) (intern_key key))
    (page_bucket_link m e))

  (func page_list_insert ((Memory * m) (const uint8_t * key) (int64_t address)) (out void)
    (let ((PageEntry * e . #'(new* PageEntry)))
      (set (-> e key) (intern_key key))
      (set (-> e address) address)
      (set (-> e next) (-> m pages))
      (set (-> m pages) e)
      (page_bucket_link m e)))

  ;; writes a fresh page header: control chunks full, the rest free, the
  ;; hash key at the front, zeroes behind it
  (func allocate_page ((Memory * m) (const uint8_t * key) (int64_t address)) (out void)
    (full_hexmap_at m (addr_hexmap address) PAGEFILE_CONTROL_COUNT)
    (free_hexmap m (+ (addr_hexmap address) PAGEFILE_CONTROL_COUNT)
                 (- (-> m hbpp) PAGEFILE_CONTROL_COUNT))
    ;; a failed read poisons the stream and every write after it no-ops --
    ;; writes clear first, exactly as the read accessors do
    (if (not ((-> (-> m data_io) good)))
        ((-> (-> m data_io) clear)))
    ((-> (-> m data_io) seekp) address std::ios::beg)
    ((-> (-> m data_io) write) (cast (char *) key) HASHKEY_SIZE)
    ((-> (-> m data_io) fill_n) (cast size_t (- (-> m page_size) HASHKEY_SIZE)) (cast char 0)))

  ;; a page for KEY: a __FREE__ page rekeyed, or a fresh one appended.
  ;; DIVERGENCE (a fix): the original inserted the reused page into the
  ;; page list under a second entry and left the __FREE__ entry behind;
  ;; here the entry is rekeyed in place.
  (func allocate_new_page ((Memory * m) (const uint8_t * key)) (out int64_t)
    (let ((PageEntry * e . #'(page_chain m FREE_HASHKEY)))
      (while (!= e nil)
        (if (== (memcmp (-> e key) FREE_HASHKEY (cast size_t HASHKEY_SIZE)) 0)
            (block
              (allocate_page m key (-> e address))
              (page_rekey m e key)
              (return (-> e address))))
        (set e (-> e key_next))))
    ;; a failed read poisons the stream and every write after it no-ops --
    ;; writes clear first, exactly as the read accessors do
    (if (not ((-> (-> m data_io) good)))
        ((-> (-> m data_io) clear)))
    ((-> (-> m data_io) seekp) 0 std::ios::end)
    (let ((int64_t start . #'((-> (-> m data_io) tellp))))
      (allocate_page m key start)
      (page_list_insert m key start)
      (set (-> m page_count) (+ (-> m page_count) 1))
      (return start)))

  (func allocate ((Memory * m) (const uint8_t * key) (int64_t size)) (out Pointer)
    (let ((int64_t actual_size . #'(size_actual size)))
      (if (> actual_size (- (-> m page_size) (+ PAGEFILE_CONTROL_SIZE CONTROL_SIZE)))
          (throw* (MemoryException "allocation overflow")))

      (pthread_mutex_lock (aof (-> m page_list_access)))
      (pthread_mutex_lock (aof (-> m free_list_access)))

      ;; a fit from the free list: the span's own class, a bounded walk,
      ;; then the first of this key's spans in any larger class. A free
      ;; entry measures the WHOLE span; the Pointer handed out measures the
      ;; DATA -- see _allocate in memory.cpp for the corruption confusing
      ;; the two caused.
      (let ((int64_t base . #'(* (key_bucket key) FREE_CLASSES))
            (int64_t c . #'(free_class actual_size))
            (FreeEntry * got . nil)
            (FreeEntry * got_prev . nil)
            (int64_t got_slot . -1))
        (while (and (< c FREE_CLASSES) (== got nil))
          (let ((FreeEntry * prev . nil)
                (FreeEntry * e . #'(nth (+ base c) (-> m free_heads)))
                (int64_t looked . 0))
            (while (and (!= e nil) (and (== got nil) (< looked 16)))
              (if (and (== (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)) 0)
                       (<= actual_size (-> e size)))
                  (block
                    (set got e)
                    (set got_prev prev)
                    (set got_slot (+ base c)))
                (block
                  (if (== (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)) 0)
                      (set looked (+ looked 1)))
                  (set prev e)
                  (set e (-> e next))))))
          (set c (+ c 1)))
        (if (!= got nil)
            (let ((Pointer p . #'(pointer_make (-> got key) (-> got address) size)))
              ;; out of its chain; a split's tail goes back in its own class
              (if (== got_prev nil)
                  (set (nth got_slot (-> m free_heads)) (-> got next))
                (set (-> got_prev next) (-> got next)))
              (if (== actual_size (-> got size))
                  (delete* got)
                (let ((int64_t slot . 0))
                  (set (-> got address) (+ (-> got address) actual_size))
                  (set (-> got size) (- (-> got size) actual_size))
                  (set slot (free_slot (-> got key) (-> got size)))
                  (set (-> got next) (nth slot (-> m free_heads)))
                  (set (nth slot (-> m free_heads)) got)))
              (pthread_mutex_unlock (aof (-> m free_list_access)))
              (pthread_mutex_unlock (aof (-> m page_list_access)))
              (return p))))

      ;; nothing fits: a new page, its tail registered free
      (let ((const uint8_t * key_interned . #'(intern_key key))
            (int64_t start . 0))
        (set start (allocate_new_page m key_interned))
        (free_list_insert m key_interned
                          (+ start (+ PAGEFILE_CONTROL_SIZE actual_size))
                          (- (-> m page_size) (+ PAGEFILE_CONTROL_SIZE actual_size)))
        (pthread_mutex_unlock (aof (-> m free_list_access)))
        (pthread_mutex_unlock (aof (-> m page_list_access)))
        (return (pointer_make key_interned (+ start PAGEFILE_CONTROL_SIZE) size)))))


  ;; ==================================================================
  ;; Freeing -- _free and its two hexmap probes. A freed run coalesces
  ;; with the free run before and after it; a fully free page goes back
  ;; to __FREE__.
  ;; ==================================================================
  (func free_prev_count ((Memory * m)) (out int64_t)
    (let ((uint8_t hexbyte . 0)
          (int64_t counter . 0))
      (if (> (% ((-> (-> m hexmap_io) tellg)) (-> m hbpp)) 0)
          (block
            ((-> (-> m hexmap_io) seekg) -1 std::ios::cur)
            ((-> (-> m hexmap_io) read_std_ubyte) hexbyte)
            (cond
              ((== (>> hexbyte 7) 0)
               (block
                 (set counter (+ counter 1))
                 (if (== ((-> (-> m hexmap_io) tellg)) 1) (return counter))))
              ((or (== ((-> (-> m hexmap_io) tellg)) 1) (== (>> hexbyte 7) 1))
               (return counter))
              (#t (return 0)))))
      (while (> (% ((-> (-> m hexmap_io) tellg)) (-> m hbpp)) 0)
        ((-> (-> m hexmap_io) seekg) -2 std::ios::cur)
        ((-> (-> m hexmap_io) read_std_ubyte) hexbyte)
        (cond
          ((== (>> hexbyte 7) 0)
           (block
             (set counter (+ counter 1))
             (if (== ((-> (-> m hexmap_io) tellg)) 1) (return counter))))
          ((or (== ((-> (-> m hexmap_io) tellg)) 1) (== (>> hexbyte 7) 1))
           (return counter))
          (#t (return 0))))
      (return 0)))

  (func free_next_count ((Memory * m)) (out int64_t)
    (let ((uint8_t hexbyte . 0)
          (int64_t counter . 0))
      (while (> (% ((-> (-> m hexmap_io) tellg)) (-> m hbpp)) 0)
        ((-> (-> m hexmap_io) read_std_ubyte) hexbyte)
        (if (== (>> hexbyte 7) 0)
            (block
              (set counter (+ counter 1))
              (if (== (>> hexbyte 6) 1) (return counter)))
          (return 0)))
      (return 0)))

  ;; the span of KEY at ADDRESS out of the list: SIZE names its class, and
  ;; a span registered otherwise is found by the bucket's every class
  (func free_slot_erase ((Memory * m) (int64_t slot) (const uint8_t * key) (int64_t address)) (out bool)
    (let ((FreeEntry * prev . nil)
          (FreeEntry * e . #'(nth slot (-> m free_heads))))
      (while (!= e nil)
        (if (and (== (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)) 0)
                 (== (-> e address) address))
            (block
              (if (== prev nil)
                  (set (nth slot (-> m free_heads)) (-> e next))
                (set (-> prev next) (-> e next)))
              (delete* e)
              (return #t)))
        (set prev e)
        (set e (-> e next)))
      (return #f)))

  (func free_list_erase_at ((Memory * m) (const uint8_t * key) (int64_t address) (int64_t size)) (out void)
    (if (free_slot_erase m (free_slot key size) key address) (return))
    (let ((int64_t base . #'(* (key_bucket key) FREE_CLASSES)))
      (for ((int64_t c . 0)) (< c FREE_CLASSES) ((++ c))
        (if (free_slot_erase m (+ base c) key address) (return)))))

  (func free_pointer ((Memory * m) (const Pointer * p)) (out void)
    (dba_watch2 m "Free" (-> p address) (-> p size))
    (bt_cache_forget m (-> p address))
    (let ((int64_t from . #'(ptr_hexmap p))
          (int64_t count . #'(ptr_actual_count p))
          (int64_t full_count . 0)
          (int64_t begin . 0))
      (set full_count count)
      (set begin from)

      (pthread_mutex_lock (aof (-> m page_list_access)))
      (pthread_mutex_lock (aof (-> m free_list_access)))

      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m hexmap_io) good)))
          ((-> (-> m hexmap_io) clear)))
      ((-> (-> m hexmap_io) seekp) from std::ios::beg)
      ((-> (-> m hexmap_io) seekg) from std::ios::beg)
      (let ((int64_t prev_count . #'(free_prev_count m)))
        (if (> prev_count 0)
            (block
              (set full_count (+ full_count prev_count))
              (set begin (- begin prev_count))
              (free_list_erase_at m (-> p hash_key) (* (- from prev_count) CHUNK_SIZE)
                                  (* prev_count CHUNK_SIZE)))))

      ((-> (-> m hexmap_io) seekg) (+ from count) std::ios::beg)
      (let ((int64_t next_count . #'(free_next_count m)))
        (if (> next_count 0)
            (block
              (set full_count (+ full_count next_count))
              (free_list_erase_at m (-> p hash_key) (* (+ from count) CHUNK_SIZE)
                                  (* next_count CHUNK_SIZE)))))

      (free_hexmap m begin full_count)

      ;; The whole page is free: hand it back to the allocator. The test is
      ;; against the page's DATA AREA, not the page -- the three pagefile
      ;; control chunks at its front are full for as long as the page
      ;; exists, so a span can never equal page_size and the original
      ;; comparison was a branch that could not fire. What that cost: a
      ;; page, once keyed to a table, stayed that table's forever, cursor
      ;; walks visited every page a workload had EVER needed at its worst,
      ;; and the twelve-worker choreography paid its own history until it
      ;; timed out. `begin' points at the first data chunk, so the page
      ;; starts one pagefile-control earlier.
      ;; DIVERGENCE (a fix, kept): the original also left the page listed
      ;; under its old key; here the entry is rekeyed in place.
      (if (== (* full_count CHUNK_SIZE) (- (-> m page_size) PAGEFILE_CONTROL_SIZE))
          (let ((int64_t page_address . #'(- (* begin CHUNK_SIZE) PAGEFILE_CONTROL_SIZE)))
            (allocate_page m FREE_HASHKEY page_address)
            ;; the page is this pointer's key's, so its own chain holds it
            (let ((PageEntry * e . #'(page_chain m (-> p hash_key))))
              (while (!= e nil)
                (if (== (-> e address) page_address)
                    (block
                      (page_rekey m e FREE_HASHKEY)
                      break))
                (set e (-> e key_next)))))
        (free_list_insert m (-> p hash_key) (* begin CHUNK_SIZE) (* full_count CHUNK_SIZE)))

      (pthread_mutex_unlock (aof (-> m free_list_access)))
      (pthread_mutex_unlock (aof (-> m page_list_access)))))

  ;; ==================================================================
  ;; Transaction plumbing
  ;; ==================================================================
  ;; THE STAGING TIME A DEFERRED INDEX ENTRY CARRIES. An entry the
  ;; transaction applies late (see "Deferred index maintenance" with the
  ;; tree) is pushed with the time its ROW was staged, not the time it was
  ;; applied, so rollback_transaction_to treats a row and its index values
  ;; as one: both before the boundary, or both after it. Zero means now.
  (thread-local) (var time_t tl_push_at . 0)

  ;; set by online_insert / online_update around a row's map(): an index
  ;; entry made under it queues for the commit instead of mapping now
  (thread-local) (var int tl_defer_maps . 0)
  ;; -1 until the environment has been read; then 0 off, 1 on
  (var int g_defer_index . -1)

  (func idx_defer_enabled () (out int)
    (if (< g_defer_index 0)
        (let ((const char * s . #'(getenv "MVCCS_DEFER_INDEX")))
          (set g_defer_index (? (and (!= s nil) (== (nth 0 s) (cast char 48))) 0 1))))
    (return g_defer_index))

  ;; the flag around a row's map(), put back however map() leaves --
  ;; a unique key refusing the row throws through here
  (struct DeferScope
    (member int saved_)
    (ctor ((int on))
      (init (saved_ 0))
      (set ($ this saved_) tl_defer_maps)
      (set tl_defer_maps on))
    (dtor ()
      (set tl_defer_maps ($ this saved_))))

  ;; the queue's three verbs, defined with the tree they map into
  (decl) (func idx_pending_apply () (out void))
  (decl) (func idx_pending_discard () (out void))
  (decl) (func idx_pending_drop_from ((time_t at)) (out void))

  ;; the log index's hooks into the store's life, defined with it (see
  ;; "THE LOG INDEX" beside the tree): a commit's first sync frees what it
  ;; made safe to free, a table's TRUNCATE drops its log indexes before a
  ;; row is freed, and a store opened afresh forgets the last one's logs
  (decl) (func log_after_sync ((Memory * m)) (out void))
  (decl) (func log_table_truncated ((Memory * m) (const uint8_t * table_key)) (out int))
  (decl) (func log_forget_memory ((Memory * m)) (out void))

  (func transaction_push ((Memory * m) (const Pointer * p)) (out void)
    (dba_watch1 m "Transaction Push" (-> p address))
    (let ((Transaction * t . #'(txn))
          (TxnEntry * e . #'(new* TxnEntry)))
      ;; same clock as query_time: rollback_transaction_to compares the two
      (set (-> e at) (? (!= tl_push_at (cast time_t 0)) tl_push_at (version_time)))
      (set (-> e ptr) (cof p))
      (set (-> e next) nil)
      (set (-> e prev) (-> t ctx_tail))
      (if (== (-> t ctx_tail) nil)
          (set (-> t ctx_head) e)
        (set (-> (-> t ctx_tail) next) e))
      (set (-> t ctx_tail) e)))

  (func write_transaction ((Memory * m) (size_t transaction_id) (time_t commit_time)) (out void)
    (let ((Transaction * t . #'(txn)))
      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m data_io) good)))
          ((-> (-> m data_io) clear)))
      ((-> (-> m data_io) seekp) (ptr_data (aof (-> t pointer))) std::ios::beg)
      ((-> (-> m data_io) write_std_size) (cast size_t transaction_id))
      ((-> (-> m data_io) write_std_time) (cast time_t commit_time))))

  (func commit_pointer ((Memory * m) (const Pointer * p) (time_t commit_time)) (out void)
    (dba_watch1 m "Commit Pointer" (-> p address))
    (let ((Control control))
      (control_clear (aof control))
      (load_control m p (aof control))

      ;; ONLY A STAGE THIS TRANSACTION STILL OWNS IS ITS TO FLIP. A writer
      ;; that does not conflict with a shared stamp can stage over it, and
      ;; the displaced transaction's commit arriving later would then flip
      ;; the DISPLACER'S uncommitted work with its own timestamp. The row
      ;; carries its stager's id; a mismatch means this transaction was
      ;; displaced here, and the row is no longer its business. Startup
      ;; recovery stands outside the rule: it executes CRASHED transactions'
      ;; recorded intentions, so foreign ids are exactly its job.
      (if (and (-> m initialized)
               (and (!= tl_txn nil)
                    (!= ($ control transaction_id) (-> tl_txn id))))
          (return))

      (cond
        ((== ($ control online_state) ROW_INSERTED)
         (block (set ($ control offline_state) ROW_INSERTED)
                (set ($ control create_time) commit_time)))
        ((== ($ control online_state) ROW_UPDATED)
         (block (set ($ control offline_state) ROW_UPDATED)
                (set ($ control modify_time) commit_time)))
        ((== ($ control online_state) ROW_DELETED)
         (block (set ($ control offline_state) ROW_DELETED)
                (set ($ control modify_time) commit_time))))

      (set ($ control online_state) ROW_NONE)
      (set ($ control online_lock) LOCK_NONE)
      (set ($ control online_time) (cast time_t 0))
      (set ($ control transaction_id) 0)
      (set ($ control query_id) 0)

      (dump_control m p (aof control))))

  ;; the rollback of ONE pointer with no ownership question asked --
  ;; rollback_pointer guards it for a transaction rolling back its own
  ;; context, and check_lock calls it bare when breaking a dead
  ;; transaction's lock, which is recovery's foreign-id work done lazily
  (func rollback_pointer_apply ((Memory * m) (const Pointer * p)) (out void)
    (let ((Control control))
      (control_clear (aof control))
      (load_control m p (aof control))

      (set ($ control online_state) ROW_NONE)
      (set ($ control online_lock) LOCK_NONE)
      (set ($ control online_time) (cast time_t 0))
      (set ($ control transaction_id) 0)
      (set ($ control query_id) 0)

      ;; a row that was never committed is flagged deleted rather than freed:
      ;; rows are never reclaimed except by TRUNCATE. BORN AND DIED AT THE
      ;; SAME INSTANT, so no snapshot anywhere can see it -- without the
      ;; birth stamp, a reader whose statement began BEFORE this rollback
      ;; read "died after my snapshot" on a row that was never alive: the
      ;; dirty read the upstream suite caught about one run in three.
      (if (== ($ control offline_state) ROW_NONE)
          (block
            (set ($ control offline_state) ROW_DELETED)
            (set ($ control modify_time) (version_time))
            (set ($ control create_time) ($ control modify_time))))

      (dump_control m p (aof control))))

  (func rollback_pointer ((Memory * m) (const Pointer * p)) (out void)
    (dba_watch1 m "Rollback Pointer" (-> p address))
    (let ((Control control))
      (control_clear (aof control))
      (load_control m p (aof control))

      ;; the same ownership rule as commit_pointer, and it is what a claim
      ;; retry's partial rollback was violating: it 'restored' a row whose
      ;; stage now belonged to a SAVE that had staged a delete over the
      ;; claim's shared stamp -- the restore erased the staged delete, the
      ;; save's commit then found nothing of its own to flip, and the row
      ;; came back from the dead as a TWIN the twelve workers bounced their
      ;; saves between forever. Startup recovery stands outside the rule,
      ;; exactly as at commit_pointer.
      (if (and (-> m initialized)
               (and (!= tl_txn nil)
                    (!= ($ control transaction_id) (-> tl_txn id))))
          (return)))
    (rollback_pointer_apply m p))

  ;; data before hexmap, every durability point -- the hexmap is the claim,
  ;; the data the substance
  (func sync_disk ((Memory * m)) (out void)
    ((-> (-> m hexmap_io) flush))
    ((-> (-> m data_io) flush))
    ((-> (-> m data_io) sync_to_disk))
    ((-> (-> m hexmap_io) sync_to_disk)))

  (func begin_transaction ((Memory * m)) (out void)
    (if (== tl_txn nil)
        (block
          (set tl_txn (new* Transaction))
          (set (-> tl_txn id) 0)
          (set (-> tl_txn pointer) (pointer_null))
          (set (-> tl_txn isolation_level) READ_COMMITTED)
          (set (-> tl_txn ctx_head) nil)
          (set (-> tl_txn ctx_tail) nil)))
    ;; A FRESH ID PER FRESH BEGIN, not per begin: a begin on a thread
    ;; whose transaction is STILL OPEN continues that transaction -- the
    ;; server begins once per request while a turn's transaction spans
    ;; many -- so the id and its registration stand there; commit and
    ;; rollback null the record pointer, which is the test. Handing such
    ;; a begin a fresh id orphaned every stage the turn had already made
    ;; (the commit's ownership guard skipped them all). Before this the
    ;; id came from generate_id, hashed from the thread and the wall
    ;; second: two FRESH begins in one second collided, and a nested
    ;; begin kept its id only by that same second-resolution accident.
    ;; The serial makes every fresh begin distinct; the hashed base
    ;; keeps ids from different runs from colliding in a store that
    ;; outlives them.
    (if (== ($ (-> tl_txn pointer) hash_key) nil)
        (block
          (block
            (pthread_mutex_lock (aof live_txn_access))
            (if (== txn_id_base (cast size_t 0))
                (set txn_id_base (Utility::generate_id)))
            (set txn_id_serial (+ txn_id_serial 1))
            (set (-> tl_txn id) (+ txn_id_base txn_id_serial))
            (if (== (-> tl_txn id) (cast size_t 0))
                (set (-> tl_txn id) txn_id_serial))
            (pthread_mutex_unlock (aof live_txn_access)))
          (transaction_register (-> tl_txn id))))
    (transaction_reset tl_txn)
    (dba_watch0 m "Begin Transaction")

    (letin* ((streams (Streams m)))
      (set (-> tl_txn pointer)
           (allocate m TRANSACTIONS_HASHKEY
                     (cast int64_t (+ (sizeof size_t) (sizeof time_t)))))
      (let ((Control control))
        (control_clear (aof control))
        (set ($ control offline_state) ROW_INSERTED)
        (dump_control m (aof (-> tl_txn pointer)) (aof control)))
      (full_hexmap m (aof (-> tl_txn pointer)))
      (write_transaction m (-> tl_txn id) (cast time_t 0))))

  ;; A STAGE NEEDS A TRANSACTION. The layer above commits between
  ;; statements and does not always begin before the next one, so the
  ;; next statement's stages arrived under the RETIRED id of the
  ;; transaction that had just committed -- alive by every intention,
  ;; dead by the registry, and the lazy stale-lock breaker rolled such
  ;; work back from under the running statement. Beginning here is
  ;; idempotent -- a begin on an open transaction continues it -- so a
  ;; stage arriving with no transaction open simply opens the next one.
  (func stage_needs_transaction ((Memory * m)) (out void)
    (if (and (-> m initialized)
             (or (== tl_txn nil)
                 (== ($ (-> tl_txn pointer) hash_key) nil)))
        (begin_transaction m)))

  (func transaction_context_clear ((Transaction * t)) (out void)
    (let ((TxnEntry * e . #'(-> t ctx_head)))
      (while (!= e nil)
        (let ((TxnEntry * dead . e))
          (set e (-> e next))
          (delete* dead))))
    (set (-> t ctx_head) nil)
    (set (-> t ctx_tail) nil))

  ;; ----------------------------------------------------------------
  ;; THE SUCCESSOR STAMP -- how the last inserted version of a row
  ;; becomes reachable from the first of its history.
  ;;
  ;; An update writes its new version at a NEW address and points it BACK
  ;; at the version it supersedes (reference_address), so the chain runs
  ;; newest-to-oldest and a reader that holds an OLD address -- the page
  ;; scan meets the oldest version first -- has no road forward: today it
  ;; chases the growing history to its end to find the version that is
  ;; current.
  ;;
  ;; The road forward is paid for with a field that is already spent.
  ;; commit_pointer zeroes query_id when a version settles, so on every
  ;; SETTLED superseded version the field is dead weight. At commit, each
  ;; new version stamps its predecessor's query_id with its own address:
  ;; a forward link, written only after both sides are committed.
  ;;
  ;; THE STAMP IS A HINT AND NEVER AN ANSWER. row_latest verifies every
  ;; hop by the successor's own reference_address pointing back -- a
  ;; stamp that is missing (an old store, a crash between the flip and
  ;; the stamp, startup recovery, a C++-engine writer), erased (a staged
  ;; write over a settled version rolls back and zeroes it), or torn can
  ;; only end the walk early, never send it to the wrong row. And a
  ;; version that is staged carries its stager's real query id in the
  ;; same field, which is why every guard below requires the settled
  ;; state before the field means an address.
  (func stamp_successor ((Memory * m) (const Pointer * p)) (out void)
    (let ((Control control))
      (control_clear (aof control))
      (load_control m p (aof control))
      ;; only a settled new version of an update stamps
      (if (or (!= ($ control online_state) ROW_NONE)
              (or (!= ($ control offline_state) ROW_INSERTED)
                  (or (!= ($ control transaction_id) (cast size_t 0))
                      (<= ($ control reference_address) -1))))
          (return))
      (if (not (chain_resolves m ($ control reference_address)))
          (return))
      (let ((Pointer prev . #'(pointer_at m (-> p hash_key) ($ control reference_address)))
            (Control pc))
        (control_clear (aof pc))
        (load_control m (aof prev) (aof pc))
        ;; and only onto a settled superseded predecessor
        (if (and (== ($ pc online_state) ROW_NONE)
                 (and (== ($ pc online_lock) LOCK_NONE)
                      (and (== ($ pc offline_state) ROW_UPDATED)
                           (== ($ pc transaction_id) (cast size_t 0)))))
            (block
              (set ($ pc query_id) (-> p address))
              (dump_control m (aof prev) (aof pc)))))))

  (func commit_transaction ((Memory * m)) (out void)
    (dba_watch0 m "Commit Transaction")
    ;; THE BULK MAP: every index entry this transaction's inserts queued,
    ;; sorted and mapped now -- before the intention, so the values are
    ;; staged under this transaction and flip with its rows below
    (idx_pending_apply)
    (let ((Transaction * t . #'(txn)))
      ;; A transaction that wrote nothing has nothing to make durable: no
      ;; control block moved, so there is no intention to record and no
      ;; sync to pay. This is not a nicety: a polling worker COMMITS ITS
      ;; READS -- twelve of them, several times a second -- and the full
      ;; dance is three syncs of two files per poll, which under one
      ;; global stream guard was most of what the twelve-worker
      ;; choreography did with its time. The record itself is freed here,
      ;; exactly as rollback frees its own -- without that, every poll
      ;; left a 64-byte record behind that only the next startup's spent
      ;; sweep would take, and the transactions table grew by the poll
      ;; count of every run. No sync: a crash resurrects an open record
      ;; that licenses nothing, which startup treats as the no-op it is.
      ;; NOT a record reuse across begins -- the Transaction is
      ;; thread-local and outlives the Memory, so a kept pointer would
      ;; dangle into the previous store after a close and reopen.
      (if (== (-> t ctx_head) nil)
          (block
            (block
              (letin* ((streams (Streams m)))
                (if (!= ($ (-> t pointer) hash_key) nil)
                    (free_pointer m (aof (-> t pointer))))
                (set (-> t pointer) (pointer_null))
                (cast void 0)))
            (transaction_retire (-> t id))
            (transaction_reset t)
            (return)))
      ;; scoped: reset() below can wait on the SERIALIZABLE gate and must
      ;; not hold the streams while it does
      (let ((time_t settled . #'(cast time_t 0)))
      (block
        (letin* ((streams (Streams m)))
          ;; ONE stamp for the whole transaction
          (let ((time_t commit_time . #'(version_time)))
            (set settled commit_time)
            ;; the intention, on disk before any control block moves
            (write_transaction m (-> t id) commit_time)
            (sync_disk m)
            ;; that sync made every log run written so far durable, the
            ;; merges' outputs among them: the runs they replace may go
            (log_after_sync m)
            ;; then the control blocks it licenses
            (let ((TxnEntry * e . #'(-> t ctx_head)))
              (while (!= e nil)
                (commit_pointer m (aof (-> e ptr)) commit_time)
                (set e (-> e next))))
            ;; and only then the successor stamps -- a SECOND pass, because
            ;; the stamp lands in a field commit_pointer zeroes. The stack
            ;; is FIFO so a pair's old version settles before its new one,
            ;; but a row updated twice in one transaction would have a
            ;; later flip erase an earlier stamp; reading the SETTLED
            ;; states after every flip has landed is unambiguous.
            (let ((TxnEntry * e . #'(-> t ctx_head)))
              (while (!= e nil)
                (stamp_successor m (aof (-> e ptr)))
                (set e (-> e next))))
            (transaction_context_clear t)
            (sync_disk m)
            ;; only then is the intention retired
            (write_transaction m (-> t id) (cast time_t 0))
            (sync_disk m))))
      ;; THE RECORD POINTER IS SPENT WITH THE TRANSACTION -- only the
      ;; read-only path nulled it, so after a writing commit the next
      ;; begin CONTINUED a committed-out transaction: its stages carried
      ;; a retired id and the lazy breaker ate live work. The record
      ;; chunk itself stays for the startup sweep, exactly as before.
      (set (-> t pointer) (pointer_null))
      ;; retired from the live registry only now, with every lock
      ;; already cleared: a waiter still seeing this id on a lock must
      ;; find it live, or it would break a commit mid-flight
      (transaction_retire (-> t id))
      (transaction_reset t)
      (info! (fprintf stderr "mvccs[t%04zx] commit: txn %zu stamped %lld\n"
                      (bitand (cast size_t (pthread_self)) 65535)
                      (cast size_t (-> t id)) (cast llong settled)))
      ;; AND ONLY NOW DOES THE COMMIT WAIT FOR REAL TIME TO REACH THE STAMP
      ;; IT WROTE. The wait belongs LAST, after everything this transaction
      ;; was holding is given back: the streams went with the block above,
      ;; the live id with transaction_retire, and the SERIALIZABLE slot with
      ;; transaction_reset -- which is a semaphore of ONE whose waiters poll
      ;; at ten milliseconds, so a committer sleeping while still holding it
      ;; would put its whole wait, rounded up to a poll, on every other
      ;; writer. It was placed before these three when it was written and
      ;; that was wrong; a wait that holds anything is a wait somebody else
      ;; pays for. What it waits for is in clock_settle.
      (clock_settle settled))))

  (func rollback_transaction ((Memory * m)) (out void)
    (dba_watch0 m "Rollback Transaction")
    ;; the rows are going; their queued index entries never reach the tree
    (idx_pending_discard)
    (let ((Transaction * t . #'(txn))
          (int staged . 0))
      ;; read BEFORE the context is cleared below
      (if (!= (-> t ctx_head) nil) (set staged 1))
      (block
        (letin* ((streams (Streams m)))
          ;; backwards, and the record freed exactly once
          (let ((TxnEntry * e . #'(-> t ctx_tail)))
            (while (!= e nil)
              (rollback_pointer m (aof (-> e ptr)))
              (set e (-> e prev))))
          (transaction_context_clear t)
          (if (!= ($ (-> t pointer) hash_key) nil)
              (free_pointer m (aof (-> t pointer))))
          (set (-> t pointer) (pointer_null))
          ;; A ROLLBACK THAT UNDID NOTHING HAS NOTHING TO MAKE DURABLE, and
          ;; this sync was unconditional where commit_transaction's is not.
          ;; The argument is commit's own, written there: a crash resurrects
          ;; an open record that licenses nothing, "which startup treats as
          ;; the no-op it is". The only difference here is that the record is
          ;; being freed rather than kept, and a crash before the free is
          ;; durable leaves exactly that -- an allocated record nobody will
          ;; ever license.
          ;;
          ;; IT IS NOT A NICETY. ziguratip's ConnectionScope rolls back on
          ;; every connection teardown, and its own comment calls that "a
          ;; no-op on the clean path" -- a no-op in WORK, and two fsyncs in
          ;; COST, on every connection of the binary protocol.
          ;; ZiguratIP#37 measured the result from the outside: half to four
          ;; fifths of requests carrying an exclusive hold over a
          ;; millisecond, median ~1.2ms, and the hold surviving every other
          ;; explanation either of us offered.
          ;;
          ;; A rollback that DID undo staged rows still syncs: those control
          ;; blocks moved, and what a crash owes them is a longer argument
          ;; than this one.
          (if (== staged 1)
              (sync_disk m))))
      ;; a rolled back transaction is as over as a committed one, and
      ;; retired the same way, after its locks are gone
      (transaction_retire (-> t id))
      (transaction_reset t)))

  ;; the partial rollback the repeatable-read retry uses
  (func rollback_transaction_to ((Memory * m) (time_t at)) (out void)
    (dba_watch0 m "Rollback Transaction to")
    ;; the queued entries of the rows this undoes go with them
    (idx_pending_drop_from at)
    (letin* ((streams (Streams m)))
      (let ((Transaction * t . #'(txn))
            (TxnEntry * e . #'(-> t ctx_tail)))
        (while (and (!= e nil) (>= (-> e at) at))
          (rollback_pointer m (aof (-> e ptr)))
          (let ((TxnEntry * dead . e))
            (set e (-> e prev))
            (if (== e nil)
                (set (-> t ctx_head) nil)
              (set (-> e next) nil))
            (set (-> t ctx_tail) e)
            (delete* dead))))
      ((-> (-> m hexmap_io) flush))
      ((-> (-> m data_io) flush))
      (cast void 0)))

  ;; ==================================================================
  ;; Visibility
  ;; ==================================================================
  (func snapshot_time ((Memory * m)) (out time_t)
    (cast void m)
    (let ((Transaction * t . #'(txn)))
      (if (!= (-> t query_time) (cast time_t 0))
          (return (-> t query_time)))
      (return (version_time))))

  (func alive_at ((const Control * c) (time_t at)) (out bool)
    ;; never committed: nothing here anybody else may see
    (if (== (-> c offline_state) ROW_NONE) (return #f))
    ;; flagged dead at rollback without ever being born: create_time 0 with
    ;; a death state is rollback_pointer's never-committed shape from before
    ;; it stamped the birth too. Nobody may see it at any time.
    (if (and (== (-> c create_time) (cast time_t 0))
             (or (== (-> c offline_state) ROW_DELETED)
                 (== (-> c offline_state) ROW_UPDATED)))
        (return #f))
    ;; born after this read began
    (if (and (!= (-> c create_time) (cast time_t 0)) (> (-> c create_time) at))
        (return #f))
    ;; died at or before it -- but modify_time only MEANS died when the
    ;; state says so (an in-place offline update stamps current rows)
    (if (and (or (== (-> c offline_state) ROW_UPDATED)
                 (== (-> c offline_state) ROW_DELETED))
             (and (!= (-> c modify_time) (cast time_t 0))
                  (<= (-> c modify_time) at)))
        (return #f))
    (return #t))

  ;; the READ COMMITTED reader: answers without waiting for anything
  (func read_committed ((Memory * m) (const Pointer * p) (Control * c)) (out bool)
    (load_control m p c)
    (let ((Transaction * t . #'(txn)))
      (if (and (!= (-> c online_lock) LOCK_NONE)
               (== (-> c transaction_id) (-> t id)))
          (block
            ;; an insert THIS query made is hidden from it
            (if (and (== (-> c online_state) ROW_INSERTED)
                     (and (> (-> t query_time) (cast time_t 0))
                          (== (-> t query_id) (-> c query_id))))
                (return #f))
            ;; superseded or removed by us
            (if (or (== (-> c online_state) ROW_UPDATED)
                    (== (-> c online_state) ROW_DELETED))
                (return #f))
            ;; our own insert from earlier in this transaction
            (if (== (-> c online_state) ROW_INSERTED)
                (return #t)))))
    ;; anybody else's staged work is invisible; what is left is what was
    ;; committed here as of when this read began
    (return (alive_at c (snapshot_time m))))

  ;; the writer's wait -- bounded, streams handed back while sleeping
  (func check_lock ((Memory * m) (int lock_mask) (const Pointer * p)
                    (Control * c) (Streams * streams)) (out bool)
    (dba_watch1 m "Check Lock" (-> p address))
    (let ((bool do_read . #t)
          (int waited_ms . 0)
          (bool looping . #t))
      (while looping
        (load_control m p c)
        (if (!= streams nil) ((-> streams unlock)))

        (if (!= (bitand (cast int (-> c online_lock)) lock_mask) 0)
            ;; the pointer is locked
            (if (== (-> c transaction_id) (-> tl_txn id))
                ;; by this transaction itself
                (block
                  (if (and (== (-> c online_state) ROW_INSERTED)
                           (and (> (-> tl_txn query_time) (cast time_t 0))
                                (== (-> tl_txn query_id) (-> c query_id))))
                      (set do_read #f)
                    (if (or (== (-> c online_state) ROW_UPDATED)
                            (== (-> c online_state) ROW_DELETED))
                        (set do_read #f)))
                  (set looping #f))
              ;; by somebody else
              (if (and (== (-> c online_state) ROW_INSERTED)
                       (> (-> c reference_address) -1))
                  (block
                    (set do_read #f)
                    (set looping #f))
                (block
                  ;; A LOCK WHOSE TRANSACTION IS DEAD IS DEBRIS, NOT
                  ;; CONTENTION. A crashed client or an abandoned pool
                  ;; slot leaves its staged lock on disk with nothing
                  ;; left to commit or roll it back; only a restart's
                  ;; recovery would sweep it, and until then every
                  ;; waiter burned its whole timeout on a corpse. So
                  ;; recovery is executed lazily, here, on contact:
                  ;; roll the one pointer back exactly as startup
                  ;; would and look at the row again.
                  (if (and (-> m initialized)
                           (not (transaction_live (-> c transaction_id))))
                      (block
                        (if (!= streams nil) ((-> streams lock)))
                        (dba_watch1 m "Break Stale Lock" (-> p address))
                        (rollback_pointer_apply m p)
                        continue))
                  ;; two sessions can each hold what the other wants: give up
                  ;; rather than spin forever
                  (if (and (> lock_wait_timeout_ms 0)
                           (>= waited_ms lock_wait_timeout_ms))
                      (block
                        (if (!= streams nil) ((-> streams lock)))
                        (throw* (MemoryException "lock wait timeout"))))
                  (usleep 10000)
                  (set waited_ms (+ waited_ms 10))
                  (if (!= streams nil) ((-> streams lock))))))
          (set looping #f)))    ;; no lock: proceed

      (if (!= streams nil) ((-> streams lock)))

      ;; the wait ended by commit or by rollback; only a landed row is
      ;; readable -- anything else would be a dirty read
      (if (and do_read
               (and (== (-> c online_lock) LOCK_NONE)
                    (and (== (-> c online_state) ROW_NONE)
                         (and (!= (-> c offline_state) ROW_INSERTED)
                              (!= (-> c offline_state) ROW_UPDATED)))))
          (set do_read #f))
      (return do_read)))

  ;; whether ONE record is visible to the transaction now running -- the
  ;; index's question. Under SNAPSHOT the pointer may be moved to an older
  ;; version, exactly as the cursor moves it.
  (func visible ((Memory * m) (Pointer * p) (Streams * streams)) (out bool)
    (let ((uint8_t hex_byte . 0)
          (RowState online_state . ROW_NONE)
          (RowLock online_lock . LOCK_NONE)
          (RowState offline_state . ROW_NONE)
          (Control control)
          (bool is_visible . #f)
          (bool settled . #f)
          (IsolationLevel level . READ_UNCOMMITTED))
      (control_clear (aof control))

      ;; THE PER-THREAD READER, NEVER THE CANONICAL STREAM. Shared-mode
      ;; readers run concurrently by design, and this seek-then-read on
      ;; `m->hexmap_io' was the one read in the visibility path that
      ;; bypassed hex_in: two readers interleaving here answered each
      ;; other's byte, and a row's state was judged from the wrong
      ;; address. Measured by contention_test's `rewrite vs index': a row
      ;; vanishing from an index it was never absent from, and a writer
      ;; refused by its own unique key after reading a garbled row.
      (let ((binarystream * vhio . #'(hex_in m)))
        (if (not ((-> vhio good))) ((-> vhio clear)))
        ((-> vhio seekg) (addr_hexmap (-> p address)) std::ios::beg)
        ((-> vhio read_std_ubyte) hex_byte)
        (set online_state (cast RowState (bitand hex_byte 12)))
        (set online_lock (cast RowLock (bitand hex_byte 3)))
        ((-> vhio read_std_ubyte) hex_byte)
        (set offline_state (cast RowState (bitand hex_byte 12))))

      (if (-> m initialized) (set level (-> tl_txn isolation_level)))

      (cond
        ((== level READ_UNCOMMITTED)
         (if (or (and (== offline_state ROW_NONE) (== online_state ROW_INSERTED))
                 (and (== offline_state ROW_INSERTED) (== online_state ROW_NONE)))
             (set is_visible #t)))

        ((== level READ_COMMITTED)
         ;; every address that holds anything at all -- the hexmap cannot
         ;; tell whether a superseded version is still the one to show
         (if (or (!= offline_state ROW_NONE) (!= online_state ROW_NONE))
             (set is_visible (read_committed m p (aof control)))))

        ((or (== level REPEATABLE_READ) (== level SERIALIZABLE))
         ;; a read WRITES: it takes a shared row lock, or waits
         (if (or (and (== offline_state ROW_NONE) (!= online_state ROW_NONE))
                 (== offline_state ROW_INSERTED))
             (if (== online_lock LOCK_NONE)
                 (block
                   ;; a stamp is a stage too, begun BEFORE the control is
                   ;; written or it would carry the retired id
                   (stage_needs_transaction m)
                   (load_control m p (aof control))
                   (set ($ control online_state) ROW_NONE)
                   (set ($ control online_lock) LOCK_SHARED)
                   (set ($ control online_time) (version_time))
                   (set ($ control transaction_id) (-> tl_txn id))
                   (set ($ control query_id) (-> tl_txn query_id))
                   (dump_control m p (aof control))
                   (transaction_push m p)
                   (set is_visible #t))
               (set is_visible
                    (check_lock m (bitor (cast int LOCK_EXCLUSIVE) (cast int LOCK_SHARED))
                                p (aof control) streams)))))

        ((== level SNAPSHOT)
         ;; follow the version chain back to the version alive at init_time
         (if (or (and (== offline_state ROW_NONE) (!= online_state ROW_NONE))
                 (or (== offline_state ROW_INSERTED) (== offline_state ROW_DELETED)))
             (while (not settled)
               (load_control m p (aof control))

               (if (and (> ($ control transaction_id) 0)
                        (== (-> tl_txn id) ($ control transaction_id)))
                   (block
                     (set is_visible (== ($ control online_state) ROW_INSERTED))
                     (set settled #t))
                 (cond
                   ((== ($ control offline_state) ROW_NONE)
                    (set settled #t))

                   ((or (== ($ control offline_state) ROW_INSERTED)
                        (== ($ control offline_state) ROW_UPDATED))
                    (if (<= ($ control create_time) (-> tl_txn init_time))
                        (block (set is_visible #t) (set settled #t))
                      (if (> ($ control reference_address) -1)
                          (set (cof p) (pointer_at m (-> p hash_key)
                                                   ($ control reference_address)))
                        (set settled #t))))

                   ((== ($ control offline_state) ROW_DELETED)
                    ;; deleted after my snapshot is visible only if it was
                    ;; also BORN by then
                    (if (and (> ($ control modify_time) (-> tl_txn init_time))
                             (and (!= ($ control create_time) (cast time_t 0))
                                  (<= ($ control create_time) (-> tl_txn init_time))))
                        (block (set is_visible #t) (set settled #t))
                      (if (> ($ control reference_address) -1)
                          (set (cof p) (pointer_at m (-> p hash_key)
                                                   ($ control reference_address)))
                        (set settled #t))))

                   (#t (throw* (MemoryException "invalid row state"))))))))

        (#t (throw* (MemoryException "invalid isolation level"))))

      (return is_visible)))

  ;; ==================================================================
  ;; THE LAST INSERTED VERSION, FROM THE FIRST -- the reader's half of
  ;; stamp_successor. Given a pointer to ANY version of a row -- in
  ;; practice the FIRST, because that is the one the page scan meets and
  ;; the one an old hand-kept Pointer names -- follow the committed
  ;; successor stamps forward until they end, leaving P on the newest
  ;; version the stamps can prove. Each hop is two control reads instead
  ;; of a full-record visit, and the growing history in between is never
  ;; touched.
  ;;
  ;; WHAT THE WALK PROVES, HOP BY HOP: the stamp names an address that
  ;; still resolves, and the control AT that address points back at the
  ;; version being left (reference_address == here). An old store whose
  ;; query_id holds a real query id, a hint erased by rollback, a
  ;; predecessor freed by TRUNCATE -- every failure mode ends the walk
  ;; where it stands, and the caller is no worse off than before the
  ;; walk began.
  ;;
  ;; WHERE IT ENDS IS NOT YET AN ANSWER. The final version still goes
  ;; through visible() under the caller's own isolation level, exactly
  ;; as a scanned one would -- and because stamps are written only at
  ;; commit, the walk cannot overshoot onto another transaction's staged
  ;; version: the newest STAMPED version is the newest COMMITTED one.
  ;; Under SNAPSHOT, visible() then walks reference_address BACKWARD
  ;; from here to the version alive at init_time -- the two directions
  ;; compose, which is the point of them sharing a chain.
  ;;
  ;; Brent's cycle check, as in bt_walk_values: a torn stamp loop must
  ;; end the walk, not hang the reader.
  (func row_latest ((Memory * m) (Pointer * p)) (out int64_t)
    (let ((int64_t hops . 0)
          (int64_t brent_mark . -2)
          (int64_t brent_steps . 0)
          (int64_t brent_limit . 2)
          (bool walking . #t))
      (while walking
        (set walking #f)
        (let ((Control control))
          (control_clear (aof control))
          (load_control m p (aof control))
          ;; a stamp only means an address on a SETTLED superseded version
          (if (and (== ($ control online_state) ROW_NONE)
                   (and (== ($ control online_lock) LOCK_NONE)
                        (and (== ($ control offline_state) ROW_UPDATED)
                             (and (== ($ control transaction_id) (cast size_t 0))
                                  (> ($ control query_id) 0)))))
              (let ((int64_t succ . #'($ control query_id)))
                (if (and (!= succ (-> p address))
                         (chain_resolves m succ))
                    (let ((Pointer sp . #'(pointer_at m (-> p hash_key) succ))
                          (Control sc))
                      (control_clear (aof sc))
                      (load_control m (aof sp) (aof sc))
                      ;; the proof: a true successor points back at us
                      (if (== ($ sc reference_address) (-> p address))
                          (block
                            (if (== succ brent_mark) (return hops))
                            (set brent_steps (+ brent_steps 1))
                            (if (== brent_steps brent_limit)
                                (block
                                  (set brent_mark succ)
                                  (set brent_steps 0)
                                  (set brent_limit (* brent_limit 2))))
                            (set (cof p) sp)
                            (set hops (+ hops 1))
                            (set walking #t)))))))))
      (return hops)))

  ;; ==================================================================
  ;; The cursor -- one hash key's records, page by page, chunk by chunk,
  ;; each judged by the isolation rules, the streams handed back around
  ;; every callback. Recursive: the repeatable-read retry re-walks.
  ;; ==================================================================
  (thread-local) (var uint8_t tl_cursor_id . 0)

  ;; PAGE ENTRIES THIS THREAD'S CURSORS HAVE STEPPED OVER, EVER. Monotonic
  ;; and thread-local, so it costs one increment per entry a walk reads and
  ;; no cursor ever waits on another to keep it. It exists because it is
  ;; the one number that says whether a cursor is reading ITS KEY'S pages
  ;; or the whole store's -- mvccs.cicili takes a difference across a
  ;; single sequence draw and refuses a walk longer than the store has
  ;; pages, where a stopwatch could only have said that a store got slower
  ;; and never why.
  (thread-local) (var int64_t tl_cursor_steps . 0)

  (func mvccs_cursor_steps () (out int64_t) (return tl_cursor_steps))

  ;; One seek and one read bring a page's whole hexmap slice into BUF, and
  ;; the walk parses it from memory. What this replaces was the walk's cost:
  ;; an absolute seek and byte-at-a-time reads PER RECORD through a buffered
  ;; stream whose buffer every seek throws away -- twelve polling workers
  ;; measured 21 of their 34 seconds inside the kernel re-reading the same
  ;; page's bytes under the one stream guard. The buffer is re-read wherever
  ;; the walk let go of the streams (the callback, a lock wait), because in
  ;; that window another thread may have written ahead of the scan.
  (func cursor_page_hexmap ((Memory * m) (int64_t page_address) (uint8_t * buf)) (out void)
    (if (> (-> m hbpp) 4096)
        (throw* (MemoryException "page too large for the cursor's hexmap buffer")))
    (let ((binarystream * hio . #'(hex_in m)))
      ((-> hio seekg) (addr_hexmap page_address) std::ios::beg)
      ((-> hio read) (cast (char *) buf) (-> m hbpp))
      (if (not ((-> hio good)))
          (block
            ((-> hio clear))
            (throw* (MemoryException "hexmap ends inside the page"))))))

  (decl) (func cursor_walk ((Memory * m) (const uint8_t * hash_key) (Streams * streams)
                            (void * ctx)
                            (func callback ((void * c) (Pointer * p)) (out bool)))
         (out void))

  (func cursor_walk ((Memory * m) (const uint8_t * hash_key) (Streams * streams)
                     (void * ctx)
                     (func callback ((void * c) (Pointer * p)) (out bool)))
        (out void)
    (dba_watch0 m "Cursor")
    (set tl_cursor_id (+ tl_cursor_id 1))
    (if (>= tl_cursor_id MAX_CURSOR_COUNT)
        (throw* (MemoryException "maximum cursor count")))

    ;; where this scan's view of the store is fixed
    (letin* ((statement (Statement m)))

      ;; THE PAGE LIST IS COPIED BEFORE IT IS WALKED -- the lesson the
      ;; original learnt the hard way, kept here: entries snapshotted
      ;; under the lock, walked without it, because the callback is free
      ;; to allocate pages.
      ;;
      ;; AND RE-COPIED UNTIL NOTHING NEW APPEARS. The walk lets the
      ;; streams go around every callback, and in that window a writer
      ;; can commit a row into a page the snapshot never saw -- fresh
      ;; from the allocator, or a __FREE__ page rekeyed to this table.
      ;; A walk that ended on the stale snapshot then answered "no such
      ;; row" about a row that was committed before it finished, and
      ;; machine_open, told exactly that, inserted a TWIN of a machine
      ;; that existed -- the twelve workers then bounced saves and
      ;; loads between the twins forever. So the walk repeats over
      ;; whatever pages appeared, until a pass adds none.
      ;;
      ;; AND NO PAGE IS LEFT UNWALKED. The snapshot used to live in fixed
      ;; arrays -- 512 entries a round, 1024 walked in all -- and a table
      ;; past 1024 pages (8 MB at the default page) was silently walked
      ;; only that far: every full scan answered a prefix of the table,
      ;; and the index REBUILD at TRUNCATE, which walks the table this
      ;; way, mapped a prefix and dropped the rest -- a base of 377
      ;; predicates lost hex_direction/2's first clause at one vacuum
      ;; and the whole predicate at the next, the vacuum's own live count
      ;; drifting with it. The arrays are the list's size now, and the
      ;; walked set is a byte per page number, grown as pages appear.
      (let ((uint8_t * walked . nil)
            (int64_t walked_cap . 0)
            (int walk_done . 0)
            (int rounds . 0))
       (while (and (== walk_done 0) (< rounds 16))
        (set rounds (+ rounds 1))
        (let ((int64_t page_total . 0)
              (int64_t page_cap . 1)
              (const uint8_t ** page_keys . nil)
              (int64_t * page_addrs . nil))
        (pthread_mutex_lock (aof (-> m page_list_access)))
        ;; THIS KEY'S CHAIN, not the store's list: the count and the
        ;; snapshot are both the size of the table, not of everything
        ;; ever written -- see "The page list and the free list"
        (let ((PageEntry * e . #'(page_chain m hash_key)))
          (while (!= e nil)
            (set page_cap (+ page_cap 1))
            (set tl_cursor_steps (+ tl_cursor_steps 1))
            (set e (-> e key_next))))
        (set page_keys (cast (const uint8_t **)
                             (calloc (cast size_t page_cap) (sizeof size_t))))   ;; a pointer's size: sizeof takes one token
        (set page_addrs (cast (int64_t *) (calloc (cast size_t page_cap) (sizeof int64_t))))
        (let ((PageEntry * e . #'(page_chain m hash_key)))
          (while (!= e nil)
            (if (== (memcmp (-> e key) hash_key (cast size_t HASHKEY_SIZE)) 0)
                (let ((int64_t pn . #'(/ (-> e address) (-> m page_size))))
                  (if (>= pn walked_cap)
                      (let ((int64_t ncap . #'(* 2 (+ pn 1024)))
                            (uint8_t * grown . #'(cast (uint8_t *) (calloc (cast size_t ncap) 1))))
                        (if (!= walked nil)
                            (block
                              (memcpy (cast (void *) grown) (cast (void *) walked)
                                      (cast size_t walked_cap))
                              (free (cast (void *) walked))))
                        (set walked grown)
                        (set walked_cap ncap)))
                  (if (== (nth pn walked) 0)
                      (block
                        (set (nth page_total page_keys) (-> e key))
                        (set (nth page_total page_addrs) (-> e address))
                        (set page_total (+ page_total 1))))))
            (set tl_cursor_steps (+ tl_cursor_steps 1))
            (set e (-> e key_next))))
        (pthread_mutex_unlock (aof (-> m page_list_access)))

        (if (== page_total 0) (set walk_done 1))
        ;; marked walked before the walk, as before: a page that appears
        ;; during it is the next round's
        (let ((int64_t pt . 0))
          (while (< pt page_total)
            (set (nth (/ (nth pt page_addrs) (-> m page_size)) walked) 1)
            (set pt (+ pt 1))))

        (let ((int64_t page_n . 0))
          (while (< page_n page_total)
            (let ((const uint8_t * page_hashkey . #'(nth page_n page_keys))
                  (int64_t page_address . #'(nth page_n page_addrs))
                  (int64_t i . PAGEFILE_CONTROL_COUNT)
                  (uint8_t hexbuf [4096])
                  (bool page_stale . #f))
              (cursor_page_hexmap m page_address hexbuf)

              (while (< i (-> m hbpp))
                (let ((int64_t hexmap_address . #'(+ (addr_hexmap page_address) i))
                      (int64_t pointer_address . 0)
                      (uint8_t hex_byte . 0)
                      (RowState online_state . ROW_NONE)
                      (RowState offline_state . ROW_NONE)
                      (RowLock online_lock . LOCK_NONE)
                      (Control control))
                  (control_clear (aof control))
                  (set pointer_address (* hexmap_address CHUNK_SIZE))

                  ;; FREE OR RECORD IS DECIDED FROM THE FIRST HEXMAP BYTE --
                  ;; the startup walk's own rule, which this walk never had:
                  ;; a free hole inside the page (the tail an allocation's
                  ;; split leaves, the span a reclaim freed) is not a record,
                  ;; and consuming its bytes as a control block read every
                  ;; record after it one phase out of step -- live rows a
                  ;; page held that no cursor, no rebuild and no reclaim
                  ;; could see, which is a base losing single clauses at
                  ;; every vacuum. A record's first chunk always carries the
                  ;; high bit; a free chunk never does. One byte decides.
                  (set hex_byte (nth i hexbuf))
                  (if (== (bitand hex_byte 128) 0)
                      (block
                        (set i (+ i 1))
                        continue))
                  (set online_state (cast RowState (bitand hex_byte 12)))
                  (set online_lock (cast RowLock (bitand hex_byte 3)))
                  (set hex_byte (nth (+ i 1) hexbuf))
                  (set offline_state (cast RowState (bitand hex_byte 12)))

                  (set i (+ i CONTROL_COUNT))
                  (let ((int64_t pointer_size . 0)
                        (bool at_end . #f))
                    (while (and (not at_end) (< i (-> m hbpp)))
                      (set hex_byte (nth i hexbuf))
                      (set i (+ i 1))

                      (if (and (!= hex_byte CONTROL_STANDALONE_CHUNK)
                               (== (bitand hex_byte 64) 64))
                          ;; the record's last chunk
                          (block
                            (set at_end #t)
                            (if (and (!= hex_byte CONTROL_CHUNK)
                                     (== (bitand hex_byte 128) 128))
                                ;; and it is data: judge the record
                                (block
                                  (set pointer_size (+ pointer_size (size_remainder hex_byte)))
                                  (let ((Pointer pointer . #'(pointer_make page_hashkey pointer_address pointer_size))
                                        (bool do_callback . #f)
                                        (bool break_while . #f)
                                        (IsolationLevel level . READ_UNCOMMITTED))
                                    (if (-> m initialized)
                                        (set level (-> tl_txn isolation_level)))

                                    (cond
                                      ((== level READ_UNCOMMITTED)
                                       (if (or (and (== offline_state ROW_NONE) (== online_state ROW_INSERTED))
                                               (and (== offline_state ROW_INSERTED) (== online_state ROW_NONE)))
                                           (set do_callback #t)))

                                      ((== level READ_COMMITTED)
                                       (if (or (!= offline_state ROW_NONE) (!= online_state ROW_NONE))
                                           (set do_callback (read_committed m (aof pointer) (aof control)))))

                                      ((or (== level REPEATABLE_READ) (== level SERIALIZABLE))
                                       (if (or (and (== offline_state ROW_NONE) (!= online_state ROW_NONE))
                                               (== offline_state ROW_INSERTED))
                                           (block
                                             ;; a stamp is a stage too -- see
                                             ;; stage_needs_transaction
                                             (stage_needs_transaction m)
                                             (load_control m (aof pointer) (aof control))
                                             (if (== online_lock LOCK_NONE)
                                                 (block
                                                   (set ($ control online_state) ROW_NONE)
                                                   (set ($ control online_lock) LOCK_SHARED)
                                                   (set ($ control online_time) (version_time))
                                                   (set ($ control transaction_id) (-> tl_txn id))
                                                   (set ($ control query_id) (-> tl_txn query_id))
                                                   (dump_control m (aof pointer) (aof control))
                                                   (transaction_push m (aof pointer))
                                                   (set do_callback #t))
                                               (block
                                                 ;; check_lock lets the streams go while it waits
                                                 (set page_stale #t)
                                                 (set do_callback
                                                      (check_lock m (bitor (cast int LOCK_EXCLUSIVE) (cast int LOCK_SHARED))
                                                                  (aof pointer) (aof control) streams))
                                                 (if (or (and (not do_callback)
                                                              (and (> ($ control transaction_id) 0)
                                                                   (!= ($ control transaction_id) (-> tl_txn id))))
                                                         (and do_callback
                                                              (> ($ control create_time) (-> tl_txn query_time))))
                                                     ;; the row changed under a repeatable read: roll back
                                                     ;; to the statement's start and walk again
                                                     (block
                                                       (if (!= streams nil) ((-> streams unlock)))
                                                       (rollback_transaction_to m (-> tl_txn query_time))
                                                       (usleep 10000)
                                                       (if (!= streams nil) ((-> streams lock)))
                                                       (set tl_cursor_id (- tl_cursor_id 1))
                                                       (cursor_walk m hash_key streams ctx callback)
                                                       (return))))))))

                                      ((== level SNAPSHOT)
                                       (if (or (and (== offline_state ROW_NONE) (!= online_state ROW_NONE))
                                               (or (== offline_state ROW_INSERTED) (== offline_state ROW_DELETED)))
                                           (while (not break_while)
                                             (load_control m (aof pointer) (aof control))
                                             (if (and (> ($ control transaction_id) 0)
                                                      (== (-> tl_txn id) ($ control transaction_id)))
                                                 (block
                                                   (set do_callback (== ($ control online_state) ROW_INSERTED))
                                                   (set break_while #t))
                                               (cond
                                                 ((== ($ control offline_state) ROW_NONE)
                                                  (set break_while #t))
                                                 ((or (== ($ control offline_state) ROW_INSERTED)
                                                      (== ($ control offline_state) ROW_UPDATED))
                                                  (if (<= ($ control create_time) (-> tl_txn init_time))
                                                      (block (set do_callback #t) (set break_while #t))
                                                    (if (> ($ control reference_address) -1)
                                                        (set pointer (pointer_at m hash_key ($ control reference_address)))
                                                      (set break_while #t))))
                                                 ((== ($ control offline_state) ROW_DELETED)
                                                  ;; deleted after my snapshot is visible only if
                                                  ;; it was also BORN by then
                                                  (if (and (> ($ control modify_time) (-> tl_txn init_time))
                                                           (and (!= ($ control create_time) (cast time_t 0))
                                                                (<= ($ control create_time) (-> tl_txn init_time))))
                                                      (block (set do_callback #t) (set break_while #t))
                                                    (if (> ($ control reference_address) -1)
                                                        (set pointer (pointer_at m hash_key ($ control reference_address)))
                                                      (set break_while #t))))
                                                 (#t (throw* (MemoryException "invalid row state"))))))))

                                      (#t (throw* (MemoryException "invalid isolation level"))))

                                    (if do_callback
                                        (block
                                          ;; the streams go back before the caller's
                                          ;; callback: it is procedure code, and the
                                          ;; ordinary thing for it to do is update the
                                          ;; row it was handed. Reads inside the
                                          ;; window go through the thread's private
                                          ;; reader -- see bt_output_vcb for the
                                          ;; measurement behind the flag.
                                          (let ((int old_rm . tl_window_reads)
                                                (int flip . #'(? (and (!= streams nil)
                                                                      (== 1 (reader_eligible m)))
                                                               1 0)))
                                            ;; the window, and whether its reads
                                            ;; go private: flip 0 with the guard
                                            ;; released is the state #33 raced in
                                            (debug! (fprintf stderr
                                                     "mvccs[t%04zx] cursor window: release=%d flip=%d\n"
                                                     (bitand (cast size_t (pthread_self)) 65535)
                                                     (? (!= streams nil) 1 0) flip))
                                            (if (!= streams nil) ((-> streams unlock)))
                                            (if (== flip 1) (set tl_window_reads 1))
                                            (if (not (callback ctx (aof pointer)))
                                                (set i (-> m hbpp)))
                                            (if (== flip 1) (set tl_window_reads old_rm))
                                            (if (!= streams nil) ((-> streams lock))))
                                          (set page_stale #t)))
                                    (if (and page_stale (< i (-> m hbpp)))
                                        (block
                                          (cursor_page_hexmap m page_address hexbuf)
                                          (set page_stale #f)))))))
                        ;; not the last chunk yet
                        (set pointer_size (+ pointer_size CHUNK_SIZE)))))))
              (set page_n (+ page_n 1)))))
          (free (cast (void *) page_keys))
          (free (cast (void *) page_addrs))))
        (if (!= walked nil) (free (cast (void *) walked)))))

    (set tl_cursor_id (- tl_cursor_id 1)))

  ;; read one row's bytes into OBJ (which carries its Pointer), under a
  ;; guard of its own -- the cursor has handed the streams back by the
  ;; time anything calls this
  ;; A READ TAKES THE GUARD FOR ITSELF -- ZiguratIP#33, and in master
  ;; since 55896d9. (This block said "EXPERIMENT -- not master" for two
  ;; commits after it stopped being one.)
  ;;
  ;; The seek and the unpack below are two operations on ONE stream with one
  ;; position, and read_row held nothing while it made them. Inside a
  ;; cursor's callback window that is a race: both cursors release the
  ;; streams guard around the callback unconditionally, but only redirect
  ;; the window's reads to the thread's private stream when
  ;; reader_eligible, which answers 0 on ANY ONE of its conditions -- an
  ;; uninitialised store, an unset reader path, no open transaction, or a
  ;; level of REPEATABLE READ or SERIALIZABLE (four early returns, line
  ;; 873). EITHER, NOT BOTH: contention_test calls memory_reader_paths in
  ;; its own main like everybody else, so what made find_then_update
  ;; ineligible was its SERIALIZABLE claim ALONE. Its callback reads ride
  ;; the canonical stream with nothing held, while seven other threads
  ;; seek that same stream.
  ;;
  ;; That fits #33's evidence exactly -- a row written back with an EMPTY
  ;; STRING, which is what an unpack reads when another thread moved the
  ;; position between the seek and the length byte; the row then never heals
  ;; because the update copies KIND from what it read. It is also why only
  ;; contention_test sees it: cocolog and the server read at READ COMMITTED,
  ;; and nothing they run claims at a level that forfeits a private stream.
  ;;
  ;; THIS COMMENT AND e8ada3f'S MESSAGE BOTH SAID THE FAULT NEEDED BOTH
  ;; HALVES -- no reader paths AND the level. A downstream session checked
  ;; the call rather than taking it on trust, and it is wrong. The fix and
  ;; its mechanism are untouched; the true claim is narrower than the one
  ;; it replaces.
  ;;
  ;; The guard is re-entrant per thread, so a caller that already holds it
  ;; pays nothing, and it is taken SHARED wherever a shared one is possible
  ;; -- which sends the read to the thread's private stream and keeps the
  ;; parallel-read design exactly as concurrent as it was. Only the case
  ;; that has no private stream to use takes the exclusive guard, and that
  ;; case is the one racing today. If this is the fault, 80 runs come back
  ;; clean.
  (func read_row ((Memory * m) (BaseTable * obj)) (out void)
    (dba_watch1 m "Read Row" ($ (-> obj pointer) address))
    ;; WHICH STREAM, AND WHAT WAS HELD. #33 was a read on the canonical
    ;; stream holding nothing, inside a window where another thread could
    ;; move its position; this line says both, per read, for every thread.
    (debug! (fprintf stderr "mvccs[t%04zx] read %lld  held=%d shared=%d window=%d eligible=%d\n"
                     (bitand (cast size_t (pthread_self)) 65535)
                     (cast llong ($ (-> obj pointer) address))
                     (? (!= tl_streams_held nil) 1 0) tl_read_mode tl_window_reads
                     (reader_eligible m)))
    (if (== 1 (reader_eligible m)) (set tl_want_shared 1))
    (letin* ((streams (Streams m)))
      (let ((binarystream * dio . #'(data_in m)))
        (if (not ((-> dio good))) ((-> dio clear)))
        ((-> dio seekg) (ptr_data (aof (-> obj pointer))) std::ios::beg)
        ((-> obj unpack) (cof dio)))
      (cast void 0)))

  ;; ==================================================================
  ;; ISUD -- the staged writes
  ;; ==================================================================
  (func control_insert ((Memory * m) (BaseTable * obj)) (out void)
    (stage_needs_transaction m)
    (dba_watch1 m "Control Insert" ($ (-> obj pointer) address))
    (let ((Control control))
      (control_clear (aof control))
      (set ($ control online_state) ROW_INSERTED)
      (set ($ control online_lock) LOCK_EXCLUSIVE)
      (set ($ control online_time) (version_time))
      (set ($ control transaction_id) (-> tl_txn id))
      (set ($ control query_id) (-> tl_txn query_id))
      (dump_control m (aof (-> obj pointer)) (aof control))))

  (func control_update ((Memory * m) (BaseTable * old_obj) (BaseTable * new_obj)
                        (Streams * streams)) (out void)
    (stage_needs_transaction m)
    (dba_watch1 m "Control Update" ($ (-> old_obj pointer) address))
    (let ((Control control))
      (control_clear (aof control))
      (if (not (check_lock m (cast int LOCK_EXCLUSIVE) (aof (-> old_obj pointer))
                           (aof control) streams))
          (return))

      (set ($ control online_state) ROW_UPDATED)
      (set ($ control online_lock) LOCK_EXCLUSIVE)
      (set ($ control online_time) (version_time))
      (set ($ control transaction_id) (-> tl_txn id))
      (set ($ control query_id) (-> tl_txn query_id))
      (dump_control m (aof (-> old_obj pointer)) (aof control))

      (control_clear (aof control))
      (set ($ control online_state) ROW_INSERTED)
      (set ($ control online_lock) LOCK_EXCLUSIVE)
      (set ($ control online_time) (version_time))
      (set ($ control transaction_id) (-> tl_txn id))
      (set ($ control query_id) (-> tl_txn query_id))
      (set ($ control reference_address) ($ (-> old_obj pointer) address))
      (dump_control m (aof (-> new_obj pointer)) (aof control))))

  (func control_delete ((Memory * m) (BaseTable * obj) (Streams * streams)) (out void)
    (stage_needs_transaction m)
    (dba_watch1 m "Control Delete" ($ (-> obj pointer) address))
    (let ((Control control))
      (control_clear (aof control))
      (if (not (check_lock m (cast int LOCK_EXCLUSIVE) (aof (-> obj pointer))
                           (aof control) streams))
          (return))
      (set ($ control online_state) ROW_DELETED)
      (set ($ control online_lock) LOCK_EXCLUSIVE)
      (set ($ control online_time) (version_time))
      (set ($ control transaction_id) (-> tl_txn id))
      (set ($ control query_id) (-> tl_txn query_id))
      (dump_control m (aof (-> obj pointer)) (aof control))))

  (func online_insert ((Memory * m) (const uint8_t * hash_key) (BaseTable * obj)) (out void)
    ((-> obj prepare))
    ;; obj->map() below is this row's indexes; their guard nests inside
    ;; this one and does nothing -- the whole reason Streams exists
    (letin* ((streams (Streams m)))
      (set (-> obj pointer) (allocate m hash_key ((-> obj pack_size))))
      (dba_watch1 m "Online Insert" ($ (-> obj pointer) address))
      (transaction_push m (aof (-> obj pointer)))
      (control_insert m obj)
      (full_hexmap m (aof (-> obj pointer)))
      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m data_io) good)))
          ((-> (-> m data_io) clear)))
      ((-> (-> m data_io) seekp) (ptr_data (aof (-> obj pointer))) std::ios::beg)
      ((-> obj pack) (cof (-> m data_io)))
      ;; the row's index entries queue for the commit's bulk map
      (letin* ((defer (DeferScope (idx_defer_enabled))))
        ((-> obj map) (cast (void *) m))
        (cast void 0))
      ((-> (-> m hexmap_io) flush))
      ((-> (-> m data_io) flush))
      (cast void 0)))

  (func online_update ((Memory * m) (const uint8_t * hash_key)
                       (BaseTable * old_obj) (BaseTable * new_obj)) (out void)
    ((-> new_obj prepare))
    (letin* ((streams (Streams m)))
      (set (-> new_obj pointer) (allocate m hash_key ((-> new_obj pack_size))))
      (dba_watch2 m "Online Update" ($ (-> old_obj pointer) address) ($ (-> new_obj pointer) address))
      (transaction_push m (aof (-> old_obj pointer)))
      (transaction_push m (aof (-> new_obj pointer)))
      (control_update m old_obj new_obj (aof streams))
      (full_hexmap m (aof (-> new_obj pointer)))
      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m data_io) good)))
          ((-> (-> m data_io) clear)))
      ((-> (-> m data_io) seekp) (ptr_data (aof (-> new_obj pointer))) std::ios::beg)
      ((-> new_obj pack) (cof (-> m data_io)))
      ((-> old_obj unmap) (cast (void *) m))
      (letin* ((defer (DeferScope (idx_defer_enabled))))
        ((-> new_obj map) (cast (void *) m))
        (cast void 0))
      ((-> (-> m hexmap_io) flush))
      ((-> (-> m data_io) flush))
      (cast void 0)))

  (func online_delete ((Memory * m) (BaseTable * obj)) (out void)
    (dba_watch1 m "Online Delete" ($ (-> obj pointer) address))
    (letin* ((streams (Streams m)))
      (transaction_push m (aof (-> obj pointer)))
      (control_delete m obj (aof streams))
      ((-> obj unmap) (cast (void *) m))
      ((-> (-> m hexmap_io) flush))
      ((-> (-> m data_io) flush))
      (cast void 0)))

  ;; the raw engine writes -- no transaction, no rollback; what indexes
  ;; and sequences use for their own records
  (func offline_insert ((Memory * m) (const uint8_t * hash_key) (BaseTable * obj)) (out void)
    (set (-> obj pointer) (allocate m hash_key ((-> obj pack_size))))
    (dba_watch1 m "Offline Insert" ($ (-> obj pointer) address))
    ;; the address may be a freed record's, and the cache may still hold it
    (bt_cache_forget m ($ (-> obj pointer) address))
    ;; THE DATA LANDS BEFORE THE ALLOCATION IS MARKED. The old order flushed
    ;; the hexmap marking first, so a process that died between the two
    ;; flushes left an ALLOCATED record whose bytes were never written --
    ;; zeros, which for a node decode as a keys head of 0: the torn link
    ;; the C++ twin measured twice. The payload and the control block both
    ;; live in the data file, so they land together under ONE flush before
    ;; the hexmap marking goes durable: a death before the marking leaves
    ;; bytes nothing points at, a death after it a complete record.
    ;; a failed read poisons the stream and every write after it no-ops --
    ;; writes clear first, exactly as the read accessors do
    (if (not ((-> (-> m data_io) good)))
        ((-> (-> m data_io) clear)))
    ((-> (-> m data_io) seekp) (ptr_data (aof (-> obj pointer))) std::ios::beg)
    ((-> obj pack) (cof (-> m data_io)))
    (let ((Control control))
      (control_clear (aof control))
      (set ($ control offline_state) ROW_INSERTED)
      (set ($ control create_time) (version_time))
      (dump_control m (aof (-> obj pointer)) (aof control)))
    ((-> (-> m data_io) flush))
    (full_hexmap m (aof (-> obj pointer)))
    ((-> (-> m hexmap_io) flush)))

  (func offline_update ((Memory * m) (BaseTable * obj)) (out void)
    (dba_watch1 m "Offline Update" ($ (-> obj pointer) address))
    (bt_cache_forget m ($ (-> obj pointer) address))
    (let ((Control control))
      (control_clear (aof control))
      (load_control m (aof (-> obj pointer)) (aof control))
      (set ($ control modify_time) (version_time))
      (dump_control m (aof (-> obj pointer)) (aof control)))
    ;; a failed read poisons the stream and every write after it no-ops --
    ;; writes clear first, exactly as the read accessors do
    (if (not ((-> (-> m data_io) good)))
        ((-> (-> m data_io) clear)))
    ((-> (-> m data_io) seekp) (ptr_data (aof (-> obj pointer))) std::ios::beg)
    ((-> obj pack) (cof (-> m data_io)))
    ((-> (-> m hexmap_io) flush))
    ((-> (-> m data_io) flush)))

  ;; ==================================================================
  ;; TRUNCATE -- the one reclaimer: every settled dead row of one hash
  ;; key, collected in full before anything is freed
  ;; ==================================================================
  (struct DeadList
    (member Pointer ptr)
    (member DeadList * next))

  ;; THE SNAPSHOT IS THE LIST'S SIZE, as the cursor's is now: the fixed
  ;; 512 it had meant a table past 512 pages was reclaimed only that far
  ;; -- a rewrite left its dead rows behind where the vacuum walked no
  ;; further, and the base grew on every pass
  (func dead_pointers ((Memory * m) (const uint8_t * hash_key)) (out DeadList *)
    (let ((DeadList * head . nil)
          (uint8_t hex_byte . 0)
          (int64_t page_total . 0)
          (int64_t page_cap . 1)
          (const uint8_t ** page_keys . nil)
          (int64_t * page_addrs . nil))

      (pthread_mutex_lock (aof (-> m page_list_access)))
      (let ((PageEntry * e . #'(page_chain m hash_key)))
        (while (!= e nil)
          (set page_cap (+ page_cap 1))
          (set e (-> e key_next))))
      (set page_keys (cast (const uint8_t **)
                           (calloc (cast size_t page_cap) (sizeof size_t))))   ;; a pointer's size: sizeof takes one token
      (set page_addrs (cast (int64_t *) (calloc (cast size_t page_cap) (sizeof int64_t))))
      (let ((PageEntry * e . #'(page_chain m hash_key)))
        (while (!= e nil)
          (if (== (memcmp (-> e key) hash_key (cast size_t HASHKEY_SIZE)) 0)
              (block
                (set (nth page_total page_keys) (-> e key))
                (set (nth page_total page_addrs) (-> e address))
                (set page_total (+ page_total 1))))
          (set e (-> e key_next))))
      (pthread_mutex_unlock (aof (-> m page_list_access)))

      (let ((int64_t page_n . 0))
        (while (< page_n page_total)
          (let ((const uint8_t * page_hashkey . #'(nth page_n page_keys))
                (int64_t page_address . #'(nth page_n page_addrs))
                (int64_t i . PAGEFILE_CONTROL_COUNT))
            (while (< i (-> m hbpp))
              (let ((int64_t hexmap_address . #'(+ (addr_hexmap page_address) i))
                    (int64_t pointer_address . 0)
                    (RowState online_state . ROW_NONE)
                    (RowState offline_state . ROW_NONE)
                    (RowLock online_lock . LOCK_NONE))
                (set pointer_address (* hexmap_address CHUNK_SIZE))

                ((-> (-> m hexmap_io) seekg) hexmap_address std::ios::beg)
                ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
                ;; free or record, from the first byte -- the same resync as
                ;; the cursor's: a hole consumed as a control block hid every
                ;; record behind it from the reclaim too, so the dead rows a
                ;; hole shadowed were never taken and the base only grew
                (if (== (bitand hex_byte 128) 0)
                    (block
                      (set i (+ i 1))
                      continue))
                (set online_state (cast RowState (bitand hex_byte 12)))
                (set online_lock (cast RowLock (bitand hex_byte 3)))
                ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
                (set offline_state (cast RowState (bitand hex_byte 12)))
                ((-> (-> m hexmap_io) seekg) (- CONTROL_COUNT 2) std::ios::cur)

                (set i (+ i CONTROL_COUNT))
                (let ((int64_t pointer_size . 0)
                      (bool at_end . #f))
                  (while (and (not at_end) (< i (-> m hbpp)))
                    ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
                    (set i (+ i 1))
                    (if (and (!= hex_byte CONTROL_STANDALONE_CHUNK)
                             (== (bitand hex_byte 64) 64))
                        (block
                          (set at_end #t)
                          (if (and (!= hex_byte CONTROL_CHUNK)
                                   (== (bitand hex_byte 128) 128))
                              (block
                                (set pointer_size (+ pointer_size (size_remainder hex_byte)))
                                ;; settled: dead and nobody mid-flight. UPDATED
                                ;; counts as dead here because only a SUPERSEDED
                                ;; version ever carries it -- commit_pointer
                                ;; stamps the new version INSERTED, the old one
                                ;; UPDATED -- and the machines table proved what
                                ;; skipping them costs: a row claimed and
                                ;; released a thousand times left a thousand
                                ;; UPDATED versions no truncate would touch,
                                ;; 22 pages carrying 4 live rows. Reclaiming
                                ;; them spends the same point-in-time reads the
                                ;; DELETED reclaim already spends.
                                (if (and (or (== offline_state ROW_DELETED)
                                             (== offline_state ROW_UPDATED))
                                         (and (== online_state ROW_NONE)
                                              (== online_lock LOCK_NONE)))
                                    (let ((DeadList * d . #'(new* DeadList)))
                                      (set (-> d ptr) (pointer_make page_hashkey pointer_address pointer_size))
                                      (set (-> d next) head)
                                      (set head d))))))
                      (set pointer_size (+ pointer_size CHUNK_SIZE)))))))
            (set page_n (+ page_n 1)))))
      (free (cast (void *) page_keys))
      (free (cast (void *) page_addrs))
      (return head)))

  (func truncate_key ((Memory * m) (const uint8_t * hash_key)) (out size_t)
    (dba_watch0 m "Truncate")
    (letin* ((streams (Streams m)))
      ;; collected in full before anything is freed: free_pointer rewrites
      ;; the hexmap and moves entries the walk stands on
      (let ((DeadList * dead . #'(dead_pointers m hash_key))
            (size_t rows . 0))
        ;; A FREED ROW'S ADDRESS CAN BE A NEW ROW'S, and a log index's
        ;; entries name rows by address: the table's log indexes go first,
        ;; durably, so no entry can outlive the row it named. The caller
        ;; rebuilds them over the survivors, as it rebuilds a tree.
        (if (!= dead nil)
            (if (== 1 (log_table_truncated m hash_key))
                (sync_disk m)))
        (while (!= dead nil)
          (free_pointer m (aof (-> dead ptr)))
          (set rows (+ rows 1))
          (let ((DeadList * spent . dead))
            (set dead (-> dead next))
            (delete* spent)))
        ((-> (-> m hexmap_io) flush))
        ((-> (-> m data_io) flush))
        (return rows))))

  ;; ==================================================================
  ;; Startup -- _initialize: load the page list, finish what interrupted
  ;; transactions left, register the holes
  ;; ==================================================================
  (struct TxnSeen
    (member size_t id)
    (member time_t commit_time)
    (member TxnSeen * next))

  (struct InitCtx
    (member Memory * m)
    (member TxnSeen * seen)
    (member DeadList * spent))

  (func initialize_txn_cb ((void * c) (Pointer * p)) (out bool)
    (let ((InitCtx * ctx . #'(cast (InitCtx *) c))
          (size_t transaction_id . 0)
          (time_t commit_time . 0))
      (let ((Memory * m . #'(-> ctx m)))
      ((-> (-> m data_io) seekg) (ptr_data p) std::ios::beg)
      ((-> (-> m data_io) read_std_size) transaction_id)
      ((-> (-> m data_io) read_std_time) commit_time)
      (let ((TxnSeen * t . #'(new* TxnSeen)))
        (set (-> t id) transaction_id)
        (set (-> t commit_time) commit_time)
        (set (-> t next) (-> ctx seen))
        (set (-> ctx seen) t))
      (return #t))))

  (func initialize_spent_cb ((void * c) (Pointer * p)) (out bool)
    (let ((InitCtx * ctx . #'(cast (InitCtx *) c))
          (DeadList * d . #'(new* DeadList)))
      (set (-> d ptr) (cof p))
      (set (-> d next) (-> ctx spent))
      (set (-> ctx spent) d)
      (return #t)))

  (func memory_initialize ((Memory * m)) (out void)
    ;; every page's hash key into the page list
    (let ((int64_t i . 0))
      (while (< i (-> m page_count))
        (let ((int64_t begin_address . #'(* i (-> m page_size)))
              (uint8_t key [20]))
          ((-> (-> m data_io) seekg) begin_address std::ios::beg)
          ((-> (-> m data_io) read) (cast (char *) key) HASHKEY_SIZE)
          ;; A PAGE WITH NO KEY AT ALL IS NOT A PAGE THIS STORE GAVE OUT.
          ;; The file is grown a chunk at a time (StreamIO/mapbuf.hpp), so
          ;; a kill can leave whole pages of zeros past the last one a
          ;; table was handed; a torn page header reads the same way, and
          ;; shadow paging says what was mid-write never happened. A real
          ;; key is a twenty-byte fold of a name and __FREE__ is a
          ;; constant, so all zeros is neither. Refreed here rather than
          ;; listed under a key nothing can ask for, which is what left it
          ;; dead space for the life of the store.
          (let ((int keyed . 0))
            (for ((int64_t b . 0)) (< b HASHKEY_SIZE) ((++ b))
              (if (!= (nth b key) 0) (set keyed 1)))
            (if (== keyed 0)
                (block
                  (warn! (fprintf stderr "mvccs[t%04zx] open: page %lld has no key, refreed\n"
                                  (bitand (cast size_t (pthread_self)) 65535)
                                  (cast llong begin_address)))
                  (allocate_page m FREE_HASHKEY begin_address)
                  (memcpy (cast (void *) key) (cast (const void *) FREE_HASHKEY)
                          (cast size_t HASHKEY_SIZE)))))
          (page_list_insert m key begin_address))
        (set i (+ i 1))))

    ;; the transactions that were mid-flight when the store closed
    (let ((InitCtx ctx))
      (set ($ ctx m) m)
      (set ($ ctx seen) nil)
      (set ($ ctx spent) nil)
      (cursor_walk m TRANSACTIONS_HASHKEY nil (cast (void *) (aof ctx)) initialize_txn_cb)

      ;; walk every page: finish uncommitted records the way their
      ;; transaction's intention says; register every hole
      (let ((PageEntry * e . #'(-> m pages)))
        (while (!= e nil)
          (let ((int64_t begin_address . #'(+ (-> e address) PAGEFILE_CONTROL_SIZE))
                (int64_t end_address . #'(+ (-> e address) (-> m page_size)))
                (bool is_data . #f)
                (RowState online_state . ROW_NONE)
                (RowLock online_lock . LOCK_NONE)
                (Control control))
            (control_clear (aof control))
            ;; A CONTENT TEAR IS SALVAGED, NOT REFUSED. A kill can catch the
            ;; hexmap mid-write, leaving a page whose bytes claim a record
            ;; that runs past the end -- the walk used to throw there and
            ;; the whole store was refused forever. What was mid-write never
            ;; reached its commit sync, so by shadow paging's own rule it
            ;; never happened: the records parsed BEFORE the tear are kept,
            ;; and the rest of the page is refreed for the allocator.
            (try
              (block
            (while (< begin_address end_address)
              ;; FREE OR RECORD IS DECIDED FROM THE FIRST HEXMAP BYTE, before
              ;; any parsing. pointer_at_state seeks CONTROL_COUNT bytes in
              ;; and measures what follows -- right for a record, and a read
              ;; straight through a SHORT free run into the record behind it.
              ;; The C++ twin measured that as the walk going one phase out
              ;; of step and rolling back live rows. A record's first chunk
              ;; is a control chunk and always carries the high bit; a free
              ;; chunk never does. One byte decides.
              (let ((uint8_t head_byte . 0)
                    (binarystream * hio . #'(hex_in m)))
                ((-> hio seekg) (addr_hexmap begin_address) std::ios::beg)
                ((-> hio read_std_ubyte) head_byte)
                (if (not ((-> hio good)))
                    (block
                      ((-> hio clear))
                      break))
                (set is_data (== (bitand head_byte 128) 128)))
              (let ((Pointer pointer . #'(pointer_null)))
                (if is_data
                    (set pointer (pointer_at_state m (-> e key) begin_address
                                    (aof is_data) (aof online_state) (aof online_lock))))
                (if is_data
                    (block
                      (if (!= online_lock LOCK_NONE)
                          (block
                            (load_control m (aof pointer) (aof control))
                            (let ((TxnSeen * t . #'($ ctx seen))
                                  (bool resolved . #f))
                              (while (and (!= t nil) (not resolved))
                                (if (and (== (-> t id) ($ control transaction_id))
                                         (> (-> t commit_time) (cast time_t 0)))
                                    (block
                                      (commit_pointer m (aof pointer) (-> t commit_time))
                                      (set resolved #t)))
                                (set t (-> t next)))
                              (if (not resolved)
                                  (rollback_pointer m (aof pointer))))))
                      (set begin_address (+ begin_address (ptr_actual_size (aof pointer)))))
                  ;; a free run is not a record: measure it from the hexmap
                  (let ((int64_t run . #'(free_run_count m begin_address end_address)))
                    (if (<= run 0)
                        (set begin_address end_address)   ;; must advance
                      (block
                        (free_list_insert m (-> e key) begin_address (* run CHUNK_SIZE))
                        ;; AND KEEP WALKING: free space is not always the tail
                        (set begin_address (+ begin_address (* run CHUNK_SIZE)))))))))
                (cast void 0))
              (catch ((const ZiguratException & ex))
                (cast void ex)
                (warn! (fprintf stderr "mvccs[t%04zx] open: a torn record at %lld salvaged -- %s\n"
                                (bitand (cast size_t (pthread_self)) 65535)
                                (cast llong begin_address) (($ ex what))))
                (if (< begin_address end_address)
                    (let ((int64_t remaining . #'(/ (- end_address begin_address) CHUNK_SIZE)))
                      ((-> (-> m hexmap_io) clear))
                      ((-> (-> m data_io) clear))
                      (free_hexmap m (addr_hexmap begin_address) remaining)
                      ((-> (-> m hexmap_io) flush))
                      (free_list_insert m (-> e key) begin_address
                                        (* remaining CHUNK_SIZE)))))))
          (set e (-> e next))))

      ;; the spent transaction records go back to the allocator
      (if (!= ($ ctx seen) nil)
          (block
            (cursor_walk m TRANSACTIONS_HASHKEY nil (cast (void *) (aof ctx)) initialize_spent_cb)
            (while (!= ($ ctx spent) nil)
              (free_pointer m (aof (-> ($ ctx spent) ptr)))
              (let ((DeadList * d . #'($ ctx spent)))
                (set ($ ctx spent) (-> d next))
                (delete* d)))))

      (while (!= ($ ctx seen) nil)
        (let ((TxnSeen * t . #'($ ctx seen)))
          (set ($ ctx seen) (-> t next))
          (delete* t))))

    (set (-> m initialized) #t))

  ;; How much of the hexmap file was WRITTEN: its length with the trailing
  ;; zeros trimmed. Read backwards a block at a time, so a file that carries
  ;; no growth -- every one a clean writer leaves -- costs a single read and
  ;; stops at its last byte. See its caller in memory_open for why the
  ;; length alone stopped being the answer.
  (func hexmap_written_length ((binarystream * hexmap_io) (int64_t hexlen)) (out int64_t)
    (let ((int64_t content . hexlen)
          (uint8_t buf [4096])
          (int done . 0))
      (while (and (== done 0) (> content 0))
        (let ((int64_t take . #'(? (> content 4096) 4096 content))
              (int64_t from . 0))
          (set from (- content take))
          ((-> hexmap_io seekg) from std::ios::beg)
          ((-> hexmap_io read) (cast (char *) buf) take)
          (if (not ((-> hexmap_io good)))
              (block
                ;; unreadable is not empty: keep the length the file claims
                ((-> hexmap_io clear))
                (set done 1))
            (let ((int64_t i . take))
              (while (and (== done 0) (> i 0))
                (if (!= (nth (- i 1) buf) 0)
                    (block
                      (set content (+ from i))
                      (set done 1))
                  (set i (- i 1))))
              (if (== done 0) (set content from))))))
      ((-> hexmap_io clear))
      (return content)))

  ;; the constructor's work -- Memory(hexmap, data, page_size)
  (func memory_open ((Memory * m) (binarystream * hexmap_io) (binarystream * data_io)
                     (int64_t page_size)) (out void)
    ;; a Memory opened again -- or a new one at a freed one's address --
    ;; owes nothing to the log indexes of the store it held before
    (log_forget_memory m)
    (set (-> m hexmap_io) hexmap_io)
    (set (-> m data_io) data_io)
    (set (-> m page_size) page_size)
    (set (-> m hbpp) (/ page_size CHUNK_SIZE))
    (set (-> m page_count) 0)
    (set (-> m initialized) #f)
    (set (-> m pages) nil)
    ;; every bucket empty before the first page: a Memory on the stack
    ;; arrives with these indeterminate, exactly as bt_cache does
    (for ((int64_t b . 0)) (< b PAGE_BUCKET_COUNT) ((++ b))
      (set (nth b (-> m page_heads)) nil))
    (for ((int64_t f . 0)) (< f FREE_SLOT_COUNT) ((++ f))
      (set (nth f (-> m free_heads)) nil))
    (set (-> m watcher) nil)
    ;; a fresh cache per open, never the field's old value: a Memory on the
    ;; stack or from a bare `new' arrives with that pointer indeterminate
    (set (-> m bt_cache) (bt_cache_new))
    (pthread_mutex_init (aof (-> m hexmap_access)) nil)
    (pthread_mutex_init (aof (-> m data_access)) nil)
    (pthread_mutex_init (aof (-> m page_list_access)) nil)
    (pthread_mutex_init (aof (-> m free_list_access)) nil)
    (set (nth 0 (-> m rd_hex_path)) (cast char 0))
    (set (nth 0 (-> m rd_data_path)) (cast char 0))
    ;; writer-preferring where the platform offers it: eight pollers
    ;; holding the shared side in relay must not starve the one writer
    (code "{ pthread_rwlockattr_t rwa; pthread_rwlockattr_init(&rwa);")
    (code "#ifdef PTHREAD_RWLOCK_PREFER_WRITER_NONRECURSIVE_NP")
    (code "  pthread_rwlockattr_setkind_np(&rwa, PTHREAD_RWLOCK_PREFER_WRITER_NONRECURSIVE_NP);")
    (code "#endif")
    (code "  pthread_rwlock_init(&m->streams_rw, &rwa); pthread_rwlockattr_destroy(&rwa); }")
    (pthread_mutex_init (aof (-> m writers_access)) nil)
    (pthread_cond_init (aof (-> m writers_clear)) nil)
    (set (-> m writers_waiting) 0)

    ((-> data_io seekg) 0 std::ios::end)
    (set (-> m page_count) (/ ((-> data_io tellg)) page_size))
    ((-> data_io clear))

    ;; A process killed mid-append leaves a torn tail: data pages the hexmap
    ;; never covered, or a ragged last page shorter than page_size. Nothing
    ;; in them was ever committed -- a commit syncs both files, so what a
    ;; kill caught in flight is by shadow paging's own rule work that never
    ;; happened -- and the walk below used to hit the missing hexmap bytes
    ;; and refuse the whole store with "hexmap ends inside the chunk",
    ;; permanently. The tail is reforged instead: the ragged page padded to
    ;; the boundary, and every page past the hexmap's coverage rewritten as
    ;; a __FREE__ page for the allocator to hand out again.
    (let ((int64_t datalen . 0) (int64_t hexlen . 0))
      ((-> data_io seekg) 0 std::ios::end)
      (set datalen ((-> data_io tellg)))
      ((-> data_io clear))
      (let ((int64_t ragged . #'(% datalen page_size)))
        (if (> ragged 0)
            (block
              ((-> data_io seekp) 0 std::ios::end)
              ((-> data_io fill_n) (cast size_t (- page_size ragged)) (cast char 0))
              ((-> data_io flush))
              (set (-> m page_count) (+ (-> m page_count) 1)))))
      ((-> hexmap_io seekg) 0 std::ios::end)
      (set hexlen ((-> hexmap_io tellg)))
      ((-> hexmap_io clear))
      ;; COVERAGE IS WHAT THE HEXMAP HOLDS, NOT HOW LONG ITS FILE IS -- and
      ;; those stopped being the same thing when the store began growing its
      ;; files a chunk at a time (StreamIO/mapbuf.hpp). The file is cut back
      ;; to its writes at every sync and at close, so only a KILL leaves the
      ;; two apart; but that is exactly when this walk matters, and a kill
      ;; can leave up to a chunk of ZEROS past the last slice. Zeros read as
      ;; free chunks, so a length taken at face value would report pages
      ;; covered that were never written -- and the repair below, which
      ;; refrees pages the hexmap does not describe, would stop firing in
      ;; the one case it exists for (a commit syncs the data file before the
      ;; hexmap; a kill between the two leaves a page keyed on disk with no
      ;; slice behind it).
      ;;
      ;; Every slice a page is given ENDS IN A STANDALONE BYTE -- 64 for a
      ;; free run, 240 for a control chunk, never 0 -- so trailing zeros are
      ;; growth nobody wrote, and trimming them gives the coverage back
      ;; exactly. A file that was never padded loses nothing: its last byte
      ;; is non-zero, so the scan reads one block and stops.
      (let ((int64_t covered . #'(/ (hexmap_written_length hexmap_io hexlen) (-> m hbpp))))
        (info! (fprintf stderr
                "mvccs[t%04zx] open: page_size %lld, %lld pages, hexmap %lld bytes covering %lld\n"
                (bitand (cast size_t (pthread_self)) 65535)
                (cast llong page_size) (cast llong (-> m page_count))
                (cast llong hexlen) (cast llong covered)))
        (if (< covered (-> m page_count))
            (let ((int64_t p . covered))
              ;; growth a kill left behind, or a hexmap that never caught up
              (warn! (fprintf stderr "mvccs[t%04zx] open: refreeing %lld page(s) the hexmap does not cover\n"
                              (bitand (cast size_t (pthread_self)) 65535)
                              (cast llong (- (-> m page_count) covered))))
              (while (< p (-> m page_count))
                (allocate_page m FREE_HASHKEY (* p page_size))
                (set p (+ p 1)))
              ((-> hexmap_io flush))
              ((-> data_io flush))))))

    (memory_initialize m)
    (begin_transaction m))



  ;; ==================================================================
  ;; The B-tree tier -- btreenode/key/value/record + btreeindex.hpp,
  ;; re-expressed. Nodes, keys and values are BaseTable rows under the
  ;; INDEX's hash key, written offline (the tree's shape is metadata);
  ;; a key's values are a chain, each link a TRANSACTIONAL row -- which
  ;; is how a rolled back delete reappears in the index on its own.
  ;; The catalogue is one record per index under __INDICES__.
  ;; ==================================================================

  ;; indexexception.hpp, code 1063
  (struct IndexException (inherits ZiguratException)
    (ctor ((const char * msg))
      (init (ZiguratException 1063 (std::string msg)))))

  ;; __INDICES__ -- byte for byte the original's hash key
  (var uint8_t INDICES_HASHKEY [20]
       . '{ 65 19 64 97 216 179 156 200 72 43 78 23 75 227 190 109 106 79 44 180 })

  (struct BTNode (inherits BaseTable)
    (member int64_t degree)
    (member int64_t is_internal)
    (member int64_t keys_address)
    (override) (method pack_size () (out int64_t) (return 24))
    (override) (method pack ((binarystream & io)) (out void)
      (($ io write_std_long) (cast int64_t ($ this degree)))
      (($ io write_std_long) (cast int64_t ($ this is_internal)))
      (($ io write_std_long) (cast int64_t ($ this keys_address))))
    (override) (method unpack ((binarystream & io)) (out void)
      (($ io read_std_long) ($ this degree))
      (($ io read_std_long) ($ this is_internal))
      (($ io read_std_long) ($ this keys_address))))

  (func bt_node_clear ((BTNode * n)) (out void)
    (set (-> n degree) 0)
    (set (-> n is_internal) 0)
    (set (-> n keys_address) -1)
    (set (-> n pointer) (pointer_null)))

  (struct BTKey (inherits BaseTable)
    (member int64_t left_node_address)
    (member int64_t left_address)
    (member int64_t right_address)
    (member int64_t right_node_address)
    (member int64_t dependents_address)
    (member int64_t values_address)
    (member int64_t key)
    (override) (method pack_size () (out int64_t) (return 56))
    (override) (method pack ((binarystream & io)) (out void)
      (($ io write_std_long) (cast int64_t ($ this left_node_address)))
      (($ io write_std_long) (cast int64_t ($ this left_address)))
      (($ io write_std_long) (cast int64_t ($ this right_address)))
      (($ io write_std_long) (cast int64_t ($ this right_node_address)))
      (($ io write_std_long) (cast int64_t ($ this dependents_address)))
      (($ io write_std_long) (cast int64_t ($ this values_address)))
      (($ io write_std_long) (cast int64_t ($ this key))))
    (override) (method unpack ((binarystream & io)) (out void)
      (($ io read_std_long) ($ this left_node_address))
      (($ io read_std_long) ($ this left_address))
      (($ io read_std_long) ($ this right_address))
      (($ io read_std_long) ($ this right_node_address))
      (($ io read_std_long) ($ this dependents_address))
      (($ io read_std_long) ($ this values_address))
      (($ io read_std_long) ($ this key))))

  (func bt_key_clear ((BTKey * k)) (out void)
    (set (-> k left_node_address) -1)
    (set (-> k left_address) -1)
    (set (-> k right_address) -1)
    (set (-> k right_node_address) -1)
    (set (-> k dependents_address) -1)
    (set (-> k values_address) -1)
    (set (-> k key) 0)
    (set (-> k pointer) (pointer_null)))

  ;; ==================================================================
  ;; The B-tree record cache.
  ;;
  ;; A node's keys are one record each, so a descent at branching 65
  ;; reads ~200 records -- a pointer_at over the hexmap, a seek and an
  ;; unpack apiece, through a filebuf that drops its buffer at every
  ;; seek -- and that was 0.85 ms of every insert, growing with the
  ;; tree (bench/insert-bench.cpp, scenario D). Nodes and keys are
  ;; OFFLINE records: no version, no rollback, written in place through
  ;; offline_insert / offline_update and released through free_pointer,
  ;; so a copy in memory is stale only after one of those three, and
  ;; each of them forgets the address. Direct-mapped, tagged by address,
  ;; bounded, no allocation on the hot path; a collision costs a re-read,
  ;; never a wrong answer. One mutex, because readers under the SHARED
  ;; streams guard fill it concurrently. The on-disk format is untouched
  ;; -- a store written by the C++ engine reads the same.
  ;; ==================================================================
  ;; THE SIZE IS THE TREE'S, NOT A CONSTANT. It was 4096 node slots and
  ;; 16384 key slots, and a table indexed by a hashed column outgrows that
  ;; at once: two million rows under a random 64-bit key are ~60 000
  ;; leaves of up to 128 keys, so nearly every key a descent read missed
  ;; and was unpacked from the store again -- a third of the insert's
  ;; time at that size (bench/table-bench.cpp, a gdb sample of the "pt"
  ;; run). Now 65536 node slots and 262144 key slots by default, ~32 MB
  ;; a store, and MVCCS_CACHE_NODES / MVCCS_CACHE_KEYS set either, rounded
  ;; down to a power of two (at least 1024) so the slot is a mask. The
  ;; slots live in vectors because a slot holds a record with a vtable,
  ;; which a malloc would leave unconstructed.

  (struct BTNodeSlot (member int64_t addr) (member BTNode node))
  (struct BTKeySlot (member int64_t addr) (member BTKey key))
  (@define (code "btnodeslots_t std::vector<BTNodeSlot>"))
  (@define (code "btkeyslots_t std::vector<BTKeySlot>"))

  ;; where an index's largest key was last appended -- the rightmost leaf,
  ;; its head and degree then, the key's record and the key -- and the
  ;; root it hung from; see "THE TAIL APPEND". KEY is the index's own hash
  ;; key: the tree's identity in the store, so every BTreeIndex attached to
  ;; one tree -- a server's compiled objects can each hold one -- reads and
  ;; forgets the same hint.
  (struct BTTail
    (member const uint8_t * key)
    (member int64_t root)
    (member int64_t leaf)
    (member int64_t head)
    (member int64_t degree)
    (member int64_t tail)
    (member int64_t max_key))
  (@define (code "bttails_t std::vector<BTTail>"))

  (struct BTCache
    (member pthread_mutex_t access)
    (member int64_t node_mask)
    (member int64_t key_mask)
    (member btnodeslots_t nodes)
    (member btkeyslots_t keys)
    (member bttails_t tails))

  ;; every slot empty, and every tail hint with them: a reset is a store
  ;; whose records may have moved under the cache
  (func bt_cache_clear_slots ((BTCache * c)) (out void)
    (($ (-> c tails) clear))
    (let ((int64_t i . 0))
      (while (<= i (-> c node_mask))
        (set ($ (nth i (-> c nodes)) addr) -1)
        (set i (+ i 1))))
    (let ((int64_t i . 0))
      (while (<= i (-> c key_mask))
        (set ($ (nth i (-> c keys)) addr) -1)
        (set i (+ i 1)))))

  ;; an environment count rounded down to a power of two, at least 1024
  (func bt_cache_slots ((const char * name) (int64_t fallback)) (out int64_t)
    (let ((const char * s . #'(getenv name))
          (int64_t want . fallback)
          (int64_t n . 1024))
      (if (!= s nil)
          (let ((int64_t v . #'(cast int64_t (atoll s))))
            (if (> v 0) (set want v))))
      (while (<= (* n 2) want)
        (set n (* n 2)))
      (return n)))

  (func bt_cache_new () (out void *)
    ;; MVCCS_NO_CACHE in the environment runs without the cache -- every
    ;; accessor answers nothing for a nil cache -- so a suspicion about it
    ;; is one run away from an answer
    (if (!= (getenv "MVCCS_NO_CACHE") nil) (return nil))
    (let ((BTCache * c . #'(new* BTCache))
          (int64_t nn . #'(bt_cache_slots "MVCCS_CACHE_NODES" 65536))
          (int64_t nk . #'(bt_cache_slots "MVCCS_CACHE_KEYS" 262144)))
      (pthread_mutex_init (aof (-> c access)) nil)
      (set (-> c node_mask) (- nn 1))
      (set (-> c key_mask) (- nk 1))
      (($ (-> c nodes) resize) (cast size_t nn))
      (($ (-> c keys) resize) (cast size_t nk))
      (bt_cache_clear_slots c)
      (return (cast (void *) c))))

  (func bt_cache_free ((Memory * m)) (out void)
    (if (!= (-> m bt_cache) nil)
        (block
          (delete* (cast (BTCache *) (-> m bt_cache)))
          (set (-> m bt_cache) nil))))

  (func bt_cache_reset ((Memory * m)) (out void)
    (if (== (-> m bt_cache) nil) (return))
    (let ((BTCache * c . #'(cast (BTCache *) (-> m bt_cache))))
      (pthread_mutex_lock (aof (-> c access)))
      (bt_cache_clear_slots c)
      (pthread_mutex_unlock (aof (-> c access)))))

  ;; records sit at least a control block apart, so the address over 64
  ;; spreads neighbours across slots
  (func bt_cache_node_slot ((BTCache * c) (int64_t address)) (out int64_t)
    (return (bitand (>> address 6) (-> c node_mask))))
  (func bt_cache_key_slot ((BTCache * c) (int64_t address)) (out int64_t)
    (return (bitand (>> address 6) (-> c key_mask))))

  (func bt_cache_forget ((Memory * m) (int64_t address)) (out void)
    (if (== (-> m bt_cache) nil) (return))
    (let ((BTCache * c . #'(cast (BTCache *) (-> m bt_cache)))
          (int64_t ns . #'(bt_cache_node_slot c address))
          (int64_t ks . #'(bt_cache_key_slot c address)))
      (pthread_mutex_lock (aof (-> c access)))
      (if (== ($ (nth ns (-> c nodes)) addr) address)
          (set ($ (nth ns (-> c nodes)) addr) -1))
      (if (== ($ (nth ks (-> c keys)) addr) address)
          (set ($ (nth ks (-> c keys)) addr) -1))
      (pthread_mutex_unlock (aof (-> c access)))))

  (func bt_cache_node_get ((Memory * m) (int64_t address) (BTNode * out)) (out int)
    (if (== (-> m bt_cache) nil) (return 0))
    (let ((BTCache * c . #'(cast (BTCache *) (-> m bt_cache)))
          (int64_t ns . #'(bt_cache_node_slot c address))
          (int hit . 0))
      (pthread_mutex_lock (aof (-> c access)))
      (if (== ($ (nth ns (-> c nodes)) addr) address)
          (block
            (set (cof out) ($ (nth ns (-> c nodes)) node))
            (set hit 1)))
      (pthread_mutex_unlock (aof (-> c access)))
      (return hit)))

  (func bt_cache_node_put ((Memory * m) (const BTNode * node)) (out void)
    (if (== (-> m bt_cache) nil) (return))
    (let ((BTCache * c . #'(cast (BTCache *) (-> m bt_cache)))
          (int64_t ns . #'(bt_cache_node_slot c ($ (-> node pointer) address))))
      (pthread_mutex_lock (aof (-> c access)))
      (set ($ (nth ns (-> c nodes)) node) (cof node))
      (set ($ (nth ns (-> c nodes)) addr) ($ (-> node pointer) address))
      (pthread_mutex_unlock (aof (-> c access)))))

  (func bt_cache_key_get ((Memory * m) (int64_t address) (BTKey * out)) (out int)
    (if (== (-> m bt_cache) nil) (return 0))
    (let ((BTCache * c . #'(cast (BTCache *) (-> m bt_cache)))
          (int64_t ks . #'(bt_cache_key_slot c address))
          (int hit . 0))
      (pthread_mutex_lock (aof (-> c access)))
      (if (== ($ (nth ks (-> c keys)) addr) address)
          (block
            (set (cof out) ($ (nth ks (-> c keys)) key))
            (set hit 1)))
      (pthread_mutex_unlock (aof (-> c access)))
      (return hit)))

  (func bt_cache_key_put ((Memory * m) (const BTKey * key)) (out void)
    (if (== (-> m bt_cache) nil) (return))
    (let ((BTCache * c . #'(cast (BTCache *) (-> m bt_cache)))
          (int64_t ks . #'(bt_cache_key_slot c ($ (-> key pointer) address))))
      (pthread_mutex_lock (aof (-> c access)))
      (set ($ (nth ks (-> c keys)) key) (cof key))
      (set ($ (nth ks (-> c keys)) addr) ($ (-> key pointer) address))
      (pthread_mutex_unlock (aof (-> c access)))))

  (struct BTValue (inherits BaseTable)
    (member int64_t value)
    (member int64_t next_address)
    (override) (method pack_size () (out int64_t) (return 16))
    (override) (method pack ((binarystream & io)) (out void)
      (($ io write_std_long) (cast int64_t ($ this value)))
      (($ io write_std_long) (cast int64_t ($ this next_address))))
    (override) (method unpack ((binarystream & io)) (out void)
      (($ io read_std_long) ($ this value))
      (($ io read_std_long) ($ this next_address))))

  ;; the catalogue record: btreerecord.hpp with the String hash_name
  ;; replaced by an int64 id derived from the index name at expansion
  ;; time (the catalogue is found by scan, not by the self-hosting index)
  (struct BTRecord (inherits BaseTable)
    (member int64_t catalogue_id)
    (member int64_t is_unique)
    (member int64_t branching_factor)
    (member int64_t root_address)
    (override) (method pack_size () (out int64_t) (return 32))
    (override) (method pack ((binarystream & io)) (out void)
      (($ io write_std_long) (cast int64_t ($ this catalogue_id)))
      (($ io write_std_long) (cast int64_t ($ this is_unique)))
      (($ io write_std_long) (cast int64_t ($ this branching_factor)))
      (($ io write_std_long) (cast int64_t ($ this root_address))))
    (override) (method unpack ((binarystream & io)) (out void)
      (($ io read_std_long) ($ this catalogue_id))
      (($ io read_std_long) ($ this is_unique))
      (($ io read_std_long) ($ this branching_factor))
      (($ io read_std_long) ($ this root_address))))

  ;; the index itself -- BTreeIndex<Table, First> minus the templates:
  ;; the key type is int64 and the table is reached through table_key +
  ;; the deftable shim, both handed over by defindex at attach time
  (struct BTreeIndex
    (member Memory * m)
    (member const char * name)
    (member const uint8_t * hash_key)
    (member const uint8_t * table_key)
    (member int64_t catalogue_id)
    (member int64_t is_unique)
    (member int64_t branching_factor)
    (member int64_t min_degree)
    (member int64_t max_degree)
    (member int64_t root_address)
    (member Pointer record_pointer)
    ;; the composite tier: how many columns this level covers (1 = the
    ;; level that holds value chains), whether this is a stack-built
    ;; dependent (no catalogue record to write through), and the hash
    ;; key every dependent level of this index shares
    (member int64_t levels)
    (member int64_t is_dependent)
    (member const uint8_t * dep_hash_key))

  ;; ---- node / key readers (_btreenode / _btreekey) ------------------
  (func bt_node_read ((BTreeIndex * idx) (int64_t address) (BTNode * node)) (out void)
    (let ((Memory * m . #'(-> idx m)))
      (if (bt_cache_node_get m address node) (return))
      (set (-> node pointer) (pointer_at m (-> idx hash_key) address))
      (let ((binarystream * ndio . #'(data_in m)))
        (if (not ((-> ndio good))) ((-> ndio clear)))
        ((-> ndio seekg) (ptr_data (aof (-> node pointer))) std::ios::beg)
        ((-> node unpack) (cof ndio)))
      (bt_cache_node_put m node)))

  (func bt_key_read ((BTreeIndex * idx) (int64_t address) (BTKey * key)) (out void)
    (let ((Memory * m . #'(-> idx m)))
      (if (bt_cache_key_get m address key) (return))
      (set (-> key pointer) (pointer_at m (-> idx hash_key) address))
      (let ((binarystream * kdio . #'(data_in m)))
        (if (not ((-> kdio good))) ((-> kdio clear)))
        ((-> kdio seekg) (ptr_data (aof (-> key pointer))) std::ios::beg)
        ((-> key unpack) (cof kdio)))
      (bt_cache_key_put m key)))

  ;; a dependent level, built on the stack per descent exactly as the
  ;; original builds its dependent_index: same store, same tuning, the
  ;; shared dependent hash key, one column fewer, and no catalogue
  (func bt_dependent ((BTreeIndex * idx) (int64_t root)) (out BTreeIndex)
    (let ((BTreeIndex dep))
      (set ($ dep m) (-> idx m))
      (set ($ dep name) (-> idx name))
      (set ($ dep hash_key) (-> idx dep_hash_key))
      (set ($ dep dep_hash_key) (-> idx dep_hash_key))
      (set ($ dep table_key) (-> idx table_key))
      (set ($ dep catalogue_id) 0)
      (set ($ dep is_unique) (-> idx is_unique))
      (set ($ dep branching_factor) (-> idx branching_factor))
      (set ($ dep min_degree) (-> idx min_degree))
      (set ($ dep max_degree) (-> idx max_degree))
      (set ($ dep levels) (- (-> idx levels) 1))
      (set ($ dep is_dependent) 1)
      (set ($ dep root_address) root)
      (set ($ dep record_pointer) (pointer_null))
      (return dep)))

  ;; ---- the tail hint (see "THE TAIL APPEND", with the map) -----------
  ;; Kept beside the record cache, so it goes with it: a store opened
  ;; afresh, a reset (drop_key_pages), MVCCS_NO_CACHE (no hints at all).
  ;; Only a writer under the exclusive guard reads or writes one; the
  ;; cache's own mutex keeps the vector whole against a reset. An index
  ;; keeps ONE entry for the store's life, interned once; a forgotten hint
  ;; is an entry whose leaf is -1, so a split every 64 appends costs no
  ;; intern_key (a lock and a walk of every key the process has interned).
  (func bt_tail_get ((BTreeIndex * idx) (BTTail * out)) (out int)
    (if (== (-> (-> idx m) bt_cache) nil) (return 0))
    (let ((BTCache * c . #'(cast (BTCache *) (-> (-> idx m) bt_cache)))
          (int found . 0))
      (pthread_mutex_lock (aof (-> c access)))
      (for ((size_t i . 0)) (and (< i (($ (-> c tails) size))) (== found 0)) ((++ i))
        (if (and (!= ($ (nth i (-> c tails)) leaf) -1)
                 (== 0 (memcmp ($ (nth i (-> c tails)) key) (-> idx hash_key) (cast size_t HASHKEY_SIZE))))
            (block
              (set (cof out) (nth i (-> c tails)))
              (set found 1))))
      (pthread_mutex_unlock (aof (-> c access)))
      (return found)))

  ;; T as IDX's hint: into its entry, the entry's own key kept; the first
  ;; time for this store, a new entry under the interned key
  (func bt_tail_put ((BTreeIndex * idx) (const BTTail * t)) (out void)
    (if (== (-> (-> idx m) bt_cache) nil) (return))
    (let ((BTCache * c . #'(cast (BTCache *) (-> (-> idx m) bt_cache)))
          (int found . 0))
      (pthread_mutex_lock (aof (-> c access)))
      (for ((size_t i . 0)) (and (< i (($ (-> c tails) size))) (== found 0)) ((++ i))
        (if (== 0 (memcmp ($ (nth i (-> c tails)) key) (-> idx hash_key) (cast size_t HASHKEY_SIZE)))
            (let ((const uint8_t * kept . #'($ (nth i (-> c tails)) key)))
              (set (nth i (-> c tails)) (cof t))
              (set ($ (nth i (-> c tails)) key) kept)
              (set found 1))))
      (if (== found 0)
          (let ((BTTail fresh . #'(cof t)))
            (set ($ fresh key) (intern_key (-> idx hash_key)))
            (($ (-> c tails) push_back) fresh)))
      (pthread_mutex_unlock (aof (-> c access)))))

  ;; IDX's hint forgotten -- or, with NODE not -1, only if it names that
  ;; leaf. The entry stays, empty.
  (func bt_tail_forget ((BTreeIndex * idx) (int64_t node)) (out void)
    (if (== (-> (-> idx m) bt_cache) nil) (return))
    (let ((BTCache * c . #'(cast (BTCache *) (-> (-> idx m) bt_cache))))
      (pthread_mutex_lock (aof (-> c access)))
      (for ((size_t i . 0)) (< i (($ (-> c tails) size))) ((++ i))
        (if (and (== 0 (memcmp ($ (nth i (-> c tails)) key) (-> idx hash_key) (cast size_t HASHKEY_SIZE)))
                 (or (== node -1) (== ($ (nth i (-> c tails)) leaf) node)))
            (set ($ (nth i (-> c tails)) leaf) -1)))
      (pthread_mutex_unlock (aof (-> c access)))))

  ;; ---- the catalogue (_insert/_select/_update_btreeindex) -----------
  (func bt_insert_record ((BTreeIndex * idx)) (out void)
    (let ((BTRecord rec))
      (set ($ rec catalogue_id) (-> idx catalogue_id))
      (set ($ rec is_unique) (-> idx is_unique))
      (set ($ rec branching_factor) (-> idx branching_factor))
      (set ($ rec root_address) (-> idx root_address))
      (offline_insert (-> idx m) INDICES_HASHKEY (cast (BaseTable *) (aof rec)))
      (set (-> idx record_pointer) ($ rec pointer))))

  (struct BTSelCtx
    (member BTreeIndex * idx)
    (member int found))

  (func bt_select_cb ((void * c) (Pointer * p)) (out bool)
    (let ((BTSelCtx * sc . #'(cast (BTSelCtx *) c)))
      (let ((BTreeIndex * idx . #'(-> sc idx))
            (BTRecord rec))
        (set ($ rec pointer) (cof p))
        (read_row (-> idx m) (cast (BaseTable *) (aof rec)))
        (if (== ($ rec catalogue_id) (-> idx catalogue_id))
            (block
              (set (-> idx root_address) ($ rec root_address))
              (set (-> idx record_pointer) (cof p))
              (set (-> sc found) 1)
              (return #f)))
        (return #t))))

  ;; answers 1 when the store met this index for the first time -- its
  ;; catalogue row was just created, and a table with rows already in it
  ;; has none of them in the tree until the consumer rebuilds it
  ;; which structure the store keeps an index as -- see "THE LOG INDEX"
  (decl) (func log_select ((BTreeIndex * idx)) (out void))

  (func bt_select_record ((BTreeIndex * idx)) (out int)
    (let ((BTSelCtx sc)
          (int fresh . 0))
      (set ($ sc idx) idx)
      (set ($ sc found) 0)
      (letin* ((streams (Streams (-> idx m))))
        (cursor_walk (-> idx m) INDICES_HASHKEY (aof streams)
                     (cast (void *) (aof sc)) bt_select_cb)
        (cast void 0))
      ;; not recording a hit left the original catalogue re-inserting
      ;; its own row on every restart; same rule here
      (if (== ($ sc found) 0)
          (block
            (bt_insert_record idx)
            (set fresh 1)))
      ;; a tree or a log, and the entries moved across when the store
      ;; kept it as the other
      (log_select idx)
      (return fresh)))

  (func bt_update_record ((BTreeIndex * idx)) (out void)
    (let ((BTRecord rec))
      (set ($ rec pointer) (-> idx record_pointer))
      (set ($ rec catalogue_id) (-> idx catalogue_id))
      (set ($ rec is_unique) (-> idx is_unique))
      (set ($ rec branching_factor) (-> idx branching_factor))
      (set ($ rec root_address) (-> idx root_address))
      (offline_update (-> idx m) (cast (BaseTable *) (aof rec)))))

  ;; ---- value chains (_insert_btreevalue / _delete_btreevalue) -------
  ;; Linked at the head -- the cheap end -- and the key written back
  ;; here, because every caller has just written the key anyway.
  ;;
  ;; nonzero while a log index's entries move back into a tree: each value
  ;; is then COMMITTED as it is written, born when its row was, because
  ;; the row it names was committed long before (log_to_tree)
  (thread-local) (var int64_t tl_offline_values . 0)

  (func bt_insert_value ((BTreeIndex * idx) (BTKey * key) (int64_t value)) (out void)
    (let ((Memory * m . #'(-> idx m))
          (BTValue v))
      (set ($ v value) value)
      (set ($ v next_address) (-> key values_address))
      (set ($ v pointer) (allocate m (-> idx hash_key) 16))

      ;; transactional, unlike the nodes and keys: the entry must roll
      ;; back with the row it indexes
      (if (!= tl_offline_values 0)
          (let ((Control control))
            (control_clear (aof control))
            (set ($ control offline_state) ROW_INSERTED)
            (set ($ control create_time) (cast time_t tl_offline_values))
            (dump_control m (aof ($ v pointer)) (aof control)))
        (block
          (transaction_push m (aof ($ v pointer)))
          (control_insert m (cast (BaseTable *) (aof v)))))

      (full_hexmap m (aof ($ v pointer)))
      ;; a failed read poisons the stream and every write after it no-ops --
      ;; writes clear first, exactly as the read accessors do
      (if (not ((-> (-> m data_io) good)))
          ((-> (-> m data_io) clear)))
      ((-> (-> m data_io) seekp) (ptr_data (aof ($ v pointer))) std::ios::beg)
      (($ v pack) (cof (-> m data_io)))

      (set (-> key values_address) ($ ($ v pointer) address))
      (offline_update m (cast (BaseTable *) key))))

  (func bt_delete_value ((BTreeIndex * idx) (BTValue * v)) (out void)
    (let ((Memory * m . #'(-> idx m)))
      (transaction_push m (aof (-> v pointer)))
      (control_delete m (cast (BaseTable *) v) (cast (Streams *) tl_streams_held))
      ((-> (-> m hexmap_io) flush))
      ((-> (-> m data_io) flush))))

  (func bt_walk_values_from ((BTreeIndex * idx) (int64_t start) (void * ctx)
                             (func vcb ((void * c) (int64_t counter) (BTValue * v)) (out bool)))
        (out void)
    (let ((Memory * m . #'(-> idx m))
          (int64_t counter . -1)
          (int64_t tmp . start)
          ;; Brent's cycle check, in three integers: remember a mark, double
          ;; the distance each time it is moved, and a link that comes back
          ;; to the mark is a chain pointing into itself -- a torn edit's
          ;; other shape, which chain_resolves cannot see because every
          ;; record in the loop is genuinely allocated.
          (int64_t brent_mark . -2)
          (int64_t brent_steps . 0)
          (int64_t brent_limit . 2))
      (while (> tmp -1)
        ;; an unresolvable or revisited link ends the chain exactly as -1 does
        (if (not (chain_resolves m tmp)) break)
        (if (== tmp brent_mark) break)
        (set brent_steps (+ brent_steps 1))
        (if (== brent_steps brent_limit)
            (block
              (set brent_mark tmp)
              (set brent_steps 0)
              (set brent_limit (* brent_limit 2))))
        (let ((Pointer pointer . #'(pointer_at m (-> idx hash_key) tmp))
              (BTValue v))
          (let ((binarystream * wdio . #'(data_in m)))
            (if (not ((-> wdio good))) ((-> wdio clear)))
            ((-> wdio seekg) (ptr_data (aof pointer)) std::ios::beg)
            (($ v unpack) (cof wdio)))
          ;; advanced before the callback, so a callback that deletes the
          ;; value it was handed does not lose the rest of the chain
          (set tmp ($ v next_address))

          (let ((Pointer vp . pointer))
            (if (visible m (aof vp) (cast (Streams *) tl_streams_held))
                (block
                  (if (!= ($ vp address) ($ pointer address))
                      (block
                        (let ((binarystream * wdio2 . #'(data_in m)))
                          (if (not ((-> wdio2 good))) ((-> wdio2 clear)))
                          ((-> wdio2 seekg) (ptr_data (aof vp)) std::ios::beg)
                          (($ v unpack) (cof wdio2)))))
                  (set ($ v pointer) vp)
                  (set counter (+ counter 1))
                  (if (not (vcb ctx counter (aof v)))
                      (return)))))))))

  (func bt_walk_values ((BTreeIndex * idx) (BTKey * key) (void * ctx)
                        (func vcb ((void * c) (int64_t counter) (BTValue * v)) (out bool)))
        (out void)
    (bt_walk_values_from idx (-> key values_address) ctx vcb))

  ;; ---- the tail append ----------------------------------------------
  ;; THE TAIL APPEND. A node's keys are a linked list read from its head,
  ;; so a key larger than every key -- a sequence's id, a clock, a block
  ;; height: the common insert -- walked EVERY key of every node on the
  ;; rightmost path, 64 to 128 a level, the walk growing with the tree's
  ;; depth. bench/table-bench.cpp's unique id alone took a row's insert
  ;; from 6 us at the first block to 23 at the thousandth, and a third of
  ;; the tree's time was bt_key_read (gdb, the "p" run past block 1 000),
  ;; while the same rows with no index stayed flat.
  ;;
  ;; So a descent that took the last key at every level and appended at
  ;; its leaf's end records where it did (BTTail), and the next key above
  ;; that one is appended there directly -- the same writes, none of the
  ;; reads. The hint is a hint: before it is used the leaf must still
  ;; have the degree and head it had, be a leaf with room, the tail key
  ;; must still end the list holding the largest key, both records must
  ;; still be this index's, and the root the same; anything else and the
  ;; descent runs as before. The rightmost leaf changes only by a split
  ;; (which forgets the hint), by an unmap_key's deletes and combines
  ;; (which forget it), or by its pages going back (drop_key_pages resets
  ;; it with the cache); a key above the largest goes down the rightmost
  ;; path and records the hint again. A dependent level is built on the
  ;; stack per descent and never keeps one. MVCCS_TAIL_HINT=0 in the
  ;; environment walks every time, as before.
  (var int g_tail_hint . -1)

  (func bt_tail_enabled () (out int)
    (if (< g_tail_hint 0)
        (let ((const char * s . #'(getenv "MVCCS_TAIL_HINT")))
          (set g_tail_hint (? (and (!= s nil) (== (nth 0 s) (cast char 48))) 0 1))))
    (return g_tail_hint))

  ;; 1 while the descent bt_map began has taken the last key at every
  ;; level; bt_map_rec clears it at any other turn
  (thread-local) (var int tl_tail_path . 0)

  ;; KEYS THIS THREAD APPENDED BY THE HINT, EVER -- what a check reads to
  ;; know the hint was taken, not merely that the answers came out right
  (thread-local) (var int64_t tl_tail_appends . 0)
  (func mvccs_tail_appends () (out int64_t) (return tl_tail_appends))

  ;; LEAF (its pointer set) just had NEW_KEY appended at its end as KEY K
  (func bt_tail_record ((BTreeIndex * idx) (BTNode * leaf) (BTKey * new_key) (int64_t k)) (out void)
    (let ((BTTail t))
      ;; bt_tail_put keeps the entry's interned key, or interns it once
      (set ($ t key) (-> idx hash_key))
      (set ($ t root) (-> idx root_address))
      (set ($ t leaf) ($ (-> leaf pointer) address))
      (set ($ t head) (-> leaf keys_address))
      (set ($ t degree) (-> leaf degree))
      (set ($ t tail) ($ (-> new_key pointer) address))
      (set ($ t max_key) k)
      (bt_tail_put idx (aof t))))

  (decl) (func key_record_holds ((Memory * m) (const uint8_t * key) (int64_t address)) (out bool))

  ;; K appended at the rightmost leaf's end if the hint still holds and
  ;; the leaf has room; answers 1 when it was, 0 for the descent. Under
  ;; the caller's exclusive guard, for a single-level index's own level.
  (func bt_tail_append ((BTreeIndex * idx) (int64_t k) (int64_t value)) (out int)
    (let ((Memory * m . #'(-> idx m))
          (BTTail t))
      (if (== 0 (bt_tail_get idx (aof t))) (return 0))
      (if (or (<= k ($ t max_key))
              (or (!= ($ t root) (-> idx root_address))
                  (>= ($ t degree) (-> idx max_degree))))
          (return 0))
      (if (or (not (key_record_holds m (-> idx hash_key) ($ t leaf)))
              (not (key_record_holds m (-> idx hash_key) ($ t tail))))
          (block
            (bt_tail_forget idx -1)
            (return 0)))
      (let ((BTNode leaf)
            (BTKey last))
        (bt_node_read idx ($ t leaf) (aof leaf))
        (bt_key_read idx ($ t tail) (aof last))
        (if (or (!= ($ leaf is_internal) 0)
                (or (!= ($ leaf degree) ($ t degree))
                    (or (!= ($ leaf keys_address) ($ t head))
                        (or (!= ($ last right_address) -1)
                            (or (!= ($ last right_node_address) -1)
                                (!= ($ last key) ($ t max_key)))))))
            (block
              (bt_tail_forget idx -1)
              (return 0)))
        ;; the leaf append, written exactly as bt_map_rec writes it
        (let ((BTKey new_key))
          (bt_key_clear (aof new_key))
          (set ($ new_key key) k)
          (set ($ new_key left_address) ($ ($ last pointer) address))
          (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof new_key)))
          (bt_insert_value idx (aof new_key) value)
          (set ($ leaf degree) (+ ($ leaf degree) 1))
          (offline_update m (cast (BaseTable *) (aof leaf)))
          (set ($ last right_address) ($ ($ new_key pointer) address))
          (offline_update m (cast (BaseTable *) (aof last)))
          (bt_tail_record idx (aof leaf) (aof new_key) k)
          (set tl_tail_appends (+ tl_tail_appends 1))))
      (return 1)))

  ;; ---- map (insert) --------------------------------------------------
  (decl) (func bt_split_node ((BTreeIndex * idx) (BTNode ** ancestors) (int depth)
                              (BTNode * node)) (out void))
  (decl) (func bt_map_to_internal ((BTreeIndex * idx) (BTNode ** ancestors) (int depth)
                                   (BTNode * node) (BTKey * new_key)) (out void))
  (decl) (func bt_map_rec ((BTreeIndex * idx) (BTNode ** ancestors) (int depth)
                           (BTNode * node) (int64_t k) (int64_t value)
                           (BTKey * out_key)) (out void))

  (struct BTUniqCtx (member int found))
  (func bt_uniq_cb ((void * c) (int64_t counter) (BTValue * v)) (out bool)
    (cast void counter)
    (cast void v)
    (let ((BTUniqCtx * uc . #'(cast (BTUniqCtx *) c)))
      (set (-> uc found) 1)
      (return #f)))

  ;; ==================================================================
  ;; Deferred index maintenance: a transaction's index entries, held back
  ;; from its inserts and mapped in bulk, sorted, when it commits.
  ;;
  ;; WHY. A table indexed on a hashed column -- a transaction id, any
  ;; String key -- maps every row into a random leaf of a growing tree, and
  ;; measured (bench/table-bench.cpp, 2 001-row blocks, 2 million rows) it
  ;; was all of the growth: the row and a sequence's primary key stayed
  ;; near 0.04 s a block while the hashed index took the block to ~1 s,
  ;; half of it walking key records and half the commit writing back the
  ;; pages the walk dirtied. Mapping a whole transaction's entries at once,
  ;; in key order, is the bulk insertion: the descents of neighbouring keys
  ;; share their path, and the entries of one block reach the tree in one
  ;; pass instead of interleaved with the rows.
  ;;
  ;; WHAT IS DEFERRED. bt_map and bt_map_multi, reached from a row's map()
  ;; inside online_insert / online_update (tl_defer_maps), on an index that
  ;; is not UNIQUE -- a unique index still refuses the duplicate at the
  ;; insert that makes it, exactly as before -- and not a dependent level
  ;; (bt_map_multi defers the whole tuple at the top). MVCCS_DEFER_INDEX=0
  ;; in the environment turns it off.
  ;;
  ;; WHY NO OTHER TRANSACTION NEEDS THEM. An index value is its row's
  ;; transactional twin (bt_insert_value stages it; a cursor trusts the
  ;; value's visibility and reads the row plainly), so the values of rows
  ;; nobody else can see yet are invisible to everybody else anyway. The
  ;; commit maps them BEFORE it records its intention, so they are staged
  ;; under this transaction and flipped with its rows, as they always were.
  ;;
  ;; THIS TRANSACTION DOES NEED THEM, and gets them first: every cursor on
  ;; any index, every unmap, a truncate and a drop map the pending entries
  ;; before they walk (idx_pending_apply is a no-op when there are none).
  ;; Each entry carries its row's query id, so a statement still does not
  ;; see the rows it inserted itself, and its row's staging time, so a
  ;; partial rollback treats the row and its values alike; entries of rows
  ;; a rollback undoes are dropped, never mapped.
  ;; ==================================================================
  (struct IdxPending
    (member BTreeIndex * idx)
    (member int64_t ks [8])
    (member int64_t value)
    (member int64_t seq)
    (member int64_t query_id)
    (member time_t at))
  (@define (code "idxpending_t std::vector<IdxPending>"))
  (thread-local) (var idxpending_t * tl_pending . nil)
  (thread-local) (var int64_t tl_pending_seq . 0)

  (func idx_pending_count () (out int64_t)
    (if (== tl_pending nil) (return 0))
    (return (cast int64_t ((-> tl_pending size)))))

  (func idx_pending_push ((BTreeIndex * idx) (const int64_t * ks) (int64_t value)) (out void)
    (if (== tl_pending nil) (set tl_pending (new* idxpending_t)))
    (let ((IdxPending e))
      (set ($ e idx) idx)
      (for ((int64_t i . 0)) (< i 8) ((++ i))
        (set (nth i ($ e ks)) (? (< i (-> idx levels)) (nth i ks) 0)))
      (set ($ e value) value)
      (set tl_pending_seq (+ tl_pending_seq 1))
      (set ($ e seq) tl_pending_seq)
      (set ($ e query_id) (? (!= tl_txn nil) (-> tl_txn query_id) 0))
      (set ($ e at) (version_time))
      ((-> tl_pending push_back) e)))

  ;; whether bt_map / bt_map_multi on IDX should queue rather than map
  (func idx_defer_here ((BTreeIndex * idx)) (out int)
    (if (!= tl_defer_maps 1) (return 0))
    (if (!= (-> idx is_dependent) 0) (return 0))
    (if (!= (-> idx is_unique) 0) (return 0))
    (return 1))

  ;; ==================================================================
  ;; THE LOG INDEX: an insertion that does not grow with the index.
  ;;
  ;; WHY. Mapped in bulk at the commit (above), a hashed index still
  ;; rewrote a random leaf and its two neighbouring key records in place
  ;; for every row -- a block of 2 001 transactions dirtied ~6 000 pages
  ;; scattered through the store, and the commit's msync waited for every
  ;; one: 58 % of the wall clock near two million rows, and growing with
  ;; the tree. Indexes kept as sorted RUNS written once and never edited
  ;; in place -- a log-structured merge tree's shape, what LevelDB keeps
  ;; a node's transaction index in -- turn the commit's index work into
  ;; one sequential append of the transaction's sorted entries, whatever
  ;; the index already holds.
  ;;
  ;; WHICH INDEXES. A single-level, non-unique, non-dependent one -- a
  ;; transaction id, any String key, a plain foreign key. A unique index
  ;; must refuse a duplicate at the insert, which wants the tree's
  ;; descent; a composite keeps its dependent trees. MVCCS_LOG_INDEX=0 in
  ;; the environment keeps every index a tree. A store switches either
  ;; way at an index's attach, moving the entries across (log_select).
  ;;
  ;; WHAT AN ENTRY MEANS: (key, row address), and nothing about whether
  ;; the row is alive. The tree's values are the rows' transactional
  ;; twins and say who may see them; a log entry is written once, at the
  ;; commit or earlier, and the ROW answers the visibility question when
  ;; a cursor reaches it (log_row_visible -- visible() itself, or at
  ;; SNAPSHOT the version's own lifetime). That is sound because a row
  ;; version never changes its columns (an update writes a new version at
  ;; a new address) and is never reclaimed except by TRUNCATE (rollback
  ;; flags it dead), and TRUNCATE drops a table's log indexes before it
  ;; frees a row (log_table_truncated) and rebuilds them after. So an
  ;; entry can be early -- a row not committed yet, or rolled back -- or
  ;; late -- a row deleted or superseded -- but never wrong: a delete or
  ;; an update's old version writes nothing to the log at all.
  ;;
  ;; ON DISK: records of the index's own LOG KEY (its hash key, every
  ;; byte turned), all offline. One META says the store keeps this index
  ;; as a log. A run is BLOCKS of sorted (key, value) pairs -- half a
  ;; page each -- and then its HEAD, written last, so a run whose head is
  ;; on disk is whole; a merged run's head names the runs it replaces.
  ;; The load (log_load) keeps every whole run nothing replaces and frees
  ;; the rest, which is all a crash can leave behind.
  ;;
  ;; THE MERGE. A run's tier is its size, LOG_BASE entries and every
  ;; LOG_FANOUT-fold after (log_tier_of); LOG_FANOUT runs of one tier
  ;; merge into one. An entry is rewritten once per tier it climbs --
  ;; sequentially -- and a lookup reads at most a few runs per tier. A
  ;; merge is PACED: each commit that adds a run carries every merge under
  ;; way a bounded step further, so no commit pays a whole one (see "THE
  ;; MERGE, PACED"). The merged-away runs' records are freed only after
  ;; the next commit's first sync has made their replacement durable
  ;; (log_after_sync), and only once no cursor still holds them (LogSnap).
  ;; ==================================================================
  (var const int64_t LOG_ROOT . -2)
  (var const int64_t LOG_KIND_META . 1)
  (var const int64_t LOG_KIND_HEAD . 2)
  (var const int64_t LOG_KIND_BLOCK . 3)
  (var const int64_t LOG_BASE . 4096)
  (var const int64_t LOG_FANOUT . 4)
  ;; a block record: six header words, the entry count, the entries,
  ;; and an empty list's count -- the first entry sits 56 bytes in
  (var const int64_t LOG_ENTS_AT . 56)

  (var const int LOG_ALL . 0)
  (var const int LOG_EQ . 1)
  (var const int LOG_NE . 2)
  (var const int LOG_LT . 3)
  (var const int LOG_LE . 4)
  (var const int LOG_GT . 5)
  (var const int LOG_GE . 6)

  (struct LogEnt
    (member int64_t key)
    (member int64_t value))
  (@define (code "logents_t std::vector<LogEnt>"))
  (@define (code "logaddrs_t std::vector<int64_t>"))

  ;; a block of a run, as the directory remembers it
  (struct LogBlockRef
    (member int64_t first)
    (member int64_t last)
    (member int64_t address)
    (member int64_t count))
  (@define (code "logblocks_t std::vector<LogBlockRef>"))

  ;; one run in memory: refs counts the directory's hold and every
  ;; cursor's; dropped says its pages went back wholesale, so nothing of
  ;; it is to be freed record by record
  (struct LogRun
    (member int64_t id)
    (member int64_t tier)
    (member int64_t count)
    (member int64_t head)
    (member int refs)
    (member int dropped)
    (member logblocks_t blocks))
  (@define (code "logruns_t std::vector<LogRun *>"))

  ;; a merge under way across commits, one a tier at most (see "THE MERGE,
  ;; PACED" with the cursors)
  (decl) (struct LogPend)
  (var const int64_t LOG_TIERS . 64)

  ;; an index kept as a log: its runs oldest first, the records of
  ;; released runs waiting for a sync before they may be freed, and the
  ;; merges under way, by the tier they merge
  (struct LogIndex
    (member BTreeIndex * idx)
    (member Memory * m)
    (member const uint8_t * key)
    (member int64_t next_id)
    (member pthread_mutex_t access)
    (member logruns_t runs)
    (member logaddrs_t doomed)
    (member LogPend * pending [64]))
  (@define (code "logindexes_t std::vector<LogIndex *>"))

  ;; every log index of the process, found by its BTreeIndex: the tree's
  ;; own struct is laid out in every compiled object that holds one, so
  ;; the log's state lives here and the index carries only LOG_ROOT in
  ;; its root_address -- one compare on a tree's every path
  (var pthread_mutex_t log_registry_access . PTHREAD_MUTEX_INITIALIZER)
  (var logindexes_t * log_registry . nil)
  ;; -1 until the environment has been read; then 0 off, 1 on
  (var int g_log_index . -1)

  (func log_index_enabled () (out int)
    (if (< g_log_index 0)
        (let ((const char * s . #'(getenv "MVCCS_LOG_INDEX")))
          (set g_log_index (? (and (!= s nil) (== (nth 0 s) (cast char 48))) 0 1))))
    (return g_log_index))

  (func log_eligible ((BTreeIndex * idx)) (out int)
    (if (== (log_index_enabled) 0) (return 0))
    (if (!= (-> idx is_unique) 0) (return 0))
    (if (!= (-> idx levels) 1) (return 0))
    (if (!= (-> idx is_dependent) 0) (return 0))
    (return 1))

  ;; the index's log, or nil for a tree
  (func log_of ((BTreeIndex * idx)) (out LogIndex *)
    (if (!= (-> idx root_address) LOG_ROOT) (return nil))
    (let ((LogIndex * found . nil))
      (pthread_mutex_lock (aof log_registry_access))
      (if (!= log_registry nil)
          (for ((size_t i . 0)) (< i ((-> log_registry size))) ((++ i))
            (let ((LogIndex * cand . #'(nth i (cof log_registry))))
              (if (== (-> cand idx) idx)
                  (block
                    (set found cand)
                    break)))))
      (pthread_mutex_unlock (aof log_registry_access))
      ;; a root that says log with no log behind it is an index used
      ;; across a store's reopen without its attach: say so, rather than
      ;; let a tree walk read address -2
      (if (== found nil)
          (throw* (IndexException "a log index used before its store attached it")))
      (return found)))

  ;; defined with the cursors, after the tree they stand beside
  (decl) (func log_push ((LogIndex * li) (int64_t k) (int64_t value)) (out void))
  (decl) (func log_add_run ((LogIndex * li) (logents_t * ents)) (out void))
  (decl) (func log_cursor ((LogIndex * li) (int mode) (int64_t k) (void * user)
                           (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool))
  (decl) (func log_drop ((LogIndex * li)) (out void))
  (decl) (func log_truncate ((LogIndex * li)) (out size_t))
  (decl) (func log_unmap_key ((LogIndex * li) (int64_t k)) (out void))

  ;; _split_node: the lower half keeps the node, the upper half moves to
  ;; a fresh node of the SAME kind, and the median key is promoted into
  ;; the parent -- or into a brand new root when there is none.
  (func bt_split_node ((BTreeIndex * idx) (BTNode ** ancestors) (int depth)
                       (BTNode * node)) (out void)
    (let ((Memory * m . #'(-> idx m))
          (BTNode new_node)
          (BTKey left_key)
          (int have_left . 0)
          ;; THE UPPER HALF HOLDS WHAT IS LEFT, not min_degree keys. A
          ;; split after an insert has max_degree + 1 keys, and with
          ;; max = 2 * min the two counts agree -- which hid that a merge
          ;; re-split by bt_combine_nodes can hold up to min + max: its
          ;; upper half was written with min_degree as its degree over a
          ;; longer list, every walk that stops at degree - 1 then took a
          ;; middle key for the last, the keys past it went unfound, and
          ;; inserts were appended after the wrong key. 241 unmap_keys over
          ;; 20 000 ids at degrees 64..128 lost 3 036 other keys;
          ;; tail-check.cpp's section 5b pins it (286 unmap_keys, then
          ;; appends) and goes red with the old count.
          (int64_t upper . #'(- (-> node degree) (+ (-> idx min_degree) 1))))
      ;; its upper half becomes the rightmost leaf, if it was that
      (bt_tail_forget idx ($ (-> node pointer) address))
      (bt_node_clear (aof new_node))
      ;; the upper half is the same kind of node as the half it came from
      (set ($ new_node is_internal) (-> node is_internal))
      (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof new_node)))

      (let ((int64_t tmp . #'(-> node keys_address))
            (int64_t index . 0)
            (int stop . 0))
        (while (and (> tmp -1) (== stop 0))
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))

            (if (== index (-> idx min_degree))
                ;; the median: promote it
                (block
                  (if (== have_left 1)
                      (block
                        (set ($ left_key right_address) -1)
                        (offline_update m (cast (BaseTable *) (aof left_key)))))
                  (set (-> node degree) (-> idx min_degree))
                  (offline_update m (cast (BaseTable *) node))

                  (set ($ cur left_node_address) ($ (-> node pointer) address))
                  (set ($ cur left_address) -1)
                  (set ($ cur right_address) -1)
                  (set ($ cur right_node_address) ($ ($ new_node pointer) address))
                  (offline_update m (cast (BaseTable *) (aof cur)))

                  (if (== depth 0)
                      ;; splitting the root: grow a new one above it.
                      ;; A DEPENDENT level has no catalogue record: its new
                      ;; root travels back through the parent key instead
                      ;; (the original wrote through a default Pointer here
                      ;; -- address zero -- and never told the parent).
                      (let ((BTNode root)
                            (BTNode * none [1]))
                        (bt_node_clear (aof root))
                        (set ($ root is_internal) 1)
                        (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof root)))
                        (bt_map_to_internal idx none 0 (aof root) (aof cur))
                        (set (-> idx root_address) ($ ($ root pointer) address))
                        (if (== (-> idx is_dependent) 0)
                            (bt_update_record idx)))
                    ;; the promoted key goes to the immediate parent, and
                    ;; the parent's own ancestors travel with it
                    (bt_map_to_internal idx ancestors (- depth 1)
                                        (nth (- depth 1) ancestors) (aof cur))))
              (if (> index (-> idx min_degree))
                  ;; the first key of the upper half
                  (block
                    (set ($ cur left_address) -1)
                    (set ($ new_node degree) upper)
                    (set ($ new_node keys_address) ($ ($ cur pointer) address))
                    (offline_update m (cast (BaseTable *) (aof new_node)))
                    (offline_update m (cast (BaseTable *) (aof cur)))
                    (set stop 1))))

            (set left_key cur)
            (set have_left 1)
            (set index (+ index 1)))))))

  ;; _map_to_internal: insert an already-written key into an internal
  ;; node's key list, keeping consecutive keys sharing a child
  (func bt_map_to_internal ((BTreeIndex * idx) (BTNode ** ancestors) (int depth)
                            (BTNode * node) (BTKey * new_key)) (out void)
    (let ((Memory * m . #'(-> idx m)))
      (if (== (-> node keys_address) -1)
          (block
            (set (-> node degree) 1)
            (set (-> node keys_address) ($ (-> new_key pointer) address))
            (offline_update m (cast (BaseTable *) node))
            (return)))

      (let ((BTKey left_key)
            (int have_left . 0)
            (int64_t tmp . #'(-> node keys_address))
            (int64_t index . 0)
            (int stop . 0))
        (while (and (> tmp -1) (== stop 0))
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))

            (if (< (-> new_key key) ($ cur key))
                (block
                  (if (== index 0)
                      (block
                        (set (-> new_key right_address) ($ ($ cur pointer) address))
                        (offline_update m (cast (BaseTable *) new_key))
                        (set (-> node degree) (+ (-> node degree) 1))
                        (set (-> node keys_address) ($ (-> new_key pointer) address))
                        (offline_update m (cast (BaseTable *) node)))
                    (block
                      (set (-> new_key left_address) ($ ($ left_key pointer) address))
                      (set (-> new_key right_address) ($ ($ cur pointer) address))
                      (offline_update m (cast (BaseTable *) new_key))
                      (set (-> node degree) (+ (-> node degree) 1))
                      (offline_update m (cast (BaseTable *) node))
                      (set ($ left_key right_address) ($ (-> new_key pointer) address))
                      (offline_update m (cast (BaseTable *) (aof left_key)))))
                  (set ($ cur left_address) ($ (-> new_key pointer) address))
                  (set ($ cur left_node_address) (-> new_key right_node_address))
                  (offline_update m (cast (BaseTable *) (aof cur)))
                  (set stop 1))
              (if (== index (- (-> node degree) 1))
                  ;; past the last key: append
                  (block
                    (set (-> new_key left_address) ($ ($ cur pointer) address))
                    (offline_update m (cast (BaseTable *) new_key))
                    (set (-> node degree) (+ (-> node degree) 1))
                    (offline_update m (cast (BaseTable *) node))
                    (set ($ cur right_address) ($ (-> new_key pointer) address))
                    (offline_update m (cast (BaseTable *) (aof cur)))
                    (set stop 1))))

            (set left_key cur)
            (set have_left 1)
            (set index (+ index 1)))))

      (if (> (-> node degree) (-> idx max_degree))
          (bt_split_node idx ancestors depth node))))

  ;; _map: descend to the leaf, insert the key or add a value to the one
  ;; already there, split what overflowed on the way back up
  (func bt_map_rec ((BTreeIndex * idx) (BTNode ** ancestors) (int depth)
                    (BTNode * node) (int64_t k) (int64_t value)
                    (BTKey * out_key)) (out void)
    (let ((Memory * m . #'(-> idx m)))
      (if (== (-> node keys_address) -1)
          (block
            (let ((BTKey new_key))
              (bt_key_clear (aof new_key))
              (set ($ new_key key) k)
              (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof new_key)))
              ;; a value chain only where this level holds the rows -- an
              ;; outer level's keys carry a dependent tree instead
              (if (== (-> idx levels) 1)
                  (bt_insert_value idx (aof new_key) value))
              (set (-> node degree) 1)
              (set (-> node keys_address) ($ ($ new_key pointer) address))
              (offline_update m (cast (BaseTable *) node))
              ;; an empty leaf reached down the rightmost path: the tree's
              ;; first key, and its largest
              (if (and (== tl_tail_path 1) (== (-> node is_internal) 0))
                  (bt_tail_record idx node (aof new_key) k))
              (if (!= out_key nil) (set (cof out_key) new_key)))
            (return)))

      (let ((BTKey left_key)
            (int64_t tmp . #'(-> node keys_address))
            (int64_t index . 0)
            (int stop . 0))
        (while (and (> tmp -1) (== stop 0))
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))

            (cond
              ((< k ($ cur key))
               (block
               ;; not the last key: this descent leaves the rightmost path
               (set tl_tail_path 0)
               (if (!= (-> node is_internal) 0)
                   (block
                     (let ((BTNode left_node))
                       (bt_node_read idx ($ cur left_node_address) (aof left_node))
                       (set (nth depth ancestors) node)
                       (bt_map_rec idx ancestors (+ depth 1) (aof left_node) k value out_key))
                     (set stop 1))
                 (block
                   (let ((BTKey new_key))
                     (bt_key_clear (aof new_key))
                     (set ($ new_key key) k)
                     (if (> index 0)
                         (set ($ new_key left_address) ($ ($ left_key pointer) address)))
                     (set ($ new_key right_address) ($ ($ cur pointer) address))
                     (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof new_key)))
                     (if (== (-> idx levels) 1)
                         (bt_insert_value idx (aof new_key) value))
                     (set (-> node degree) (+ (-> node degree) 1))
                     (if (== index 0)
                         (set (-> node keys_address) ($ ($ new_key pointer) address)))
                     (offline_update m (cast (BaseTable *) node))
                     (if (> index 0)
                         (block
                           (set ($ left_key right_address) ($ ($ new_key pointer) address))
                           (offline_update m (cast (BaseTable *) (aof left_key)))))
                     (set ($ cur left_address) ($ ($ new_key pointer) address))
                     (offline_update m (cast (BaseTable *) (aof cur)))
                     (if (!= out_key nil) (set (cof out_key) new_key)))
                   (set stop 1)))))

              ((== k ($ cur key))
               (block
                 (set tl_tail_path 0)
                 ;; uniqueness is the whole tuple's: only the level holding
                 ;; the value chains can refuse
                 (if (and (!= (-> idx is_unique) 0) (== (-> idx levels) 1))
                     (let ((BTUniqCtx uc))
                       (set ($ uc found) 0)
                       (bt_walk_values idx (aof cur) (cast (void *) (aof uc)) bt_uniq_cb)
                       (if (== ($ uc found) 1)
                           (throw* (IndexException "unique key")))))
                 (if (== (-> idx levels) 1)
                     (bt_insert_value idx (aof cur) value))
                 (if (!= out_key nil) (set (cof out_key) cur))
                 (set stop 1)))

              (#t
               (if (and (!= (-> node is_internal) 0)
                        (== index (- (-> node degree) 1)))
                   (block
                     (let ((BTNode right_node))
                       (bt_node_read idx ($ cur right_node_address) (aof right_node))
                       (set (nth depth ancestors) node)
                       (bt_map_rec idx ancestors (+ depth 1) (aof right_node) k value out_key))
                     (set stop 1))
                 (if (and (== (-> node is_internal) 0)
                          (== index (- (-> node degree) 1)))
                     (block
                       (let ((BTKey new_key))
                         (bt_key_clear (aof new_key))
                         (set ($ new_key key) k)
                         (set ($ new_key left_address) ($ ($ cur pointer) address))
                         (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof new_key)))
                         (if (== (-> idx levels) 1)
                             (bt_insert_value idx (aof new_key) value))
                         (set (-> node degree) (+ (-> node degree) 1))
                         (offline_update m (cast (BaseTable *) node))
                         (set ($ cur right_address) ($ ($ new_key pointer) address))
                         (offline_update m (cast (BaseTable *) (aof cur)))
                         ;; appended at the rightmost leaf's end: where the
                         ;; next larger key goes (a split below forgets it)
                         (if (== tl_tail_path 1)
                             (bt_tail_record idx node (aof new_key) k))
                         (if (!= out_key nil) (set (cof out_key) new_key)))
                       (set stop 1))))))

            (set left_key cur)
            (set index (+ index 1)))))

      (if (> (-> node degree) (-> idx max_degree))
          (bt_split_node idx ancestors depth node))))

  (func bt_map ((BTreeIndex * idx) (int64_t k) (int64_t value)) (out void)
    (dba_watch2 (-> idx m) "BTreeIndex map" k value)
    ;; a log index queues every entry, inside an insert or not: the queue
    ;; is how its entries reach a run
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_push (log_of idx) k value)
          (return)))
    ;; a row's insert queues its entry; the commit maps the queue in bulk
    (if (== 1 (idx_defer_here idx))
        (let ((int64_t ks [1]))
          (set (nth 0 ks) k)
          (idx_pending_push idx ks value)
          (return)))
    (let ((Memory * m . #'(-> idx m)))
      ;; reached from online_insert, which is already holding these; the
      ;; guard nests and does nothing. Reached bare, it locks for real.
      (letin* ((streams (Streams m)))
        (if (== (-> idx root_address) -1)
            (block
              (let ((BTNode root))
                (bt_node_clear (aof root))
                (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof root)))
                (set (-> idx root_address) ($ ($ root pointer) address)))
              (if (== (-> idx is_dependent) 0)
                  (bt_update_record idx))))
        ;; a key above the largest goes where the last one went, unread
        (let ((int hinted . #'(? (and (== 1 (bt_tail_enabled))
                                      (and (== (-> idx levels) 1) (== (-> idx is_dependent) 0)))
                                 1 0)))
          (if (and (== hinted 1) (== 1 (bt_tail_append idx k value)))
              (return))
          (let ((BTNode root_node)
                (BTNode * ancestors [64]))
            (set tl_tail_path hinted)
            (bt_node_read idx (-> idx root_address) (aof root_node))
            (bt_map_rec idx ancestors 0 (aof root_node) k value nil)
            (set tl_tail_path 0)))
        (cast void 0))))

  ;; the composite map: each level maps its column's key WITHOUT a value
  ;; chain and descends into the key's dependent tree; only the innermost
  ;; level holds the rows. The dependent's root travels back through the
  ;; parent key WHENEVER it changed -- creation or a root split. (The
  ;; original wrote it back on creation only, and a dependent root split
  ;; also updated a catalogue record the dependent does not have, through
  ;; a default Pointer at address zero. Both are corrected here.)
  (decl) (func bt_map_multi ((BTreeIndex * idx) (int64_t * ks) (int64_t value)) (out void))
  (func bt_map_multi ((BTreeIndex * idx) (int64_t * ks) (int64_t value)) (out void)
    (if (== (-> idx levels) 1)
        (block
          (bt_map idx (nth 0 ks) value)
          (return)))
    ;; the whole tuple queues at the top level, never a dependent's tail
    (if (== 1 (idx_defer_here idx))
        (block
          (idx_pending_push idx ks value)
          (return)))
    (let ((Memory * m . #'(-> idx m)))
      (letin* ((streams (Streams m)))
        (if (== (-> idx root_address) -1)
            (block
              (let ((BTNode root))
                (bt_node_clear (aof root))
                (offline_insert m (-> idx hash_key) (cast (BaseTable *) (aof root)))
                (set (-> idx root_address) ($ ($ root pointer) address)))
              (if (== (-> idx is_dependent) 0)
                  (bt_update_record idx))))
        (let ((BTNode root_node)
              (BTNode * ancestors [64])
              (BTKey keyrec))
          (bt_key_clear (aof keyrec))
          (bt_node_read idx (-> idx root_address) (aof root_node))
          ;; a composite's outer level keeps no tail hint
          (set tl_tail_path 0)
          (bt_map_rec idx ancestors 0 (aof root_node) (nth 0 ks) value (aof keyrec))
          (let ((int64_t old_dep . #'($ keyrec dependents_address)))
            (let ((BTreeIndex dep . #'(bt_dependent idx old_dep)))
              (bt_map_multi (aof dep) (aof (nth 1 ks)) value)
              (if (!= ($ dep root_address) old_dep)
                  ;; re-read before writing back: a split at this level may
                  ;; have relinked the record since keyrec was copied
                  (let ((BTKey fresh))
                    (bt_key_read idx ($ ($ keyrec pointer) address) (aof fresh))
                    (set ($ fresh dependents_address) ($ dep root_address))
                    (offline_update m (cast (BaseTable *) (aof fresh))))))))
        (cast void 0))))

  ;; ---- the deferred entries, mapped in bulk -------------------------
  ;; index, then key tuple, then arrival: one index's entries in key order,
  ;; and one key's in the order its rows came, so its value chain ends up
  ;; exactly as immediate mapping would have built it
  (func idx_pending_cmp ((const void * a) (const void * b)) (out int)
    (let ((const IdxPending * x . #'(cast (const IdxPending *) a))
          (const IdxPending * y . #'(cast (const IdxPending *) b)))
      (if (< (cast uintptr_t (-> x idx)) (cast uintptr_t (-> y idx))) (return -1))
      (if (> (cast uintptr_t (-> x idx)) (cast uintptr_t (-> y idx))) (return 1))
      (for ((int i . 0)) (< i 8) ((++ i))
        (if (< (nth i (-> x ks)) (nth i (-> y ks))) (return -1))
        (if (> (nth i (-> x ks)) (nth i (-> y ks))) (return 1)))
      (if (< (-> x seq) (-> y seq)) (return -1))
      (if (> (-> x seq) (-> y seq)) (return 1))
      (return 0)))

  ;; what the bulk map borrows -- the defer flag, the shared ask, the
  ;; staging time, the query id -- handed back however the map leaves
  (struct ApplyScope
    (member int defer_)
    (member int want_)
    (member time_t at_)
    (member int64_t query_)
    (ctor ()
      (init (defer_ 0) (want_ 0) (at_ 0) (query_ 0))
      (set ($ this defer_) tl_defer_maps)
      (set ($ this want_) tl_want_shared)
      (set ($ this at_) tl_push_at)
      (if (!= tl_txn nil) (set ($ this query_) (-> tl_txn query_id)))
      (set tl_defer_maps 0)
      ;; the maps write: an exclusive guard, never a shared one a read
      ;; above us asked for and has not constructed yet
      (set tl_want_shared 0))
    (dtor ()
      (set tl_defer_maps ($ this defer_))
      (set tl_want_shared ($ this want_))
      (set tl_push_at ($ this at_))
      (if (!= tl_txn nil) (set (-> tl_txn query_id) ($ this query_)))))

  ;; Every queued entry of this thread's transaction, mapped now. The queue
  ;; is taken whole before the first map, so an entry is mapped once even
  ;; if a map throws.
  (func idx_pending_apply () (out void)
    (if (or (== tl_pending nil) ((-> tl_pending empty))) (return))
    (let ((idxpending_t batch))
      (($ batch swap) (cof tl_pending))
      (qsort (cast (void *) (($ batch data))) (($ batch size)) (sizeof IdxPending) idx_pending_cmp)
      (letin* ((scope (ApplyScope)))
        (let ((size_t i . 0)
              (size_t n . #'(($ batch size))))
          (while (< i n)
            (let ((IdxPending * e . #'(aof (nth i batch))))
              (if (== (-> (-> e idx) root_address) LOG_ROOT)
                  ;; a log index's entries are together and in key order:
                  ;; they become one run
                  (let ((BTreeIndex * idx . #'(-> e idx))
                        (logents_t ents))
                    (while (and (< i n) (== ($ (nth i batch) idx) idx))
                      (let ((LogEnt le))
                        (set ($ le key) (nth 0 ($ (nth i batch) ks)))
                        (set ($ le value) ($ (nth i batch) value))
                        (($ ents push_back) le))
                      (set i (+ i 1)))
                    (log_add_run (log_of idx) (aof ents)))
                (block
                  (set tl_push_at (-> e at))
                  (if (!= tl_txn nil) (set (-> tl_txn query_id) (-> e query_id)))
                  (if (> (-> (-> e idx) levels) 1)
                      (bt_map_multi (-> e idx) (-> e ks) (-> e value))
                    (bt_map (-> e idx) (nth 0 (-> e ks)) (-> e value)))
                  (set i (+ i 1)))))))
        (cast void 0))))

  ;; a full rollback: the rows are gone, so are their entries
  (func idx_pending_discard () (out void)
    (if (!= tl_pending nil) ((-> tl_pending clear))))

  ;; a partial rollback to AT: the entries of the rows staged at or after
  ;; it go with them (an entry is queued in its row's own insert, so its
  ;; time and its row's fall on the same side of any statement's start)
  (func idx_pending_drop_from ((time_t at)) (out void)
    (if (== tl_pending nil) (return))
    (let ((size_t kept . 0))
      (for ((size_t i . 0)) (< i ((-> tl_pending size))) ((++ i))
        (if (< ($ (nth i (cof tl_pending)) at) at)
            (block
              (set (nth kept (cof tl_pending)) (nth i (cof tl_pending)))
              (set kept (+ kept 1)))))
      ((-> tl_pending resize) kept)))

  ;; ---- unmap: one row's entry, never the key's whole chain ----------
  ;;
  ;; AND NEVER THE SAME CHAIN TWICE IN ONE STATEMENT. A mass DELETE's
  ;; i-th row used to find its entry by walking the key's chain from the
  ;; head, past the i-1 entries the same statement had already staged
  ;; dead -- ~3200 clauses of one knowledge base cost ~30 seconds, all
  ;; of it re-reading dead links (measured from cocolog's forget_all).
  ;; Entries join a chain at its HEAD, so any two rows enter every
  ;; index's chain in the same relative order they were inserted -- and
  ;; a scan deletes them in chain order, whichever index it rides. So
  ;; each unmap REMEMBERS where it ended, per (transaction, index, key),
  ;; and the next unmap on that key starts there: the whole statement is
  ;; one walk per chain. The mark is a HINT and never an answer -- a
  ;; miss (an entry inserted since, a scan in another order) falls back
  ;; to the head, so the mark can only save work, never lose an entry.
  ;; It is transaction-stamped because only an address this transaction
  ;; itself staged dead is pinned against TRUNCATE reclaiming it; a mark
  ;; from a retired transaction is ignored, never followed.
  ;;
  ;; THE SLOT IS THE INDEX'S, NOT THE KEY'S. The table was first filed by
  ;; `key & 63' alone, and a table has more than one index: cocolog's
  ;; clauses carry a PRIMARY KEY drawn from a sequence beside the two
  ;; chain indexes (kb, name), and a sequence's keys sweep all 64 slots,
  ;; so every ~64 rows the primary key's unmap landed on the chain's slot
  ;; and evicted its mark -- and the next unmap on that chain walked from
  ;; the head again, past every newer row and every dead link. Measured
  ;; (bench/delete-bench.cpp): 0.09 ms a row with the mark intact, 1.37
  ;; with a sequence-keyed index beside it; in the server, 82% of a
  ;; forget_clauses inside this walk, 3.8 ms a row on a fresh base and
  ;; 16.6 with 14000 dead links. So the slot is chosen by the INDEX (its
  ;; address), with four sub-slots by key so a statement that alternates
  ;; between a few keys of one index keeps a mark for each; an index's
  ;; own keys can evict only its own marks, and a miss still costs work,
  ;; never an entry.
  (struct UnmapMark
    (member size_t txn)
    (member BTreeIndex * idx)
    (member int64_t key)
    (member int64_t addr))
  (thread-local) (var UnmapMark tl_unmap_marks [256])

  (func unmap_mark_slot ((BTreeIndex * idx) (int64_t k)) (out int)
    (return (cast int (+ (* (bitand (>> (cast size_t idx) 4) 63) 4)
                         (bitand k 3)))))

  (struct BTUnmapCtx (member int64_t value) (member BTreeIndex * idx) (member int64_t found))
  (func bt_unmap_vcb ((void * c) (int64_t counter) (BTValue * v)) (out bool)
    (cast void counter)
    (let ((BTUnmapCtx * uc . #'(cast (BTUnmapCtx *) c)))
      (if (== (-> v value) (-> uc value))
          (block
            (set (-> uc found) ($ (-> v pointer) address))
            (bt_delete_value (-> uc idx) v)
            (return #f)))
      (return #t)))

  (decl) (func bt_unmap_rec ((BTreeIndex * idx) (BTNode * node) (int64_t k) (int64_t value)) (out void))
  (func bt_unmap_rec ((BTreeIndex * idx) (BTNode * node) (int64_t k) (int64_t value)) (out void)
    (let ((int64_t tmp . #'(-> node keys_address))
          (int stop . 0))
      (while (and (> tmp -1) (== stop 0))
        (let ((BTKey cur))
          (bt_key_read idx tmp (aof cur))
          (set tmp ($ cur right_address))
          (cond
            ((< k ($ cur key))
             (if (!= (-> node is_internal) 0)
                 (block
                   (let ((BTNode left_node))
                     (bt_node_read idx ($ cur left_node_address) (aof left_node))
                     (bt_unmap_rec idx (aof left_node) k value))
                   (set stop 1))))
            ((== k ($ cur key))
             (block
               (let ((BTUnmapCtx uc)
                     (int slot . #'(unmap_mark_slot idx k))
                     (UnmapMark * mark . #'(aof (nth slot tl_unmap_marks))))
                 (set ($ uc value) value)
                 (set ($ uc idx) idx)
                 (set ($ uc found) -1)
                 ;; this transaction's mark on this (index, key): resume there
                 (if (!= tl_txn nil)
                     (if (and (== (-> mark txn) (-> tl_txn id))
                              (and (== (-> mark idx) idx)
                                   (and (== (-> mark key) k)
                                        (> (-> mark addr) -1))))
                         (bt_walk_values_from idx (-> mark addr)
                                              (cast (void *) (aof uc)) bt_unmap_vcb)))
                 ;; the hint missed, or there was none: the head answers
                 (if (== ($ uc found) -1)
                     (bt_walk_values idx (aof cur) (cast (void *) (aof uc)) bt_unmap_vcb))
                 (if (!= tl_txn nil)
                     (if (> ($ uc found) -1)
                         (block
                           (set (-> mark txn) (-> tl_txn id))
                           (set (-> mark idx) idx)
                           (set (-> mark key) k)
                           (set (-> mark addr) ($ uc found))))))
               (set stop 1)))
            (#t
             (if (and (!= (-> node is_internal) 0)
                      (== ($ cur right_address) -1))
                 (block
                   (let ((BTNode right_node))
                     (bt_node_read idx ($ cur right_node_address) (aof right_node))
                     (bt_unmap_rec idx (aof right_node) k value))
                   (set stop 1)))))))))

  (func bt_unmap ((BTreeIndex * idx) (int64_t k) (int64_t value)) (out void)
    (dba_watch2 (-> idx m) "BTreeIndex unmap" k value)
    ;; a log keeps the entry: the row it names says it is dead
    (if (== (-> idx root_address) LOG_ROOT) (return))
    ;; the value to mark may still be queued
    (idx_pending_apply)
    (letin* ((streams (Streams (-> idx m))))
      (if (!= (-> idx root_address) -1)
          (let ((BTNode root_node))
            (bt_node_read idx (-> idx root_address) (aof root_node))
            (bt_unmap_rec idx (aof root_node) k value)))
      (cast void 0)))

  ;; locate one key's record by equal-descent -- the read-only half of
  ;; the map descent, for the composite unmap
  (decl) (func bt_find_key ((BTreeIndex * idx) (int64_t node_address) (int64_t k)
                            (BTKey * out)) (out bool))
  (func bt_find_key ((BTreeIndex * idx) (int64_t node_address) (int64_t k)
                     (BTKey * out)) (out bool)
    (let ((BTNode node)
          (bool found . #f))
      (bt_node_read idx node_address (aof node))
      (let ((int64_t tmp . #'($ node keys_address))
            (int stop . 0))
        (while (and (> tmp -1) (== stop 0))
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))
            (cond
              ((< k ($ cur key))
               (block
                 (if (!= ($ node is_internal) 0)
                     (set found (bt_find_key idx ($ cur left_node_address) k out)))
                 (set stop 1)))
              ((== k ($ cur key))
               (block
                 (set (cof out) cur)
                 (set found #t)
                 (set stop 1)))
              (#t
               (if (and (!= ($ node is_internal) 0) (== ($ cur right_address) -1))
                   (block
                     (set found (bt_find_key idx ($ cur right_node_address) k out))
                     (set stop 1))))))))
      (return found)))

  ;; the composite unmap: descend the levels to the innermost tree and
  ;; mark the one row's value there -- keys at every level stay, exactly
  ;; as a single-level key stays with an empty chain
  (decl) (func bt_unmap_multi ((BTreeIndex * idx) (int64_t * ks) (int64_t value)) (out void))
  (func bt_unmap_multi ((BTreeIndex * idx) (int64_t * ks) (int64_t value)) (out void)
    (if (== (-> idx levels) 1)
        (block
          (bt_unmap idx (nth 0 ks) value)
          (return)))
    (if (== (-> idx is_dependent) 0) (idx_pending_apply))
    (letin* ((streams (Streams (-> idx m))))
      (if (> (-> idx root_address) -1)
          (let ((BTKey keyrec))
            (bt_key_clear (aof keyrec))
            (if (bt_find_key idx (-> idx root_address) (nth 0 ks) (aof keyrec))
                (if (> ($ keyrec dependents_address) -1)
                    (let ((BTreeIndex dep . #'(bt_dependent idx ($ keyrec dependents_address))))
                      (bt_unmap_multi (aof dep) (aof (nth 1 ks)) value))))))
      (cast void 0)))

  ;; ==================================================================
  ;; unmap_key -- TRUE key deletion, the operation the original ships
  ;; but never calls ("reached from unmap_key, which nothing calls
  ;; yet"). Unlike unmap, which marks a value dead and keeps history,
  ;; this removes the key from the tree and gives its records back to
  ;; the allocator. The upstream body has the defects of unfinished
  ;; work (see README); this port keeps its structure -- leaf unlink,
  ;; successor replacement, underflow merge through the parent's
  ;; separator, re-split on overflow -- with those corrected.
  ;; ==================================================================

  ;; the whole chain back to the allocator, for a key leaving the tree
  (func bt_free_key_values ((BTreeIndex * idx) (BTKey * key)) (out void)
    (let ((Memory * m . #'(-> idx m))
          (int64_t tmp . #'(-> key values_address)))
      (while (> tmp -1)
        ;; An unresolvable link ends the chain exactly as -1 does. This is
        ;; also what makes the walk safe against a chain that points back
        ;; into itself: freeing marks the chunks FREE, so a link that comes
        ;; around again stops resolving before it can be freed twice.
        (if (not (chain_resolves m tmp)) break)
        (let ((Pointer pointer . #'(pointer_at m (-> idx hash_key) tmp))
              (BTValue v))
          ((-> (-> m data_io) seekg) (ptr_data (aof pointer)) std::ios::beg)
          (($ v unpack) (cof (-> m data_io)))
          ;; one link ahead of the freeing, as the original insists
          (set tmp ($ v next_address))
          (free_pointer m (aof pointer))))
      (set (-> key values_address) -1)))

  ;; the in-order successor: the leftmost leaf key of a subtree
  (decl) (func bt_leftmost_key ((BTreeIndex * idx) (int64_t node_address) (BTKey * out)) (out void))
  (func bt_leftmost_key ((BTreeIndex * idx) (int64_t node_address) (BTKey * out)) (out void)
    (let ((BTNode n))
      (bt_node_read idx node_address (aof n))
      (let ((BTKey first))
        (bt_key_read idx ($ n keys_address) (aof first))
        (if (!= ($ n is_internal) 0)
            (bt_leftmost_key idx ($ first left_node_address) out)
          (set (cof out) first)))))

  ;; merge the two children around one separator: the separator leaves
  ;; the parent, demotes between the left child's last key and the right
  ;; child's first, ADOPTING the boundary children (the original zeroes
  ;; them, which loses two subtrees on an internal merge), and the right
  ;; child's node record goes back to the allocator.
  (func bt_combine_nodes ((BTreeIndex * idx) (BTNode * node) (BTKey * sep)) (out void)
    (let ((Memory * m . #'(-> idx m)))
      ;; out of the parent's key list
      (if (!= (-> sep left_address) -1)
          (let ((BTKey left_key))
            (bt_key_read idx (-> sep left_address) (aof left_key))
            (set ($ left_key right_address) (-> sep right_address))
            (offline_update m (cast (BaseTable *) (aof left_key))))
        (set (-> node keys_address) (-> sep right_address)))
      (if (!= (-> sep right_address) -1)
          (let ((BTKey right_key))
            (bt_key_read idx (-> sep right_address) (aof right_key))
            ;; the merged node is the one the right neighbour now hangs on
            (set ($ right_key left_node_address) (-> sep left_node_address))
            (set ($ right_key left_address) (-> sep left_address))
            (offline_update m (cast (BaseTable *) (aof right_key)))))

      (let ((BTNode left_node)
            (BTNode right_node))
        (bt_node_read idx (-> sep left_node_address) (aof left_node))
        (bt_node_read idx (-> sep right_node_address) (aof right_node))

        ;; the left child's last key
        (let ((BTKey llast)
              (int64_t tmp . #'($ left_node keys_address)))
          (bt_key_read idx tmp (aof llast))
          (while (!= ($ llast right_address) -1)
            (bt_key_read idx ($ llast right_address) (aof llast)))

          ;; the right child's first key
          (let ((BTKey rfirst))
            (bt_key_read idx ($ right_node keys_address) (aof rfirst))

            ;; the separator demotes between them, adopting the boundary
            ;; children (both -1 when the children are leaves)
            (set (-> sep left_address) ($ ($ llast pointer) address))
            (set (-> sep right_address) ($ ($ rfirst pointer) address))
            (set (-> sep left_node_address) ($ llast right_node_address))
            (set (-> sep right_node_address) ($ rfirst left_node_address))
            (offline_update m (cast (BaseTable *) sep))

            (set ($ llast right_address) ($ (-> sep pointer) address))
            (offline_update m (cast (BaseTable *) (aof llast)))
            (set ($ rfirst left_address) ($ (-> sep pointer) address))
            (offline_update m (cast (BaseTable *) (aof rfirst)))))

        (set (-> node degree) (- (-> node degree) 1))
        (offline_update m (cast (BaseTable *) node))

        (set ($ left_node degree) (+ (+ ($ left_node degree) 1) ($ right_node degree)))
        (offline_update m (cast (BaseTable *) (aof left_node)))

        ;; the right child's NODE record goes back; its keys moved by list
        (free_pointer m (aof ($ right_node pointer)))

        ;; a merge that overflowed is re-split -- only the immediate
        ;; parent is known here, which is as much as this path ever had
        (if (> ($ left_node degree) (-> idx max_degree))
            (let ((BTNode * one [1]))
              (set (nth 0 one) node)
              (bt_split_node idx one 1 (aof left_node))))

        ;; the root shrinks only when the emptied parent IS the root --
        ;; the original sets the root on any degree-zero node
        (if (and (== (-> node degree) 0)
                 (== ($ (-> node pointer) address) (-> idx root_address)))
            (block
              (set (-> idx root_address) ($ ($ left_node pointer) address))
              (if (== (-> idx is_dependent) 0)
                  (bt_update_record idx)))))))

  (decl) (func bt_unmap_key_rec ((BTreeIndex * idx) (BTNode * parent_node) (BTKey * parent_key)
                                 (BTNode * node) (int64_t k)) (out void))
  (func bt_unmap_key_rec ((BTreeIndex * idx) (BTNode * parent_node) (BTKey * parent_key)
                          (BTNode * node) (int64_t k)) (out void)
    (let ((Memory * m . #'(-> idx m))
          (BTKey left_key)
          (int64_t tmp . #'(-> node keys_address))
          (int64_t index . 0)
          (int stop . 0))
      (while (and (> tmp -1) (== stop 0))
        (let ((BTKey cur))
          (bt_key_read idx tmp (aof cur))
          (set tmp ($ cur right_address))

          (cond
            ((< k ($ cur key))
             (block
               (if (!= (-> node is_internal) 0)
                   (let ((BTNode child))
                     (bt_node_read idx ($ cur left_node_address) (aof child))
                     (bt_unmap_key_rec idx node (aof cur) (aof child) k)))
               (set stop 1)))

            ((== k ($ cur key))
             (block
               (if (!= (-> node is_internal) 0)
                   ;; an internal key: its own values go back, then the
                   ;; in-order successor's payload takes its place and
                   ;; the successor is deleted out of the right subtree.
                   ;; (The original lifts the right child's FIRST key,
                   ;; which is the successor only when that child is a
                   ;; leaf, and then combines with the freed key.)
                   (block
                     (bt_free_key_values idx (aof cur))
                     (let ((BTKey succ))
                       (bt_leftmost_key idx ($ cur right_node_address) (aof succ))
                       (set ($ cur key) ($ succ key))
                       (set ($ cur values_address) ($ succ values_address))
                       (set ($ cur dependents_address) ($ succ dependents_address))
                       (offline_update m (cast (BaseTable *) (aof cur)))
                       ;; the payload moved: strip the leaf copy so its
                       ;; deletion frees nothing that is now the key's
                       (set ($ succ values_address) -1)
                       (set ($ succ dependents_address) -1)
                       (offline_update m (cast (BaseTable *) (aof succ)))
                       (let ((BTNode child))
                         (bt_node_read idx ($ cur right_node_address) (aof child))
                         (bt_unmap_key_rec idx node (aof cur) (aof child) ($ cur key)))))
                 ;; a leaf key: unlink, free the chain, free the record
                 (block
                   (bt_free_key_values idx (aof cur))
                   (cond
                     ((== index 0)
                      (block
                        (set (-> node degree) (- (-> node degree) 1))
                        (set (-> node keys_address) ($ cur right_address))
                        (offline_update m (cast (BaseTable *) node))
                        (if (!= ($ cur right_address) -1)
                            (let ((BTKey right_key))
                              (bt_key_read idx ($ cur right_address) (aof right_key))
                              (set ($ right_key left_address) -1)
                              (offline_update m (cast (BaseTable *) (aof right_key)))))))
                     ((== index (- (-> node degree) 1))
                      (block
                        (set (-> node degree) (- (-> node degree) 1))
                        (offline_update m (cast (BaseTable *) node))
                        (set ($ left_key right_address) -1)
                        (offline_update m (cast (BaseTable *) (aof left_key)))))
                     (#t
                      (block
                        (set (-> node degree) (- (-> node degree) 1))
                        (offline_update m (cast (BaseTable *) node))
                        (set ($ left_key right_address) ($ cur right_address))
                        (offline_update m (cast (BaseTable *) (aof left_key)))
                        (let ((BTKey right_key))
                          (bt_key_read idx ($ cur right_address) (aof right_key))
                          (set ($ right_key left_address) ($ cur left_address))
                          (offline_update m (cast (BaseTable *) (aof right_key)))))))
                   (free_pointer m (aof ($ cur pointer)))))
               (set stop 1)))

            (#t
             (if (and (!= (-> node is_internal) 0)
                      (== ($ cur right_address) -1))
                 (block
                   (let ((BTNode child))
                     (bt_node_read idx ($ cur right_node_address) (aof child))
                     (bt_unmap_key_rec idx node (aof cur) (aof child) k))
                   (set stop 1)))))

          (set left_key cur)
          (set index (+ index 1))))

      ;; the underflow ripples up: each frame asks about its own node
      ;; once the work below it is done
      (if (and (< (-> node degree) (-> idx min_degree))
               (!= parent_node nil))
          (bt_combine_nodes idx parent_node parent_key))))

  (func bt_unmap_key ((BTreeIndex * idx) (int64_t k)) (out void)
    ;; the composite semantics upstream are unfinished (the outer key
    ;; goes wholesale, taking other tuples with it); refuse loudly
    (dba_watch1 (-> idx m) "BTreeIndex unmap_key" k)
    (if (> (-> idx levels) 1)
        (throw* (IndexException "unmap_key is single-level only")))
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_unmap_key (log_of idx) k)
          (return)))
    (letin* ((streams (Streams (-> idx m))))
      ;; deletes and combines can move the rightmost leaf
      (bt_tail_forget idx -1)
      (if (> (-> idx root_address) -1)
          (let ((BTNode root))
            (bt_node_read idx (-> idx root_address) (aof root))
            (bt_unmap_key_rec idx nil nil (aof root) k)))
      (cast void 0)))

  ;; ---- the in-order key walk every cursor is built on ----------------
  ;;
  ;;     c0   k0   c1   k1   c2   k2   c3
  ;;
  ;; c0 is k0.left_node_address and c(i+1) is k(i).right_node_address;
  ;; consecutive keys share a child, so the walk descends the left child
  ;; of the FIRST key only and then alternates key, right child.
  (decl) (func bt_walk_keys_rec ((BTreeIndex * idx) (int64_t node_address) (void * ctx)
                                 (func kcb ((void * c) (BTKey * key)) (out bool))) (out bool))
  (func bt_walk_keys_rec ((BTreeIndex * idx) (int64_t node_address) (void * ctx)
                          (func kcb ((void * c) (BTKey * key)) (out bool))) (out bool)
    (let ((BTNode node))
      (bt_node_read idx node_address (aof node))
      (let ((int64_t tmp . #'($ node keys_address))
            (int64_t index . 0)
            ;; the key chain is edited in place exactly as a value chain is,
            ;; so it tears the same way: the same resolve check and Brent's
            ;; cycle check as bt_walk_values, ending the chain at a torn link
            (int64_t brent_mark . -2)
            (int64_t brent_steps . 0)
            (int64_t brent_limit . 2))
        ;; an all-zero node is a torn offline insert's shape: degree 0 with
        ;; a keys head of 0, which no real node writes -- an empty head is -1
        (if (and (== tmp 0) (== ($ node degree) 0))
            (set tmp -1))
        (while (> tmp -1)
          (if (not (chain_resolves (-> idx m) tmp)) break)
          (if (== tmp brent_mark) break)
          (set brent_steps (+ brent_steps 1))
          (if (== brent_steps brent_limit)
              (block
                (set brent_mark tmp)
                (set brent_steps 0)
                (set brent_limit (* brent_limit 2))))
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))
            (if (and (!= ($ node is_internal) 0) (== index 0))
                (if (not (bt_walk_keys_rec idx ($ cur left_node_address) ctx kcb))
                    (return #f)))
            (if (not (kcb ctx (aof cur)))
                (return #f))
            (if (!= ($ node is_internal) 0)
                (if (not (bt_walk_keys_rec idx ($ cur right_node_address) ctx kcb))
                    (return #f))))
          (set index (+ index 1)))))
    (return #t))

  ;; ---- _cursor_output: a key's rows to the caller --------------------
  ;; The value record answered the visibility question already -- it is
  ;; the row's transactional twin -- so the row itself is read plainly,
  ;; and THE STREAMS GO BACK around the caller's callback.
  (struct BTRowsCtx
    (member BTreeIndex * idx)
    (member void * user)
    (member func rcb ((void * c) (Pointer * p)) (out bool))
    (member int cont))

  (func bt_output_vcb ((void * c) (int64_t counter) (BTValue * v)) (out bool)
    (cast void counter)
    (let ((BTRowsCtx * rc . #'(cast (BTRowsCtx *) c)))
      (let ((Memory * m . #'(-> (-> rc idx) m)))
        ;; a value naming a row that no longer resolves is debris of a torn
        ;; edit: skip it and keep walking, as the chain links themselves do
        (if (not (chain_resolves m (-> v value)))
            (return #t))
        (let ((Pointer row_ptr . #'(pointer_at m (-> (-> rc idx) table_key) (-> v value)))
              ;; WHICHEVER SIDE THIS THREAD HOLDS, not the exclusive one
              ;; alone. A lookup holding the shared guard released nothing
              ;; here while this read only the exclusive name, so its
              ;; callback ran with the guard still held -- and a callback
              ;; that WRITES then met an exclusive guard constructed under a
              ;; shared one, the case lock() refuses. That was the whole
              ;; blocker on the 98 % ZiguratIP#37 measured.
              (Streams * held . #'(? (!= tl_streams_held nil)
                                     (cast (Streams *) tl_streams_held)
                                     (cast (Streams *) tl_streams_shared)))
              ;; THE UNLOCKED WINDOW READS PRIVATELY. The guard goes back
              ;; around the callback so it can nest engine work -- and any
              ;; read the callback itself does (read_row above all) must
              ;; NOT touch the canonical streams, whose positions now
              ;; belong to whichever thread holds the lock. Unmarked, the
              ;; row unpacked from wherever another cursor had seeked the
              ;; canonical stream: an id of 0, an unmap that found no key
              ;; and said nothing, the old entry left alive for the unique
              ;; check to refuse -- contention_test's `rewrite vs index',
              ;; red on every run. Flagging read_mode for the window sends
              ;; hex_in/data_in to the thread's private reader; a callback
              ;; that WRITES takes its own guard, which routes its reads
              ;; back to the canonical stream it is then sole holder of.
              (int old_rm . tl_window_reads))
          ;; the flag flips ONLY when an exclusive guard was actually
          ;; released: that is the one case where another thread can now
          ;; hold the canonical streams. A guard-less single-threaded
          ;; caller keeps canonical -- its own unflushed bytes live there.
          ;; and only for a store that HAS private readers to give --
          ;; reader_eligible is the same gate a shared guard passes.
          (let ((int flip . #'(? (and (!= held nil) (== 1 (reader_eligible m))) 1 0)))
            (if (!= held nil) ((-> held unlock)))
            (if (== flip 1) (set tl_window_reads 1))
            (set (-> rc cont) (? ((-> rc rcb) (-> rc user) (aof row_ptr)) 1 0))
            (if (== flip 1) (set tl_window_reads old_rm))
            (if (!= held nil) ((-> held lock))))
          (return (== (-> rc cont) 1))))))

  (func bt_cursor_output ((BTreeIndex * idx) (BTKey * key) (void * user)
                          (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool)
    (let ((BTRowsCtx rc))
      (set ($ rc idx) idx)
      (set ($ rc user) user)
      (set ($ rc rcb) rcb)
      ;; true unless the callback stops: an unmapped row leaves its key
      ;; behind with an empty bucket, and that is not a reason to end
      (set ($ rc cont) 1)
      (bt_walk_values idx key (cast (void *) (aof rc)) bt_output_vcb)
      (return (== ($ rc cont) 1))))

  ;; what a qualifying key yields depends on the level: rows where this
  ;; level holds the value chains, the DEPENDENT INDEX where it does not
  ;; -- the caller's dep callback receives it under the streams, exactly
  ;; as the original hands its stack-built dependent_index over
  (struct BTEmit
    (member BTreeIndex * idx)
    (member void * user)
    (member func rcb ((void * c) (Pointer * p)) (out bool))
    (member func dcb ((void * c) (BTreeIndex * dep)) (out bool))
    (member int cont))

  (func bt_no_rows ((void * c) (Pointer * p)) (out bool)
    (cast void c) (cast void p) (return #t))
  (func bt_no_deps ((void * c) (BTreeIndex * d)) (out bool)
    (cast void c) (cast void d) (return #t))

  (func bt_emit_key ((BTEmit * em) (BTKey * key)) (out bool)
    (let ((BTreeIndex * idx . #'(-> em idx))
          (bool cont . #t))
      (if (> (-> idx levels) 1)
          (block
            ;; THE DEPENDENT CALLBACK HAS NO WINDOW -- the guard is held
            ;; across it, unlike the row callback below, which hands it
            ;; back through bt_output_vcb. That is why bt_cursor_dep and
            ;; bt_cursor_equal_dep keep the EXCLUSIVE side while the seven
            ;; row cursors ask for the shared one: a callback that writes
            ;; rides an exclusive hold as a nested no-op, and would meet
            ;; the "exclusive under shared" refusal on a shared one. A
            ;; window here would let the dep pair go shared too; it would
            ;; also be a new unlocked window in the machinery ZiguratIP#33
            ;; was fixed in, and it is not free to add.
            (if (> (-> key dependents_address) -1)
                (let ((BTreeIndex dep . #'(bt_dependent idx (-> key dependents_address))))
                  (set cont ((-> em dcb) (-> em user) (aof dep))))))
        (set cont (bt_cursor_output idx key (-> em user) (-> em rcb))))
      (set (-> em cont) (? cont 1 0))
      (return cont)))

  (func bt_emit_kcb ((void * c) (BTKey * key)) (out bool)
    (return (bt_emit_key (cast (BTEmit *) c) key)))

  ;; ---- the seven cursors ---------------------------------------------
  (func bt_cursor ((BTreeIndex * idx) (void * user)
                   (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (return (log_cursor (log_of idx) LOG_ALL 0 user rcb)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; a read, so it asks for the shared side -- see bt_cursor_equal
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_walk_keys_rec idx (-> idx root_address)
                                     (cast (void *) (aof em)) bt_emit_kcb)
                   (cast void 0)))
        (cast void 0))
      (return (== ($ em cont) 1))))

  ;; the full walk handing DEPENDENT INDEXES to the callback -- the
  ;; composite counterpart of bt_cursor, as the variadic class shapes it
  (func bt_cursor_dep ((BTreeIndex * idx) (void * user)
                       (func dcb ((void * c) (BTreeIndex * dep)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    ;; a log index is single-level: it has no dependents to hand over
    (if (== (-> idx root_address) LOG_ROOT) (return #t))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) bt_no_rows)
      (set ($ em dcb) dcb)
      (set ($ em cont) 1)
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_walk_keys_rec idx (-> idx root_address)
                                     (cast (void *) (aof em)) bt_emit_kcb)
                   (cast void 0)))
        (cast void 0))
      (return (== ($ em cont) 1))))

  (decl) (func bt_equal_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k)
                             (BTEmit * em)) (out bool))
  (func bt_equal_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k)
                      (BTEmit * em)) (out bool)
    (let ((BTNode node)
          (bool do_continue . #t))
      (bt_node_read idx node_address (aof node))
      (let ((int64_t tmp . #'($ node keys_address))
            (int stop . 0))
        (while (and (> tmp -1) (== stop 0))
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))
            (cond
              ((< k ($ cur key))
               (block
                 ;; everything from here on is larger: the child between
                 ;; the previous key and this one, or nowhere
                 (if (!= ($ node is_internal) 0)
                     (set do_continue (bt_equal_rec idx ($ cur left_node_address) k em)))
                 (set stop 1)))
              ((== k ($ cur key))
               (block
                 (set do_continue (bt_emit_key em (aof cur)))
                 (set stop 1)))
              (#t
               ;; only past the last key does the rightmost child count
               (if (and (!= ($ node is_internal) 0) (== ($ cur right_address) -1))
                   (block
                     (set do_continue (bt_equal_rec idx ($ cur right_node_address) k em))
                     (set stop 1))))))))
      (return do_continue)))

  (func bt_cursor_equal ((BTreeIndex * idx) (int64_t k) (void * user)
                         (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (return (log_cursor (log_of idx) LOG_EQ k user rcb)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; THE SHARED ASK, SECOND ATTEMPT -- and it is only safe because of
      ;; the gate in Streams::lock above. 0dd8b2a asked for the shared side
      ;; here without one and LIVELOCKED on four cores: six readers in a
      ;; tight `do { cursor_equal } while (writing)' loop overlapped
      ;; continuously and the writer they were waiting on was granted the
      ;; guard zero times in 120 rounds, because glibc let every one of
      ;; 36.7 million shared acquisitions barge a queued writer. With the
      ;; gate a queued writer is respected by the engine rather than by the
      ;; platform, and this becomes what the measurement always said it
      ;; was: 98 % of a reading thread's occupancy of the one guard, given
      ;; back. reader_eligible is the same gate read_row passes in
      ;; e8ada3f, 0 at REPEATABLE READ and SERIALIZABLE where a read stamps
      ;; row locks.
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_equal_rec idx (-> idx root_address) k (aof em))
                   (cast void 0)))
        (cast void 0))
      (return (== ($ em cont) 1))))

  (func bt_cursor_equal_dep ((BTreeIndex * idx) (int64_t k) (void * user)
                             (func dcb ((void * c) (BTreeIndex * dep)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT) (return #t))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) bt_no_rows)
      (set ($ em dcb) dcb)
      (set ($ em cont) 1)
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_equal_rec idx (-> idx root_address) k (aof em))
                   (cast void 0)))
        (cast void 0))
      (return (== ($ em cont) 1))))

  ;; a full walk with one key held back
  (decl) (func bt_not_equal_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k)
                                 (BTEmit * em)) (out bool))
  (func bt_not_equal_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k)
                          (BTEmit * em)) (out bool)
    (let ((BTNode node))
      (bt_node_read idx node_address (aof node))
      (let ((int64_t tmp . #'($ node keys_address))
            (int64_t index . 0))
        (while (> tmp -1)
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))
            (if (and (!= ($ node is_internal) 0) (== index 0))
                (if (not (bt_not_equal_rec idx ($ cur left_node_address) k em))
                    (return #f)))
            (if (!= k ($ cur key))
                (if (not (bt_emit_key em (aof cur)))
                    (return #f)))
            (if (!= ($ node is_internal) 0)
                (if (not (bt_not_equal_rec idx ($ cur right_node_address) k em))
                    (return #f))))
          (set index (+ index 1)))))
    (return #t))

  (func bt_cursor_not_equal ((BTreeIndex * idx) (int64_t k) (void * user)
                             (func rcb ((void * c) (Pointer * p)) (out bool))) (out void)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_cursor (log_of idx) LOG_NE k user rcb)
          (return)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; a read, so it asks for the shared side -- see bt_cursor_equal
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_not_equal_rec idx (-> idx root_address) k (aof em))
                   (cast void 0)))
        (cast void 0))))

  ;; in order from the smallest key, stopped at the bound
  (decl) (func bt_less_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k) (int or_equal)
                            (BTEmit * em)) (out bool))
  (func bt_less_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k) (int or_equal)
                     (BTEmit * em)) (out bool)
    (let ((BTNode node))
      (bt_node_read idx node_address (aof node))
      (let ((int64_t tmp . #'($ node keys_address))
            (int64_t index . 0))
        (while (> tmp -1)
          (let ((BTKey cur))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))
            (if (and (!= ($ node is_internal) 0) (== index 0))
                (if (not (bt_less_rec idx ($ cur left_node_address) k or_equal em))
                    (return #f)))
            ;; at or above the bound: the straddling child is already walked
            (if (== or_equal 0)
                (if (not (< ($ cur key) k)) (return #t))
              (if (< k ($ cur key)) (return #t)))
            (if (not (bt_emit_key em (aof cur)))
                (return #f))
            ;; keys are distinct in the tree: once the bound itself has
            ;; been emitted there is nothing above it left to match
            (if (and (!= or_equal 0) (== k ($ cur key))) (return #t))
            (if (!= ($ node is_internal) 0)
                (if (not (bt_less_rec idx ($ cur right_node_address) k or_equal em))
                    (return #f))))
          (set index (+ index 1)))))
    (return #t))

  (func bt_cursor_less_than ((BTreeIndex * idx) (int64_t k) (void * user)
                             (func rcb ((void * c) (Pointer * p)) (out bool))) (out void)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_cursor (log_of idx) LOG_LT k user rcb)
          (return)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; a read, so it asks for the shared side -- see bt_cursor_equal
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_less_rec idx (-> idx root_address) k 0 (aof em))
                   (cast void 0)))
        (cast void 0))))

  (func bt_cursor_less_than_equal ((BTreeIndex * idx) (int64_t k) (void * user)
                                   (func rcb ((void * c) (Pointer * p)) (out bool))) (out void)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_cursor (log_of idx) LOG_LE k user rcb)
          (return)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; a read, so it asks for the shared side -- see bt_cursor_equal
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_less_rec idx (-> idx root_address) k 1 (aof em))
                   (cast void 0)))
        (cast void 0))))

  ;; skip forward to the bound, then walk in order to the end; only the
  ;; first qualifying key needs its left child descended
  (decl) (func bt_greater_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k) (int or_equal)
                               (BTEmit * em)) (out bool))
  (func bt_greater_rec ((BTreeIndex * idx) (int64_t node_address) (int64_t k) (int or_equal)
                        (BTEmit * em)) (out bool)
    (let ((BTNode node)
          (int started . 0))
      (bt_node_read idx node_address (aof node))
      (let ((int64_t tmp . #'($ node keys_address)))
        (while (> tmp -1)
          (let ((BTKey cur)
                (int below . 0))
            (bt_key_read idx tmp (aof cur))
            (set tmp ($ cur right_address))

            (if (== started 0)
                (block
                  (if (== or_equal 0)
                      (set below (? (not (< k ($ cur key))) 1 0))
                    (set below (? (< ($ cur key) k) 1 0)))
                  (if (== below 1)
                      ;; still at or below the bound: the rightmost child
                      ;; is the only one left once the keys run out
                      (block
                        (if (and (!= ($ node is_internal) 0)
                                 (== ($ cur right_address) -1))
                            (return (bt_greater_rec idx ($ cur right_node_address)
                                                    k or_equal em)))
                        continue))
                  (set started 1)
                  (if (!= ($ node is_internal) 0)
                      (if (not (bt_greater_rec idx ($ cur left_node_address)
                                               k or_equal em))
                          (return #f)))))

            (if (not (bt_emit_key em (aof cur)))
                (return #f))
            (if (!= ($ node is_internal) 0)
                (if (not (bt_greater_rec idx ($ cur right_node_address)
                                         k or_equal em))
                    (return #f)))))))
    (return #t))

  (func bt_cursor_greater_than ((BTreeIndex * idx) (int64_t k) (void * user)
                                (func rcb ((void * c) (Pointer * p)) (out bool))) (out void)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_cursor (log_of idx) LOG_GT k user rcb)
          (return)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; a read, so it asks for the shared side -- see bt_cursor_equal
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_greater_rec idx (-> idx root_address) k 0 (aof em))
                   (cast void 0)))
        (cast void 0))))

  (func bt_cursor_greater_than_equal ((BTreeIndex * idx) (int64_t k) (void * user)
                                      (func rcb ((void * c) (Pointer * p)) (out bool))) (out void)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_cursor (log_of idx) LOG_GE k user rcb)
          (return)))
    (let ((BTEmit em))
      (set ($ em idx) idx)
      (set ($ em user) user)
      (set ($ em rcb) rcb)
      (set ($ em dcb) bt_no_deps)
      (set ($ em cont) 1)
      ;; a read, so it asks for the shared side -- see bt_cursor_equal
      (if (== 1 (reader_eligible (-> idx m))) (set tl_want_shared 1))
      (letin* ((statement (Statement (-> idx m)))
               (streams (Streams (-> idx m))))
        (if (> (-> idx root_address) -1)
            (block (bt_greater_rec idx (-> idx root_address) k 1 (aof em))
                   (cast void 0)))
        (cast void 0))))

  ;; ---- the composite walks over the whole level stack ----------------

  ;; every row under a composite index, levels descended automatically
  (struct BTDeepCtx
    (member void * user)
    (member func rcb ((void * c) (Pointer * p)) (out bool))
    (member int cont))

  (decl) (func bt_cursor_rows_deep ((BTreeIndex * idx) (void * user)
                                    (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool))

  (func bt_deep_dcb ((void * c) (BTreeIndex * dep)) (out bool)
    (let ((BTDeepCtx * dc . #'(cast (BTDeepCtx *) c)))
      (set (-> dc cont) (? (bt_cursor_rows_deep dep (-> dc user) (-> dc rcb)) 1 0))
      (return (== (-> dc cont) 1))))

  (func bt_cursor_rows_deep ((BTreeIndex * idx) (void * user)
                             (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx levels) 1)
        (return (bt_cursor idx user rcb)))
    (let ((BTDeepCtx dc))
      (set ($ dc user) user)
      (set ($ dc rcb) rcb)
      (set ($ dc cont) 1)
      (bt_cursor_dep idx (cast (void *) (aof dc)) bt_deep_dcb)
      (return (== ($ dc cont) 1))))

  ;; equality on the whole tuple: equal at each level, rows at the last
  (struct BTEqChainCtx
    (member int64_t * ks)
    (member void * user)
    (member func rcb ((void * c) (Pointer * p)) (out bool))
    (member int cont))

  (decl) (func bt_cursor_equal_multi ((BTreeIndex * idx) (int64_t * ks) (void * user)
                                      (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool))

  (func bt_eqchain_dcb ((void * c) (BTreeIndex * dep)) (out bool)
    (let ((BTEqChainCtx * ec . #'(cast (BTEqChainCtx *) c)))
      (set (-> ec cont)
           (? (bt_cursor_equal_multi dep (aof (nth 1 (-> ec ks))) (-> ec user) (-> ec rcb)) 1 0))
      (return (== (-> ec cont) 1))))

  (func bt_cursor_equal_multi ((BTreeIndex * idx) (int64_t * ks) (void * user)
                               (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx levels) 1)
        (return (bt_cursor_equal idx (nth 0 ks) user rcb)))
    (let ((BTEqChainCtx ec))
      (set ($ ec ks) ks)
      (set ($ ec user) user)
      (set ($ ec rcb) rcb)
      (set ($ ec cont) 1)
      (bt_cursor_equal_dep idx (nth 0 ks) (cast (void *) (aof ec)) bt_eqchain_dcb)
      (return (== ($ ec cont) 1))))

  ;; ---- truncate: unlink the settled dead values, then reclaim --------
  (func bt_unlink_dead_values ((BTreeIndex * idx) (BTKey * key)) (out void)
    (let ((Memory * m . #'(-> idx m))
          (BTValue previous)
          (int has_previous . 0)
          (int64_t tmp . #'(-> key values_address))
          ;; the same Brent's cycle check as the values walk: this is the
          ;; walk the C++ vacuum was measured spinning in
          (int64_t brent_mark . -2)
          (int64_t brent_steps . 0)
          (int64_t brent_limit . 2))
      (while (> tmp -1)
        ;; an unresolvable or revisited link ends the chain exactly as -1 does
        (if (not (chain_resolves m tmp)) break)
        (if (== tmp brent_mark) break)
        (set brent_steps (+ brent_steps 1))
        (if (== brent_steps brent_limit)
            (block
              (set brent_mark tmp)
              (set brent_steps 0)
              (set brent_limit (* brent_limit 2))))
        (let ((Pointer pointer . #'(pointer_at m (-> idx hash_key) tmp))
              (BTValue v)
              (Control control))
          (control_clear (aof control))
          ((-> (-> m data_io) seekg) (ptr_data (aof pointer)) std::ios::beg)
          (($ v unpack) (cof (-> m data_io)))
          (set ($ v pointer) pointer)
          (set tmp ($ v next_address))

          (load_control m (aof pointer) (aof control))
          ;; settled, as _dead_pointers means it: the chain is closed over
          ;; the dead link BEFORE its space can be asked for
          (if (and (or (== ($ control offline_state) ROW_DELETED)
                       (== ($ control offline_state) ROW_UPDATED))
                   (and (== ($ control online_state) ROW_NONE)
                        (== ($ control online_lock) LOCK_NONE)))
              (if (== has_previous 1)
                  (block
                    (set ($ previous next_address) ($ v next_address))
                    (offline_update m (cast (BaseTable *) (aof previous))))
                (block
                  (set (-> key values_address) ($ v next_address))
                  (offline_update m (cast (BaseTable *) key))))
            (block
              (set previous v)
              (set has_previous 1)))))))

  ;; down through the dependents: an outer level's keys hold no values
  ;; of their own, so the chains to unlink live at the innermost level
  (decl) (func bt_unlink_dead ((BTreeIndex * idx)) (out void))

  (func bt_unlink_kcb ((void * c) (BTKey * key)) (out bool)
    (let ((BTreeIndex * idx . #'(cast (BTreeIndex *) c)))
      (if (> (-> idx levels) 1)
          (block
            (if (> (-> key dependents_address) -1)
                (let ((BTreeIndex dep . #'(bt_dependent idx (-> key dependents_address))))
                  (bt_unlink_dead (aof dep)))))
        (bt_unlink_dead_values idx key))
      (return #t)))

  (func bt_unlink_dead ((BTreeIndex * idx)) (out void)
    (if (> (-> idx root_address) -1)
        (block (bt_walk_keys_rec idx (-> idx root_address)
                                 (cast (void *) idx) bt_unlink_kcb)
               (cast void 0))))

  ;; two hash keys to sweep for a composite, not one: every dependent
  ;; level shares dep_hash_key, which is not the top level's own
  (func bt_truncate ((BTreeIndex * idx) (Memory * m)) (out size_t)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (return (log_truncate (log_of idx))))
    (block
      (letin* ((streams (Streams (-> idx m))))
        ;; values only, the keys stay -- forgotten anyway, it is cheap
        (bt_tail_forget idx -1)
        (bt_unlink_dead idx)
        (cast void 0)))
    (let ((size_t freed . #'(truncate_key m (-> idx hash_key))))
      (if (> (-> idx levels) 1)
          (set freed (+ freed (truncate_key m (-> idx dep_hash_key)))))
      (return freed)))

  ;; ---- rebuild: drop the whole index, then map the live rows again --
  ;; What bt_truncate cannot reach is the point: it unlinks DEAD VALUE
  ;; records, but the keys, the nodes and the once-dead values' key rows
  ;; stay -- "keys at every level stay" is the unmap contract -- so an
  ;; index over a churning table grows by every id it has ever seen, and
  ;; a walk pays for all of them forever. Four such indexes held 72 of a
  ;; vacuumed store's 168 pages with twelve rows alive. A truncate is the
  ;; one moment the table is at its smallest, so instead of sweeping the
  ;; index it is REBUILT there: every page under its keys goes back to
  ;; the allocator wholesale, and the survivors -- read through the
  ;; table's own cursor -- are mapped into a fresh tree.
  (func drop_key_pages ((Memory * m) (const uint8_t * key)) (out void)
    ;; whole pages go back: every cached record of this key is stale
    (bt_cache_reset m)
    (pthread_mutex_lock (aof (-> m page_list_access)))
    (pthread_mutex_lock (aof (-> m free_list_access)))
    ;; the key's free entries first: their space is about to sit inside
    ;; __FREE__ pages and must not be handed out under the old key
    (let ((int64_t base . #'(* (key_bucket key) FREE_CLASSES)))
      (for ((int64_t c . 0)) (< c FREE_CLASSES) ((++ c))
        (let ((FreeEntry * prev . nil)
              (FreeEntry * e . #'(nth (+ base c) (-> m free_heads))))
          (while (!= e nil)
            (if (== 0 (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)))
                (let ((FreeEntry * dead . e))
                  (set e (-> e next))
                  (if (== prev nil) (set (nth (+ base c) (-> m free_heads)) e) (set (-> prev next) e))
                  (delete* dead))
              (block
                (set prev e)
                (set e (-> e next))))))))
    ;; the key's own chain, and the next link is taken BEFORE the rekey
    ;; moves this entry out of it -- the two chains can be one bucket
    (let ((PageEntry * e . #'(page_chain m key))
          (PageEntry * nxt . nil))
      (while (!= e nil)
        (set nxt (-> e key_next))
        (if (== 0 (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)))
            (block
              (allocate_page m FREE_HASHKEY (-> e address))
              (page_rekey m e FREE_HASHKEY)))
        (set e nxt)))
    (pthread_mutex_unlock (aof (-> m free_list_access)))
    (pthread_mutex_unlock (aof (-> m page_list_access))))

  (func bt_drop_storage ((BTreeIndex * idx) (Memory * m)) (out void)
    ;; this transaction's own queued entries reach the tree first
    (idx_pending_apply)
    (if (== (-> idx root_address) LOG_ROOT)
        (block
          (log_drop (log_of idx))
          (return)))
    (block
      (letin* ((streams (Streams m)))
        (drop_key_pages m (-> idx hash_key))
        (if (> (-> idx levels) 1)
            (drop_key_pages m (-> idx dep_hash_key)))
        ((-> (-> m hexmap_io) flush))
        ((-> (-> m data_io) flush))
        (cast void 0)))
    (set (-> idx root_address) -1)
    ;; the reset root has to outlive the process, or the next attach
    ;; would follow the catalogue into pages that are __FREE__ now
    (if (and (== (-> idx is_dependent) 0)
             (!= ($ (-> idx record_pointer) hash_key) nil))
        (bt_update_record idx)))

  ;; ==================================================================
  ;; THE LOG INDEX, built (the design is with the tree's deferred
  ;; maintenance, above bt_split_node)
  ;; ==================================================================
  (func log_ent_cmp ((const void * a) (const void * b)) (out int)
    (let ((const LogEnt * x . #'(cast (const LogEnt *) a))
          (const LogEnt * y . #'(cast (const LogEnt *) b)))
      (if (< (-> x key) (-> y key)) (return -1))
      (if (> (-> x key) (-> y key)) (return 1))
      (if (< (-> x value) (-> y value)) (return -1))
      (if (> (-> x value) (-> y value)) (return 1))
      (return 0)))

  (func log_addr_cmp ((const void * a) (const void * b)) (out int)
    (let ((int64_t x . #'(cof (cast (const int64_t *) a)))
          (int64_t y . #'(cof (cast (const int64_t *) b))))
      (if (< x y) (return -1))
      (if (> x y) (return 1))
      (return 0)))

  (func log_ent_before ((const LogEnt * x) (const LogEnt * y)) (out bool)
    (if (< (-> x key) (-> y key)) (return #t))
    (if (> (-> x key) (-> y key)) (return #f))
    (return (< (-> x value) (-> y value))))

  ;; the one record a log key holds: six header words, the entry count
  ;; and the entries, the list's count and the list. A META is its kind
  ;; alone; a run's HEAD is (a id, b tier, c entries, d blocks) with the
  ;; ids of the runs it replaces as its list; a run's BLOCK is (a id, b
  ;; sequence, c entries) with the entries. Host order, as every record.
  (struct LogRecord (inherits BaseTable)
    (member int64_t kind)
    (member int64_t a)
    (member int64_t b)
    (member int64_t c)
    (member int64_t d)
    (member int64_t e)
    (member logents_t ents)
    (member logaddrs_t list)
    (override) (method pack_size () (out int64_t)
      (return (+ 64 (+ (* 16 (cast int64_t (($ ($ this ents) size))))
                       (* 8 (cast int64_t (($ ($ this list) size))))))))
    (override) (method pack ((binarystream & io)) (out void)
      (($ io write_std_long) (cast int64_t ($ this kind)))
      (($ io write_std_long) (cast int64_t ($ this a)))
      (($ io write_std_long) (cast int64_t ($ this b)))
      (($ io write_std_long) (cast int64_t ($ this c)))
      (($ io write_std_long) (cast int64_t ($ this d)))
      (($ io write_std_long) (cast int64_t ($ this e)))
      (($ io write_std_long) (cast int64_t (($ ($ this ents) size))))
      (if (> (($ ($ this ents) size)) 0)
          (($ io write) (cast (const char *) (($ ($ this ents) data)))
                        (cast int64_t (* 16 (($ ($ this ents) size))))))
      (($ io write_std_long) (cast int64_t (($ ($ this list) size))))
      (if (> (($ ($ this list) size)) 0)
          (($ io write) (cast (const char *) (($ ($ this list) data)))
                        (cast int64_t (* 8 (($ ($ this list) size)))))))
    (override) (method unpack ((binarystream & io)) (out void)
      (($ io read_std_long) ($ this kind))
      (($ io read_std_long) ($ this a))
      (($ io read_std_long) ($ this b))
      (($ io read_std_long) ($ this c))
      (($ io read_std_long) ($ this d))
      (($ io read_std_long) ($ this e))
      (let ((int64_t n . 0))
        (($ io read_std_long) n)
        (if (or (< n 0) (> n 1048576)) (set n 0))
        (($ ($ this ents) resize) (cast size_t n))
        (if (> n 0)
            (($ io read) (cast (char *) (($ ($ this ents) data))) (* 16 n))))
      (let ((int64_t n . 0))
        (($ io read_std_long) n)
        (if (or (< n 0) (> n 1048576)) (set n 0))
        (($ ($ this list) resize) (cast size_t n))
        (if (> n 0)
            (($ io read) (cast (char *) (($ ($ this list) data))) (* 8 n))))))

  (func log_record_clear ((LogRecord * r) (int64_t kind)) (out void)
    (set (-> r kind) kind)
    (set (-> r a) 0)
    (set (-> r b) 0)
    (set (-> r c) 0)
    (set (-> r d) 0)
    (set (-> r e) 0)
    (($ (-> r ents) clear))
    (($ (-> r list) clear))
    (set (-> r pointer) (pointer_null)))

  ;; half a page of entries a block: two share a page, and a block never
  ;; meets allocate's ceiling
  (func log_block_cap ((Memory * m)) (out int64_t)
    (let ((int64_t cap . #'(/ (- (/ (-> m page_size) 2) 128) 16)))
      (if (< cap 16) (set cap 16))
      (return cap)))

  (func log_tier_of ((int64_t n)) (out int64_t)
    (let ((int64_t tier . 0)
          (int64_t size . LOG_BASE))
      (while (> n size)
        (set size (* size LOG_FANOUT))
        (set tier (+ tier 1)))
      (return tier)))

  ;; the log's own key: the index's, every byte turned
  (func log_key_of ((BTreeIndex * idx)) (out const uint8_t *)
    (let ((uint8_t key [20]))
      (for ((int64_t i . 0)) (< i HASHKEY_SIZE) ((++ i))
        (set (nth i key) (cast uint8_t (bitand (xor (nth i (-> idx hash_key)) 255) 255))))
      (return (intern_key key))))

  ;; whether ADDRESS names an allocated record in a page keyed KEY -- the
  ;; question every address the log holds is asked before it is read, and
  ;; a sequence's kept row too
  (func key_record_holds ((Memory * m) (const uint8_t * key) (int64_t address)) (out bool)
    (if (<= address 0) (return #f))
    (if (not (chain_resolves m address)) (return #f))
    (let ((uint8_t page_key [20])
          (int64_t page_size . #'(-> m page_size))
          (binarystream * dio . #'(data_in m)))
      (if (not ((-> dio good))) ((-> dio clear)))
      ((-> dio seekg) (* (/ address page_size) page_size) std::ios::beg)
      ((-> dio read) (cast (char *) page_key) HASHKEY_SIZE)
      (if (not ((-> dio good)))
          (block
            ((-> dio clear))
            (return #f)))
      (return (== 0 (memcmp page_key key (cast size_t HASHKEY_SIZE))))))

  ;; THE RAW WALK: every allocated record of KEY that is committed in the
  ;; offline sense, handed to CB, judged by nobody. A cursor walk would
  ;; judge -- and at REPEATABLE READ stamp a lock on what it reads, which
  ;; a log's own records must never carry. The hexmap reading is
  ;; cursor_walk's own. Under the caller's exclusive guard.
  (func key_records ((Memory * m) (const uint8_t * key) (void * ctx)
                     (func cb ((void * c) (Pointer * p)) (out void))) (out void)
    (let ((logaddrs_t pages))
      (pthread_mutex_lock (aof (-> m page_list_access)))
      (let ((PageEntry * e . #'(page_chain m key)))
        (while (!= e nil)
          (if (== (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)) 0)
              (($ pages push_back) (-> e address)))
          (set e (-> e key_next))))
      (pthread_mutex_unlock (aof (-> m page_list_access)))
      (for ((size_t pn . 0)) (< pn (($ pages size))) ((++ pn))
        (let ((int64_t page_address . #'(nth pn pages))
              (uint8_t hexbuf [4096])
              (int64_t i . PAGEFILE_CONTROL_COUNT))
          (cursor_page_hexmap m page_address hexbuf)
          (while (< i (-> m hbpp))
            (let ((uint8_t hb . #'(nth i hexbuf)))
              (if (== (bitand hb 128) 0)
                  (block
                    (set i (+ i 1))
                    continue))
              (let ((int64_t start . #'(+ (addr_hexmap page_address) i))
                    (RowState online_state . #'(cast RowState (bitand hb 12)))
                    (RowState offline_state . #'(cast RowState (bitand (nth (+ i 1) hexbuf) 12)))
                    (int64_t size . 0)
                    (bool at_end . #f)
                    (bool is_data . #f))
                (set i (+ i CONTROL_COUNT))
                (while (and (not at_end) (< i (-> m hbpp)))
                  (let ((uint8_t b . #'(nth i hexbuf)))
                    (set i (+ i 1))
                    (if (and (!= b CONTROL_STANDALONE_CHUNK) (== (bitand b 64) 64))
                        (block
                          (set at_end #t)
                          (if (and (!= b CONTROL_CHUNK) (== (bitand b 128) 128))
                              (block
                                (set is_data #t)
                                (set size (+ size (size_remainder b))))))
                      (set size (+ size CHUNK_SIZE)))))
                (if (and is_data (and (== offline_state ROW_INSERTED) (== online_state ROW_NONE)))
                    (let ((Pointer p . #'(pointer_make key (* start CHUNK_SIZE) size)))
                      (cb ctx (aof p)))))))))))

  ;; ---- the directory's runs ----------------------------------------
  ;; R loses a hold -- caller holds li->access. The last hold gone, its
  ;; records wait for a sync (log_after_sync), unless its pages already
  ;; went back wholesale.
  (func log_unref ((LogIndex * li) (LogRun * r)) (out void)
    (set (-> r refs) (- (-> r refs) 1))
    (if (> (-> r refs) 0) (return))
    (if (== (-> r dropped) 0)
        (block
          (for ((size_t bi . 0)) (< bi (($ (-> r blocks) size))) ((++ bi))
            (($ (-> li doomed) push_back) ($ (nth bi (-> r blocks)) address)))
          (if (> (-> r head) 0)
              (($ (-> li doomed) push_back) (-> r head)))))
    (delete* r))

  ;; R out of the directory -- caller holds li->access
  (func log_unlist ((LogIndex * li) (LogRun * r)) (out void)
    (let ((size_t n . #'(($ (-> li runs) size)))
          (size_t w . 0))
      (for ((size_t i . 0)) (< i n) ((++ i))
        (if (!= (nth i (-> li runs)) r)
            (block
              (set (nth w (-> li runs)) (nth i (-> li runs)))
              (set w (+ w 1)))))
      (($ (-> li runs) resize) w))
    (log_unref li r))

  ;; defined with the paced merge -- caller holds li->access
  (decl) (func log_pend_abandon ((LogIndex * li) (int doom)) (out void))

  ;; every run let go WITHOUT a record freed one by one: the pages go
  ;; back wholesale, or belong to a store this process no longer holds.
  ;; A merge under way goes first, its blocks with the rest.
  (func log_release_all ((LogIndex * li)) (out void)
    (pthread_mutex_lock (aof (-> li access)))
    (log_pend_abandon li 0)
    (for ((size_t i . 0)) (< i (($ (-> li runs) size))) ((++ i))
      (let ((LogRun * r . #'(nth i (-> li runs))))
        (set (-> r dropped) 1)
        (log_unref li r)))
    (($ (-> li runs) clear))
    (($ (-> li doomed) clear))
    (pthread_mutex_unlock (aof (-> li access))))

  ;; a cursor's hold on the runs it walks: a merge finished by another
  ;; thread's commit -- which may run inside this cursor's callback window
  ;; -- cannot free a block this walk has yet to read
  (struct LogSnap
    (member LogIndex * li)
    (member logruns_t runs)
    (ctor ((LogIndex * l))
      (init (li l))
      (pthread_mutex_lock (aof (-> l access)))
      (set ($ this runs) (-> l runs))
      (for ((size_t i . 0)) (< i (($ ($ this runs) size))) ((++ i))
        (let ((LogRun * r . #'(nth i ($ this runs))))
          (set (-> r refs) (+ (-> r refs) 1))))
      (pthread_mutex_unlock (aof (-> l access))))
    (dtor ()
      (pthread_mutex_lock (aof (-> ($ this li) access)))
      (for ((size_t i . 0)) (< i (($ ($ this runs) size))) ((++ i))
        (log_unref ($ this li) (nth i ($ this runs))))
      (pthread_mutex_unlock (aof (-> ($ this li) access)))))

  ;; ---- writing a run -----------------------------------------------
  ;; Entries go in in order, a block goes out each time one fills, and the
  ;; head goes out last -- so a merge streams, holding a block of each
  ;; input and one of output, however big the runs. Under the caller's
  ;; exclusive guard.
  (struct LogWriter
    (member LogIndex * li)
    (member LogRun * run)
    (member int64_t cap)
    (member int64_t seq)
    (member logents_t buf))

  (func log_writer_begin ((LogIndex * li) (LogWriter * w)) (out void)
    (let ((LogRun * run . #'(new* LogRun)))
      (set (-> run id) (-> li next_id))
      (set (-> li next_id) (+ (-> li next_id) 1))
      (set (-> run tier) 0)
      (set (-> run count) 0)
      (set (-> run head) -1)
      (set (-> run refs) 1)
      (set (-> run dropped) 0)
      (set (-> w li) li)
      (set (-> w run) run)
      (set (-> w cap) (log_block_cap (-> li m)))
      (set (-> w seq) 0)
      (($ (-> w buf) clear))))

  (func log_writer_flush ((LogWriter * w)) (out void)
    (if (== (($ (-> w buf) size)) 0) (return))
    (let ((LogRecord rec)
          (LogRun * run . #'(-> w run))
          (int64_t take . #'(cast int64_t (($ (-> w buf) size)))))
      (log_record_clear (aof rec) LOG_KIND_BLOCK)
      (set ($ rec a) (-> run id))
      (set ($ rec b) (-> w seq))
      (set ($ rec c) take)
      (($ ($ rec ents) swap) (-> w buf))
      (offline_insert (-> (-> w li) m) (-> (-> w li) key) (cast (BaseTable *) (aof rec)))
      (let ((LogBlockRef br))
        (set ($ br first) ($ (nth 0 ($ rec ents)) key))
        (set ($ br last) ($ (nth (- take 1) ($ rec ents)) key))
        (set ($ br address) ($ ($ rec pointer) address))
        (set ($ br count) take)
        (($ (-> run blocks) push_back) br))
      (set (-> run count) (+ (-> run count) take))
      (set (-> w seq) (+ (-> w seq) 1))
      (($ (-> w buf) clear))))

  (func log_writer_add ((LogWriter * w) (const LogEnt * e)) (out void)
    (($ (-> w buf) push_back) (cof e))
    (if (>= (cast int64_t (($ (-> w buf) size))) (-> w cap))
        (log_writer_flush w)))

  ;; the head, naming REPLACED (nil for none), and the run joins the
  ;; directory
  (func log_writer_end ((LogWriter * w) (logaddrs_t * replaced)) (out void)
    (log_writer_flush w)
    (let ((LogRecord rec)
          (LogIndex * li . #'(-> w li))
          (LogRun * run . #'(-> w run)))
      (set (-> run tier) (log_tier_of (-> run count)))
      (log_record_clear (aof rec) LOG_KIND_HEAD)
      (set ($ rec a) (-> run id))
      (set ($ rec b) (-> run tier))
      (set ($ rec c) (-> run count))
      (set ($ rec d) (cast int64_t (($ (-> run blocks) size))))
      (if (!= replaced nil) (set ($ rec list) (cof replaced)))
      (offline_insert (-> li m) (-> li key) (cast (BaseTable *) (aof rec)))
      (set (-> run head) ($ ($ rec pointer) address))
      (pthread_mutex_lock (aof (-> li access)))
      (($ (-> li runs) push_back) run)
      (pthread_mutex_unlock (aof (-> li access)))))

  (func log_write_run ((LogIndex * li) (logents_t * ents) (logaddrs_t * replaced)) (out void)
    (let ((LogWriter w))
      (log_writer_begin li (aof w))
      (for ((size_t i . 0)) (< i ((-> ents size))) ((++ i))
        (log_writer_add (aof w) (aof (nth i (cof ents)))))
      (log_writer_end (aof w) replaced)))

  (func log_write_meta ((LogIndex * li)) (out void)
    (let ((LogRecord rec))
      (log_record_clear (aof rec) LOG_KIND_META)
      (set ($ rec a) 1)
      (offline_insert (-> li m) (-> li key) (cast (BaseTable *) (aof rec)))))

  ;; ---- reading a run -----------------------------------------------
  ;; whether the record at BR is still block BR of run R: a run a
  ;; TRUNCATE dropped under a cursor's window reads as its end, never as
  ;; whatever the page holds now
  (func log_block_ok ((LogIndex * li) (LogRun * r) (LogBlockRef * br)) (out bool)
    (let ((binarystream * dio . #'(data_in (-> li m)))
          (int64_t hdr [7]))
      (if (not (key_record_holds (-> li m) (-> li key) (-> br address))) (return #f))
      (if (not ((-> dio good))) ((-> dio clear)))
      ((-> dio seekg) (addr_data (-> br address)) std::ios::beg)
      ((-> dio read) (cast (char *) hdr) 56)
      (if (not ((-> dio good)))
          (block
            ((-> dio clear))
            (return #f)))
      (return (and (== (nth 0 hdr) LOG_KIND_BLOCK)
                   (and (== (nth 1 hdr) (-> r id))
                        (== (nth 6 hdr) (-> br count)))))))

  ;; block BI of run R, whole, into OUT
  (func log_read_block ((LogIndex * li) (LogRun * r) (size_t bi) (logents_t * out)) (out bool)
    (let ((LogBlockRef * br . #'(aof (nth bi (-> r blocks))))
          (binarystream * dio . #'(data_in (-> li m))))
      ((-> out clear))
      (if (not (log_block_ok li r br)) (return #f))
      ((-> out resize) (cast size_t (-> br count)))
      (if (not ((-> dio good))) ((-> dio clear)))
      ((-> dio seekg) (+ (addr_data (-> br address)) LOG_ENTS_AT) std::ios::beg)
      ((-> dio read) (cast (char *) ((-> out data))) (* 16 (-> br count)))
      (if (not ((-> dio good)))
          (block
            ((-> dio clear))
            ((-> out clear))
            (return #f)))
      (return #t)))

  ;; the entry at POS of a block already checked
  (func log_entry_at ((LogIndex * li) (LogBlockRef * br) (int64_t pos) (LogEnt * out)) (out void)
    (let ((binarystream * dio . #'(data_in (-> li m))))
      (if (not ((-> dio good))) ((-> dio clear)))
      ((-> dio seekg) (+ (addr_data (-> br address)) (+ LOG_ENTS_AT (* pos 16))) std::ios::beg)
      ((-> dio read) (cast (char *) out) 16)))

  ;; every row run R holds under K: the directory names the blocks, and
  ;; halving inside a block finds the first -- a few reads, not a block's
  (func log_collect_eq ((LogIndex * li) (LogRun * r) (int64_t k) (logaddrs_t * out)) (out void)
    (let ((size_t nb . #'(($ (-> r blocks) size)))
          (size_t lo . 0)
          (size_t hi . 0)
          (size_t bi . 0)
          (int more . 1))
      (set hi nb)
      ;; the first block whose last key is not below K
      (while (< lo hi)
        (let ((size_t mid . #'(/ (+ lo hi) 2)))
          (if (< ($ (nth mid (-> r blocks)) last) k)
              (set lo (+ mid 1))
            (set hi mid))))
      (set bi lo)
      (while (and (== more 1) (< bi nb))
        (let ((LogBlockRef * br . #'(aof (nth bi (-> r blocks))))
              (int64_t pos . 0)
              (int64_t top . 0)
              (LogEnt ent))
          (if (or (> (-> br first) k) (not (log_block_ok li r br)))
              (set more 0)
            (block
              (set top (-> br count))
              (while (< pos top)
                (let ((int64_t mid . #'(/ (+ pos top) 2)))
                  (log_entry_at li br mid (aof ent))
                  (if (< ($ ent key) k)
                      (set pos (+ mid 1))
                    (set top mid))))
              (while (and (== more 1) (< pos (-> br count)))
                (log_entry_at li br pos (aof ent))
                (if (!= ($ ent key) k)
                    (set more 0)
                  (block
                    ((-> out push_back) ($ ent value))
                    (set pos (+ pos 1)))))))
          (set bi (+ bi 1))))))

  ;; one run walked in key order, a block in memory at a time
  (struct LogIter
    (member LogRun * run)
    (member size_t bi)
    (member size_t pos)
    (member int done)
    (member logents_t ents))
  (@define (code "logiters_t std::vector<LogIter>"))

  ;; block BI into the iterator, or the run's end -- a block that will
  ;; not read ends the walk of its run
  (func log_iter_fill ((LogIndex * li) (LogIter * it)) (out void)
    (if (>= (-> it bi) (($ (-> (-> it run) blocks) size)))
        (block
          (set (-> it done) 1)
          (return)))
    (if (not (log_read_block li (-> it run) (-> it bi) (aof (-> it ents))))
        (set (-> it done) 1)))

  ;; past the current block's end: on to the next one
  (func log_iter_settle ((LogIndex * li) (LogIter * it)) (out void)
    (while (and (== (-> it done) 0) (>= (-> it pos) (($ (-> it ents) size))))
      (set (-> it bi) (+ (-> it bi) 1))
      (set (-> it pos) 0)
      (log_iter_fill li it)))

  ;; at the first entry MODE can want: a bound found by halving for GT and
  ;; GE, the run's first entry for everything else
  (func log_iter_start ((LogIndex * li) (LogIter * it) (int mode) (int64_t k)) (out void)
    (let ((int bounded . #'(? (or (== mode LOG_GT) (== mode LOG_GE)) 1 0)))
      (set (-> it bi) 0)
      (set (-> it pos) 0)
      (set (-> it done) 0)
      (if (== bounded 1)
          (let ((size_t lo . 0)
                (size_t hi . #'(($ (-> (-> it run) blocks) size))))
            (while (< lo hi)
              (let ((size_t mid . #'(/ (+ lo hi) 2))
                    (int64_t last . #'($ (nth mid (-> (-> it run) blocks)) last)))
                (if (or (< last k) (and (== mode LOG_GT) (== last k)))
                    (set lo (+ mid 1))
                  (set hi mid))))
            (set (-> it bi) lo)))
      (log_iter_fill li it)
      (if (and (== bounded 1) (== (-> it done) 0))
          (let ((size_t p . 0)
                (size_t n . #'(($ (-> it ents) size))))
            (while (and (< p n)
                        (or (< ($ (nth p (-> it ents)) key) k)
                            (and (== mode LOG_GT) (== ($ (nth p (-> it ents)) key) k))))
              (set p (+ p 1)))
            (set (-> it pos) p)))
      (log_iter_settle li it)))

  ;; the iterator at the smallest (key, row), or -1 when every one is done
  (func log_iters_best ((logiters_t * its)) (out int64_t)
    (let ((int64_t best . -1))
      (for ((size_t i . 0)) (< i ((-> its size))) ((++ i))
        (if (== ($ (nth i (cof its)) done) 0)
            (if (or (< best 0)
                    (log_ent_before (aof (nth ($ (nth i (cof its)) pos) ($ (nth i (cof its)) ents)))
                                    (aof (nth ($ (nth best (cof its)) pos) ($ (nth best (cof its)) ents)))))
                (set best (cast int64_t i)))))
      (return best)))

  ;; ---- what a row answers ------------------------------------------
  ;; THE ROW ANSWERS. visible() is the reader's judgment of one version,
  ;; except at SNAPSHOT, where it walks a chain from the NEWEST version
  ;; back -- right for a page scan, which meets the newest first, and
  ;; wrong for a log entry naming an OLD version under its old key. There
  ;; the version's own lifetime is the answer; the newer version has an
  ;; entry of its own.
  (func log_row_visible ((Memory * m) (Pointer * p) (Streams * streams)) (out bool)
    (if (and (-> m initialized)
             (and (!= tl_txn nil) (== (-> tl_txn isolation_level) SNAPSHOT)))
        (let ((Control c))
          (control_clear (aof c))
          (load_control m p (aof c))
          (if (and (> ($ c transaction_id) 0) (== ($ c transaction_id) (-> tl_txn id)))
              (return (== ($ c online_state) ROW_INSERTED)))
          (return (alive_at (aof c) (-> tl_txn init_time)))))
    (return (visible m p streams)))

  ;; whether the row at ADDR is anything but settled dead -- what the
  ;; tree's own truncate keeps (bt_unlink_dead_values)
  (func log_row_alive ((LogIndex * li) (int64_t addr)) (out bool)
    (let ((Memory * m . #'(-> li m))
          (const uint8_t * table_key . #'(-> (-> li idx) table_key)))
      (if (not (key_record_holds m table_key addr)) (return #f))
      (let ((Pointer p . #'(pointer_at m table_key addr))
            (Control c))
        (control_clear (aof c))
        (load_control m (aof p) (aof c))
        (return (not (and (or (== ($ c offline_state) ROW_DELETED)
                              (== ($ c offline_state) ROW_UPDATED))
                          (and (== ($ c online_state) ROW_NONE)
                               (== ($ c online_lock) LOCK_NONE))))))))

  ;; when the row at ADDR was born, if it is a settled live row, else 0 --
  ;; the rows a log hands back to a tree
  (func log_row_born ((LogIndex * li) (int64_t addr)) (out int64_t)
    (let ((Memory * m . #'(-> li m))
          (const uint8_t * table_key . #'(-> (-> li idx) table_key)))
      (if (not (key_record_holds m table_key addr)) (return 0))
      (let ((Pointer p . #'(pointer_at m table_key addr))
            (Control c))
        (control_clear (aof c))
        (load_control m (aof p) (aof c))
        (if (or (!= ($ c offline_state) ROW_INSERTED)
                (or (!= ($ c online_state) ROW_NONE)
                    (!= ($ c online_lock) LOCK_NONE)))
            (return 0))
        (if (<= (cast int64_t ($ c create_time)) 0) (return 1))
        (return (cast int64_t ($ c create_time))))))

  ;; one row to the caller, if this reader may see it, with the streams
  ;; handed back around the callback exactly as bt_output_vcb hands them
  ;; back. Answers 0 when the callback ends the walk.
  (func log_emit ((LogIndex * li) (int64_t addr) (void * user)
                  (func rcb ((void * c) (Pointer * p)) (out bool))) (out int)
    (let ((Memory * m . #'(-> li m))
          (const uint8_t * table_key . #'(-> (-> li idx) table_key))
          (Streams * held . #'(? (!= tl_streams_held nil)
                                 (cast (Streams *) tl_streams_held)
                                 (cast (Streams *) tl_streams_shared))))
      (if (not (key_record_holds m table_key addr)) (return 1))
      (let ((Pointer row . #'(pointer_at m table_key addr)))
        (if (not (log_row_visible m (aof row) held)) (return 1))
        (let ((int old_rm . tl_window_reads)
              (int flip . #'(? (and (!= held nil) (== 1 (reader_eligible m))) 1 0))
              (int cont . 1))
          (if (!= held nil) ((-> held unlock)))
          (if (== flip 1) (set tl_window_reads 1))
          (set cont (? (rcb user (aof row)) 1 0))
          (if (== flip 1) (set tl_window_reads old_rm))
          (if (!= held nil) ((-> held lock)))
          (return cont)))))

  ;; the runs merged in key order, each (key, row) once, within MODE's
  ;; bound: every cursor but equality
  (func log_merge_walk ((LogIndex * li) (logruns_t * runs) (int mode) (int64_t k) (void * user)
                        (func rcb ((void * c) (Pointer * p)) (out bool))) (out int)
    (let ((logiters_t its)
          (int cont . 1)
          (int have_last . 0)
          (LogEnt last))
      (($ its resize) ((-> runs size)))
      (for ((size_t i . 0)) (< i (($ its size))) ((++ i))
        (set ($ (nth i its) run) (nth i (cof runs)))
        (log_iter_start li (aof (nth i its)) mode k))
      (while (== cont 1)
        (let ((int64_t best . #'(log_iters_best (aof its))))
          (if (< best 0) break)
          (let ((LogIter * it . #'(aof (nth best its)))
                (LogEnt ent))
            (set ent (nth (-> it pos) (-> it ents)))
            ;; past the bound, nothing later qualifies either
            (if (or (and (== mode LOG_LT) (>= ($ ent key) k))
                    (and (== mode LOG_LE) (> ($ ent key) k)))
                break)
            (set (-> it pos) (+ (-> it pos) 1))
            (log_iter_settle li it)
            (if (and (== have_last 1)
                     (and (== ($ ent key) ($ last key)) (== ($ ent value) ($ last value))))
                continue)
            (set have_last 1)
            (set last ent)
            (if (and (== mode LOG_NE) (== ($ ent key) k)) continue)
            (set cont (log_emit li ($ ent value) user rcb)))))
      (return cont)))

  (func log_cursor ((LogIndex * li) (int mode) (int64_t k) (void * user)
                    (func rcb ((void * c) (Pointer * p)) (out bool))) (out bool)
    ;; this transaction's own queued entries reach the log first
    (idx_pending_apply)
    (let ((Memory * m . #'(-> li m))
          (int cont . 1))
      ;; a read, so the shared side wherever the isolation writes nothing
      (if (== 1 (reader_eligible m)) (set tl_want_shared 1))
      (letin* ((statement (Statement m))
               (streams (Streams m))
               (snap (LogSnap li)))
        (if (== mode LOG_EQ)
            (let ((logaddrs_t addrs))
              (for ((size_t i . 0)) (< i (($ ($ snap runs) size))) ((++ i))
                (log_collect_eq li (nth i ($ snap runs)) k (aof addrs)))
              (if (> (($ addrs size)) 1)
                  (qsort (cast (void *) (($ addrs data))) (($ addrs size)) (sizeof int64_t) log_addr_cmp))
              (for ((size_t i . 0)) (and (< i (($ addrs size))) (== cont 1)) ((++ i))
                (if (or (== i 0) (!= (nth i addrs) (nth (- i 1) addrs)))
                    (set cont (log_emit li (nth i addrs) user rcb)))))
          (set cont (log_merge_walk li (aof ($ snap runs)) mode k user rcb)))
        (cast void 0))
      (return (== cont 1))))

  ;; ---- the merge ---------------------------------------------------
  ;; GROUP's runs into one, streamed: MODE 0 keeps every entry, 1 leaves
  ;; key K out, 2 leaves out the entries of settled dead rows. The new
  ;; run's head names the runs it replaces, and they leave the directory.
  ;; Answers how many entries were left out. Under the caller's exclusive
  ;; guard.
  (func log_merge ((LogIndex * li) (logruns_t * group) (int mode) (int64_t k)) (out int64_t)
    (let ((logiters_t its)
          (logaddrs_t ids)
          (LogWriter w)
          (int64_t dropped . 0)
          (int have_last . 0)
          (LogEnt last))
      (($ its resize) ((-> group size)))
      (for ((size_t i . 0)) (< i (($ its size))) ((++ i))
        (set ($ (nth i its) run) (nth i (cof group)))
        (let ((LogRun * r . #'(nth i (cof group))))
          (($ ids push_back) (-> r id)))
        (log_iter_start li (aof (nth i its)) LOG_ALL 0))
      (log_writer_begin li (aof w))
      (while #t
        (let ((int64_t best . #'(log_iters_best (aof its))))
          (if (< best 0) break)
          (let ((LogIter * it . #'(aof (nth best its)))
                (LogEnt ent))
            (set ent (nth (-> it pos) (-> it ents)))
            (set (-> it pos) (+ (-> it pos) 1))
            (log_iter_settle li it)
            (if (and (== have_last 1)
                     (and (== ($ ent key) ($ last key)) (== ($ ent value) ($ last value))))
                continue)
            (set have_last 1)
            (set last ent)
            (if (or (and (== mode 1) (== ($ ent key) k))
                    (and (== mode 2) (not (log_row_alive li ($ ent value)))))
                (set dropped (+ dropped 1))
              (log_writer_add (aof w) (aof ent))))))
      (log_writer_end (aof w) (aof ids))
      (pthread_mutex_lock (aof (-> li access)))
      (for ((size_t g . 0)) (< g ((-> group size))) ((++ g))
        (log_unlist li (nth g (cof group))))
      (pthread_mutex_unlock (aof (-> li access)))
      (return dropped)))

  ;; ---- the merge, paced ---------------------------------------------
  ;; THE MERGE, PACED. A set merged whole in the commit that completed it
  ;; is that commit's to pay, and a tier's merge is LOG_FANOUT times the
  ;; one below: table-bench's 2 001-row blocks paid 0.2-0.4 s at blocks
  ;; 256, 512 and 768 for ~0.05 s elsewhere, and the next would be four
  ;; times that -- an insertion constant on average whose worst case grows
  ;; with the index. Paced, its worst block was 0.14-0.16 s. So a merge is carried ACROSS commits: each commit that adds
  ;; a run takes every merge under way LOG_PACE times its own entries
  ;; further (LOG_BASE at least), lowest tier first. A tier's set
  ;; takes its LOG_FANOUT runs' worth of commits to gather, and its merge
  ;; half that at this pace, so a merge is done before its tier has
  ;; another set; a commit's merge work is bounded by its own size times
  ;; the tiers, whatever the index holds.
  ;;
  ;; A merge under way is a LogPend: the runs it holds (a hold each, so
  ;; nothing frees a block it has yet to read), an iterator on each, and
  ;; the writer of the run it makes, whose blocks are written as they fill
  ;; and whose head is written last, when the inputs are spent -- in the
  ;; commit that finishes it, which lists the run and lets the inputs go.
  ;; Until then a cursor reads the inputs, which are still listed, and
  ;; never the half-written run, which is not. A crash leaves the run's
  ;; blocks headless, which the load frees; anything that takes runs out
  ;; of the directory otherwise -- a drop, a truncate, an unmap_key, a
  ;; store let go -- abandons the merges first (log_pend_abandon).
  ;;
  ;; WHY NOT A THREAD. One was built and measured first: a commit that
  ;; completed a set only signalled, and a thread merged, a block each time
  ;; it held the guard. Under the one exclusive guard its writes took turns
  ;; with the inserts, and every commit's msync paid for the pages it had
  ;; dirtied, so the cost moved to the next block and grew nothing smaller
  ;; -- table-bench's merge blocks 0.23-0.43 s against 0.21-0.27 in the
  ;; commit, its average 0.061-0.065 s against 0.054-0.055, and through
  ;; the server,
  ;; 1 000 blocks a client process each, 0.1470 s a block against 0.1465
  ;; with the one slow block, 0.76 s and 0.78, at the same merge. Pacing
  ;; needs no second writer at all. MVCCS_LOG_MERGE=0 in the environment
  ;; merges whole in the commit, as before.
  (var const int64_t LOG_PACE . 2)
  ;; -1 until the environment has been read; then 0 whole, 1 paced
  (var int g_log_paced . -1)

  (func log_merge_paced () (out int)
    (if (< g_log_paced 0)
        (let ((const char * s . #'(getenv "MVCCS_LOG_MERGE")))
          (set g_log_paced (? (and (!= s nil) (== (nth 0 s) (cast char 48))) 0 1))))
    (return g_log_paced))

  (struct LogPend
    (member int64_t tier)
    (member logruns_t runs)
    (member logiters_t its)
    (member logaddrs_t ids)
    (member LogWriter w)
    (member int have_last)
    (member LogEnt last))

  ;; P given up or done: its holds let go and the record of it deleted. A
  ;; run it was still writing is headless; DOOM 1 sends its blocks to wait
  ;; for a sync, 0 leaves them to go back with the log's pages (a drop) or
  ;; to the next load. Caller holds li->access.
  (func log_pend_free ((LogIndex * li) (LogPend * p) (int doom)) (out void)
    (for ((size_t i . 0)) (< i (($ (-> p runs) size))) ((++ i))
      (log_unref li (nth i (-> p runs))))
    (let ((LogRun * run . #'($ (-> p w) run)))
      (if (!= run nil)
          (block
            (if (== doom 1)
                (for ((size_t bi . 0)) (< bi (($ (-> run blocks) size))) ((++ bi))
                  (($ (-> li doomed) push_back) ($ (nth bi (-> run blocks)) address))))
            (delete* run))))
    (delete* p))

  ;; every merge of LI under way, given up -- caller holds li->access
  (func log_pend_abandon ((LogIndex * li) (int doom)) (out void)
    (for ((int64_t t . 0)) (< t LOG_TIERS) ((++ t))
      (let ((LogPend * p . #'(nth t (-> li pending))))
        (if (!= p nil)
            (block
              (set (nth t (-> li pending)) nil)
              (log_pend_free li p doom))))))

  ;; TIER's runs, held, as a merge under way -- when the tier has a full
  ;; set and no merge of its own yet. Under the caller's exclusive guard.
  (func log_pend_start ((LogIndex * li) (int64_t tier)) (out LogPend *)
    (let ((LogPend * p . nil)
          (int64_t have . 0))
      (pthread_mutex_lock (aof (-> li access)))
      (if (== (nth tier (-> li pending)) nil)
          (block
            (for ((size_t i . 0)) (< i (($ (-> li runs) size))) ((++ i))
              (let ((LogRun * r . #'(nth i (-> li runs))))
                (if (== (-> r tier) tier) (set have (+ have 1)))))
            (if (>= have LOG_FANOUT)
                (block
                  (set p (new* LogPend))
                  (set (-> p tier) tier)
                  (set (-> p have_last) 0)
                  (set ($ (-> p w) run) nil)
                  (for ((size_t i . 0)) (< i (($ (-> li runs) size))) ((++ i))
                    (let ((LogRun * r . #'(nth i (-> li runs))))
                      (if (== (-> r tier) tier)
                          (block
                            (set (-> r refs) (+ (-> r refs) 1))
                            (($ (-> p runs) push_back) r)
                            (($ (-> p ids) push_back) (-> r id))))))
                  (set (nth tier (-> li pending)) p)))))
      (pthread_mutex_unlock (aof (-> li access)))
      (if (!= p nil)
          (block
            (($ (-> p its) resize) (($ (-> p runs) size)))
            (for ((size_t i . 0)) (< i (($ (-> p its) size))) ((++ i))
              (set ($ (nth i (-> p its)) run) (nth i (-> p runs)))
              (log_iter_start li (aof (nth i (-> p its))) LOG_ALL 0))
            (log_writer_begin li (aof (-> p w)))))
      (return p)))

  ;; P carried BUDGET of its inputs' entries further. Answers 1 when they
  ;; are spent: the run's head written, the run listed, the inputs out of
  ;; the directory and out of P. Under the caller's exclusive guard.
  (func log_pend_step ((LogIndex * li) (LogPend * p) (int64_t budget)) (out int)
    (let ((int64_t taken . 0))
      (while (< taken budget)
        (let ((int64_t best . #'(log_iters_best (aof (-> p its)))))
          (if (< best 0)
              (block
                (log_writer_end (aof (-> p w)) (aof (-> p ids)))
                (set ($ (-> p w) run) nil)
                (pthread_mutex_lock (aof (-> li access)))
                (for ((size_t i . 0)) (< i (($ (-> p runs) size))) ((++ i))
                  (let ((LogRun * r . #'(nth i (-> p runs))))
                    (log_unlist li r)
                    (log_unref li r)))
                (($ (-> p runs) clear))
                (pthread_mutex_unlock (aof (-> li access)))
                (return 1)))
          (let ((LogIter * it . #'(aof (nth best (-> p its))))
                (LogEnt ent))
            (set ent (nth (-> it pos) (-> it ents)))
            (set (-> it pos) (+ (-> it pos) 1))
            (log_iter_settle li it)
            (set taken (+ taken 1))
            (if (or (== (-> p have_last) 0)
                    (or (!= ($ ent key) ($ (-> p last) key)) (!= ($ ent value) ($ (-> p last) value))))
                (block
                  (set (-> p have_last) 1)
                  (set (-> p last) ent)
                  (log_writer_add (aof (-> p w)) (aof ent)))))))
      (return 0)))

  ;; a commit's share: every tier, lowest first, its set's merge begun if
  ;; one is due and carried LOG_PACE times ADDED further -- LOG_BASE at
  ;; least, so a small commit still finishes the merges of its own tier's
  ;; size -- and a merge that finishes may complete a higher tier's set,
  ;; which the same pass reaches
  (func log_pace ((LogIndex * li) (int64_t added)) (out void)
    (let ((int64_t budget . #'(* LOG_PACE added)))
      (if (< budget LOG_BASE) (set budget LOG_BASE))
      (for ((int64_t t . 0)) (< t LOG_TIERS) ((++ t))
        (let ((LogPend * p . #'(nth t (-> li pending))))
          (if (== p nil) (set p (log_pend_start li t)))
          (if (!= p nil)
              (if (== 1 (log_pend_step li p budget))
                  (block
                    (pthread_mutex_lock (aof (-> li access)))
                    (set (nth t (-> li pending)) nil)
                    (log_pend_free li p 0)
                    (pthread_mutex_unlock (aof (-> li access))))))))))

  ;; the lowest tier holding LOG_FANOUT runs, merged whole -- and round
  ;; again, since the merged run may complete the next tier's set: the
  ;; commit's way under MVCCS_LOG_MERGE=0, and a tree's move into a log
  (func log_compact ((LogIndex * li)) (out void)
    (pthread_mutex_lock (aof (-> li access)))
    (log_pend_abandon li 1)
    (pthread_mutex_unlock (aof (-> li access)))
    (let ((int merged . 1))
      (while (== merged 1)
        (set merged 0)
        (let ((logruns_t group)
              (int64_t tier . -1))
          (pthread_mutex_lock (aof (-> li access)))
          (for ((int64_t t . 0)) (and (< t LOG_TIERS) (< tier 0)) ((++ t))
            (let ((int64_t have . 0))
              (for ((size_t i . 0)) (< i (($ (-> li runs) size))) ((++ i))
                (let ((LogRun * r . #'(nth i (-> li runs))))
                  (if (== (-> r tier) t) (set have (+ have 1)))))
              (if (>= have LOG_FANOUT) (set tier t))))
          (if (>= tier 0)
              (for ((size_t i . 0)) (< i (($ (-> li runs) size))) ((++ i))
                (let ((LogRun * r . #'(nth i (-> li runs))))
                  (if (== (-> r tier) tier)
                      (($ group push_back) r)))))
          (pthread_mutex_unlock (aof (-> li access)))
          (if (>= tier 0)
              (block
                (log_merge li (aof group) 0 0)
                (set merged 1)))))))

  ;; ---- the verbs the tree's functions hand a log -------------------
  ;; one transaction's entries for one index as a run, and its share of
  ;; the merges (whole ones under MVCCS_LOG_MERGE=0)
  (func log_add_run ((LogIndex * li) (logents_t * ents)) (out void)
    (if (== ((-> ents size)) 0) (return))
    (qsort (cast (void *) ((-> ents data))) ((-> ents size)) (sizeof LogEnt) log_ent_cmp)
    (set tl_want_shared 0)
    (letin* ((streams (Streams (-> li m))))
      (log_write_run li ents nil)
      (if (== 1 (log_merge_paced))
          (log_pace li (cast int64_t ((-> ents size))))
        (log_compact li))
      (cast void 0)))

  ;; how many queued entries a mapping outside a row's insert -- a
  ;; rebuild walking a whole table -- may hold before they go to a run
  (var const int64_t LOG_QUEUE_LIMIT . 1048576)

  ;; an entry joins this thread's queue; the next drain or the commit
  ;; makes the queue a run. Outside a row's insert the queue is not
  ;; bounded by the transaction's inserts, so it is drained every
  ;; LOG_QUEUE_LIMIT entries: a run written early only names rows a
  ;; reader judges anyway.
  (func log_push ((LogIndex * li) (int64_t k) (int64_t value)) (out void)
    (let ((int64_t ks [1]))
      (set (nth 0 ks) k)
      (idx_pending_push (-> li idx) ks value))
    (if (and (!= tl_defer_maps 1) (>= (idx_pending_count) LOG_QUEUE_LIMIT))
        (idx_pending_apply)))

  ;; the log's pages back wholesale, the directory emptied (a merge under
  ;; way with it), and a fresh META: the index stays a log, holding nothing
  (func log_drop ((LogIndex * li)) (out void)
    (set tl_want_shared 0)
    (letin* ((streams (Streams (-> li m))))
      (log_release_all li)
      (drop_key_pages (-> li m) (-> li key))
      (log_write_meta li)
      ((-> (-> (-> li m) hexmap_io) flush))
      ((-> (-> (-> li m) data_io) flush))
      (cast void 0)))

  ;; what TRUNCATE asks of an index: every run merged into one without
  ;; the entries of settled dead rows -- a merge under way given up for
  ;; it. Answers how many went.
  (func log_truncate ((LogIndex * li)) (out size_t)
    (let ((logruns_t group)
          (int64_t dropped . 0))
      (set tl_want_shared 0)
      (letin* ((streams (Streams (-> li m))))
        (pthread_mutex_lock (aof (-> li access)))
        (log_pend_abandon li 1)
        (set group (-> li runs))
        (pthread_mutex_unlock (aof (-> li access)))
        (if (> (($ group size)) 0)
            (set dropped (log_merge li (aof group) 2 0)))
        (cast void 0))
      (return (cast size_t dropped))))

  ;; TRUE key deletion: every run merged into one without K -- the queue
  ;; drained first, so an entry still queued goes too, and a merge under
  ;; way given up, so none writes K back
  (func log_unmap_key ((LogIndex * li) (int64_t k)) (out void)
    (idx_pending_apply)
    (let ((logruns_t group))
      (set tl_want_shared 0)
      (letin* ((streams (Streams (-> li m))))
        (pthread_mutex_lock (aof (-> li access)))
        (log_pend_abandon li 1)
        (set group (-> li runs))
        (pthread_mutex_unlock (aof (-> li access)))
        (if (> (($ group size)) 0)
            (log_merge li (aof group) 1 k))
        (cast void 0))))

  ;; the records of released runs, freed: run after a commit's first sync,
  ;; which made every run written before it durable
  (func log_free_doomed ((LogIndex * li)) (out void)
    (let ((logaddrs_t gone))
      (pthread_mutex_lock (aof (-> li access)))
      (($ gone swap) (-> li doomed))
      (pthread_mutex_unlock (aof (-> li access)))
      (for ((size_t i . 0)) (< i (($ gone size))) ((++ i))
        (if (key_record_holds (-> li m) (-> li key) (nth i gone))
            (let ((Pointer p . #'(pointer_at (-> li m) (-> li key) (nth i gone))))
              (free_pointer (-> li m) (aof p)))))))

  (func log_after_sync ((Memory * m)) (out void)
    (if (== log_registry nil) (return))
    (let ((logindexes_t mine))
      (pthread_mutex_lock (aof log_registry_access))
      (for ((size_t i . 0)) (< i ((-> log_registry size))) ((++ i))
        (let ((LogIndex * cand . #'(nth i (cof log_registry))))
          (if (== (-> cand m) m)
              (($ mine push_back) cand))))
      (pthread_mutex_unlock (aof log_registry_access))
      (for ((size_t i . 0)) (< i (($ mine size))) ((++ i))
        (log_free_doomed (nth i mine)))))

  ;; a table's dead rows are about to be freed: its log indexes go first
  ;; (see truncate_key). Answers 1 when there were any.
  (func log_table_truncated ((Memory * m) (const uint8_t * table_key)) (out int)
    (if (== log_registry nil) (return 0))
    (let ((logindexes_t hit))
      (pthread_mutex_lock (aof log_registry_access))
      (for ((size_t i . 0)) (< i ((-> log_registry size))) ((++ i))
        (let ((LogIndex * li . #'(nth i (cof log_registry))))
          (if (and (== (-> li m) m)
                   (== 0 (memcmp (-> (-> li idx) table_key) table_key (cast size_t HASHKEY_SIZE))))
              (($ hit push_back) li))))
      (pthread_mutex_unlock (aof log_registry_access))
      (for ((size_t i . 0)) (< i (($ hit size))) ((++ i))
        (log_drop (nth i hit)))
      (return (? (> (($ hit size)) 0) 1 0))))

  ;; IDX's entry for its store. Answers it with *KNOWN 1 when this store's
  ;; directory is already in memory -- an attach run twice -- and otherwise
  ;; made, or found for another store and EMPTIED, to be read again.
  (func log_register ((BTreeIndex * idx) (int * known)) (out LogIndex *)
    (let ((LogIndex * li . nil))
      (set (cof known) 0)
      (pthread_mutex_lock (aof log_registry_access))
      (if (== log_registry nil) (set log_registry (new* logindexes_t)))
      (for ((size_t i . 0)) (< i ((-> log_registry size))) ((++ i))
        (let ((LogIndex * cand . #'(nth i (cof log_registry))))
          (if (== (-> cand idx) idx)
              (block
                (set li cand)
                break))))
      (if (and (!= li nil) (== (-> li m) (-> idx m)))
          (block
            (pthread_mutex_unlock (aof log_registry_access))
            (set (cof known) 1)
            (return li)))
      (if (== li nil)
          (block
            (set li (new* LogIndex))
            (pthread_mutex_init (aof (-> li access)) nil)
            (for ((int64_t t . 0)) (< t LOG_TIERS) ((++ t))
              (set (nth t (-> li pending)) nil))
            ((-> log_registry push_back) li)))
      (pthread_mutex_unlock (aof log_registry_access))
      (log_release_all li)
      (pthread_mutex_lock (aof (-> li access)))
      (set (-> li idx) idx)
      (set (-> li m) (-> idx m))
      (set (-> li key) (log_key_of idx))
      (set (-> li next_id) 1)
      (pthread_mutex_unlock (aof (-> li access)))
      (return li)))

  ;; every log of a store, forgotten: it is being opened afresh, or closed.
  ;; An index still saying LOG_ROOT afterwards refuses until attached again.
  (func log_forget_where ((Memory * m) (BTreeIndex * idx)) (out void)
    (if (== log_registry nil) (return))
    (pthread_mutex_lock (aof log_registry_access))
    (let ((size_t w . 0))
      (for ((size_t i . 0)) (< i ((-> log_registry size))) ((++ i))
        (let ((LogIndex * li . #'(nth i (cof log_registry))))
          (if (or (and (!= m nil) (== (-> li m) m))
                  (and (!= idx nil) (== (-> li idx) idx)))
              (block
                (log_release_all li)
                (pthread_mutex_destroy (aof (-> li access)))
                (delete* li))
            (block
              (set (nth w (cof log_registry)) li)
              (set w (+ w 1))))))
      ((-> log_registry resize) w))
    (pthread_mutex_unlock (aof log_registry_access)))

  (func log_forget_memory ((Memory * m)) (out void)
    (log_forget_where m nil))

  ;; ---- the load and the moves across -------------------------------
  (struct LogHeadInfo
    (member int64_t address)
    (member int64_t id)
    (member int64_t tier)
    (member int64_t count)
    (member int64_t nblocks)
    (member int whole)
    (member logaddrs_t replaced))
  (@define (code "logheads_t std::vector<LogHeadInfo>"))

  (struct LogBlockInfo
    (member int64_t address)
    (member int64_t run)
    (member int64_t seq)
    (member int64_t count)
    (member int64_t first)
    (member int64_t last))
  (@define (code "logbinfos_t std::vector<LogBlockInfo>"))

  (struct LogLoad
    (member Memory * m)
    (member logaddrs_t metas)
    (member logaddrs_t debris)
    (member logheads_t heads)
    (member logbinfos_t blocks))

  (func log_binfo_cmp ((const void * a) (const void * b)) (out int)
    (let ((const LogBlockInfo * x . #'(cast (const LogBlockInfo *) a))
          (const LogBlockInfo * y . #'(cast (const LogBlockInfo *) b)))
      (if (< (-> x run) (-> y run)) (return -1))
      (if (> (-> x run) (-> y run)) (return 1))
      (if (< (-> x seq) (-> y seq)) (return -1))
      (if (> (-> x seq) (-> y seq)) (return 1))
      (return 0)))

  (func log_load_cb ((void * c) (Pointer * p)) (out void)
    (let ((LogLoad * ld . #'(cast (LogLoad *) c))
          (binarystream * dio . #'(data_in (-> ld m)))
          (int64_t hdr [7]))
      (if (not ((-> dio good))) ((-> dio clear)))
      ((-> dio seekg) (ptr_data p) std::ios::beg)
      ((-> dio read) (cast (char *) hdr) 56)
      (if (not ((-> dio good)))
          (block
            ((-> dio clear))
            (($ (-> ld debris) push_back) (-> p address))
            (return)))
      (cond
        ((== (nth 0 hdr) LOG_KIND_META)
         (($ (-> ld metas) push_back) (-> p address)))
        ((and (== (nth 0 hdr) LOG_KIND_HEAD) (== (nth 6 hdr) 0))
         (let ((LogHeadInfo h)
               (int64_t nl . 0))
           (set ($ h address) (-> p address))
           (set ($ h id) (nth 1 hdr))
           (set ($ h tier) (nth 2 hdr))
           (set ($ h count) (nth 3 hdr))
           (set ($ h nblocks) (nth 4 hdr))
           (set ($ h whole) 0)
           ((-> dio read_std_long) nl)
           (if (and (not (not ((-> dio good)))) (and (>= nl 0) (<= nl 4096)))
               (block
                 (($ ($ h replaced) resize) (cast size_t nl))
                 (if (> nl 0)
                     ((-> dio read) (cast (char *) (($ ($ h replaced) data))) (* 8 nl)))))
           (if (not ((-> dio good)))
               (block
                 ((-> dio clear))
                 (($ ($ h replaced) clear))))
           (($ (-> ld heads) push_back) h)))
        ((and (== (nth 0 hdr) LOG_KIND_BLOCK) (> (nth 6 hdr) 0))
         (let ((LogBlockInfo b)
               (LogEnt e))
           (set ($ b address) (-> p address))
           (set ($ b run) (nth 1 hdr))
           (set ($ b seq) (nth 2 hdr))
           (set ($ b count) (nth 6 hdr))
           ((-> dio read) (cast (char *) (aof e)) 16)
           (set ($ b first) ($ e key))
           ((-> dio seekg) (+ (ptr_data p) (+ LOG_ENTS_AT (* 16 (- (nth 6 hdr) 1)))) std::ios::beg)
           ((-> dio read) (cast (char *) (aof e)) 16)
           (set ($ b last) ($ e key))
           (if (not (not ((-> dio good))))
               (($ (-> ld blocks) push_back) b)
             (block
               ((-> dio clear))
               (($ (-> ld debris) push_back) (-> p address))))))
        (#t (($ (-> ld debris) push_back) (-> p address))))))

  ;; THE DIRECTORY, READ BACK: every whole run nothing replaces, and the
  ;; rest freed -- a run without its head, a run a merge's head names, a
  ;; second META, whatever will not read: all a crash can leave behind.
  ;; Answers whether the store already keeps this index as a log. Under
  ;; the caller's exclusive guard.
  (func log_load ((LogIndex * li)) (out int)
    (let ((LogLoad ld)
          (Memory * m . #'(-> li m))
          (logaddrs_t replaced)
          (logaddrs_t lose)
          (int64_t top . 0))
      (set ($ ld m) m)
      (key_records m (-> li key) (cast (void *) (aof ld)) log_load_cb)
      (if (> (($ ($ ld blocks) size)) 1)
          (qsort (cast (void *) (($ ($ ld blocks) data))) (($ ($ ld blocks) size))
                 (sizeof LogBlockInfo) log_binfo_cmp))
      ;; whole: every block there, numbered from 0
      (for ((size_t h . 0)) (< h (($ ($ ld heads) size))) ((++ h))
        (let ((LogHeadInfo * hd . #'(aof (nth h ($ ld heads))))
              (int64_t seen . 0))
          (if (> (-> hd id) top) (set top (-> hd id)))
          (for ((size_t b . 0)) (< b (($ ($ ld blocks) size))) ((++ b))
            (if (and (== ($ (nth b ($ ld blocks)) run) (-> hd id))
                     (== ($ (nth b ($ ld blocks)) seq) seen))
                (set seen (+ seen 1))))
          (if (== seen (-> hd nblocks))
              (block
                (set (-> hd whole) 1)
                (($ replaced insert) (($ replaced end))
                                     (($ (-> hd replaced) begin)) (($ (-> hd replaced) end)))))))
      ;; kept: whole, and replaced by no whole run
      (for ((size_t h . 0)) (< h (($ ($ ld heads) size))) ((++ h))
        (let ((LogHeadInfo * hd . #'(aof (nth h ($ ld heads))))
              (int gone . 0))
          (for ((size_t r . 0)) (< r (($ replaced size))) ((++ r))
            (if (== (nth r replaced) (-> hd id)) (set gone 1)))
          (if (or (== (-> hd whole) 0) (== gone 1))
              (block
                (set (-> hd whole) 0)
                (($ lose push_back) (-> hd address)))
            (let ((LogRun * run . #'(new* LogRun)))
              (set (-> run id) (-> hd id))
              (set (-> run tier) (-> hd tier))
              (set (-> run count) (-> hd count))
              (set (-> run head) (-> hd address))
              (set (-> run refs) 1)
              (set (-> run dropped) 0)
              (for ((size_t b . 0)) (< b (($ ($ ld blocks) size))) ((++ b))
                (let ((LogBlockInfo * bi . #'(aof (nth b ($ ld blocks)))))
                  (if (== (-> bi run) (-> hd id))
                      (let ((LogBlockRef br))
                        (set ($ br first) (-> bi first))
                        (set ($ br last) (-> bi last))
                        (set ($ br address) (-> bi address))
                        (set ($ br count) (-> bi count))
                        (($ (-> run blocks) push_back) br)))))
              (pthread_mutex_lock (aof (-> li access)))
              (($ (-> li runs) push_back) run)
              (pthread_mutex_unlock (aof (-> li access)))))))
      ;; the blocks of no kept run
      (for ((size_t b . 0)) (< b (($ ($ ld blocks) size))) ((++ b))
        (let ((LogBlockInfo * bi . #'(aof (nth b ($ ld blocks))))
              (int kept . 0))
          (if (> (-> bi run) top) (set top (-> bi run)))
          (for ((size_t h . 0)) (< h (($ ($ ld heads) size))) ((++ h))
            (if (and (== ($ (nth h ($ ld heads)) whole) 1)
                     (== ($ (nth h ($ ld heads)) id) (-> bi run)))
                (set kept 1)))
          (if (== kept 0) (($ lose push_back) (-> bi address)))))
      ;; one META is the mark; a second, and the debris, go too
      (for ((size_t i . 1)) (< i (($ ($ ld metas) size))) ((++ i))
        (($ lose push_back) (nth i ($ ld metas))))
      (($ lose insert) (($ lose end)) (($ ($ ld debris) begin)) (($ ($ ld debris) end)))
      (for ((size_t i . 0)) (< i (($ lose size))) ((++ i))
        (if (key_record_holds m (-> li key) (nth i lose))
            (let ((Pointer p . #'(pointer_at m (-> li key) (nth i lose))))
              (free_pointer m (aof p)))))
      (set (-> li next_id) (+ top 1))
      (return (? (> (($ ($ ld metas) size)) 0) 1 0))))

  (struct LogTreeCtx
    (member BTreeIndex * idx)
    (member logents_t * ents))

  ;; every value of KEY's chain, whatever its visibility: a log holds the
  ;; superset its rows judge (see "WHAT AN ENTRY MEANS")
  (func log_tree_kcb ((void * c) (BTKey * key)) (out bool)
    (let ((LogTreeCtx * tc . #'(cast (LogTreeCtx *) c))
          (Memory * m . #'(-> (-> tc idx) m))
          (int64_t tmp . #'(-> key values_address))
          (int64_t brent_mark . -2)
          (int64_t brent_steps . 0)
          (int64_t brent_limit . 2))
      (while (> tmp -1)
        (if (not (chain_resolves m tmp)) break)
        (if (== tmp brent_mark) break)
        (set brent_steps (+ brent_steps 1))
        (if (== brent_steps brent_limit)
            (block
              (set brent_mark tmp)
              (set brent_steps 0)
              (set brent_limit (* brent_limit 2))))
        (let ((Pointer vp . #'(pointer_at m (-> (-> tc idx) hash_key) tmp))
              (BTValue v)
              (LogEnt e)
              (binarystream * dio . #'(data_in m)))
          (if (not ((-> dio good))) ((-> dio clear)))
          ((-> dio seekg) (ptr_data (aof vp)) std::ios::beg)
          (($ v unpack) (cof dio))
          (set ($ e key) (-> key key))
          (set ($ e value) ($ v value))
          ((-> (-> tc ents) push_back) e)
          (set tmp ($ v next_address))))
      (return #t)))

  ;; a tree the store kept for this index: its entries into one run, its
  ;; storage back to the allocator, and the catalogue's root with it
  (func log_from_tree ((LogIndex * li)) (out void)
    (let ((BTreeIndex * idx . #'(-> li idx))
          (logents_t ents)
          (LogTreeCtx tc))
      (set ($ tc idx) idx)
      (set ($ tc ents) (aof ents))
      (bt_walk_keys_rec idx (-> idx root_address) (cast (void *) (aof tc)) log_tree_kcb)
      (if (> (($ ents size)) 1)
          (qsort (cast (void *) (($ ents data))) (($ ents size)) (sizeof LogEnt) log_ent_cmp))
      (if (> (($ ents size)) 0)
          (block
            (log_write_run li (aof ents) nil)
            (log_compact li)))
      (drop_key_pages (-> li m) (-> idx hash_key))
      (set (-> idx root_address) -1)
      (if (!= ($ (-> idx record_pointer) hash_key) nil)
          (bt_update_record idx))))

  ;; what the move back borrows -- the defer flag, and the offline stamp
  ;; bt_insert_value reads -- handed back however the maps leave
  (struct LogBackScope
    (member int defer_)
    (ctor ()
      (init (defer_ 0))
      (set ($ this defer_) tl_defer_maps)
      (set tl_defer_maps 0))
    (dtor ()
      (set tl_defer_maps ($ this defer_))
      (set tl_offline_values 0)))

  ;; a log the store kept for an index that is a tree now: the entries of
  ;; the rows still alive back into the tree -- each value committed as it
  ;; is written and born when its row was, so every reader that could see
  ;; the row finds it -- and the log's pages back to the allocator
  (func log_to_tree ((BTreeIndex * idx) (const uint8_t * key)) (out void)
    (let ((LogIndex * li . #'(new* LogIndex))
          (logents_t all)
          (logents_t blk)
          (Memory * m . #'(-> idx m)))
      (pthread_mutex_init (aof (-> li access)) nil)
      (set (-> li idx) idx)
      (set (-> li m) m)
      (set (-> li key) key)
      (set (-> li next_id) 1)
      (log_load li)
      (for ((size_t r . 0)) (< r (($ (-> li runs) size))) ((++ r))
        (let ((LogRun * run . #'(nth r (-> li runs))))
          (for ((size_t bi . 0)) (< bi (($ (-> run blocks) size))) ((++ bi))
            (if (log_read_block li run bi (aof blk))
                (($ all insert) (($ all end)) (($ blk begin)) (($ blk end)))))))
      (if (> (($ all size)) 1)
          (qsort (cast (void *) (($ all data))) (($ all size)) (sizeof LogEnt) log_ent_cmp))
      (letin* ((scope (LogBackScope)))
        (for ((size_t i . 0)) (< i (($ all size))) ((++ i))
          (if (or (== i 0)
                  (or (!= ($ (nth i all) key) ($ (nth (- i 1) all) key))
                      (!= ($ (nth i all) value) ($ (nth (- i 1) all) value))))
              (let ((int64_t born . #'(log_row_born li ($ (nth i all) value))))
                (if (> born 0)
                    (block
                      (set tl_offline_values born)
                      ;; a UNIQUE index now refuses what the log held twice
                      (try (bt_map idx ($ (nth i all) key) ($ (nth i all) value))
                           (catch ((const IndexException & x))
                             (cast void x)))
                      (set tl_offline_values 0))))))
        (cast void 0))
      (log_release_all li)
      (pthread_mutex_destroy (aof (-> li access)))
      (delete* li)
      (drop_key_pages m key)))

  ;; WHICH STRUCTURE, decided at an index's attach: a log where
  ;; log_eligible says so, a tree everywhere else -- and the entries
  ;; moved across when the store kept the index as the other
  (func log_select ((BTreeIndex * idx)) (out void)
    (if (== 1 (log_eligible idx))
        (let ((int known . 0)
              (LogIndex * li . #'(log_register idx (aof known))))
          (if (== known 1)
              (block
                (set (-> idx root_address) LOG_ROOT)
                (return)))
          (set tl_want_shared 0)
          (letin* ((streams (Streams (-> idx m))))
            (let ((int had_meta . #'(log_load li)))
              (if (> (-> idx root_address) -1)
                  (log_from_tree li))
              (if (== had_meta 0)
                  (log_write_meta li))
              (set (-> idx root_address) LOG_ROOT))
            (cast void 0)))
      (let ((const uint8_t * key . #'(log_key_of idx))
            (int has . 0))
        (log_forget_where nil idx)
        (pthread_mutex_lock (aof (-> (-> idx m) page_list_access)))
        (let ((PageEntry * e . #'(page_chain (-> idx m) key)))
          (while (!= e nil)
            (if (== (memcmp (-> e key) key (cast size_t HASHKEY_SIZE)) 0)
                (block
                  (set has 1)
                  break))
            (set e (-> e key_next))))
        (pthread_mutex_unlock (aof (-> (-> idx m) page_list_access)))
        (if (== has 1)
            (block
              (set tl_want_shared 0)
              (letin* ((streams (Streams (-> idx m))))
                (log_to_tree idx key)
                (cast void 0)))))))

  ;; ==================================================================
  ;; The singleton registry -- the rest of Globals: the store's two
  ;; streams and the Memory itself, set once at startup and read by
  ;; everything the server wires together.
  ;; ==================================================================
  (var binarystream * g_memory_hexmap_stream)
  (var binarystream * g_memory_data_stream)
  (var Memory * g_memory)

  (func globals_memory_hexmap_stream () (out binarystream *) (return g_memory_hexmap_stream))
  (func globals_set_memory_hexmap_stream ((binarystream * stream)) (out void)
    (set g_memory_hexmap_stream stream))
  (func globals_memory_data_stream () (out binarystream *) (return g_memory_data_stream))
  (func globals_set_memory_data_stream ((binarystream * stream)) (out void)
    (set g_memory_data_stream stream))
  (func globals_memory () (out Memory *) (return g_memory))
  (func globals_set_memory ((Memory * m)) (out void) (set g_memory m))

  ;; ==================================================================
  ;; The DBA reports -- dba_pagefiles and dba_pointers, the Memory
  ;; Viewer's raw dumps, and the watcher's attach/detach. The pointers
  ;; walk runs under the Streams pair; the original reads the shared
  ;; streams there with nothing held, which is one more seek/read race.
  ;; ==================================================================
  (func dba_attach_watcher ((Memory * m) (binarystream * watcher)) (out void)
    (if (!= (-> m watcher) nil)
        (delete* (-> m watcher)))
    (set (-> m watcher) watcher))

  (func dba_detach_watcher ((Memory * m)) (out void)
    (if (!= (-> m watcher) nil)
        (delete* (-> m watcher)))
    (set (-> m watcher) nil))

  (func dba_pagefiles ((Memory * m) (binarystream * stream)) (out void)
    (pthread_mutex_lock (aof (-> m page_list_access)))
    (let ((size_t total . 0)
          (PageEntry * e . #'(-> m pages)))
      (while (!= e nil)
        (set total (+ total 1))
        (set e (-> e next)))
      ((-> stream write_std_size) (cast size_t total))
      (set e (-> m pages))
      (while (!= e nil)
        ((-> stream write_std_string) (Utility::octet_as_hex (-> e key) (cast size_t HASHKEY_SIZE)))
        ((-> stream write_std_long) (cast int64_t (-> e address)))
        (set e (-> e next))))
    (pthread_mutex_unlock (aof (-> m page_list_access))))

  (func dba_pointers ((Memory * m) (binarystream * stream)) (out void)
    (letin* ((streams (Streams m)))
      (let ((int64_t pagefile_start . 0))
        ((-> stream read_std_long) pagefile_start)
        (if (or (< pagefile_start 0)
                (> pagefile_start (* (-> m page_count) (-> m page_size))))
            (block
              ((-> stream write_std_bool) #f)
              (return)))

        ((-> stream write_std_bool) #t)
        ((-> stream write_std_ubyte) (cast uint8_t 2))
        ((-> stream write_std_long) (cast int64_t pagefile_start))
        ((-> stream write_std_long) (cast int64_t PAGEFILE_CONTROL_SIZE))
        ((-> stream write_std_long) (cast int64_t PAGEFILE_CONTROL_SIZE))

        (let ((int64_t begin_address . #'(+ pagefile_start PAGEFILE_CONTROL_SIZE))
              (int64_t end_address . #'(+ pagefile_start (-> m page_size)))
              (Control control)
              (uint8_t hex_byte . 0))
          (control_clear (aof control))
          (while (< begin_address end_address)
            ((-> (-> m data_io) seekg) begin_address std::ios::beg)
            ((-> (-> m data_io) read_std_time) ($ control online_time))
            ((-> (-> m data_io) read_std_size) ($ control transaction_id))
            ((-> (-> m data_io) read_std_long) ($ control query_id))
            ((-> (-> m data_io) read_std_long) ($ control reference_address))
            ((-> (-> m data_io) read_std_time) ($ control modify_time))
            ((-> (-> m data_io) read_std_time) ($ control create_time))

            ((-> (-> m hexmap_io) seekg) (addr_hexmap begin_address) std::ios::beg)
            ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
            (set ($ control online_state) (cast RowState (bitand hex_byte 12)))
            (set ($ control online_lock) (cast RowLock (bitand hex_byte 3)))
            ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
            (set ($ control offline_state) (cast RowState (bitand hex_byte 12)))
            (set ($ control offline_lock) (cast RowLock (bitand hex_byte 3)))
            ((-> (-> m hexmap_io) seekg) (- CONTROL_COUNT 2) std::ios::cur)

            (let ((int64_t size . 0)
                  (int64_t actual_size . CONTROL_SIZE)
                  (int at_end . 0)
                  (int is_data . 0))
              (while (== at_end 0)
                ((-> (-> m hexmap_io) read_std_ubyte) hex_byte)
                (if (== (bitand hex_byte 64) 64)
                    (block
                      (set at_end 1)
                      (set is_data (? (== (bitand hex_byte 128) 128) 1 0))
                      ((-> stream write_std_bool) #t)
                      ((-> stream write_std_ubyte) (cast uint8_t is_data))
                      ((-> stream write_std_long) (cast int64_t begin_address))
                      ((-> stream write_std_long) (cast int64_t (+ size (size_remainder hex_byte))))
                      ((-> stream write_std_long) (cast int64_t (+ actual_size CHUNK_SIZE)))
                      (if (== is_data 1)
                          (block
                            ((-> stream write_std_ubyte) (cast uint8_t ($ control online_state)))
                            ((-> stream write_std_ubyte) (cast uint8_t ($ control online_lock)))
                            ((-> stream write_std_ubyte) (cast uint8_t ($ control offline_state)))
                            ((-> stream write_std_ubyte) (cast uint8_t ($ control offline_lock)))
                            ((-> stream write_std_time) (cast time_t ($ control online_time)))
                            ((-> stream write_std_size) (cast size_t ($ control transaction_id)))
                            ((-> stream write_std_long) (cast int64_t ($ control query_id)))
                            ((-> stream write_std_long) (cast int64_t ($ control reference_address)))
                            ((-> stream write_std_time) (cast time_t ($ control modify_time)))
                            ((-> stream write_std_time) (cast time_t ($ control create_time)))))
                      (set actual_size (+ actual_size CHUNK_SIZE)))
                  (block
                    (set size (+ size CHUNK_SIZE))
                    (set actual_size (+ actual_size CHUNK_SIZE)))))
              (set begin_address (+ begin_address actual_size))))))
      ((-> stream write_std_bool) #f)
      (cast void 0)))

  ;; ==================================================================
  ;; Sequences -- basesequence.hpp. One row per sequence under its own
  ;; hash key, guarded by a per-sequence mutex, every write OFFLINE:
  ;; a sequence never rolls back, by design. The CRTP statics of the
  ;; original (NAME, FROM, TO, STEP per generated class) are macro
  ;; parameters here -- see defsequence below -- and the null checks on
  ;; them vanish: a macro argument is present by construction.
  ;; ==================================================================

  ;; sequenceexception.hpp, code 5330
  (struct SequenceException (inherits ZiguratException)
    (ctor ((const char * msg))
      (init (ZiguratException 5330 (std::string msg)))))

  ;; the one row a sequence keeps
  (struct SeqRow (inherits BaseTable)
    (member int64_t current)
    (override) (method pack_size () (out int64_t) (return 8))
    (override) (method pack ((binarystream & io)) (out void)
      (($ io write_std_long) (cast int64_t ($ this current))))
    (override) (method unpack ((binarystream & io)) (out void)
      (($ io read_std_long) ($ this current))))

  ;; a lock the way the original holds its _guard: RAII, so a refusal
  ;; thrown from under it still lets the next caller in
  (struct MutexGuard
    (member pthread_mutex_t * mtx)
    (ctor ((pthread_mutex_t * mx))
      (init (mtx mx))
      (pthread_mutex_lock ($ this mtx)))
    (dtor ()
      (pthread_mutex_unlock ($ this mtx))))

  (struct Sequence
    (member Memory * m)
    (member const char * name)
    (member const uint8_t * hash_key)
    (member int64_t from)
    (member int64_t to)
    (member int64_t step)
    ;; 0 before the row was looked for, 1 once it exists, and from the
    ;; first read on THE ROW'S ADDRESS -- see seq_with_current. No record
    ;; starts at 0 or 1 (a page opens with its control area), and the
    ;; address rides in this member rather than a new one because a
    ;; generated sequence object owns the struct: a member it was compiled
    ;; without would be a write past the end of its static.
    (member int64_t initialized)
    (member pthread_mutex_t guard))

  (struct SeqFetchCtx
    (member Memory * m)
    (member SeqRow row)
    (member int found))

  (func seq_fetch_cb ((void * c) (Pointer * p)) (out bool)
    (let ((SeqFetchCtx * fc . #'(cast (SeqFetchCtx *) c)))
      (set ($ (-> fc row) pointer) (cof p))
      (read_row (-> fc m) (cast (BaseTable *) (aof (-> fc row))))
      (set (-> fc found) 1)
      (return #f)))

  ;; find the row, or create it at FROM -- and say so when there is no
  ;; store at all, which beats the segmentation fault it replaces
  (func seq_initialize ((Sequence * s)) (out void)
    (if (== (-> s m) nil)
        (throw* (SequenceException "sequence has no memory to read")))
    (let ((SeqFetchCtx fc))
      (set ($ fc m) (-> s m))
      (set ($ fc found) 0)
      (letin* ((streams (Streams (-> s m))))
        (cursor_walk (-> s m) (-> s hash_key) (aof streams)
                     (cast (void *) (aof fc)) seq_fetch_cb)
        (cast void 0))
      (if (== ($ fc found) 0)
          (let ((SeqRow row))
            (set ($ row current) (-> s from))
            (letin* ((streams (Streams (-> s m))))
              (offline_insert (-> s m) (-> s hash_key) (cast (BaseTable *) (aof row)))
              (cast void 0)))))
    (set (-> s initialized) 1))

  ;; the row, or a refusal that names the sequence -- a silent default
  ;; became "not null column" crashes several frames away upstream
  ;; whether ADDRESS still holds this sequence's row: an allocated record
  ;; in a page keyed to the sequence -- a sequence keeps one row, written
  ;; in place, so that is the row. Under the caller's streams guard.
  (func seq_row_holds ((Sequence * s) (int64_t address)) (out bool)
    (return (key_record_holds (-> s m) (-> s hash_key) address)))

  ;; THE ROW IS READ WHERE IT WAS FOUND. Every NEXT used to find its one
  ;; row by a cursor walk -- a statement, the key's page list copied into
  ;; fresh arrays twice (the walk's second round finds nothing new), a
  ;; walked-page map allocated, and the page's hexmap judged a byte at a
  ;; time, nearly all of it free. In a server on a 6.5 GB store, 2 001
  ;; NEXTs inside one procedure took 16 ms (the median of nine; 2 to 3 us
  ;; a call on a small store), the row id of every row of a 2 001-row
  ;; block. The row is written in place (offline_update), so its address
  ;; stands until the sequence's storage goes: the walk now runs once, the
  ;; address is kept in `initialized', and each read first checks that
  ;; the address still names an allocated record in a page keyed to this
  ;; sequence, walking again when it does not. The same 2 001: 3 ms.
  (func seq_with_current ((Sequence * s) (SeqRow * out)) (out void)
    (if (== (-> s initialized) 0)
        (seq_initialize s))
    (if (> (-> s initialized) 1)
        (letin* ((streams (Streams (-> s m))))
          (if (seq_row_holds s (-> s initialized))
              (block
                (set ($ (cof out) pointer) (pointer_at (-> s m) (-> s hash_key) (-> s initialized)))
                (read_row (-> s m) (cast (BaseTable *) out))
                (return)))
          (set (-> s initialized) 1)))
    (let ((SeqFetchCtx fc))
      (set ($ fc m) (-> s m))
      (set ($ fc found) 0)
      (letin* ((streams (Streams (-> s m))))
        (cursor_walk (-> s m) (-> s hash_key) (aof streams)
                     (cast (void *) (aof fc)) seq_fetch_cb)
        (cast void 0))
      (if (== ($ fc found) 0)
          (throw* (SequenceException "sequence has no row: it was never created, or this transaction cannot see it")))
      (set (cof out) ($ fc row))
      (if (> ($ ($ fc row) pointer address) 1)
          (set (-> s initialized) ($ ($ fc row) pointer address)))))

  (func seq_write ((Sequence * s) (SeqRow * row)) (out void)
    (letin* ((streams (Streams (-> s m))))
      (offline_update (-> s m) (cast (BaseTable *) row))
      (cast void 0)))

  (func seq_current ((Sequence * s)) (out int64_t)
    (letin* ((g (MutexGuard (aof (-> s guard)))))
      (let ((SeqRow row))
        (seq_with_current s (aof row))
        (return ($ row current)))))

  (func seq_set_current ((Sequence * s) (int64_t v)) (out void)
    (letin* ((g (MutexGuard (aof (-> s guard)))))
      (if (or (< v (-> s from)) (> v (-> s to)))
          (throw* (SequenceException "not in range")))
      (let ((SeqRow row))
        (seq_with_current s (aof row))
        (set ($ row current) v)
        (seq_write s (aof row)))
      (cast void 0)))

  ;; NEXT answers the value it stands on and then advances -- the first
  ;; NEXT of a fresh sequence is FROM, exactly as upstream
  (func seq_next ((Sequence * s)) (out int64_t)
    (letin* ((g (MutexGuard (aof (-> s guard)))))
      (let ((SeqRow row))
        (seq_with_current s (aof row))
        (if (> (+ ($ row current) (-> s step)) (-> s to))
            (throw* (SequenceException "maximum exceeds")))
        (let ((int64_t answer . #'($ row current)))
          (set ($ row current) (+ ($ row current) (-> s step)))
          (seq_write s (aof row))
          (return answer)))))

  (func seq_back ((Sequence * s)) (out int64_t)
    (letin* ((g (MutexGuard (aof (-> s guard)))))
      (let ((SeqRow row))
        (seq_with_current s (aof row))
        (if (< (- ($ row current) (-> s step)) (-> s from))
            (throw* (SequenceException "minimum exceeds")))
        (let ((int64_t answer . #'($ row current)))
          (set ($ row current) (- ($ row current) (-> s step)))
          (seq_write s (aof row))
          (return answer)))))

  (func seq_reset ((Sequence * s)) (out void)
    (letin* ((g (MutexGuard (aof (-> s guard)))))
      (let ((SeqRow row))
        (seq_with_current s (aof row))
        (set ($ row current) (-> s from))
        (seq_write s (aof row)))
      (cast void 0)))

  ;; ==================================================================
  ;; deftable -- Cicili metaprogramming where C++ used templates.
  ;;
  ;; The original instantiates Memory::online_insert<T> and friends per
  ;; generated table, with per-class statics for the name and hash key.
  ;; Here one macro expands the table definition into the struct (a real
  ;; BaseTable subclass with pack/unpack/pack_size written out), a
  ;; 20-byte hash key computed AT EXPANSION TIME in Lisp, and the typed
  ;; insert/update/delete/cursor/truncate wrappers. What a template
  ;; would have stamped out at instantiation, the macro stamps out at
  ;; read time -- checkable, greppable, and no template in sight.
  ;;
  ;; Columns are int64_t, (TEXT c) -- a std::string stored as a 16-bit
  ;; length and the bytes -- (REAL c): a double, eight bytes as they
  ;; are -- or (VECTOR c): the real engine's Vector<Double>, a dvec_t
  ;; stored as an int64 count and the doubles, eight bytes each. The
  ;; nullable Type layer is out of scope here -- and the store cannot
  ;; read a NULL back anyway, as doc/truncate.md records.
  ;; ==================================================================
  ;; The name may be the object's own qualified spelling -- Cicili's ::
  ;; is a name, so (deftable COCOLOG::MACHINES ID ...) needs no string:
  ;; the SQL name is the spelling itself, and the identifiers fold the
  ;; :: to _. A string after the name still overrides, which is what the
  ;; unqualified test tables use.
  (DEFMACRO deftable (name &REST args)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           ;; COCOLOG::MACHINES -> "COCOLOG_MACHINES": the C identifier the
           ;; generated functions and structs carry
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (qname   (FUNCALL qjoin name))
           (sqlname (IF (STRINGP (FIRST args)) (FIRST args) qname))
           (columns (IF (STRINGP (FIRST args)) (REST args) args))
           (sname   (FUNCALL qfold qname))
           (name    (INTERN sname))
           ;; a column is a symbol -- an int64 -- or (TEXT sym): a
           ;; variable-length string, stored as binarystream's std_text
           ;; (a 16-bit length and the bytes), which is what lets a row
           ;; carry clause text and 4000-byte machine chunks -- or
           ;; (VECTOR sym): a dvec_t, count then doubles -- or (REAL
           ;; sym): a double, eight bytes as they are. The kind symbol
           ;; is matched by NAME, because the generated file's TEXT and
           ;; this file's TEXT need not be the same package's. pack_size
           ;; is a virtual, so a row's size is its own business.
           (colspecs (MAPCAR (LAMBDA (c)
                               (COND ((NOT (LISTP c)) (CONS c 'INT))
                                     ((STRING= (SYMBOL-NAME (FIRST c)) "VECTOR")
                                      (CONS (SECOND c) 'VECTOR))
                                     ((STRING= (SYMBOL-NAME (FIRST c)) "REAL")
                                      (CONS (SECOND c) 'REAL))
                                     (T (CONS (SECOND c) 'TEXT))))
                             columns))
           (intcols  (LOOP FOR c IN colspecs
                           WHEN (EQ (CDR c) 'INT) COLLECT (CAR c)))
           (textcols (LOOP FOR c IN colspecs
                           WHEN (EQ (CDR c) 'TEXT) COLLECT (CAR c)))
           (veccols  (LOOP FOR c IN colspecs
                           WHEN (EQ (CDR c) 'VECTOR) COLLECT (CAR c)))
           (realcols (LOOP FOR c IN colspecs
                           WHEN (EQ (CDR c) 'REAL) COLLECT (CAR c)))
           (harr    (INTERN (CONCATENATE 'STRING sname "_HASHKEY")))
           (hready  (INTERN (CONCATENATE 'STRING sname "_hashkey_ready")))
           (kname   (INTERN (CONCATENATE 'STRING sname "_key")))
           (ctxname (INTERN (CONCATENATE 'STRING sname "_CursorCtx")))
           (hooksname (INTERN (CONCATENATE 'STRING sname "_Hooks")))
           (hooksvar (INTERN (CONCATENATE 'STRING sname "_hooks")))
           (shim    (INTERN (CONCATENATE 'STRING sname "_cursor_shim")))
           (icur    (INTERN (CONCATENATE 'STRING sname "_cursor")))
           (iins    (INTERN (CONCATENATE 'STRING sname "_insert")))
           (iupd    (INTERN (CONCATENATE 'STRING sname "_update")))
           (idel    (INTERN (CONCATENATE 'STRING sname "_delete")))
           (itrunc  (INTERN (CONCATENATE 'STRING sname "_truncate")))
           ;; a 20-byte digest of the table's SQL name, derived in Lisp.
           ;; DIVERGENCE: the real engine uses SHA-1; equality and
           ;; stability are all the engine ever asks of it.
           (bytes (LET ((h 2166136261) (out NIL))
                    (LOOP FOR ch ACROSS sqlname
                          DO (SETF h (LOGAND (* (LOGXOR h (CHAR-CODE ch)) 16777619)
                                             #xFFFFFFFF)))
                    (LOOP FOR i FROM 0 BELOW 20
                          DO (SETF h (LOGAND (+ (* h 1103515245) (+ 12345 i))
                                             #xFFFFFFFF))
                             (PUSH (LOGAND (ASH h -16) #xFF) out))
                    (NREVERSE out))))
      ;; THE COLUMN KINDS OUTLIVE THIS EXPANSION. defindex expands after
      ;; this form and with only a column's name in hand, so the kinds
      ;; ride on the table symbol's plist -- the one place two macro
      ;; expansions in one image can meet -- and defindex reads them
      ;; back to fold each key by its kind
      (SETF (GET name 'mvccs-colspecs) colspecs)
      `($$$
        ;; the seam an index attaches through: what the C++ engine wired
        ;; with per-class statics and generated map() bodies, a table
        ;; here exposes as one hooks record an index fills in at attach
        (struct ,hooksname
          (member func on_map ((void * mm) (void * rr)) (out void))
          (member func on_unmap ((void * mm) (void * rr)) (out void))
          (member func on_truncate ((void * mm)) (out void)))
        (var ,hooksname ,hooksvar)

        (struct ,name (inherits BaseTable)
          ,@(LOOP FOR c IN colspecs
                  COLLECT (COND ((EQ (CDR c) 'TEXT)   `(member std::string ,(CAR c)))
                                ((EQ (CDR c) 'VECTOR) `(member dvec_t ,(CAR c)))
                                ((EQ (CDR c) 'REAL)   `(member double ,(CAR c)))
                                (T                    `(member int64_t ,(CAR c)))))
          (override)
          (method pack_size () (out int64_t)
            (return ,(LET ((acc (* 8 (+ (LENGTH intcols) (LENGTH realcols)))))
                       (LOOP FOR c IN textcols
                             DO (SETF acc `(+ ,acc (+ 2 (cast int64_t (($ ($ this ,c) size)))))))
                       (LOOP FOR c IN veccols
                             DO (SETF acc `(+ ,acc (+ 8 (* 8 (cast int64_t (($ ($ this ,c) size))))))))
                       acc)))
          (override)
          (method pack ((binarystream & io)) (out void)
            ,@(LOOP FOR c IN colspecs
                    COLLECT (COND
                              ((EQ (CDR c) 'TEXT)
                               `(($ io write_std_text) (std::string ($ this ,(CAR c)))))
                              ((EQ (CDR c) 'VECTOR)
                               `(let ((size_t vi . 0)
                                      (size_t vn . #'(($ ($ this ,(CAR c)) size))))
                                  (($ io write_std_long) (cast int64_t vn))
                                  (while (< vi vn)
                                    (($ io write_std_double) (cast double (($ ($ this ,(CAR c)) at) vi)))
                                    (set vi (+ vi 1)))))
                              ((EQ (CDR c) 'REAL)
                               `(($ io write_std_double) (cast double ($ this ,(CAR c)))))
                              (T
                               `(($ io write_std_long) (cast int64_t ($ this ,(CAR c))))))))
          (override)
          (method unpack ((binarystream & io)) (out void)
            ,@(LOOP FOR c IN colspecs
                    COLLECT (COND
                              ((EQ (CDR c) 'TEXT)
                               `(($ io read_std_text) ($ this ,(CAR c))))
                              ((EQ (CDR c) 'VECTOR)
                               `(let ((int64_t vn . 0) (int64_t vi . 0) (double vd . 0.0))
                                  (($ ($ this ,(CAR c)) clear))
                                  (($ io read_std_long) vn)
                                  (($ ($ this ,(CAR c)) reserve) (cast size_t vn))
                                  (while (< vi vn)
                                    (($ io read_std_double) vd)
                                    (($ ($ this ,(CAR c)) push_back) vd)
                                    (set vi (+ vi 1)))))
                              ((EQ (CDR c) 'REAL)
                               `(($ io read_std_double) ($ this ,(CAR c))))
                              (T
                               `(($ io read_std_long) ($ this ,(CAR c)))))))
          (override)
          (method map ((void * mm)) (out void)
            (if (!= ($ ,hooksvar on_map) nil)
                (($ ,hooksvar on_map) mm (cast (void *) this))))
          (override)
          (method unmap ((void * mm)) (out void)
            (if (!= ($ ,hooksvar on_unmap) nil)
                (($ ,hooksvar on_unmap) mm (cast (void *) this)))))

        ;; no dotted inits here: a macro-produced dotted var breaks the
        ;; reader path, and namespace-scope C++ zero-initializes both anyway
        (var uint8_t ,harr [20])
        (var int ,hready)

        (func ,kname () (out const uint8_t *)
          (if (== ,hready 0)
              (block
                ,@(LOOP FOR b IN bytes FOR i FROM 0
                        COLLECT `(set (nth ,i ,harr) ,b))
                (set ,hready 1)))
          (return (cast (uint8_t *) ,harr)))

        (struct ,ctxname
          (member Memory * m)
          (member void * user)
          (member func cb ((void * u) (,name * r)) (out bool)))

        (func ,shim ((void * c) (Pointer * p)) (out bool)
          (let ((,ctxname * cc . #'(cast (,ctxname *) c)))
            (let ((,name row))
              (set ($ row pointer) (cof p))
              (read_row (-> cc m) (cast (BaseTable *) (aof row)))
              (return ((-> cc cb) (-> cc user) (aof row))))))

        (func ,icur ((Memory * m) (void * user)
                     (func cb ((void * u) (,name * r)) (out bool))) (out void)
          (let ((,ctxname cc))
            (set ($ cc m) m)
            (set ($ cc user) user)
            (set ($ cc cb) cb)
            ;; shared when the isolation writes nothing; the ctor decides
            (set tl_want_shared 1)
            (letin* ((streams (Streams m)))
              (cursor_walk m (,kname) (aof streams) (cast (void *) (aof cc)) ,shim)
              (cast void 0))))

        (func ,iins ((Memory * m) (,name * row)) (out void)
          (online_insert m (,kname) (cast (BaseTable *) row)))

        (func ,iupd ((Memory * m) (,name * old_row) (,name * new_row)) (out void)
          (online_update m (,kname) (cast (BaseTable *) old_row) (cast (BaseTable *) new_row)))

        (func ,idel ((Memory * m) (,name * row)) (out void)
          (online_delete m (cast (BaseTable *) row)))

        (func ,itrunc ((Memory * m)) (out size_t)
          ;; the rows first, then the indexes over them, as the original
          ;; truncate<T> orders it
          (let ((size_t rows . #'(truncate_key m (,kname))))
            (if (!= ($ ,hooksvar on_truncate) nil)
                (($ ,hooksvar on_truncate) (cast (void *) m)))
            (return rows))))))

  ;; ==================================================================
  ;; defindex -- the index tier's counterpart to deftable. Where the C++
  ;; engine instantiated BTreeIndex<Table, Column> with the hash key
  ;; SHA-1'd at runtime and the instance wired in a static initialiser,
  ;; this macro expands the index instance, its 20-byte hash key and
  ;; catalogue id (both computed at expansion time), an attach function
  ;; the program calls once per process after memory_open, and the typed
  ;; cursor wrappers over the table's own shim.
  ;;
  ;;   (defindex IDX_BOOK_VALUE Book value 0 65)
  ;;                            table col unique branching
  ;;
  ;; EVERY COLUMN KIND IS INDEXABLE. The column's kind -- read back from
  ;; what its deftable recorded -- decides how the key folds to the
  ;; tree's int64 (the rules beside text_key64) and what the wrappers
  ;; take: an INT index's _equal takes an int64_t, a TEXT index's a
  ;; const std::string &, a REAL index's a double, a VECTOR index's a
  ;; const dvec_t &. INT and REAL keys keep their order and get the
  ;; range family; TEXT and VECTOR keys are hashes and get equality
  ;; only. A consumer of a hashed index re-checks the column on each
  ;; row it is handed -- a collision is a wasted visit, never a wrong
  ;; answer -- and the rule is the server's too.
  ;;
  ;; Attaching hooks the index into the table's map/unmap/truncate seam;
  ;; several indexes chain on one table. _attach answers 1 the first
  ;; time a store meets the index, and _rebuild then fills its tree from
  ;; the rows the table already holds.
  ;; ==================================================================
  (DEFMACRO defindex (idxname table column unique branching)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           ;; COCOLOG::MACHINES -> "COCOLOG_MACHINES": the C identifier the
           ;; generated functions and structs carry
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (iname    (FUNCALL qfold (FUNCALL qjoin idxname)))
           (tname    (FUNCALL qfold (FUNCALL qjoin table)))
           (idxname  (INTERN iname))
           (table    (INTERN tname))
           (cols     (IF (LISTP column) column (LIST column)))
           (nlev     (LENGTH cols))
           ;; the column kinds deftable left on the table symbol: what
           ;; decides how each key folds to the tree's int64 (see the
           ;; key rules beside text_key64). A table this file never
           ;; declared, or a column the table does not have, is a
           ;; mistake at expansion time, not a C++ error three files on.
           (colspecs (OR (GET table 'mvccs-colspecs)
                         (ERROR "defindex ~A: no (deftable ~A ...) precedes it, so the columns' kinds are unknown"
                                iname tname)))
           (kind-of  (LAMBDA (c)
                       (LET ((spec (FIND (SYMBOL-NAME c) colspecs
                                         :KEY (LAMBDA (s) (SYMBOL-NAME (CAR s)))
                                         :TEST #'STRING=)))
                         (IF spec
                             (CDR spec)
                             (ERROR "defindex ~A: ~A is not a column of ~A" iname c tname)))))
           (kinds    (MAPCAR kind-of cols))
           ;; the row's key for one column: the member itself, or its fold
           (rowkey   (LAMBDA (c)
                       (CASE (FUNCALL kind-of c)
                         (TEXT   `(text_key64 (($ (-> r ,c) data)) (($ (-> r ,c) size))))
                         (VECTOR `(dvec_key64 (-> r ,c)))
                         (REAL   `(real_key64 (-> r ,c)))
                         (T      `(-> r ,c)))))
           ;; a wrapper's key parameter is typed by the column's kind, and
           ;; folded the same way the row's key was
           (ptype    (LAMBDA (k)
                       (CASE k
                         (TEXT   '(const std::string &))
                         (VECTOR '(const dvec_t &))
                         (REAL   '(double))
                         (T      '(int64_t)))))
           (pfold    (LAMBDA (k p)
                       (CASE k
                         (TEXT   `(text_key64 (($ ,p data)) (($ ,p size))))
                         (VECTOR `(dvec_key64 ,p))
                         (REAL   `(real_key64 ,p))
                         (T      p))))
           ;; the range family exists only where the tree's order is the
           ;; column's order: a hashed kind gets equality and nothing else
           (ordered  (AND (= nlev 1) (MEMBER (FIRST kinds) '(INT REAL))))
           (harr     (INTERN (CONCATENATE 'STRING iname "_HASHKEY")))
           (hready   (INTERN (CONCATENATE 'STRING iname "_hashkey_ready")))
           (keyfn    (INTERN (CONCATENATE 'STRING iname "_key")))
           (depharr  (INTERN (CONCATENATE 'STRING iname "_DEP_HASHKEY")))
           (dephready (INTERN (CONCATENATE 'STRING iname "_dep_hashkey_ready")))
           (depkeyfn (INTERN (CONCATENATE 'STRING iname "_dep_key")))
           (attach   (INTERN (CONCATENATE 'STRING iname "_attach")))
           (irebuild (INTERN (CONCATENATE 'STRING iname "_rebuild")))
           (prevvar  (INTERN (CONCATENATE 'STRING iname "_prev_hooks")))
           (regvar   (INTERN (CONCATENATE 'STRING iname "_registered")))
           (domap    (INTERN (CONCATENATE 'STRING iname "_do_map")))
           (dounmap  (INTERN (CONCATENATE 'STRING iname "_do_unmap")))
           (dotrunc  (INTERN (CONCATENATE 'STRING iname "_do_truncate")))
           (rebuildcb (INTERN (CONCATENATE 'STRING iname "_rebuild_row")))
           (tcur     (INTERN (CONCATENATE 'STRING tname "_cursor")))
           (icur     (INTERN (CONCATENATE 'STRING iname "_cursor")))
           (ieq      (INTERN (CONCATENATE 'STRING iname "_equal")))
           (ieqfirst (INTERN (CONCATENATE 'STRING iname "_equal_first")))
           (ieqfdep  (INTERN (CONCATENATE 'STRING iname "_equal_first_dep")))
           (ineq     (INTERN (CONCATENATE 'STRING iname "_not_equal")))
           (ilt      (INTERN (CONCATENATE 'STRING iname "_less_than")))
           (ilte     (INTERN (CONCATENATE 'STRING iname "_less_than_equal")))
           (igt      (INTERN (CONCATENATE 'STRING iname "_greater_than")))
           (igte     (INTERN (CONCATENATE 'STRING iname "_greater_than_equal")))
           (itrunc   (INTERN (CONCATENATE 'STRING iname "_truncate")))
           (tablekeyfn (INTERN (CONCATENATE 'STRING tname "_key")))
           (hooksvar (INTERN (CONCATENATE 'STRING tname "_hooks")))
           (hooksname (INTERN (CONCATENATE 'STRING tname "_Hooks")))
           (ctxname  (INTERN (CONCATENATE 'STRING tname "_CursorCtx")))
           (shim     (INTERN (CONCATENATE 'STRING tname "_cursor_shim")))
           ;; a 20-byte digest of a name, derived in Lisp at expansion time.
           ;; DIVERGENCE: the real engine uses SHA-1; equality and stability
           ;; are all the engine ever asks of it.
           (digest (LAMBDA (nm)
                     (LET ((h 2166136261) (out NIL))
                       (LOOP FOR ch ACROSS nm
                             DO (SETF h (LOGAND (* (LOGXOR h (CHAR-CODE ch)) 16777619)
                                                #xFFFFFFFF)))
                       (LOOP FOR i FROM 0 BELOW 20
                             DO (SETF h (LOGAND (+ (* h 1103515245) (+ 12345 i))
                                                #xFFFFFFFF))
                                (PUSH (LOGAND (ASH h -16) #xFF) out))
                       (NREVERSE out))))
           (bytes    (FUNCALL digest iname))
           ;; every dependent level of one index shares this second key --
           ;; the counterpart of the original's memcpy from the hash name
           (depbytes (FUNCALL digest (CONCATENATE 'STRING iname "~dep")))
           ;; the catalogue id: the digest's first eight bytes folded to a
           ;; positive int64 -- what the original kept as a hex hash_name
           (catid (LET ((v 0))
                    (LOOP FOR i FROM 0 BELOW 8
                          DO (SETF v (+ (* v 256) (NTH i bytes))))
                    (LOGAND v #x7FFFFFFFFFFFFFFF)))
           (kparams (LOOP FOR i FROM 0 BELOW nlev
                          COLLECT (INTERN (FORMAT NIL "k~A" i)))))
      `($$$
        (var uint8_t ,harr [20])
        (var int ,hready)
        (func ,keyfn () (out const uint8_t *)
          (if (== ,hready 0)
              (block
                ,@(LOOP FOR b IN bytes FOR i FROM 0
                        COLLECT `(set (nth ,i ,harr) ,b))
                (set ,hready 1)))
          (return (cast (uint8_t *) ,harr)))

        ,@(IF (> nlev 1)
              `((var uint8_t ,depharr [20])
                (var int ,dephready)
                (func ,depkeyfn () (out const uint8_t *)
                  (if (== ,dephready 0)
                      (block
                        ,@(LOOP FOR b IN depbytes FOR i FROM 0
                                COLLECT `(set (nth ,i ,depharr) ,b))
                        (set ,dephready 1)))
                  (return (cast (uint8_t *) ,depharr))))
              '())

        (var BTreeIndex ,idxname)

        ;; several indexes share one table: each keeps the hooks it found
        ;; at registration and calls them ahead of its own work, so the
        ;; table's map/unmap/truncate fan out down the chain. Registered
        ;; once per process -- a re-attach must not rechain, or the chain
        ;; would loop.
        (var ,hooksname ,prevvar)
        (var int ,regvar)

        ,@(IF (= nlev 1)
              `((func ,domap ((void * mm) (void * rr)) (out void)
                  (if (!= ($ ,prevvar on_map) nil)
                      (($ ,prevvar on_map) mm rr))
                  (let ((,table * r . #'(cast (,table *) rr)))
                    (bt_map (aof ,idxname) ,(FUNCALL rowkey (FIRST cols)) ($ (-> r pointer) address))))
                (func ,dounmap ((void * mm) (void * rr)) (out void)
                  (if (!= ($ ,prevvar on_unmap) nil)
                      (($ ,prevvar on_unmap) mm rr))
                  (let ((,table * r . #'(cast (,table *) rr)))
                    (bt_unmap (aof ,idxname) ,(FUNCALL rowkey (FIRST cols)) ($ (-> r pointer) address)))))
              `((func ,domap ((void * mm) (void * rr)) (out void)
                  (if (!= ($ ,prevvar on_map) nil)
                      (($ ,prevvar on_map) mm rr))
                  (let ((,table * r . #'(cast (,table *) rr))
                        (int64_t ks [8]))
                    ,@(LOOP FOR c IN cols FOR i FROM 0
                            COLLECT `(set (nth ,i ks) ,(FUNCALL rowkey c)))
                    (bt_map_multi (aof ,idxname) ks ($ (-> r pointer) address))))
                (func ,dounmap ((void * mm) (void * rr)) (out void)
                  (if (!= ($ ,prevvar on_unmap) nil)
                      (($ ,prevvar on_unmap) mm rr))
                  (let ((,table * r . #'(cast (,table *) rr))
                        (int64_t ks [8]))
                    ,@(LOOP FOR c IN cols FOR i FROM 0
                            COLLECT `(set (nth ,i ks) ,(FUNCALL rowkey c)))
                    (bt_unmap_multi (aof ,idxname) ks ($ (-> r pointer) address))))))

        ;; the rebuild's row hand: THIS index only -- domap chains the
        ;; other indexes' hooks, and each of them rebuilds itself. A row
        ;; the tree REFUSES -- a UNIQUE key the rows already hold twice
        ;; -- is counted for the caller (u, when it is not nil) rather
        ;; than thrown: this runs inside a cursor's callback window, and
        ;; an exception out of one would leave the streams guard behind.
        ,@(IF (= nlev 1)
              `((func ,rebuildcb ((void * u) (,table * r)) (out bool)
                  (try (bt_map (aof ,idxname) ,(FUNCALL rowkey (FIRST cols)) ($ (-> r pointer) address))
                       (catch ((const IndexException & e))
                         (cast void e)
                         (if (!= u nil)
                             (set (cof (cast (int64_t *) u)) (+ (cof (cast (int64_t *) u)) 1)))))
                  (return #t)))
              `((func ,rebuildcb ((void * u) (,table * r)) (out bool)
                  (let ((int64_t ks [8]))
                    ,@(LOOP FOR c IN cols FOR i FROM 0
                            COLLECT `(set (nth ,i ks) ,(FUNCALL rowkey c)))
                    (try (bt_map_multi (aof ,idxname) ks ($ (-> r pointer) address))
                         (catch ((const IndexException & e))
                           (cast void e)
                           (if (!= u nil)
                               (set (cof (cast (int64_t *) u)) (+ (cof (cast (int64_t *) u)) 1))))))
                  (return #t))))

        ;; a truncate is the one moment the table is at its smallest, so
        ;; the index is not swept there but REBUILT -- storage dropped
        ;; wholesale, survivors mapped into a fresh tree. See
        ;; bt_drop_storage for what sweeping could never reclaim.
        (func ,dotrunc ((void * mm)) (out void)
          (if (!= ($ ,prevvar on_truncate) nil)
              (($ ,prevvar on_truncate) mm))
          (bt_drop_storage (aof ,idxname) (cast (Memory *) mm))
          (,tcur (cast (Memory *) mm) nil ,rebuildcb))

        ;; answers 1 when the STORE met this index for the first time:
        ;; its catalogue row was just created, and whatever rows the
        ;; table already holds are not in the tree. The consumer then
        ;; calls the _rebuild below -- inside its own transaction, so the
        ;; index lands with the commit it chooses -- and 0 every open
        ;; after that.
        (func ,attach ((Memory * m)) (out int)
          (set ($ ,idxname m) m)
          (set ($ ,idxname name) ,iname)
          (set ($ ,idxname hash_key) (intern_key (,keyfn)))
          (set ($ ,idxname table_key) (,tablekeyfn))
          (set ($ ,idxname catalogue_id) ,catid)
          (set ($ ,idxname is_unique) ,unique)
          (set ($ ,idxname branching_factor) ,branching)
          (set ($ ,idxname min_degree) ,(- branching 1))
          (set ($ ,idxname max_degree) ,(* (- branching 1) 2))
          (set ($ ,idxname root_address) -1)
          (set ($ ,idxname record_pointer) (pointer_null))
          (set ($ ,idxname levels) ,nlev)
          (set ($ ,idxname is_dependent) 0)
          ,(IF (> nlev 1)
               `(set ($ ,idxname dep_hash_key) (intern_key (,depkeyfn)))
               `(set ($ ,idxname dep_hash_key) nil))
          (let ((int fresh . #'(bt_select_record (aof ,idxname))))
            (if (== ,regvar 0)
                (block
                  (set ($ ,prevvar on_map) ($ ,hooksvar on_map))
                  (set ($ ,prevvar on_unmap) ($ ,hooksvar on_unmap))
                  (set ($ ,prevvar on_truncate) ($ ,hooksvar on_truncate))
                  (set ($ ,hooksvar on_map) ,domap)
                  (set ($ ,hooksvar on_unmap) ,dounmap)
                  (set ($ ,hooksvar on_truncate) ,dotrunc)
                  (set ,regvar 1)))
            (return fresh)))

        ;; the tree over the rows already there: storage dropped, then
        ;; one table walk maps every row into a fresh tree. What the
        ;; truncate hook does for the whole chain, for THIS index alone.
        ;; Exclusive for the walk -- the callback writes nodes and keys,
        ;; and the table cursor's own shared guard nests under this one
        ;; as a no-op. Answers how many rows the tree refused: 0 is a
        ;; complete index; anything else is a UNIQUE key the table
        ;; already holds twice, and the caller decides what that means.
        (func ,irebuild ((Memory * m)) (out int64_t)
          (let ((int64_t refused . 0))
            (bt_drop_storage (aof ,idxname) m)
            (set tl_want_shared 0)
            (letin* ((streams (Streams m)))
              (,tcur m (cast (void *) (aof refused)) ,rebuildcb)
              (cast void 0))
            (return refused)))

        ;; the full row walk descends every level by itself
        (func ,icur ((Memory * m) (void * user)
                     (func cb ((void * u) (,table * r)) (out bool))) (out void)
          (let ((,ctxname cc))
            (set ($ cc m) m)
            (set ($ cc user) user)
            (set ($ cc cb) cb)
            (bt_cursor_rows_deep (aof ,idxname) (cast (void *) (aof cc)) ,shim)))

        ;; equality over the whole tuple: one key parameter per column,
        ;; typed by the column's kind and folded as the row's key was
        (func ,ieq ((Memory * m)
                    ,@(LOOP FOR kp IN kparams FOR k IN kinds
                            COLLECT `(,@(FUNCALL ptype k) ,kp))
                    (void * user)
                    (func cb ((void * u) (,table * r)) (out bool))) (out void)
          (let ((,ctxname cc)
                (int64_t ks [8]))
            (set ($ cc m) m)
            (set ($ cc user) user)
            (set ($ cc cb) cb)
            ,@(LOOP FOR kp IN kparams FOR k IN kinds FOR i FROM 0
                    COLLECT `(set (nth ,i ks) ,(FUNCALL pfold k kp)))
            (bt_cursor_equal_multi (aof ,idxname) ks (cast (void *) (aof cc)) ,shim)))

        ;; a composite answers its LEADING column alone: equality on the
        ;; first level, every dependent level walked whole -- the rows a
        ;; (kb name) index holds for one kb. What the server's WHERE
        ;; compiler emits for a predicate on the first column only.
        ,@(IF (> nlev 1)
              `((func ,ieqfdep ((void * c) (BTreeIndex * dep)) (out bool)
                  (return (bt_cursor_rows_deep dep c ,shim)))
                (func ,ieqfirst ((Memory * m) (,@(FUNCALL ptype (FIRST kinds)) k) (void * user)
                                 (func cb ((void * u) (,table * r)) (out bool))) (out void)
                  (let ((,ctxname cc))
                    (set ($ cc m) m)
                    (set ($ cc user) user)
                    (set ($ cc cb) cb)
                    (bt_cursor_equal_dep (aof ,idxname) ,(FUNCALL pfold (FIRST kinds) 'k)
                                         (cast (void *) (aof cc)) ,ieqfdep))))
              '())

        ;; the range family stays single-column: on a composite index the
        ;; engine's *_dep cursors hand the dependent levels to the caller.
        ;; And it exists only over an ORDERED kind -- a hashed key's tree
        ;; is in hash order, and a range over it would answer garbage, so
        ;; a TEXT or VECTOR index has equality and nothing else.
        ,@(IF ordered
              (LET ((kt (FUNCALL ptype (FIRST kinds)))
                    (kf (FUNCALL pfold (FIRST kinds) 'k)))
                `((func ,ineq ((Memory * m) (,@kt k) (void * user)
                               (func cb ((void * u) (,table * r)) (out bool))) (out void)
                    (let ((,ctxname cc))
                      (set ($ cc m) m)
                      (set ($ cc user) user)
                      (set ($ cc cb) cb)
                      (bt_cursor_not_equal (aof ,idxname) ,kf (cast (void *) (aof cc)) ,shim)))
                  (func ,ilt ((Memory * m) (,@kt k) (void * user)
                              (func cb ((void * u) (,table * r)) (out bool))) (out void)
                    (let ((,ctxname cc))
                      (set ($ cc m) m)
                      (set ($ cc user) user)
                      (set ($ cc cb) cb)
                      (bt_cursor_less_than (aof ,idxname) ,kf (cast (void *) (aof cc)) ,shim)))
                  (func ,ilte ((Memory * m) (,@kt k) (void * user)
                               (func cb ((void * u) (,table * r)) (out bool))) (out void)
                    (let ((,ctxname cc))
                      (set ($ cc m) m)
                      (set ($ cc user) user)
                      (set ($ cc cb) cb)
                      (bt_cursor_less_than_equal (aof ,idxname) ,kf (cast (void *) (aof cc)) ,shim)))
                  (func ,igt ((Memory * m) (,@kt k) (void * user)
                              (func cb ((void * u) (,table * r)) (out bool))) (out void)
                    (let ((,ctxname cc))
                      (set ($ cc m) m)
                      (set ($ cc user) user)
                      (set ($ cc cb) cb)
                      (bt_cursor_greater_than (aof ,idxname) ,kf (cast (void *) (aof cc)) ,shim)))
                  (func ,igte ((Memory * m) (,@kt k) (void * user)
                               (func cb ((void * u) (,table * r)) (out bool))) (out void)
                    (let ((,ctxname cc))
                      (set ($ cc m) m)
                      (set ($ cc user) user)
                      (set ($ cc cb) cb)
                      (bt_cursor_greater_than_equal (aof ,idxname) ,kf (cast (void *) (aof cc)) ,shim)))))
              '())

        ;; true key deletion, single-level only -- the composite
        ;; semantics upstream are unfinished and the engine refuses them
        ,@(IF (= nlev 1)
              `((func ,(INTERN (CONCATENATE 'STRING iname "_unmap_key"))
                      ((Memory * m) (,@(FUNCALL ptype (FIRST kinds)) k)) (out void)
                  (cast void m)
                  (bt_unmap_key (aof ,idxname) ,(FUNCALL pfold (FIRST kinds) 'k))))
              '())

        (func ,itrunc ((Memory * m)) (out size_t)
          (return (bt_truncate (aof ,idxname) m))))))

  ;; ==================================================================
  ;; defsequence -- the sequence tier's macro. The original's generated
  ;; sequence class is CRTP over BaseSequence with NAME/FROM/TO/STEP as
  ;; per-class statics; here they are expansion-time arguments, and the
  ;; instance, its hash key and the argument-free wrappers come out of
  ;; one form:
  ;;
  ;;   (defsequence SEQ_ORDER "smoke::OrderSeq" 100 999 1)
  ;; ==================================================================
  (DEFMACRO defsequence (seqname &REST args)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           ;; COCOLOG::MACHINES -> "COCOLOG_MACHINES": the C identifier the
           ;; generated functions and structs carry
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (fullq   (FUNCALL qjoin seqname))
           (sqlname (IF (STRINGP (FIRST args)) (FIRST args) fullq))
           (bounds  (IF (STRINGP (FIRST args)) (REST args) args))
           (from    (FIRST bounds))
           (to      (SECOND bounds))
           (step    (THIRD bounds))
           (qname   (FUNCALL qfold fullq))
           (seqname (INTERN qname))
           (harr    (INTERN (CONCATENATE 'STRING qname "_HASHKEY")))
           (hready  (INTERN (CONCATENATE 'STRING qname "_hashkey_ready")))
           (keyfn   (INTERN (CONCATENATE 'STRING qname "_key")))
           (attach  (INTERN (CONCATENATE 'STRING qname "_attach")))
           (wcur    (INTERN (CONCATENATE 'STRING qname "_current")))
           (wset    (INTERN (CONCATENATE 'STRING qname "_set_current")))
           (wnext   (INTERN (CONCATENATE 'STRING qname "_next")))
           (wback   (INTERN (CONCATENATE 'STRING qname "_back")))
           (wreset  (INTERN (CONCATENATE 'STRING qname "_reset")))
           (bytes (LET ((h 2166136261) (out NIL))
                    (LOOP FOR ch ACROSS sqlname
                          DO (SETF h (LOGAND (* (LOGXOR h (CHAR-CODE ch)) 16777619)
                                             #xFFFFFFFF)))
                    (LOOP FOR i FROM 0 BELOW 20
                          DO (SETF h (LOGAND (+ (* h 1103515245) (+ 12345 i))
                                             #xFFFFFFFF))
                             (PUSH (LOGAND (ASH h -16) #xFF) out))
                    (NREVERSE out))))
      `($$$
        (var uint8_t ,harr [20])
        (var int ,hready)
        (func ,keyfn () (out const uint8_t *)
          (if (== ,hready 0)
              (block
                ,@(LOOP FOR b IN bytes FOR i FROM 0
                        COLLECT `(set (nth ,i ,harr) ,b))
                (set ,hready 1)))
          (return (cast (uint8_t *) ,harr)))

        (var Sequence ,seqname)

        (func ,attach ((Memory * m)) (out void)
          (set ($ ,seqname m) m)
          (set ($ ,seqname name) ,qname)
          (set ($ ,seqname hash_key) (intern_key (,keyfn)))
          (set ($ ,seqname from) ,from)
          (set ($ ,seqname to) ,to)
          (set ($ ,seqname step) ,step)
          (set ($ ,seqname initialized) 0)
          (pthread_mutex_init (aof ($ ,seqname guard)) nil))

        (func ,wcur () (out int64_t)
          (return (seq_current (aof ,seqname))))
        (func ,wset ((int64_t v)) (out void)
          (seq_set_current (aof ,seqname) v))
        (func ,wnext () (out int64_t)
          (return (seq_next (aof ,seqname))))
        (func ,wback () (out int64_t)
          (return (seq_back (aof ,seqname))))
        (func ,wreset () (out void)
          (seq_reset (aof ,seqname))))))

  ;; ==================================================================
  ;; The DML tier. What the Parsi compiler's SELECT/UPDATE/DELETE
  ;; emission does with capturing lambdas, a Cicili consumer does with
  ;; these: each macro folds the context struct, the lifted callback
  ;; and the runner that hand-written queries spell out one by one.
  ;;
  ;; The WHERE argument is any Cicili boolean form; inside it `row' is
  ;; the current row (a TABLE *) and every declared parameter is in
  ;; scope by its own name. Parameters are (type name) pairs; a type is
  ;; one symbol (int64_t, std::string).
  ;;
  ;;   (defcount  book_count Book ((int64_t k)) (== (-> row value) k))
  ;;   (deffind   book_find  Book ((int64_t id)) (== (-> row id) id))
  ;;   (defdelete loan_drop  Loan ((int64_t b)) (== (-> row book_id) b))
  ;;   (defupdate reprice    Book ((int64_t f) (int64_t v))
  ;;              (== (-> row value) f)
  ;;              ((value v)))
  ;;   (defquery  book_sum   Book () #t
  ;;     (set (cof (cast (int64_t *) user))
  ;;          (+ (cof (cast (int64_t *) user)) (-> row value))))
  ;;
  ;; All of them walk the table's own cursor -- the visibility rules
  ;; ride with it -- and apply WHERE to every row, exactly as the
  ;; generated C++ scan does. An indexed walk stays what it always
  ;; was: the defindex wrappers, called by hand where the key is known.
  ;; ==================================================================

  ;; defquery -- the general fold: run BODY for each row WHERE admits.
  ;; The runner takes (Memory * m), the parameters, and a (void * user)
  ;; that reaches BODY untouched -- the accumulator's seat, since
  ;; nothing here captures.
  (DEFMACRO defquery (name table params where &BODY body)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (tname   (FUNCALL qfold (FUNCALL qjoin table)))
           (table   (INTERN tname))
           (tcur    (INTERN (CONCATENATE 'STRING tname "_cursor")))
           (sname   (SYMBOL-NAME name))
           (name    (INTERN sname))
           (ctxname (INTERN (CONCATENATE 'STRING sname "_QCtx")))
           (cbname  (INTERN (CONCATENATE 'STRING sname "_qcb")))
           (cbbody  `((if ,where (block ,@body))
                      (return #t))))
      `($$$
        (struct ,ctxname
          ,@(LOOP FOR p IN params COLLECT `(member ,(FIRST p) ,(SECOND p)))
          (member void * user))
        (func ,cbname ((void * u) (,table * row)) (out bool)
          (let ((,ctxname * qq . #'(cast (,ctxname *) u)))
            (let ((void * user . #'(-> qq user)))
              ,@(IF params
                    `((let ,(LOOP FOR p IN params
                                  COLLECT `(,(FIRST p) ,(SECOND p) . #'(-> qq ,(SECOND p))))
                        ,@cbbody))
                    cbbody))))
        (func ,name ((Memory * m) ,@params (void * user)) (out void)
          (let ((,ctxname qq))
            ,@(LOOP FOR p IN params COLLECT `(set ($ qq ,(SECOND p)) ,(SECOND p)))
            (set ($ qq user) user)
            (,tcur m (cast (void *) (aof qq)) ,cbname))))))

  ;; defcount -- how many rows WHERE admits
  (DEFMACRO defcount (name table params where)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (tname   (FUNCALL qfold (FUNCALL qjoin table)))
           (table   (INTERN tname))
           (tcur    (INTERN (CONCATENATE 'STRING tname "_cursor")))
           (sname   (SYMBOL-NAME name))
           (name    (INTERN sname))
           (ctxname (INTERN (CONCATENATE 'STRING sname "_QCtx")))
           (cbname  (INTERN (CONCATENATE 'STRING sname "_qcb")))
           (cbbody  `((if ,where (set (-> qq hits) (+ (-> qq hits) 1)))
                      (return #t))))
      `($$$
        (struct ,ctxname
          ,@(LOOP FOR p IN params COLLECT `(member ,(FIRST p) ,(SECOND p)))
          (member int64_t hits))
        (func ,cbname ((void * u) (,table * row)) (out bool)
          (let ((,ctxname * qq . #'(cast (,ctxname *) u)))
            ,@(IF params
                  `((let ,(LOOP FOR p IN params
                                COLLECT `(,(FIRST p) ,(SECOND p) . #'(-> qq ,(SECOND p))))
                      ,@cbbody))
                  cbbody)))
        (func ,name ((Memory * m) ,@params) (out int64_t)
          (let ((,ctxname qq))
            ,@(LOOP FOR p IN params COLLECT `(set ($ qq ,(SECOND p)) ,(SECOND p)))
            (set ($ qq hits) 0)
            (,tcur m (cast (void *) (aof qq)) ,cbname)
            (return ($ qq hits)))))))

  ;; deffind -- the first row WHERE admits, copied to out_row; the walk
  ;; stops at the hit. Returns 1 found, 0 not.
  (DEFMACRO deffind (name table params where)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (tname   (FUNCALL qfold (FUNCALL qjoin table)))
           (table   (INTERN tname))
           (tcur    (INTERN (CONCATENATE 'STRING tname "_cursor")))
           (sname   (SYMBOL-NAME name))
           (name    (INTERN sname))
           (ctxname (INTERN (CONCATENATE 'STRING sname "_QCtx")))
           (cbname  (INTERN (CONCATENATE 'STRING sname "_qcb")))
           (cbbody  `((if ,where
                          (block
                            (set (-> qq row) (cof row))
                            (set (-> qq found) 1)
                            (return #f)))
                      (return #t))))
      `($$$
        (struct ,ctxname
          ,@(LOOP FOR p IN params COLLECT `(member ,(FIRST p) ,(SECOND p)))
          (member ,table row)
          (member int found))
        (func ,cbname ((void * u) (,table * row)) (out bool)
          (let ((,ctxname * qq . #'(cast (,ctxname *) u)))
            ,@(IF params
                  `((let ,(LOOP FOR p IN params
                                COLLECT `(,(FIRST p) ,(SECOND p) . #'(-> qq ,(SECOND p))))
                      ,@cbbody))
                  cbbody)))
        (func ,name ((Memory * m) ,@params (,table * out_row)) (out int)
          (let ((,ctxname qq))
            ,@(LOOP FOR p IN params COLLECT `(set ($ qq ,(SECOND p)) ,(SECOND p)))
            (set ($ qq found) 0)
            (,tcur m (cast (void *) (aof qq)) ,cbname)
            (if (and (== ($ qq found) 1) (!= out_row nil))
                (set (cof out_row) ($ qq row)))
            (return ($ qq found)))))))

  ;; defdelete -- online_delete every row WHERE admits, inside the
  ;; walk, exactly as the generated DELETE ... WHERE does. Returns how
  ;; many.
  (DEFMACRO defdelete (name table params where)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (tname   (FUNCALL qfold (FUNCALL qjoin table)))
           (table   (INTERN tname))
           (tcur    (INTERN (CONCATENATE 'STRING tname "_cursor")))
           (tdel    (INTERN (CONCATENATE 'STRING tname "_delete")))
           (sname   (SYMBOL-NAME name))
           (name    (INTERN sname))
           (ctxname (INTERN (CONCATENATE 'STRING sname "_QCtx")))
           (cbname  (INTERN (CONCATENATE 'STRING sname "_qcb")))
           (cbbody  `((if ,where
                          (block
                            (,tdel (-> qq m) row)
                            (set (-> qq hits) (+ (-> qq hits) 1))))
                      (return #t))))
      `($$$
        (struct ,ctxname
          ,@(LOOP FOR p IN params COLLECT `(member ,(FIRST p) ,(SECOND p)))
          (member Memory * m)
          (member int64_t hits))
        (func ,cbname ((void * u) (,table * row)) (out bool)
          (let ((,ctxname * qq . #'(cast (,ctxname *) u)))
            ,@(IF params
                  `((let ,(LOOP FOR p IN params
                                COLLECT `(,(FIRST p) ,(SECOND p) . #'(-> qq ,(SECOND p))))
                      ,@cbbody))
                  cbbody)))
        (func ,name ((Memory * m) ,@params) (out int64_t)
          (let ((,ctxname qq))
            ,@(LOOP FOR p IN params COLLECT `(set ($ qq ,(SECOND p)) ,(SECOND p)))
            (set ($ qq m) m)
            (set ($ qq hits) 0)
            (,tcur m (cast (void *) (aof qq)) ,cbname)
            (return ($ qq hits)))))))

  ;; defupdate -- for every row WHERE admits: copy it, apply the SET
  ;; pairs ((column expr) ...), online_update old to new -- the
  ;; generated UPDATE ... SET ... WHERE, folded. An expr sees `row'
  ;; (the OLD row) and the parameters. Returns how many.
  (DEFMACRO defupdate (name table params where sets)
    (LET* ((qjoin (LAMBDA (n)
                    (IF (LISTP n)
                        (FORMAT NIL "~{~A~^::~}" (CDR n))
                        (SYMBOL-NAME n))))
           (qfold (LAMBDA (q)
                    (LET ((out NIL) (i 0) (n (LENGTH q)))
                      (LOOP WHILE (< i n)
                            DO (LET ((ch (CHAR q i)))
                                 (IF (AND (CHAR= ch #\:) (< (+ i 1) n)
                                          (CHAR= (CHAR q (+ i 1)) #\:))
                                     (PROGN (PUSH #\_ out) (SETF i (+ i 2)))
                                     (PROGN (PUSH ch out) (SETF i (+ i 1))))))
                      (COERCE (NREVERSE out) 'STRING))))
           (tname   (FUNCALL qfold (FUNCALL qjoin table)))
           (table   (INTERN tname))
           (tcur    (INTERN (CONCATENATE 'STRING tname "_cursor")))
           (tupd    (INTERN (CONCATENATE 'STRING tname "_update")))
           (sname   (SYMBOL-NAME name))
           (name    (INTERN sname))
           (ctxname (INTERN (CONCATENATE 'STRING sname "_QCtx")))
           (cbname  (INTERN (CONCATENATE 'STRING sname "_qcb")))
           (cbbody  `((if ,where
                          (block
                            (let ((,table nr))
                              (set nr (cof row))
                              ,@(LOOP FOR s IN sets
                                      COLLECT `(set ($ nr ,(FIRST s)) ,(SECOND s)))
                              (,tupd (-> qq m) row (aof nr)))
                            (set (-> qq hits) (+ (-> qq hits) 1))))
                      (return #t))))
      `($$$
        (struct ,ctxname
          ,@(LOOP FOR p IN params COLLECT `(member ,(FIRST p) ,(SECOND p)))
          (member Memory * m)
          (member int64_t hits))
        (func ,cbname ((void * u) (,table * row)) (out bool)
          (let ((,ctxname * qq . #'(cast (,ctxname *) u)))
            ,@(IF params
                  `((let ,(LOOP FOR p IN params
                                COLLECT `(,(FIRST p) ,(SECOND p) . #'(-> qq ,(SECOND p))))
                      ,@cbbody))
                  cbbody)))
        (func ,name ((Memory * m) ,@params) (out int64_t)
          (let ((,ctxname qq))
            ,@(LOOP FOR p IN params COLLECT `(set ($ qq ,(SECOND p)) ,(SECOND p)))
            (set ($ qq m) m)
            (set ($ qq hits) 0)
            (,tcur m (cast (void *) (aof qq)) ,cbname)
            (return ($ qq hits)))))))
))
