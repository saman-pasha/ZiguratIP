;;;; The generated-schema test: the .cicili files under generated/ are
;;;; BYTE-FOR-BYTE what the Parsi compiler wrote beside the C++ pair for
;;;; cocolog's tables and sequences (copied from home/ld/_COCOLOG::*_.cicili;
;;;; regenerate with cocolog's `make schema`). If this target compiles and
;;;; its checks run green, a Parsi schema really does define the same
;;;; objects against the Cicili MVCCS engine through the def... macros.
;;;;
;;;; STRING/TEXT Parsi columns ride as (TEXT col) -- std::string members
;;;; packed as 2-byte length + bytes -- and their indexes are real: a
;;;; String-keyed Parsi index is a defindex over the TEXT column, keyed
;;;; by the text's hash, equality only, with the row re-checked by the
;;;; consumer. The name lookups here go both ways, scan and index, and
;;;; the UNIQUE name is enforced. An index a store meets for the first
;;;; time over a table with rows (the KB index, attached only at the
;;;; reopen) is rebuilt from them, and the rebuild is durable.
;;;; Vector<Double> columns ride as (VECTOR col) -- dvec_t members packed
;;;; as an int64 count and the doubles, eight bytes each, exactly as they
;;;; are: the tensors twin here proves a vector row goes in, comes back
;;;; bit-equal, and survives a restart.

(source "schema_test.cpp"
  (make :cpp #t
        ;; TWO CLANG-ONLY COMPLAINTS ABOUT CORRECT EMISSION: the
        ;; paren-wrapped `while ((x == 0))' the transpiler writes, and
        ;; the unbraced else-if chain. Cicili treats any unrecognised
        ;; compiler chatter as FATAL, so under clang the first of these
        ;; stopped the build outright -- an `Unhandled SIMPLE-ERROR'
        ;; whose text was a -Wparentheses-equality warning. gcc ignores
        ;; unknown -Wno- options, so both flags travel to every platform.
        ;; cocolog.cicili and embed.cicili carry the same pair.
        ;;
        ;; AND THE STANDARD, SAID OUT LOUD. Every makefile in this
        ;; workspace compiles with -std=c++17; these Cicili targets did
        ;; not say, and inherited whatever the compiler defaulted to --
        ;; gnu++17 on Ubuntu's clang, C++14 on Apple's. Under C++14
        ;; there is no guaranteed copy elision, so the transpiler's
        ;; `filestream f = filestream(...)' needs a copy constructor the
        ;; class deletes, and the build died at `call to
        ;; implicitly-deleted copy constructor' naming a line that is
        ;; correct C++17. gnu++17 rather than c++17 because the emitted
        ;; code uses statement expressions, a GNU extension both
        ;; compilers accept.
        ;; A THIRD, FROM APPLE'S SDK: `sprintf' is marked deprecated
        ;; there, and a deprecation is a warning -- which Cicili treats
        ;; as fatal, so the build stopped naming a function that works.
        ;; Silenced in the target's own list, as the other two are.
        :compile ("-std=gnu++17" "-Wno-deprecated-declarations"
                  "-Wno-parentheses-equality" "-Wno-dangling-else"
                  "-c" "schema_test.cpp")
        :link ("-lschema_test.o" "-o" "schema_test"
               "-L../home/lib" "-lCore" "-lStreamIO"
               "-lpthread"))

  (include <cstdio>)
  (include <cstdint>)
  (include <cstring>)
  (include <cstdlib>)
  (include <string>)
  (include <vector>)
  (include <pthread.h>)
  (include <unistd.h>)
  (include <time.h>)
  (include <ctype.h>)
  (include "../home/include/zexception.hpp")
  (include "../home/include/utility.hpp")
  (include "../home/include/binarystream.hpp")
  (include "../home/include/filestream.hpp")
  (include "../home/include/mapstream.hpp")
  (include "../home/include/bufferstream.hpp")
  (include "../home/include/textstream.hpp")

  (import "./mvccs-lib.cicili")
  (mvccs-engine)

  ;; what the Parsi compiler wrote, untouched
  (import "./generated/cocolog-machines.cicili")
  (import "./generated/cocolog-machines-seq.cicili")
  (import "./generated/cocolog-tensors.cicili")
  (import "./generated/cocolog-tensors-seq.cicili")
  (define-COCOLOG_MACHINES)
  (define-COCOLOG_MACHINES_SEQ)
  (define-COCOLOG_TENSORS)
  (define-COCOLOG_TENSORS_SEQ)

  (var int failures . 0)

  (func check ((const char * what) (int64_t got) (int64_t want)) (out void)
    (if (== got want)
        (printf "ok   %-44s %ld\n" what (cast long got))
      (block
        (printf "FAIL %-44s got %ld want %ld\n" what (cast long got) (cast long want))
        (set failures (+ failures 1)))))

  (struct MCountCtx
    (member int64_t rows)
    (member int64_t id_sum))

  (func machine_count_cb ((void * u) (COCOLOG_MACHINES * r)) (out bool)
    (let ((MCountCtx * c . #'(cast (MCountCtx *) u)))
      (set (-> c rows) (+ (-> c rows) 1))
      (set (-> c id_sum) (+ (-> c id_sum) (-> r ID)))
      (return #t)))

  ;; name lookup by scan, and the same through the generated TEXT index
  ;; -- the callback re-checks the name either way, which is what a
  ;; consumer of a hashed key owes
  (struct MNameCtx
    (member const char * target)
    (member int64_t hits)
    (member int64_t id))

  (func machine_name_cb ((void * u) (COCOLOG_MACHINES * r)) (out bool)
    (let ((MNameCtx * c . #'(cast (MNameCtx *) u)))
      (if (== 0 (strcmp (($ (-> r NAME) c_str)) (-> c target)))
          (block
            (set (-> c hits) (+ (-> c hits) 1))
            (set (-> c id) (-> r ID))))
      (return #t)))

  (func machines_by_name ((Memory * m) (const char * name)) (out int64_t)
    (let ((MNameCtx c))
      (set ($ c target) name)
      (set ($ c hits) 0)
      (set ($ c id) 0)
      (COCOLOG_MACHINES_cursor m (cast (void *) (aof c)) machine_name_cb)
      (return ($ c hits))))

  (func machine_id_by_name ((Memory * m) (const char * name)) (out int64_t)
    (let ((MNameCtx c))
      (set ($ c target) name)
      (set ($ c hits) 0)
      (set ($ c id) 0)
      (COCOLOG_MACHINES_cursor m (cast (void *) (aof c)) machine_name_cb)
      (return ($ c id))))

  (func machines_by_name_idx ((Memory * m) (const char * name)) (out int64_t)
    (let ((MNameCtx c))
      (set ($ c target) name)
      (set ($ c hits) 0)
      (set ($ c id) 0)
      (IDX_COCOLOG_MACHINES_NAME_equal m (std::string name) (cast (void *) (aof c)) machine_name_cb)
      (return ($ c hits))))

  (func machine_kb_cb ((void * u) (COCOLOG_MACHINES * r)) (out bool)
    (let ((MNameCtx * c . #'(cast (MNameCtx *) u)))
      (if (== 0 (strcmp (($ (-> r KB) c_str)) (-> c target)))
          (set (-> c hits) (+ (-> c hits) 1)))
      (return #t)))

  (func machines_by_kb_idx ((Memory * m) (const char * kb)) (out int64_t)
    (let ((MNameCtx c))
      (set ($ c target) kb)
      (set ($ c hits) 0)
      (set ($ c id) 0)
      (IDX_COCOLOG_MACHINES_KB_equal m (std::string kb) (cast (void *) (aof c)) machine_kb_cb)
      (return ($ c hits))))

  (func id_equal_count ((Memory * m) (int64_t id)) (out int64_t)
    (let ((MCountCtx c))
      (set ($ c rows) 0)
      (set ($ c id_sum) 0)
      (IDX_COCOLOG_MACHINES_ID_equal m id (cast (void *) (aof c)) machine_count_cb)
      (return ($ c rows))))

  ;; the VECTOR column: the one tensors row back out, vector and all
  (struct TRowCtx
    (member COCOLOG_TENSORS row)
    (member int64_t hits))

  (func tensor_row_cb ((void * u) (COCOLOG_TENSORS * r)) (out bool)
    (let ((TRowCtx * c . #'(cast (TRowCtx *) u)))
      (set (-> c hits) (+ (-> c hits) 1))
      (set ($ (-> c row) ID) (-> r ID))
      (set ($ (-> c row) SEQ) (-> r SEQ))
      (set ($ (-> c row) VEC) (-> r VEC))
      (return #t)))

  ;; 1 exactly when the store holds ONE tensors row whose vector is the
  ;; three doubles the test put in, each compared for exact equality --
  ;; the doubles cross the row as their own eight bytes, so equality is
  ;; the claim, not closeness
  (func tensor_vec_ok ((Memory * m)) (out int64_t)
    (let ((TRowCtx c))
      (set ($ c hits) 0)
      (COCOLOG_TENSORS_cursor m (cast (void *) (aof c)) tensor_row_cb)
      (if (!= ($ c hits) 1) (return 0))
      (if (!= (cast int64_t (($ ($ ($ c row) VEC) size))) 3) (return 0))
      (if (!= (($ ($ ($ c row) VEC) at) 0) 1.5) (return 0))
      (if (!= (($ ($ ($ c row) VEC) at) 1) -0.25) (return 0))
      (if (!= (($ ($ ($ c row) VEC) at) 2) 3.141592653589793) (return 0))
      (return 1)))

  (main
    (remove "/tmp/mvccs-schema-hexmap.bin")
    (remove "/tmp/mvccs-schema-data.bin")
    (letin* ((hexmap (Zigurat::filestream (std::string "/tmp/mvccs-schema-hexmap.bin")
                                 (bitor std::ios::in (bitor std::ios::out std::ios::trunc))))
             (data (Zigurat::filestream (std::string "/tmp/mvccs-schema-data.bin")
                               (bitor std::ios::in (bitor std::ios::out std::ios::trunc)))))
      (let ((Memory mem))
        (memory_open (aof mem) (cast (binarystream *) (aof hexmap))
                     (cast (binarystream *) (aof data)) 8192)

        ;; the generated objects, attached exactly as their comments say:
        ;; the ID index, the UNIQUE name index and the sequence. The KB
        ;; index is left for the reopen, on purpose: it is then an index
        ;; the store meets for the first time over a table with rows.
        (IDX_COCOLOG_MACHINES_ID_attach (aof mem))
        (IDX_COCOLOG_MACHINES_NAME_attach (aof mem))
        (COCOLOG_MACHINES_SEQ_attach (aof mem))
        (IDX_COCOLOG_TENSORS_ID_attach (aof mem))
        (COCOLOG_TENSORS_SEQ_attach (aof mem))

        ;; three machines, their ids drawn from the generated sequence,
        ;; their names/kb/status through the generated TEXT columns
        (let ((int64_t i . 0))
          (while (< i 3)
            (let ((COCOLOG_MACHINES row)
                  (char nm [16]))
              (sprintf nm "m-%ld" (cast long i))
              (set ($ row ID) (COCOLOG_MACHINES_SEQ_next))
              (set ($ row NAME) (std::string nm))
              (set ($ row KB) (std::string "user"))
              (set ($ row STATUS) (std::string "idle"))
              (set ($ row CHUNKS) 0)
              (set ($ row NOTE) (std::string ""))
              (COCOLOG_MACHINES_insert (aof mem) (aof row)))
            (set i (+ i 1))))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))

        (let ((MCountCtx c))
          (set ($ c rows) 0)
          (set ($ c id_sum) 0)
          (COCOLOG_MACHINES_cursor (aof mem) (cast (void *) (aof c)) machine_count_cb)
          (check "three machines through the generated table" ($ c rows) 3)
          ;; the generated sequence starts at 1: ids 1, 2, 3
          (check "their ids came from the generated sequence" ($ c id_sum) 6))

        (check "a TEXT name scan finds one" (machines_by_name (aof mem) "m-1") 1)
        (check "and misses what was never there" (machines_by_name (aof mem) "m-9") 0)
        (check "the scan pairs name with its id" (machine_id_by_name (aof mem) "m-2") 3)
        (check "the generated ID index finds one" (id_equal_count (aof mem) 2) 1)
        (check "and misses what was never drawn" (id_equal_count (aof mem) 99) 0)
        (check "the generated TEXT index finds one" (machines_by_name_idx (aof mem) "m-1") 1)
        (check "and misses what was never there" (machines_by_name_idx (aof mem) "m-9") 0)

        ;; the generated UNIQUE name, enforced through the hash: a twin
        ;; of m-1 under a fresh id is refused, and the refusal leaves the
        ;; one behind
        (let ((int64_t refused . 0))
          (try (block
                 (let ((COCOLOG_MACHINES twin))
                   (set ($ twin ID) 77)
                   (set ($ twin NAME) (std::string "m-1"))
                   (set ($ twin KB) (std::string "user"))
                   (set ($ twin STATUS) (std::string "idle"))
                   (set ($ twin CHUNKS) 0)
                   (set ($ twin NOTE) (std::string ""))
                   (COCOLOG_MACHINES_insert (aof mem) (aof twin))))
               (catch ((const IndexException & e))
                 (cast void e)
                 (set refused 1)))
          (check "the generated UNIQUE name refuses a twin" refused 1))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "and the refusal left the one behind" (machines_by_name_idx (aof mem) "m-1") 1)

        ;; ID is the schema's PRIMARY key; the generated index enforces it
        (let ((int64_t refused . 0))
          (try (block
                 (let ((COCOLOG_MACHINES dup))
                   (set ($ dup ID) 2)
                   (set ($ dup NAME) (std::string "again"))
                   (set ($ dup KB) (std::string "user"))
                   (set ($ dup STATUS) (std::string "idle"))
                   (set ($ dup CHUNKS) 0)
                   (set ($ dup NOTE) (std::string ""))
                   (COCOLOG_MACHINES_insert (aof mem) (aof dup))))
               (catch ((const IndexException & e))
                 (cast void e)
                 (set refused 1)))
          (check "the schema's PRIMARY ID is enforced" refused 1))
        (rollback_transaction (aof mem))
        (begin_transaction (aof mem))

        (check "the sequence kept its draw" (COCOLOG_MACHINES_SEQ_current) 4)

        ;; one tensors row through the generated VECTOR column: three
        ;; doubles in, and the same three back out of the cursor
        (let ((COCOLOG_TENSORS trow))
          (set ($ trow ID) (COCOLOG_TENSORS_SEQ_next))
          (set ($ trow KB) (std::string "user"))
          (set ($ trow NAME) (std::string "weights"))
          (set ($ trow SEQ) 0)
          (($ ($ trow VEC) push_back) 1.5)
          (($ ($ trow VEC) push_back) -0.25)
          (($ ($ trow VEC) push_back) 3.141592653589793)
          (COCOLOG_TENSORS_insert (aof mem) (aof trow)))
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (check "a VECTOR column hands its doubles back equal" (tensor_vec_ok (aof mem)) 1)

        (sync_disk (aof mem))
        (cast void 0)))

    ;; and the generated objects come back through the catalogue
    (letin* ((hexmap (Zigurat::filestream (std::string "/tmp/mvccs-schema-hexmap.bin")
                                 (bitor std::ios::in std::ios::out)))
             (data (Zigurat::filestream (std::string "/tmp/mvccs-schema-data.bin")
                               (bitor std::ios::in std::ios::out))))
      (let ((Memory mem))
        (memory_open (aof mem) (cast (binarystream *) (aof hexmap))
                     (cast (binarystream *) (aof data)) 8192)
        (IDX_COCOLOG_MACHINES_ID_attach (aof mem))
        (check "a reopened store knows its TEXT index"
               (IDX_COCOLOG_MACHINES_NAME_attach (aof mem)) 0)
        (COCOLOG_MACHINES_SEQ_attach (aof mem))
        (IDX_COCOLOG_TENSORS_ID_attach (aof mem))
        (COCOLOG_TENSORS_SEQ_attach (aof mem))
        (check "TEXT columns survive a restart" (machines_by_name (aof mem) "m-1") 1)
        (check "the generated index survives too" (id_equal_count (aof mem) 3) 1)
        (check "the generated TEXT index survives too" (machines_by_name_idx (aof mem) "m-2") 1)
        (check "so does the generated sequence" (COCOLOG_MACHINES_SEQ_current) 4)
        (check "a VECTOR column survives a restart bit-equal" (tensor_vec_ok (aof mem)) 1)

        ;; an index the store meets for the first time, over a table that
        ;; already has rows: attach says so, and until the rebuild the
        ;; tree is empty
        (check "a new index over an old table: attach says so"
               (IDX_COCOLOG_MACHINES_KB_attach (aof mem)) 1)
        (check "and its tree is empty until rebuilt" (machines_by_kb_idx (aof mem) "user") 0)
        (IDX_COCOLOG_MACHINES_KB_rebuild (aof mem))
        (check "the rebuild fills it from the rows" (machines_by_kb_idx (aof mem) "user") 3)
        (check "and finds nothing for a kb never stored" (machines_by_kb_idx (aof mem) "nope") 0)
        (commit_transaction (aof mem))
        (begin_transaction (aof mem))
        (sync_disk (aof mem))
        (cast void 0)))

    ;; and a third opening: the rebuilt index is durable, and the store
    ;; now knows it
    (letin* ((hexmap (Zigurat::filestream (std::string "/tmp/mvccs-schema-hexmap.bin")
                                 (bitor std::ios::in std::ios::out)))
             (data (Zigurat::filestream (std::string "/tmp/mvccs-schema-data.bin")
                               (bitor std::ios::in std::ios::out))))
      (let ((Memory mem))
        (memory_open (aof mem) (cast (binarystream *) (aof hexmap))
                     (cast (binarystream *) (aof data)) 8192)
        (IDX_COCOLOG_MACHINES_ID_attach (aof mem))
        (IDX_COCOLOG_MACHINES_NAME_attach (aof mem))
        (check "the rebuilt index is known on the next open"
               (IDX_COCOLOG_MACHINES_KB_attach (aof mem)) 0)
        (COCOLOG_MACHINES_SEQ_attach (aof mem))
        (check "and it survived the restart" (machines_by_kb_idx (aof mem) "user") 3)
        (cast void 0)))

    (if (== failures 0)
        (printf "\nschema-test: all green\n")
      (printf "\nschema-test: %d FAILED\n" failures))
    (return failures)))
